{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Api": {
    "BaseUrl": "http://localhost:5000"
  },
  "Node": {
    "Id": "node-1",
    "Token": "token"
  },
  "Cache": {
    "Root": "www",
    "Profiles": {
      "Home": { "Ttl": 60, "IgnoreQuery": false, "ForceCache": false, "QueryIgnoreList": [] },
      "Site": { "Ttl": 300, "IgnoreQuery": false, "ForceCache": false, "QueryIgnoreList": [] },
      "Static": { "Ttl": 2592000, "IgnoreQuery": true, "ForceCache": true, "QueryIgnoreList": [ "utm_*" ] },
      "Video": { "Ttl": 604800, "IgnoreQuery": false, "ForceCache": true, "QueryIgnoreList": [] }
    },
    "Rules": [],
    "StaticExtensions": [
      ".css", ".js", ".map", ".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg", ".ico",
      ".woff", ".woff2", ".ttf", ".otf", ".eot",
      ".txt", ".xml", ".json", ".pdf",
      ".zip", ".rar", ".7z",
      ".mp3", ".wav",
      ".wasm"
    ],
    "VideoExtensions": [
      ".mp4", ".m4v", ".mkv", ".mov", ".avi", ".flv", ".webm", ".ts", ".m3u8"
    ],
    "HomePaths": [ "/", "/index.html", "/index.htm" ]
  },
  "LogPipeline": {
    "BatchSize": 512,
    "FlushIntervalMs": 1000,
    "MaxQueue": 200000
  },
  "Stream": {
    "Mode": "userspace",
    "FallbackToUserspaceOnNatFailure": true,
    "IptablesBinary": "iptables",
    "CommandTimeoutMs": 3000
  },
  "Plugins": {
    "Enabled": false,
    "Directory": "plugins",
    "RequireSignature": true,
    "MaxAssemblyBytes": 33554432,
    "RestrictAssemblyToPluginDirectory": true,
    "AllowedPluginNames": [],
    "EvalTimeoutMs": 5,
    "ScanIntervalSeconds": 3,
    "Breaker": {
      "FailThreshold": 20,
      "WindowSeconds": 60,
      "OpenSeconds": 120
    }
  },
  "ReverseProxy": {
    "Health": {
      "ActivePolicy": {
        "DefaultThreshold": 2
      },
      "PassivePolicy": {
        "DetectionWindowSize": "00:01:00",
        "MinimalTotalCountThreshold": 10,
        "DefaultFailureRateLimit": 0.3
      }
    },
    "Routes": {
      "default": {
        "ClusterId": "origin",
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "origin": {
        "Destinations": {
          "origin-1": {
            "Address": "http://127.0.0.1:8080/"
          }
        }
      }
    }
  }
}
