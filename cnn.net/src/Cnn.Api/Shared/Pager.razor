<div class="pager">
    <div class="pager-total">总计 @Total</div>
    <div class="pager-controls">
        <select class="form-select form-select-sm" value="@PageSize" @onchange="OnPageSizeChanged">
            @foreach (var size in PageSizes)
            {
                <option value="@size">@size/页</option>
            }
        </select>
        <button class="btn btn-sm btn-outline-secondary" disabled="@(_page <= 1)" @onclick="Prev">上一页</button>
        <span class="pager-page">@_page / @_totalPages</span>
        <button class="btn btn-sm btn-outline-secondary" disabled="@(_page >= _totalPages)" @onclick="Next">下一页</button>
    </div>
</div>

@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 20;
    [Parameter] public long Total { get; set; }
    [Parameter] public int[] PageSizes { get; set; } = new[] { 10, 20, 50, 100 };
    [Parameter] public EventCallback<int> PageChanged { get; set; }
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }

    private int _page => Math.Max(1, Page);
    private int _totalPages => Math.Max(1, (int)Math.Ceiling(Total / (double)Math.Max(1, PageSize)));

    private async Task Prev()
    {
        if (_page <= 1)
        {
            return;
        }

        await PageChanged.InvokeAsync(_page - 1);
    }

    private async Task Next()
    {
        if (_page >= _totalPages)
        {
            return;
        }

        await PageChanged.InvokeAsync(_page + 1);
    }

    private async Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (args.Value == null)
        {
            return;
        }

        if (int.TryParse(args.Value.ToString(), out var size) && size > 0)
        {
            await PageSizeChanged.InvokeAsync(size);
        }
    }
}
