@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms

<div class="country-selector">
    <div class="mode-selector">
        <InputRadioGroup @bind-Value="_mode" @onchange="OnModeChanged" class="mode-group">
            <label class="form-check">
                <InputRadio class="form-check-input" Value='@("none")' />
                <span class="form-check-label">不设置</span>
            </label>
            <label class="form-check">
                <InputRadio class="form-check-input" Value='@("foreign_exclude")' />
                <span class="form-check-label">国外（不包括港澳台）</span>
            </label>
            <label class="form-check">
                <InputRadio class="form-check-input" Value='@("foreign_include")' />
                <span class="form-check-label">国外（包括港澳台）</span>
            </label>
            <label class="form-check">
                <InputRadio class="form-check-input" Value='@("china_include")' />
                <span class="form-check-label">中国（包括港澳台）</span>
            </label>
            <label class="form-check">
                <InputRadio class="form-check-input" Value='@("china_exclude")' />
                <span class="form-check-label">中国（不包括港澳台）</span>
            </label>
            <label class="form-check">
                <InputRadio class="form-check-input" Value='@("custom")' />
                <span class="form-check-label">自定义</span>
            </label>
        </InputRadioGroup>
    </div>

    @if (_mode == "custom")
    {
        <div class="custom-selector">
            @for (var i = 0; i < _groups.Count; i++)
            {
                var group = _groups[i];
                <div class="country-group">
                    <div class="group-header">
                        <div class="header-left">
                            <span class="group-label">@group.Label：</span>
                            <label class="form-check group-check">
                                <input type="checkbox"
                                       class="form-check-input"
                                       checked="@IsGroupAllChecked(group)"
                                       @onchange="(e) => ToggleGroupAll(group, e.Value)" />
                                <span class="form-check-label">全选</span>
                            </label>
                            <button type="button" class="btn btn-link btn-sm expand-btn" @onclick="() => ToggleGroupExpand(i)">
                                @(group.Expanded ? "收起" : "展开")
                            </button>
                        </div>
                    </div>
                    @if (group.Expanded)
                    {
                        <div class="group-items">
                            @foreach (var item in group.Items)
                            {
                                <label class="form-check group-item">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           checked="@IsItemChecked(item.Value)"
                                           @onchange="(e) => ToggleItem(item.Value, e.Value)" />
                                    <span class="form-check-label">@item.Label</span>
                                </label>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public List<string> Value { get; set; } = new();

    [Parameter]
    public EventCallback<List<string>> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<List<string>> OnChange { get; set; }

    private string _mode = "none";
    private List<CountryGroupState> _groups = RawGroups.Select(group => new CountryGroupState(group)).ToList();

    protected override void OnParametersSet()
    {
        Value ??= new List<string>();
        var detected = DetectMode(Value);
        if (_mode != "custom")
        {
            if (detected != _mode)
            {
                _mode = detected;
            }
        }
        else if (detected != "custom" && detected != "none")
        {
            _mode = detected;
        }
    }

    private async Task OnModeChanged(ChangeEventArgs e)
    {
        var mode = e.Value?.ToString() ?? "none";
        _mode = mode;
        if (mode == "custom")
        {
            return;
        }

        var newValue = mode switch
        {
            "china_exclude" => new List<string>(PresetChinaExclude),
            "china_include" => new List<string>(PresetChinaInclude),
            "foreign_include" => new List<string>(PresetForeignInclude),
            "foreign_exclude" => new List<string>(PresetForeignExclude),
            _ => new List<string>()
        };

        await UpdateValueAsync(newValue);
    }

    private async Task ToggleGroupAll(CountryGroupState group, object? checkedValue)
    {
        var isChecked = ParseBool(checkedValue);
        var current = new HashSet<string>(Value, StringComparer.OrdinalIgnoreCase);
        if (isChecked)
        {
            foreach (var item in group.Items)
            {
                current.Add(item.Value);
            }
        }
        else
        {
            foreach (var item in group.Items)
            {
                current.Remove(item.Value);
            }
        }

        await UpdateValueAsync(current.ToList());
    }

    private async Task ToggleItem(string code, object? checkedValue)
    {
        var isChecked = ParseBool(checkedValue);
        var current = new HashSet<string>(Value, StringComparer.OrdinalIgnoreCase);
        if (isChecked)
        {
            current.Add(code);
        }
        else
        {
            current.Remove(code);
        }

        await UpdateValueAsync(current.ToList());
    }

    private void ToggleGroupExpand(int index)
    {
        if (index < 0 || index >= _groups.Count)
        {
            return;
        }
        _groups[index].Expanded = !_groups[index].Expanded;
    }

    private bool IsItemChecked(string code)
    {
        return Value?.Contains(code, StringComparer.OrdinalIgnoreCase) ?? false;
    }

    private bool IsGroupAllChecked(CountryGroupState group)
    {
        if (Value == null || Value.Count == 0)
        {
            return false;
        }
        var current = new HashSet<string>(Value, StringComparer.OrdinalIgnoreCase);
        return group.Items.All(item => current.Contains(item.Value));
    }

    private static bool ParseBool(object? value)
    {
        if (value is bool flag)
        {
            return flag;
        }
        if (value is string text && bool.TryParse(text, out var parsed))
        {
            return parsed;
        }
        return false;
    }

    private async Task UpdateValueAsync(List<string> value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
        if (OnChange.HasDelegate)
        {
            await OnChange.InvokeAsync(value);
        }
    }

    private static string DetectMode(IReadOnlyList<string> value)
    {
        if (value == null || value.Count == 0)
        {
            return "none";
        }

        if (AreSetsEqual(value, PresetChinaExclude)) return "china_exclude";
        if (AreSetsEqual(value, PresetChinaInclude)) return "china_include";
        if (AreSetsEqual(value, PresetForeignInclude)) return "foreign_include";
        if (AreSetsEqual(value, PresetForeignExclude)) return "foreign_exclude";

        return "custom";
    }

    private static bool AreSetsEqual(IReadOnlyList<string> left, IReadOnlyList<string> right)
    {
        if (left.Count != right.Count)
        {
            return false;
        }
        var set = new HashSet<string>(right, StringComparer.OrdinalIgnoreCase);
        return left.All(item => set.Contains(item));
    }

    private sealed record CountryItem(string Label, string Value);

    private sealed record CountryGroup(string Label, List<CountryItem> Items);

    private sealed class CountryGroupState
    {
        public CountryGroupState(CountryGroup group)
        {
            Label = group.Label;
            Items = group.Items;
        }

        public string Label { get; }
        public List<CountryItem> Items { get; }
        public bool Expanded { get; set; } = true;
    }

    private const string ChinaInlandCode = "cn";
    private static readonly List<string> ChinaRegionCodes = new() { "hk", "mo", "tw" };
    private static readonly List<string> PresetChinaExclude = new() { ChinaInlandCode };
    private static readonly List<string> PresetChinaInclude = new() { ChinaInlandCode, "hk", "mo", "tw" };
    private static List<string> AllItemCodes => RawGroups
        .SelectMany(group => group.Items.Select(item => item.Value))
        .ToList();
    private static List<string> PresetForeignInclude => AllItemCodes
        .Where(code => !string.Equals(code, ChinaInlandCode, StringComparison.OrdinalIgnoreCase))
        .ToList();
    private static List<string> PresetForeignExclude => AllItemCodes
        .Where(code =>
            !string.Equals(code, ChinaInlandCode, StringComparison.OrdinalIgnoreCase) &&
            !ChinaRegionCodes.Contains(code, StringComparer.OrdinalIgnoreCase))
        .ToList();

