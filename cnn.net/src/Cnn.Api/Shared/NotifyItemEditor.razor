@using Cnn.Api.Models

<div class="notify-item">
    <div class="notify-title">@Title</div>
    <div class="notify-body">
        <div class="form-check form-switch">
            <InputCheckbox class="form-check-input" @bind-Value="_enabled" />
            <label class="form-check-label">开启</label>
        </div>

        @if (_enabled)
        {
            <div class="notify-section">
                <label class="form-label">通知方式</label>
                <div class="notify-methods">
                    <label class="form-check">
                        <InputCheckbox class="form-check-input" @bind-Value="_emailEnabled" />
                        <span class="form-check-label">邮件</span>
                    </label>
                    <label class="form-check">
                        <InputCheckbox class="form-check-input" @bind-Value="_smsEnabled" />
                        <span class="form-check-label">短信</span>
                    </label>
                </div>
            </div>

            @if (ShowRemainTraffic)
            {
                <div class="notify-section">
                    <label class="form-label">剩余流量不足 (GB)</label>
                    <InputNumber class="form-control" @bind-Value="Model.RemainTraffic" />
                </div>
            }

            @if (ShowDays)
            {
                <div class="notify-section">
                    <label class="form-label">剩余时间不足 (天)</label>
                    <InputNumber class="form-control" @bind-Value="Model.Days" />
                </div>
            }

            <div class="notify-section">
                <label class="form-label">连续通知次数</label>
                <InputNumber class="form-control" @bind-Value="Model.ContinuousTimes" />
            </div>
            <div class="notify-section">
                <label class="form-label">间隔时间 (小时)</label>
                <InputNumber class="form-control" @bind-Value="Model.Interval" />
            </div>
            <div class="notify-section">
                <label class="form-label">通知模板</label>
                <InputRadioGroup @bind-Value="_templateType">
                    <div class="notify-methods">
                        <label class="form-check">
                            <InputRadio class="form-check-input" Value='@("email")' />
                            <span class="form-check-label">邮件模板</span>
                        </label>
                        <label class="form-check">
                            <InputRadio class="form-check-input" Value='@("sms")' />
                            <span class="form-check-label">短信模板</span>
                        </label>
                    </div>
                </InputRadioGroup>
            </div>
            @if (_templateType == "email")
            {
                <div class="notify-template">
                    <label class="form-label">标题</label>
                    <InputText class="form-control" @bind-Value="Model.EmailTemplate.Title" />
                    <label class="form-label mt-2">内容</label>
                    <InputTextArea class="form-control" rows="4" @bind-Value="Model.EmailTemplate.Content" />
                    @if (Variables.Length > 0)
                    {
                        <div class="notify-vars">
                            <span>可用变量:</span>
                            @foreach (var variable in Variables)
                            {
                                <button type="button" class="var-tag" @onclick="() => AppendVariable(variable, true)">@variable</button>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="notify-template">
                    <label class="form-label">内容</label>
                    <InputTextArea class="form-control" rows="4" @bind-Value="Model.SmsTemplate.Content" />
                    @if (Variables.Length > 0)
                    {
                        <div class="notify-vars">
                            <span>可用变量:</span>
                            @foreach (var variable in Variables)
                            {
                                <button type="button" class="var-tag" @onclick="() => AppendVariable(variable, false)">@variable</button>
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter] public NotifyItemModel Model { get; set; } = new();
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string[] Variables { get; set; } = Array.Empty<string>();
    [Parameter] public bool ShowRemainTraffic { get; set; }
    [Parameter] public bool ShowDays { get; set; }

    private bool _enabled
    {
        get => Model.Enable == 1;
        set => Model.Enable = value ? 1 : 0;
    }

    private bool _emailEnabled
    {
        get => Model.Methods.Contains("email");
        set
        {
            if (value)
            {
                if (!Model.Methods.Contains("email"))
                {
                    Model.Methods.Add("email");
                }
            }
            else
            {
                Model.Methods.Remove("email");
            }
        }
    }

    private bool _smsEnabled
    {
        get => Model.Methods.Contains("sms");
        set
        {
            if (value)
            {
                if (!Model.Methods.Contains("sms"))
                {
                    Model.Methods.Add("sms");
                }
            }
            else
            {
                Model.Methods.Remove("sms");
            }
        }
    }

    private string _templateType = "email";

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(Model.EmailTemplate.Content))
        {
            _templateType = "email";
        }
        if (!string.IsNullOrWhiteSpace(Model.SmsTemplate.Content) && string.IsNullOrWhiteSpace(Model.EmailTemplate.Content))
        {
            _templateType = "sms";
        }
    }

    private void AppendVariable(string variable, bool isEmail)
    {
        if (isEmail)
        {
            Model.EmailTemplate.Content = (Model.EmailTemplate.Content ?? string.Empty) + variable;
        }
        else
        {
            Model.SmsTemplate.Content = (Model.SmsTemplate.Content ?? string.Empty) + variable;
        }
    }
}
