        string Key,
        string Title,
        string Icon,
        List<MenuItem> Items,
        string[]? Roles,
        IReadOnlyList<string>? ActivePathPrefixes = null);

    private sealed record MenuItem(string Title, string Path, string Icon, string[]? Roles);
