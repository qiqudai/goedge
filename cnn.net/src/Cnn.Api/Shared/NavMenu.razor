@inject ClientSession Session
@inject NavigationManager Navigation

@implements IDisposable

<MudNavMenu Dense="true" Class="nav-menu-root">
    @if (DashboardVisible)
    {
        <MudNavLink Href="@Dashboard.Path"
                    Match="NavLinkMatch.Prefix"
                    Icon="@Dashboard.Icon">
            @Dashboard.Title
        </MudNavLink>
    }

    @foreach (var group in FilteredGroups)
    {
        <MudNavGroup Title="@group.Title"
                     Icon="@group.Icon"
                     Expanded="@IsExpanded(group)"
                     ExpandedChanged="value => OnExpandedChanged(group, value)">
            @foreach (var item in group.Items)
            {
                <MudNavLink Href="@item.Path"
                            Match="NavLinkMatch.Prefix"
                            Icon="@item.Icon">
                    @item.Title
                </MudNavLink>
            }
        </MudNavGroup>
    }
</MudNavMenu>

@code {
    [Parameter]
    public EventCallback OnNavigate { get; set; }

    private string? _expandedGroupKey;
    private static readonly MenuItem Dashboard = new("仪表盘", "/dashboard", Icons.Material.Filled.Fullscreen, new[] { "admin", "user" });

    private bool DashboardVisible => Dashboard.Roles == null
        || Dashboard.Roles.Length == 0
        || Dashboard.Roles.Contains(Session.Role);

    private IReadOnlyList<MenuGroup> FilteredGroups => _groups
        .Where(group => group.Roles == null || group.Roles.Length == 0 || group.Roles.Contains(Session.Role))
        .Select(group => group with
        {
            Items = group.Items
                .Where(item => item.Roles == null || item.Roles.Length == 0 || item.Roles.Contains(Session.Role))
                .ToList()
        })
        .Where(group => group.Items.Count > 0)
        .ToList();

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        EnsureExpandedState(forceActiveOpen: true, singleOpen: true);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        EnsureExpandedState(forceActiveOpen: true, singleOpen: true);
        _ = InvokeAsync(async () =>
        {
            if (OnNavigate.HasDelegate)
            {
                await OnNavigate.InvokeAsync();
            }
            StateHasChanged();
        });
    }

    private bool IsExpanded(MenuGroup group)
    {
        EnsureExpandedState(forceActiveOpen: false, singleOpen: false);
        return string.Equals(_expandedGroupKey, group.Key, StringComparison.OrdinalIgnoreCase);
    }

    private void OnExpandedChanged(MenuGroup group, bool value)
    {
        if (value)
        {
            _expandedGroupKey = group.Key;
            return;
        }

        if (string.Equals(_expandedGroupKey, group.Key, StringComparison.OrdinalIgnoreCase))
        {
            _expandedGroupKey = null;
        }
    }

    private void EnsureExpandedState(bool forceActiveOpen, bool singleOpen)
    {
        var currentPath = NormalizePath("/" + Navigation.ToBaseRelativePath(Navigation.Uri));
        var visibleKeys = new HashSet<string>(FilteredGroups.Select(g => g.Key), StringComparer.OrdinalIgnoreCase);

        if (!string.IsNullOrWhiteSpace(_expandedGroupKey) && !visibleKeys.Contains(_expandedGroupKey))
        {
            _expandedGroupKey = null;
        }

        var activeGroup = FilteredGroups.FirstOrDefault(group => GroupMatchesPath(group, currentPath));
        if (activeGroup != null && forceActiveOpen)
        {
            _expandedGroupKey = activeGroup.Key;
            return;
        }

        if (singleOpen && string.IsNullOrWhiteSpace(_expandedGroupKey))
        {
            _expandedGroupKey = FilteredGroups.FirstOrDefault()?.Key;
        }
    }

    private static bool GroupMatchesPath(MenuGroup group, string currentPath)
    {
        if (group.Items.Any(item => PathMatches(currentPath, NormalizePath(item.Path))))
        {
            return true;
        }

        if (group.ActivePathPrefixes != null)
        {
            foreach (var path in group.ActivePathPrefixes)
            {
                if (PathMatches(currentPath, NormalizePath(path)))
                {
                    return true;
                }
            }
        }

        return false;
    }

    private static bool PathMatches(string currentPath, string targetPath)
    {
        return string.Equals(currentPath, targetPath, StringComparison.OrdinalIgnoreCase)
            || currentPath.StartsWith(targetPath + "/", StringComparison.OrdinalIgnoreCase);
    }

    private static string NormalizePath(string path)
    {
        var normalized = string.IsNullOrWhiteSpace(path) ? "/" : path.Trim();
        if (!normalized.StartsWith("/", StringComparison.Ordinal))
        {
            normalized = "/" + normalized;
        }

        var queryIndex = normalized.IndexOf('?');
        if (queryIndex >= 0)
        {
            normalized = normalized[..queryIndex];
        }

        var hashIndex = normalized.IndexOf('#');
        if (hashIndex >= 0)
        {
            normalized = normalized[..hashIndex];
        }

        return normalized.TrimEnd('/').ToLowerInvariant() switch
        {
            "" => "/",
            _ => normalized.TrimEnd('/').ToLowerInvariant()
        };
    }

