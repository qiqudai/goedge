@inherits LayoutComponentBase
@using Cnn.Common.Contracts
@using global::System.Timers
@inject ClientSession Session
@inject LocalStorageService Storage
@inject SystemInfoClient SystemInfoClient
@inject ApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime Js

<MudThemeProvider @bind-IsDarkMode="_isDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<PageTitle>@_pageTitle</PageTitle>

<div class="common-layout">
    <MudLayout>
        <MudAppBar Dense="true" Elevation="0" Class="app-header">
            <MudHidden Breakpoint="Breakpoint.MdAndUp">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
            </MudHidden>

            <MudText Typo="Typo.body1" Class="header-title">@_consoleTitle</MudText>
            <MudSpacer />

            @if (!Session.IsAdmin)
            {
                @if (_unreadCount > 0)
                {
                    <MudBadge Content="@(_unreadCount > 99 ? "99+" : _unreadCount.ToString())" Color="Color.Error" Overlap="true">
                        <MudIconButton Icon="@Icons.Material.Filled.NotificationsNone" Color="Color.Inherit" OnClick="GoMessages" />
                    </MudBadge>
                }
                else
                {
                    <MudIconButton Icon="@Icons.Material.Filled.NotificationsNone" Color="Color.Inherit" OnClick="GoMessages" />
                }
            }

            <button class="theme-switch @(_isDark ? "dark" : string.Empty)" type="button" @onclick="ToggleTheme">
                <span class="theme-thumb">
                    <MudIcon Icon="@(_isDark ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode)" Size="Size.Small" />
                </span>
            </button>

            <MudMenu Icon="@Icons.Material.Filled.PersonOutline" Color="Color.Inherit" Dense="true">
                @if (Session.IsAdmin)
                {
                    <MudMenuItem OnClick="GoSystemConfig">系统设置</MudMenuItem>
                }
                else
                {
                    <MudMenuItem OnClick="GoProfile">个人中心</MudMenuItem>
                }
                <MudDivider />
                <MudMenuItem OnClick="Logout">退出登录</MudMenuItem>
            </MudMenu>
        </MudAppBar>

        <MudDrawer @bind-Open="_drawerOpen"
                   Anchor="Anchor.Start"
                   Variant="DrawerVariant.Responsive"
                   Breakpoint="Breakpoint.Md"
                   ClipMode="DrawerClipMode.Always"
                   Elevation="0"
                   Class="app-drawer">
            <MudDrawerHeader Class="drawer-header">
                @if (!string.IsNullOrWhiteSpace(_systemInfo?.LogoFile))
                {
                    <img src="@_systemInfo!.LogoFile" class="drawer-logo" alt="logo" />
                }
                else
                {
                    <MudText Typo="Typo.h6" Class="drawer-title">@(_systemInfo?.SysName ?? "CDN Admin")</MudText>
                }
            </MudDrawerHeader>

            <NavMenu />
        </MudDrawer>

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.False" Class="content-wrap">
                @Body
            </MudContainer>

            @if (_showFooter)
            {
                <footer class="app-footer">
                    <div class="footer-links">
                        @foreach (var link in _footerLinks)
                        {
                            <a href="@link.Url" target="_blank" rel="noopener">@link.Label</a>
                        }
                    </div>
                    <div class="footer-copy">@_systemInfo?.FooterCopyright</div>
                </footer>
            }
        </MudMainContent>
    </MudLayout>
</div>

@code {
    private SystemInfoDto? _systemInfo;
    private string _pageTitle = "CDN Admin";
    private string _consoleTitle = "管理后台";
    private bool _isDark;
    private bool _drawerOpen = true;
    private int _unreadCount;
    private Timer? _pollTimer;
    private List<(string Label, string Url)> _footerLinks = new();
    private bool _showFooter;
    private bool _clientBootstrapped;

    protected override async Task OnInitializedAsync()
    {
        await LoadSystemInfoAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _clientBootstrapped)
        {
            return;
        }

        _clientBootstrapped = true;
        await EnsureSessionAsync();
        await LoadSystemInfoAsync();
        await ApplyThemeAsync();
        StartPolling();
        StateHasChanged();
    }

    private async Task EnsureSessionAsync()
    {
        if (Session.Initialized)
        {
            return;
        }

        var token = await Storage.GetItemAsync("admin_token");
        var role = await Storage.GetItemAsync("role");
        var username = await Storage.GetItemAsync("username");
        Session.Set(token, role, username);
        Session.MarkInitialized();

        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    }

    private async Task LoadSystemInfoAsync()
    {
        _systemInfo = await SystemInfoClient.GetAsync();
        _pageTitle = Session.IsAdmin
            ? (_systemInfo.AdminConsoleTitle ?? _systemInfo.SysName ?? "管理后台")
            : (_systemInfo.UserConsoleTitle ?? _systemInfo.SysName ?? "控制台");
        _consoleTitle = _pageTitle;
        BuildFooterLinks();
        StateHasChanged();
    }

    private void BuildFooterLinks()
    {
        _footerLinks = new List<(string Label, string Url)>();
        var raw = _systemInfo?.FooterLink ?? string.Empty;
        if (!string.IsNullOrWhiteSpace(raw))
        {
            foreach (var line in raw.Split(new[] { "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries))
            {
                var parts = line.Split('|', 2, StringSplitOptions.RemoveEmptyEntries);
                if (parts.Length == 0)
                {
                    continue;
                }

                var label = parts[0].Trim();
                var url = parts.Length > 1 ? parts[1].Trim() : label;
                if (!string.IsNullOrWhiteSpace(url))
                {
                    _footerLinks.Add((string.IsNullOrWhiteSpace(label) ? url : label, url));
                }
            }
        }

        _showFooter = _footerLinks.Count > 0 || !string.IsNullOrWhiteSpace(_systemInfo?.FooterCopyright);
    }

    private async Task ApplyThemeAsync()
    {
        var theme = await Storage.GetItemAsync("theme");
        _isDark = string.Equals(theme, "dark", StringComparison.OrdinalIgnoreCase);
        await Js.InvokeVoidAsync("cnn.theme.set", _isDark ? "dark" : "light");
    }

    private async Task ToggleTheme()
    {
        _isDark = !_isDark;
        await Storage.SetItemAsync("theme", _isDark ? "dark" : "light");
        await Js.InvokeVoidAsync("cnn.theme.set", _isDark ? "dark" : "light");
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task PollUnreadAsync()
    {
        if (Session.IsAdmin)
        {
            return;
        }

        var response = await Api.GetAsync<MessageUnreadResult>("messages/unread", ApiScope.User);
        if (response?.Data == null)
        {
            return;
        }

        _unreadCount = (int)response.Data.Count;
        StateHasChanged();
    }

    private void StartPolling()
    {
        if (Session.IsAdmin)
        {
            return;
        }

        _pollTimer?.Stop();
        _pollTimer?.Dispose();
        _pollTimer = new Timer(30000);
        _pollTimer.Elapsed += (_, _) => InvokeAsync(PollUnreadAsync);
        _pollTimer.Start();
        _ = PollUnreadAsync();
    }

    private void GoSystemConfig()
    {
        Navigation.NavigateTo("/system/config");
    }

    private void GoProfile()
    {
        Navigation.NavigateTo("/account/profile");
    }

    private void GoMessages()
    {
        Navigation.NavigateTo("/account/messages");
    }

    private async Task Logout()
    {
        Session.Clear();
        await Storage.RemoveItemAsync("admin_token");
        await Storage.RemoveItemAsync("role");
        await Storage.RemoveItemAsync("username");
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
