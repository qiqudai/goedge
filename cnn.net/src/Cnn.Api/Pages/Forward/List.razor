@page "/forward/list"
@using Cnn.Common.Contracts
@using Cnn.Common.Contracts.Admin
@inject ApiClient Api
@inject ClientSession Session
@inject IJSRuntime Js
@inject NavigationManager Nav

<div class="page-container">
    <div class="page-title">转发列表</div>

    <div class="tab-bar mb-3">
        <button class="tab-button active">转发列表</button>
        <button class="tab-button" @onclick='@(() => Nav.NavigateTo("/forward/default"))'>默认设置</button>
        <button class="tab-button" @onclick='@(() => Nav.NavigateTo("/forward/monitor"))'>实时监控</button>
    </div>

    <div class="filter-bar">
        <button class="btn btn-primary" @onclick="OpenCreate">新增转发</button>
        <button class="btn btn-outline-secondary" disabled="@(!_selectedIds.Any())" @onclick='@(() => BatchActionAsync("enable"))'>启用</button>
        <button class="btn btn-outline-secondary" disabled="@(!_selectedIds.Any())" @onclick='@(() => BatchActionAsync("disable"))'>禁用</button>
        <button class="btn btn-outline-danger" disabled="@(!_selectedIds.Any())" @onclick='@(() => BatchActionAsync("delete"))'>删除</button>
        <button class="btn btn-outline-secondary" @onclick="RefreshAsync">刷新</button>
    </div>

    <div class="filter-bar">
        <select class="form-select" style="max-width: 150px" @bind="_filters.SearchField">
            <option value="all">全部字段</option>
            <option value="forward_id">ID</option>
            <option value="listen">监听端口</option>
            <option value="origin">源站</option>
            <option value="cname">CNAME</option>
            <option value="package">套餐</option>
            <option value="group">分组</option>
            <option value="user">用户</option>
        </select>
        <InputText class="form-control" style="max-width: 220px" @bind-Value="_filters.Keyword" placeholder="关键字" />
        <select class="form-select" style="max-width: 140px" @bind="_filters.Status">
            <option value="">全部状态</option>
            <option value="enabled">启用</option>
            <option value="disabled">禁用</option>
        </select>
        <button class="btn btn-primary" @onclick="SearchAsync">搜索</button>
        <button class="btn btn-link" @onclick="OpenAdvancedSearch">高级搜索</button>
        <button class="btn btn-outline-secondary" @onclick="TogglePagingDiagnostics">
            @(_showPagingDiagnostics ? "隐藏分页诊断" : "显示分页诊断")
        </button>
    </div>

    @if (_showPagingDiagnostics)
    {
        <div class="alert alert-light py-2 px-3 mt-2 mb-2 small">
            <div><strong>分页诊断</strong></div>
            <div>stateKey: <code>forward:list:table</code></div>
            <div>pagingEnabled: <code>@(_pageQuery.PagingEnabled ? "true" : "false")</code></div>
            <div>page: <code>@_pageQuery.Page</code>, pageSize: <code>@_pageQuery.PageSize</code></div>
            <div>loaded: <code>@_items.Count</code>, total: <code>@_total</code></div>
        </div>
    }

    <TablePager @ref="_tablePager"
                StateKey="forward:list:table"
                Total="_total"
                DefaultPageSize="20"
                UnpagedLimit="1000"
                QueryChanged="OnPageQueryChangedAsync">
        <ChildContent>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th style="width:50px"><input type="checkbox" class="form-check-input" checked="@AllSelected" @onchange="ToggleSelectAll" /></th>
                            <th>ID</th>
                            @if (Session.IsAdmin)
                            {
                                <th>用户</th>
                            }
                            <th>监听端口</th>
                            <th>源站</th>
                            <th>区域(线路组)</th>
                            <th>CNAME</th>
                            <th>套餐</th>
                            <th>分组</th>
                            <th>状态</th>
                            <th>时间</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_loading)
                        {
                            <tr><td colspan="10">加载中...</td></tr>
                        }
                        else if (_items.Count == 0)
                        {
                            <tr><td colspan="10">暂无数据</td></tr>
                        }
                        else
                        {
                            @foreach (var item in _items)
                            {
                                <tr>
                                    <td><input type="checkbox" class="form-check-input" checked="@_selectedIds.Contains(item.Id)" @onchange="e => ToggleRow(item.Id, e)" /></td>
                                    <td>@item.Id</td>
                                    @if (Session.IsAdmin)
                                    {
                                        <td>@FormatUser(item)</td>
                                    }
                                    <td>@item.ListenPorts</td>
                                    <td>@item.OriginDisplay</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.NodeGroupName) ? "-" : item.NodeGroupName)</td>
                                    <td>@item.Cname</td>
                                    <td>@item.UserPackageName</td>
                                    <td>@item.GroupName</td>
                                    <td>@(item.Status ? "启用" : "禁用")</td>
                                    <td>@FormatDate(item.CreatedAt)</td>
                                    <td class="d-flex gap-2 flex-wrap">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEdit(item)">编辑</button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick='@(() => RowActionAsync(item, item.Status ? "disable" : "enable"))'>
                                            @(item.Status ? "禁用" : "启用")
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(item)">删除</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </ChildContent>
    </TablePager>
</div>

@if (_advancedVisible)
{
    <div class="modal-backdrop">
        <div class="modal-panel" style="max-width: 500px">
            <div class="modal-header">
                <h5>高级搜索</h5>
                <button class="btn-close" @onclick="CloseAdvancedSearch"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">状态</label>
                    <select class="form-select" @bind="_advancedStatus">
                        <option value="">全部</option>
                        <option value="enabled">正常</option>
                        <option value="disabled">停用</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-end gap-2">
                <button class="btn btn-secondary" @onclick="CloseAdvancedSearch">取消</button>
                <button class="btn btn-primary" @onclick="ApplyAdvancedSearch">搜索</button>
            </div>
        </div>
    </div>
}

@if (_editorVisible)
{
    <div class="modal-backdrop">
        <div class="modal-panel">
            <div class="modal-header">
                <h5>@(_editing.Id > 0 ? "编辑转发" : "新增转发")</h5>
                <button class="btn-close" @onclick="CloseEditor"></button>
            </div>
            <div class="modal-body">
                <div class="tab-bar mb-3">
                    <button class='tab-button @(_editorTab == "single" ? "active" : "")' @onclick='@(() => _editorTab = "single")'>单个</button>
                    @if (_editing.Id <= 0)
                    {
                        <button class='tab-button @(_editorTab == "batch" ? "active" : "")' @onclick='@(() => _editorTab = "batch")'>批量</button>
                    }
                </div>
                <div class="row g-3">
                    @if (Session.IsAdmin)
                    {
                        <div class="col-md-12">
                            <label class="form-label">用户</label>
                            <select class="form-select" @bind="_editing.UserId" @bind:after="OnEditorUserChangedAsync">
                                <option value="0">请选择用户</option>
                                @foreach (var user in _users)
                                {
                                    <option value="@user.Id">@FormatUserOption(user)</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="col-md-12">
                        <label class="form-label">套餐</label>
                        <select class="form-select" @bind="_editing.UserPackageId">
                            <option value="0">请选择套餐</option>
                            @foreach (var pkg in _packages)
                            {
                                <option value="@pkg.Id">@pkg.Name</option>
                            }
                        </select>
                    </div>
                    @if (_editorTab == "single" || _editing.Id > 0)
                    {
                        <div class="col-md-12">
                            <label class="form-label">监听端口</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="_editing.ListenPortsInput" placeholder="88、99/udp或88/tcp, 多个端口空格分隔" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">源地址:端口</label>
                            <InputTextArea class="form-control" rows="3" @bind-Value="_editing.OriginInput" placeholder="1.1.1.1:99 或 www.abc.com:99" />
                        </div>
                    }
                    else
                    {
                        <div class="col-md-12">
                            <label class="form-label">批量转发数据</label>
                            <InputTextArea class="form-control" rows="5" @bind-Value="_editing.BatchData" placeholder="格式: 监听端口|IP|回源端口&#10;88 99/udp|1.2.3.4|8080&#10;77 66|8.8.8.8|8080" />
                        </div>
                        <div class="col-md-12">
                            <div class="form-check">
                                <input class="form-check-input" id="forwardIgnoreErrors" type="checkbox" @bind="_editing.IgnoreErrors" />
                                <label class="form-check-label" for="forwardIgnoreErrors">有转发添加出错时不中断，继续添加下一条</label>
                            </div>
                        </div>
                    }
                </div>

                <div class="my-4 text-center">
                    <button class="btn btn-link text-decoration-none" @onclick='@(() => _expandEditorOptions = !_expandEditorOptions)'>
                        更多设置 @(_expandEditorOptions ? "收起" : "展开")
                    </button>
                </div>

                @if (_expandEditorOptions)
                {
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label">所属分组</label>
                            @if (_groups.Count == 0)
                            {
                                <div class="form-text">暂无可用分组</div>
                            }
                            else
                            {
                                <div class="border rounded p-2" style="max-height: 180px; overflow-y: auto;">
                                    @foreach (var group in _groups)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="@($"forward-group-{group.Id}")" checked="@_editing.GroupIds.Contains(group.Id)" @onchange="e => ToggleEditorGroup(group.Id, e)" />
                                            <label class="form-check-label" for="@($"forward-group-{group.Id}")">@group.Name</label>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">备注</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="_editing.Remark" />
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer d-flex justify-content-end gap-2">
                <button class="btn btn-secondary" @onclick="CloseEditor">取消</button>
                <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">保存</button>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<ForwardListItem> _items = new();
    private readonly List<UserPackageItemDto> _packages = new();
    private readonly List<ForwardGroupDto> _groups = new();
    private readonly List<UserItemDto> _users = new();
    private readonly HashSet<long> _selectedIds = new();
    private bool _loading;
    private bool _saving;
    private bool _editorVisible;
    private bool _advancedVisible;
    private bool _showPagingDiagnostics;
    private bool _expandEditorOptions;
    private int _total;
    private TablePageQuery _pageQuery = new() { PagingEnabled = true, Page = 1, PageSize = 20 };
    private string _advancedStatus = string.Empty;
    private string _editorTab = "single";
    private ForwardFilters _filters = new();
    private ForwardEditModel _editing = new();
    private TablePager? _tablePager;

    protected override async Task OnInitializedAsync()
    {
        await LoadInitialDependenciesAsync();
    }

    private ApiScope Scope => Session.IsAdmin ? ApiScope.Admin : ApiScope.User;

    private async Task LoadAsync()
    {
        if (_loading)
        {
            return;
        }

        _loading = true;
        var query = new Dictionary<string, string?>
        {
            ["page"] = _pageQuery.Page.ToString(),
            ["pageSize"] = _pageQuery.PageSize.ToString(),
            ["keyword"] = _filters.Keyword,
            ["search_field"] = _filters.SearchField,
            ["status"] = _filters.Status
        };

        var response = await Api.GetAsync<ForwardListResult>("forwards", Scope, query);
        _items.Clear();
        if (response?.Data?.List != null)
        {
            _items.AddRange(response.Data.List);
            _total = (int)response.Data.Total;
        }
        else
        {
            _total = 0;
        }
        _loading = false;
    }

    private async Task LoadInitialDependenciesAsync()
    {
        if (Session.IsAdmin)
        {
            var usersResponse = await Api.GetAsync<UserListResult>("users", ApiScope.Admin, new Dictionary<string, string?>
            {
                ["pageSize"] = "200"
            });
            _users.Clear();
            if (usersResponse?.Data?.List != null)
            {
                _users.AddRange(usersResponse.Data.List.OrderBy(x => x.Name ?? string.Empty).ThenBy(x => x.Id));
            }
        }

        await LoadEditorDependenciesAsync(Session.IsAdmin ? 0 : (Session.UserId ?? 0));
    }

    private async Task LoadEditorDependenciesAsync(long userId)
    {
        _packages.Clear();
        _groups.Clear();

        var packageQuery = new Dictionary<string, string?>
        {
            ["pageSize"] = "1000"
        };
        if (Session.IsAdmin && userId > 0)
        {
            packageQuery["user_id"] = userId.ToString();
        }

        var packageResponse = await Api.GetAsync<UserPackageListResult>("user_packages", Scope, packageQuery);
        if (packageResponse?.Data?.List != null)
        {
            _packages.AddRange(packageResponse.Data.List);
        }

        Dictionary<string, string?>? groupQuery = null;
        if (Session.IsAdmin && userId > 0)
        {
            groupQuery = new Dictionary<string, string?>
            {
                ["user_id"] = userId.ToString()
            };
        }

        var groupResponse = await Api.GetAsync<ForwardGroupListResult>("forward_groups", Scope, groupQuery);
        if (groupResponse?.Data?.List != null)
        {
            _groups.AddRange(groupResponse.Data.List);
        }
    }

    private async Task SearchAsync()
    {
        if (_tablePager != null)
        {
            await _tablePager.SearchAsync();
            return;
        }

        _pageQuery = new TablePageQuery
        {
            PagingEnabled = _pageQuery.PagingEnabled,
            Page = 1,
            PageSize = _pageQuery.PageSize
        };
        await RefreshAsync();
    }

    private void OpenAdvancedSearch()
    {
        _advancedStatus = _filters.Status;
        _advancedVisible = true;
    }

    private void CloseAdvancedSearch()
    {
        _advancedVisible = false;
    }

    private async Task ApplyAdvancedSearch()
    {
        _filters.Status = _advancedStatus;
        _advancedVisible = false;
        if (_tablePager != null)
        {
            await _tablePager.SearchAsync();
            return;
        }

        _pageQuery = new TablePageQuery
        {
            PagingEnabled = _pageQuery.PagingEnabled,
            Page = 1,
            PageSize = _pageQuery.PageSize
        };
        await RefreshAsync();
    }

    private Task OnPageQueryChangedAsync(TablePageQuery query)
    {
        _pageQuery = query;
        return LoadAsync();
    }

    private void TogglePagingDiagnostics()
    {
        _showPagingDiagnostics = !_showPagingDiagnostics;
    }

    private Task RefreshAsync()
    {
        if (_tablePager != null)
        {
            return _tablePager.RefreshAsync();
        }

        return LoadAsync();
    }

    private void OpenCreate()
    {
        _editing = new ForwardEditModel();
        if (!Session.IsAdmin)
        {
            _editing.UserId = Session.UserId ?? 0;
        }
        _editorTab = "single";
        _expandEditorOptions = false;
        _editorVisible = true;
        _ = OnEditorUserChangedAsync();
    }

    private void OpenEdit(ForwardListItem item)
    {
        _editing = ForwardEditModel.FromItem(item);
        _editorTab = "single";
        _expandEditorOptions = _editing.GroupIds.Count > 0 || !string.IsNullOrWhiteSpace(_editing.Remark);
        _editorVisible = true;
        _ = OnEditorUserChangedAsync();
    }

    private void CloseEditor()
    {
        _editorVisible = false;
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        if (Session.IsAdmin && _editing.UserId <= 0)
        {
            _saving = false;
            await Js.InvokeVoidAsync("alert", "请选择用户");
            return;
        }

        if (_editing.UserPackageId <= 0)
        {
            _saving = false;
            await Js.InvokeVoidAsync("alert", "请选择套餐");
            return;
        }

        if (_editing.Id > 0)
        {
            var request = _editing.ToUpdateRequest();
            await Api.PutAsync<object>($"forwards/{_editing.Id}", request, Scope);
        }
        else if (_editorTab == "batch")
        {
            if (string.IsNullOrWhiteSpace(_editing.BatchData))
            {
                _saving = false;
                await Js.InvokeVoidAsync("alert", "请输入批量转发数据");
                return;
            }

            var request = _editing.ToBatchCreateRequest();
            await Api.PostAsync<object>("forwards/batch", request, Scope);
        }
        else
        {
            var request = _editing.ToCreateRequest();
            await Api.PostAsync<object>("forwards", request, Scope);
        }
        _saving = false;
        _editorVisible = false;
        await RefreshAsync();
    }

    private async Task BatchActionAsync(string action, IReadOnlyList<long>? idsOverride = null)
    {
        var ids = (idsOverride ?? _selectedIds.ToList()).Where(id => id > 0).Distinct().ToList();
        if (ids.Count == 0)
        {
            return;
        }

        var ok = await Js.InvokeAsync<bool>("confirm", $"确认执行{ResolveBatchActionLabel(action)}操作？");
        if (!ok)
        {
            return;
        }

        var request = new ForwardBatchActionRequest
        {
            Action = action,
            Ids = ids
        };
        var response = await Api.PostAsync<ForwardBatchActionResult>("forwards/batch_action", request, Scope);
        if (response == null || response.Code != ErrorCodes.Success)
        {
            await Js.InvokeVoidAsync("alert", response?.Message ?? "转发批量操作提交失败");
            return;
        }

        var taskId = response.Data?.TaskId ?? 0;
        if (taskId > 0)
        {
            await Js.InvokeVoidAsync("alert", $"转发{ResolveBatchActionLabel(action)}任务已提交：{taskId}");
        }

        if (idsOverride == null)
        {
            _selectedIds.Clear();
        }

        await RefreshAsync();
        if (taskId > 0)
        {
            await RefreshAfterTaskAsync();
        }
    }

    private Task RowActionAsync(ForwardListItem item, string action)
    {
        return action == "delete"
            ? DeleteAsync(item)
            : BatchActionAsync(action, new[] { item.Id });
    }

    private async Task DeleteAsync(ForwardListItem item)
    {
        var result = await DeleteWorkflowHelper.ConfirmAndRequestAsync(
            Api,
            Js,
            $"forwards/{item.Id}",
            Scope,
            "确认删除该转发？",
            "转发删除任务已提交");
        if (!result.Success)
        {
            if (!result.Cancelled)
            {
                await Js.InvokeVoidAsync("alert", result.Message);
            }

            return;
        }

        await Js.InvokeVoidAsync("alert", result.Message);
        await RefreshAsync();
        if (result.TaskId > 0)
        {
            await RefreshAfterTaskAsync();
        }
    }

    private async Task RefreshAfterTaskAsync()
    {
        await Task.Delay(1200);
        await RefreshAsync();
        await InvokeAsync(StateHasChanged);
    }

    private static string ResolveBatchActionLabel(string action) => action switch
    {
        "enable" => "启用",
        "disable" => "禁用",
        "delete" => "删除",
        _ => action
    };

    private bool AllSelected => _items.Count > 0 && _items.All(item => _selectedIds.Contains(item.Id));

    private void ToggleSelectAll(ChangeEventArgs args)
    {
        var isChecked = args.Value?.ToString() == "true" || args.Value?.ToString() == "on";
        if (isChecked)
        {
            foreach (var item in _items)
            {
                _selectedIds.Add(item.Id);
            }
        }
        else
        {
            _selectedIds.Clear();
        }
    }

    private void ToggleRow(long id, ChangeEventArgs args)
    {
        var isChecked = args.Value?.ToString() == "true" || args.Value?.ToString() == "on";
        if (isChecked)
        {
            _selectedIds.Add(id);
        }
        else
        {
            _selectedIds.Remove(id);
        }
    }

    private static string FormatUser(ForwardListItem item)
    {
        var name = string.IsNullOrWhiteSpace(item.UserName) ? "" : item.UserName.Trim();
        return string.IsNullOrWhiteSpace(name) ? $"ID {item.UserId}" : $"{name} ({item.UserId})";
    }

    private static string FormatDate(DateTime? value)
    {
        if (value == null || value == DateTime.MinValue)
        {
            return "-";
        }

        return value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");
    }

    private async Task OnEditorUserChangedAsync()
    {
        var userId = Session.IsAdmin ? _editing.UserId : (Session.UserId ?? 0);
        await LoadEditorDependenciesAsync(userId);

        if (_packages.All(x => x.Id != _editing.UserPackageId))
        {
            _editing.UserPackageId = 0;
        }

        _editing.GroupIds = _editing.GroupIds.Where(id => _groups.Any(g => g.Id == id)).Distinct().ToList();
        if (_editing.GroupIds.Count == 0 && _editing.GroupId > 0 && _groups.Any(g => g.Id == _editing.GroupId))
        {
            _editing.GroupIds.Add(_editing.GroupId);
        }

        _editing.GroupId = _editing.GroupIds.FirstOrDefault();
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleEditorGroup(long id, ChangeEventArgs args)
    {
        var isChecked = args.Value?.ToString() == "true" || args.Value?.ToString() == "on";
        if (isChecked)
        {
            if (!_editing.GroupIds.Contains(id))
            {
                _editing.GroupIds.Add(id);
            }
        }
        else
        {
            _editing.GroupIds.Remove(id);
        }

        _editing.GroupId = _editing.GroupIds.FirstOrDefault();
    }

    private static string FormatUserOption(UserItemDto user)
    {
        var name = string.IsNullOrWhiteSpace(user.Name) ? $"用户 {user.Id}" : user.Name.Trim();
        var secondary = !string.IsNullOrWhiteSpace(user.Email)
            ? user.Email!.Trim()
            : !string.IsNullOrWhiteSpace(user.Phone)
                ? user.Phone!.Trim()
                : user.Id.ToString();
        return $"{name} ({secondary})";
    }

    private sealed class ForwardFilters
    {
        public string Keyword { get; set; } = string.Empty;
        public string SearchField { get; set; } = "all";
        public string Status { get; set; } = string.Empty;
    }

    private sealed class ForwardEditModel
    {
        public long Id { get; set; }
        public long UserId { get; set; }
        public long UserPackageId { get; set; }
        public long GroupId { get; set; }
        public List<long> GroupIds { get; set; } = new();
        public string ListenPortsInput { get; set; } = string.Empty;
        public string OriginInput { get; set; } = string.Empty;
        public string BatchData { get; set; } = string.Empty;
        public bool IgnoreErrors { get; set; }
        public string Remark { get; set; } = string.Empty;

        public static ForwardEditModel FromItem(ForwardListItem item)
        {
            return new ForwardEditModel
            {
                Id = item.Id,
                UserId = item.UserId,
                UserPackageId = item.UserPackageId,
                GroupId = item.GroupId,
                GroupIds = item.GroupIds?.Where(id => id > 0).Distinct().ToList() ?? new List<long>(),
                ListenPortsInput = item.ListenPorts ?? string.Empty,
                OriginInput = item.Origin ?? item.OriginDisplay ?? string.Empty,
                Remark = item.Remark ?? string.Empty
            };
        }

        public ForwardCreateRequest ToCreateRequest()
        {
            return new ForwardCreateRequest
            {
                UserId = UserId,
                UserPackageId = UserPackageId,
                GroupId = GroupIds.FirstOrDefault(),
                GroupIds = GroupIds,
                ListenPortsInput = ListenPortsInput,
                OriginInput = OriginInput,
                Remark = Remark
            };
        }

        public ForwardUpdateRequest ToUpdateRequest()
        {
            return new ForwardUpdateRequest
            {
                UserId = UserId,
                UserPackageId = UserPackageId,
                GroupId = GroupIds.FirstOrDefault(),
                GroupIds = GroupIds,
                ListenPortsInput = ListenPortsInput,
                OriginInput = OriginInput,
                Remark = Remark
            };
        }

        public ForwardBatchCreateRequest ToBatchCreateRequest()
        {
            return new ForwardBatchCreateRequest
            {
                UserId = UserId,
                UserPackageId = UserPackageId,
                GroupId = GroupIds.FirstOrDefault(),
                GroupIds = GroupIds,
                Data = BatchData,
                IgnoreError = IgnoreErrors,
                Remark = Remark
            };
        }
    }
}
