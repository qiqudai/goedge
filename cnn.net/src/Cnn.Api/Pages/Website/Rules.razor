                                <div class="alert alert-light border">暂无规则，点击“新增规则”添加。</div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered align-middle">
                                        <thead>
                                            <tr>
                                                <th>匹配项</th>
                                                <th>操作符</th>
                                                <th>匹配值</th>
                                                <th>操作</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (var i = 0; i < _ccMatcherForm.Rules.Count; i++)
                                            {
                                                var rule = _ccMatcherForm.Rules[i];
                                                var ruleIndex = i;
                                                <tr>
                                                    <td>
                                                        <select class="form-select form-select-sm" @bind="rule.Item">
                                                            @foreach (var option in AclMatchItemOptions)
                                                            {
                                                                <option value="@option.Value">@option.Label</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td>
                                                        <select class="form-select form-select-sm" @bind="rule.Operator">
                                                            @foreach (var option in AclOperatorOptions)
                                                            {
                                                                <option value="@option.Value">@option.Label</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td>
                                                        <InputText class="form-control form-control-sm" @bind-Value="rule.Value" />
                                                    </td>
                                                    <td>
                                                        <div class="d-flex gap-1">
                                                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(ruleIndex == 0)" @onclick='@(() => MoveCcMatcherRule(ruleIndex, -1))'>上</button>
                                                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(ruleIndex >= _ccMatcherForm.Rules.Count - 1)" @onclick='@(() => MoveCcMatcherRule(ruleIndex, 1))'>下</button>
                                                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick='@(() => RemoveCcMatcherRule(ruleIndex))'>删</button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @if (Session.IsAdmin)
                        {
                            <div class="col-md-4">
                                <label class="form-label">规则归属</label>
                                <select class="form-select" @bind="_ccFilterForm.Type">
                                    <option value="system">系统规则</option>
                                    <option value="user">用户规则</option>
                                </select>
                            </div>
                            @if (_ccFilterForm.Type == "user")
                            {
                                <div class="col-md-8">
                                    <label class="form-label">用户</label>
                                    <div class="input-group mb-1">
                                        <InputText class="form-control" @bind-Value="_ccUserSearchKeyword" placeholder="输入ID、邮箱、用户名" />
                                        <button class="btn btn-outline-secondary" @onclick="CcSearchUsersAsync" disabled="@_ccUserSearching">搜索</button>
                                    </div>
                                    @if (_ccUserSearchResults.Count > 0)
                                    {
                                        <select class="form-select mt-1" size="3" @onchange="@(e => OnCcUserSelected(e, "filter"))">
                                            @foreach (var u in _ccUserSearchResults)
                                            {
                                                <option value="@u.Id">@($"{u.Name ?? u.Email} (ID: {u.Id})")</option>
                                            }
                                        </select>
                                    }
                                    @if (_ccFilterForm.UserId > 0)
                                    {
                                        <div class="form-text text-success">已选用户ID: @_ccFilterForm.UserId</div>
                                    }
                                </div>
                            }
                        }
                        <div class="col-md-4">
                            <label class="form-label">名称</label>
                            <InputText class="form-control" @bind-Value="_ccFilterForm.Name" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">备注</label>
                            <InputText class="form-control" @bind-Value="_ccFilterForm.Remark" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">过滤器类型</label>
                            <select class="form-select" @bind="_ccFilterForm.Action">
                                @foreach (var option in FilterActionOptions)
                                {
                                    <option value="@option.Value">@option.Label</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">匹配模式</label>
                            <select class="form-select" @bind="_ccFilterForm.MatchMode">
                                <option value="simple">simple</option>
                                <option value="strict">strict</option>
                            </select>
                        </div>
                        @if (IsReqRateAction(_ccFilterForm.Action))
                        {
                            <div class="col-md-3">
                                <label class="form-label">统计周期(秒)</label>
                                <InputNumber class="form-control" @bind-Value="_ccFilterForm.WithinSecond" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">允许总请求</label>
                                <InputNumber class="form-control" @bind-Value="_ccFilterForm.MaxReq" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">允许同URL请求</label>
                                <InputNumber class="form-control" @bind-Value="_ccFilterForm.MaxReqPerUri" />
                            </div>
                        }
                        else if (IsChallengeAction(_ccFilterForm.Action) || IsUrlAuthAction(_ccFilterForm.Action))
                        {
                            <div class="col-md-3">
                                <label class="form-label">统计周期(秒)</label>
                                <InputNumber class="form-control" @bind-Value="_ccFilterForm.WithinSecond" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">允许验证失败</label>
                                <InputNumber class="form-control" @bind-Value="_ccFilterForm.MaxReq" />
                            </div>
                        }
                        <div class="col-md-4 d-flex align-items-end gap-3">
                            <label class="form-check">
                                <InputCheckbox class="form-check-input" @bind-Value="_ccFilterForm.Enable" />
                                <span class="form-check-label">启用</span>
                            </label>
                            <label class="form-check">
                                <InputCheckbox class="form-check-input" @bind-Value="_ccFilterForm.Blacklist" />
                                <span class="form-check-label">黑名单</span>
                            </label>
                        </div>
                        @if (IsUrlAuthAction(_ccFilterForm.Action))
                        {
                            <div class="col-md-12">
                                <div class="border rounded p-2">
                                    <div class="fw-semibold mb-2">URL鉴权配置</div>
                                    <div class="row g-2">
                                        <div class="col-md-3">
                                            <label class="form-label">鉴权方式</label>
                                            <select class="form-select" @bind="_ccFilterForm.Auth.Method">
                                                <option value="A">A</option>
                                                <option value="B">B</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">IP鉴权</label>
                                            <div class="form-check form-switch mt-2">
                                                <InputCheckbox class="form-check-input" @bind-Value="_ccFilterForm.Auth.IpAuth" />
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">密钥</label>
                                            <InputText class="form-control" @bind-Value="_ccFilterForm.Auth.Key" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">签名参数名</label>
                                            <InputText class="form-control" @bind-Value="_ccFilterForm.Auth.SignParam" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">时间戳参数名</label>
                                            <InputText class="form-control" @bind-Value="_ccFilterForm.Auth.TimeParam" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">最大时间偏差(秒)</label>
                                            <InputNumber class="form-control" @bind-Value="_ccFilterForm.Auth.MaxTimeDiff" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">签名最大使用次数</label>
                                            <InputNumber class="form-control" @bind-Value="_ccFilterForm.Auth.MaxSignUsage" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="modal-footer d-flex justify-content-end gap-2">
                <button class="btn btn-secondary" @onclick="CloseEditor">取消</button>
                <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">保存</button>
            </div>
        </div>
    </div>
}

@code {
    private readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web)
    {
        WriteIndented = true,
        PropertyNameCaseInsensitive = true
    };

    private string _activeTopTab = "cc";
    private string _activeCcTab = "cc_group";
    private string _keyword = string.Empty;
    private string _ccStatus = string.Empty;
    private bool _saving;

    private bool _permissionLoaded;
    private bool _canCustomCcRule;

    private readonly List<AclListItem> _aclList = new();
    private readonly List<CcRuleGroupListItem> _ccGroupList = new();
    private readonly List<CcMatcherListItem> _ccMatcherList = new();
    private readonly List<CcFilterListItem> _ccFilterList = new();
    private readonly List<CcMatcherListItem> _ccMatcherOptions = new();
    private readonly List<CcFilterListItem> _ccFilterOptions = new();

    private bool _editorVisible;
    private string _editorType = string.Empty;
    private long _editorId;
    private string _editorTitle = string.Empty;
    private AclEditorModel _aclForm = new();
    private string _aclUserSearchKeyword = string.Empty;
    private bool _aclUserSearching;
    private readonly List<UserItemDto> _aclUserSearchResults = new();
    private string _ccUserSearchKeyword = string.Empty;
    private bool _ccUserSearching;
    private readonly List<UserItemDto> _ccUserSearchResults = new();
    private CcGroupEditorModel _ccGroupForm = new();
    private CcMatcherEditorModel _ccMatcherForm = new();
    private CcFilterEditorModel _ccFilterForm = new();

    private ApiScope Scope => Session.IsAdmin ? ApiScope.Admin : ApiScope.User;
    private string CurrentRuleTab => _activeTopTab == "acl" ? "acl" : _activeCcTab;

    private static IReadOnlyList<SelectOption> AclMatchItemOptions { get; } = new List<SelectOption>
    {
        new("all", "匹配所有请求"),
        new("ip", "IP地址"),
        new("domain", "域名"),
        new("request_uri", "请求URI"),
        new("request_path", "请求URI(不带参数)"),
        new("header", "请求头"),
        new("user_agent_unique_count", "独立UA数量"),
        new("status_404_count", "404状态码数量"),
        new("method", "请求方法"),
        new("user_agent", "浏览器UA"),
        new("referer", "请求来源"),
        new("country", "国家代码"),
        new("asn", "AS号码"),
        new("province", "省份"),
        new("city", "城市"),
        new("isp", "运营商"),
        new("http_version", "HTTP版本"),
        new("accept_language", "请求头accept_language")
    };

    private static IReadOnlyList<SelectOption> AclOperatorOptions { get; } = new List<SelectOption>
    {
        new("eq", "等于"),
        new("neq", "不等于"),
        new("contains", "包含"),
        new("not_contains", "不包含"),
        new("prefix", "前缀匹配"),
        new("suffix", "后缀匹配"),
        new("regex", "正则匹配"),
        new("not_regex", "正则不匹配"),
        new("exists", "存在"),
        new("not_exists", "不存在"),
        new("ip_range", "在IP段"),
        new("not_ip_range", "不在IP段")
    };

    private static IReadOnlyList<SelectOption> FilterActionOptions { get; } = new List<SelectOption>
    {
        new("req_rate", "请求频率"),
        new("silent_captcha", "无感验证"),
        new("five_seconds", "5秒盾"),
        new("click_captcha", "点击验证"),
        new("click_captcha_simple", "点击验证(简单)"),
        new("slide_captcha", "滑动验证"),
        new("slide_captcha_simple", "滑动验证(简单)"),
        new("captcha", "验证码"),
        new("rotate_captcha", "旋转图片"),
        new("302", "302跳转"),
        new("url_auth", "URL鉴权")
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadPermissionAsync();
        await LoadEditorDependenciesAsync();

        if (_activeTopTab == "cc" && !_canCustomCcRule)
        {
            _activeTopTab = "acl";
        }

        await LoadAsync();
    }

    private async Task LoadPermissionAsync()
    {
        if (Session.IsAdmin)
        {
            _canCustomCcRule = true;
            _permissionLoaded = true;
            return;
        }

        var query = new Dictionary<string, string?>
        {
            ["page"] = "1",
            ["pageSize"] = "1000"
        };

        var response = await Api.GetAsync<UserPackageListResult>("user_packages", ApiScope.User, query);
        var list = response?.Data?.List ?? Array.Empty<UserPackageItemDto>();
        _canCustomCcRule = list.Any(item => item.CustomCcRule && !item.IsExpired && !string.Equals(item.Status, "expired", StringComparison.OrdinalIgnoreCase));
        _permissionLoaded = true;
    }

    private async Task LoadEditorDependenciesAsync()
    {
        if (!_canCustomCcRule)
        {
            _ccMatcherOptions.Clear();
            _ccFilterOptions.Clear();
            return;
        }

        var matcherResp = await Api.GetAsync<CcListResult<CcMatcherListItem>>("rules/cc/matchers", Scope);
        _ccMatcherOptions.Clear();
        if (matcherResp?.Data?.List != null)
        {
            _ccMatcherOptions.AddRange(matcherResp.Data.List);
        }

        var filterResp = await Api.GetAsync<CcListResult<CcFilterListItem>>("rules/cc/filters", Scope);
        _ccFilterOptions.Clear();
        if (filterResp?.Data?.List != null)
        {
            _ccFilterOptions.AddRange(filterResp.Data.List);
        }
    }

    private async Task LoadAsync()
    {
        var tab = CurrentRuleTab;

        if (tab != "acl" && !_canCustomCcRule)
        {
            _ccGroupList.Clear();
            _ccMatcherList.Clear();
            _ccFilterList.Clear();
            return;
        }

        if (tab == "acl")
        {
            var response = await Api.GetAsync<AclListResult>("rules/acl", Scope, new Dictionary<string, string?> { ["name"] = _keyword });
            _aclList.Clear();
            if (response?.Data?.List != null)
            {
                _aclList.AddRange(response.Data.List);
            }
            return;
        }

        if (tab == "cc_group")
        {
            var response = await Api.GetAsync<CcListResult<CcRuleGroupListItem>>("rules/cc/groups", Scope, new Dictionary<string, string?> { ["name"] = _keyword, ["status"] = string.IsNullOrEmpty(_ccStatus) ? null : _ccStatus });
            _ccGroupList.Clear();
            if (response?.Data?.List != null)
            {
                _ccGroupList.AddRange(response.Data.List);
            }
            return;
        }

        if (tab == "cc_matcher")
        {
            var response = await Api.GetAsync<CcListResult<CcMatcherListItem>>("rules/cc/matchers", Scope, new Dictionary<string, string?> { ["name"] = _keyword });
            _ccMatcherList.Clear();
            if (response?.Data?.List != null)
            {
                _ccMatcherList.AddRange(response.Data.List);
            }
            return;
        }

        var filterResponse = await Api.GetAsync<CcListResult<CcFilterListItem>>("rules/cc/filters", Scope, new Dictionary<string, string?> { ["name"] = _keyword });
        _ccFilterList.Clear();
        if (filterResponse?.Data?.List != null)
        {
            _ccFilterList.AddRange(filterResponse.Data.List);
        }
    }

    private async Task SearchAsync()
    {
        await LoadAsync();
    }

    private async Task SetTopTabAsync(string tab)
    {
        _activeTopTab = tab;
        _keyword = string.Empty;
        await LoadAsync();
    }

    private async Task SetCcTabAsync(string tab)
    {
        _activeCcTab = tab;
        _keyword = string.Empty;
        await LoadAsync();
    }

    private async Task OpenCreateAsync()
    {
        _editorId = 0;
        _editorType = CurrentRuleTab;
        _editorTitle = "新增规则";
        ResetEditorForms();
        if (_editorType != "acl")
        {
            await LoadEditorDependenciesAsync();
        }
        _editorVisible = true;
    }

    private async Task OpenEditAsync(string type, long id)
    {
        _editorId = id;
        _editorType = type;
        _editorTitle = "编辑规则";
        ResetEditorForms();

        if (type == "acl")
        {
            var response = await Api.GetAsync<AclDetailDto>($"rules/acl/{id}", Scope);
            if (response?.Data != null)
            {
                _aclForm = new AclEditorModel
                {
                    UserId = response.Data.UserId,
                    Name = response.Data.Name ?? string.Empty,
                    Description = response.Data.Description ?? string.Empty,
                    DefaultAction = string.IsNullOrWhiteSpace(response.Data.DefaultAction) ? "allow" : response.Data.DefaultAction!,
                    Enable = response.Data.Enable ?? true,
                    DefaultDenyStatus = response.Data.DefaultDenyStatus <= 0 ? 403 : response.Data.DefaultDenyStatus,
                    DefaultRedirectUrl = response.Data.DefaultRedirectUrl ?? string.Empty,
                    Rules = (response.Data.Rules ?? Array.Empty<AclRuleDto>()).Select(CloneAclRule).ToList()
                };
            }
        }
        else if (type == "cc_group")
        {
            await LoadEditorDependenciesAsync();
            var response = await Api.GetAsync<CcRuleGroupDetailDto>($"rules/cc/groups/{id}", Scope);
            if (response?.Data != null)
            {
                _ccGroupForm = new CcGroupEditorModel
                {
                    UserId = response.Data.UserId,
                    Type = NormalizeRuleType(response.Data.Type, response.Data.UserId),
                    Name = response.Data.Name ?? string.Empty,
                    Remark = response.Data.Remark ?? string.Empty,
                    IsVisible = response.Data.IsVisible ?? response.Data.IsShow ?? true,
                    SortOrder = response.Data.SortOrder ?? 0,
                    Rules = ParseCcGroupRules(response.Data.Rules)
                };
            }
        }
        else if (type == "cc_matcher")
        {
            var response = await Api.GetAsync<CcMatcherDetailDto>($"rules/cc/matchers/{id}", Scope);
            if (response?.Data != null)
            {
                _ccMatcherForm = new CcMatcherEditorModel
                {
                    UserId = response.Data.UserId,
                    Type = NormalizeRuleType(response.Data.Type, response.Data.UserId),
                    Name = response.Data.Name ?? string.Empty,
                    Remark = response.Data.Remark ?? string.Empty,
                    IsOn = response.Data.IsOn ?? true,
                    Rules = ParseCcMatcherRules(response.Data.Rules)
                };
            }
        }
        else
        {
            var response = await Api.GetAsync<CcFilterDetailDto>($"rules/cc/filters/{id}", Scope);
            if (response?.Data != null)
            {
                _ccFilterForm = new CcFilterEditorModel
                {
                    UserId = response.Data.UserId,
                    Type = NormalizeRuleType(response.Data.Type, response.Data.UserId),
                    Name = response.Data.Name ?? string.Empty,
                    Remark = response.Data.Remark ?? string.Empty,
                    Enable = response.Data.Enable ?? true,
                    Action = string.IsNullOrWhiteSpace(response.Data.Action) ? "req_rate" : response.Data.Action!,
                    MatchMode = string.IsNullOrWhiteSpace(response.Data.MatchMode) ? "simple" : response.Data.MatchMode!,
                    Blacklist = response.Data.Blacklist ?? false,
                    WithinSecond = response.Data.WithinSecond ?? 10,
                    MaxReq = response.Data.MaxReq ?? 100,
                    MaxReqPerUri = response.Data.MaxReqPerUri ?? 0,
                    Auth = ParseUrlAuth(response.Data.Auth)
                };
            }
        }

        _editorVisible = true;
    }

    private void CloseEditor()
    {
        _editorVisible = false;
    }

    private async Task AclSearchUsersAsync()
    {
        if (_aclUserSearching || string.IsNullOrWhiteSpace(_aclUserSearchKeyword)) return;
        _aclUserSearching = true;
        var query = new Dictionary<string, string?> { ["keyword"] = _aclUserSearchKeyword, ["pageSize"] = "20" };
        var resp = await Api.GetAsync<UserListResult>("users", ApiScope.Admin, query);
        _aclUserSearchResults.Clear();
        if (resp?.Data?.List != null)
        {
            _aclUserSearchResults.AddRange(resp.Data.List);
        }
        _aclUserSearching = false;
    }

    private void OnAclUserSelected(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var id) && id > 0)
        {
            _aclForm.UserId = id;
        }
    }

    private async Task CcSearchUsersAsync()
    {
        if (_ccUserSearching || string.IsNullOrWhiteSpace(_ccUserSearchKeyword)) return;
        _ccUserSearching = true;
        var query = new Dictionary<string, string?> { ["keyword"] = _ccUserSearchKeyword, ["pageSize"] = "20" };
        var resp = await Api.GetAsync<UserListResult>("users", ApiScope.Admin, query);
        _ccUserSearchResults.Clear();
        if (resp?.Data?.List != null)
            _ccUserSearchResults.AddRange(resp.Data.List);
        _ccUserSearching = false;
    }

    private void OnCcUserSelected(ChangeEventArgs e, string target)
    {
        if (!long.TryParse(e.Value?.ToString(), out var id) || id <= 0) return;
        switch (target)
        {
            case "group":   _ccGroupForm.UserId   = id; break;
            case "matcher": _ccMatcherForm.UserId = id; break;
            case "filter":  _ccFilterForm.UserId  = id; break;
        }
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        try
        {
            if (_editorType == "acl")
            {
                var request = new AclUpsertRequest
                {
                    UserId = Session.IsAdmin && _aclForm.UserId > 0 ? _aclForm.UserId : null,
                    Name = _aclForm.Name,
                    Description = _aclForm.Description,
                    DefaultAction = string.IsNullOrWhiteSpace(_aclForm.DefaultAction) ? "allow" : _aclForm.DefaultAction,
                    Enable = _aclForm.Enable,
                    DefaultDenyStatus = _aclForm.DefaultDenyStatus <= 0 ? 403 : _aclForm.DefaultDenyStatus,
                    DefaultRedirectUrl = _aclForm.DefaultRedirectUrl,
                    Rules = NormalizeAclRules(_aclForm.Rules)
                };

                if (_editorId > 0)
                {
                    await Api.PutAsync<object>($"rules/acl/{_editorId}", request, Scope);
                }
                else
                {
                    await Api.PostAsync<object>("rules/acl", request, Scope);
                }
            }
            else if (_editorType == "cc_group")
            {
                var request = new CcRuleGroupUpsertRequest
                {
                    UserId = Session.IsAdmin && _ccGroupForm.Type == "user" && _ccGroupForm.UserId > 0 ? _ccGroupForm.UserId : null,
                    Type = NormalizeRuleType(_ccGroupForm.Type, _ccGroupForm.UserId),
                    Name = _ccGroupForm.Name,
                    Remark = _ccGroupForm.Remark,
                    IsVisible = _ccGroupForm.IsVisible,
                    SortOrder = _ccGroupForm.SortOrder,
                    Rules = _ccGroupForm.Rules.Select(rule => JsonSerializer.SerializeToElement(rule, JsonOptions)).ToList()
                };

                if (_editorId > 0)
                {
                    await Api.PutAsync<object>($"rules/cc/groups/{_editorId}", request, Scope);
                }
                else
                {
                    await Api.PostAsync<object>("rules/cc/groups", request, Scope);
                }
            }
            else if (_editorType == "cc_matcher")
            {
                var request = new CcMatcherUpsertRequest
                {
                    UserId = Session.IsAdmin && _ccMatcherForm.Type == "user" && _ccMatcherForm.UserId > 0 ? _ccMatcherForm.UserId : null,
                    Type = NormalizeRuleType(_ccMatcherForm.Type, _ccMatcherForm.UserId),
                    Name = _ccMatcherForm.Name,
                    Remark = _ccMatcherForm.Remark,
                    IsOn = _ccMatcherForm.IsOn,
                    Rules = _ccMatcherForm.Rules.Select(rule => JsonSerializer.SerializeToElement(rule, JsonOptions)).ToList()
                };

                if (_editorId > 0)
                {
                    await Api.PutAsync<object>($"rules/cc/matchers/{_editorId}", request, Scope);
                }
                else
                {
                    await Api.PostAsync<object>("rules/cc/matchers", request, Scope);
                }
            }
            else
            {
                var request = new CcFilterUpsertRequest
                {
                    UserId = Session.IsAdmin && _ccFilterForm.Type == "user" && _ccFilterForm.UserId > 0 ? _ccFilterForm.UserId : null,
                    Type = NormalizeRuleType(_ccFilterForm.Type, _ccFilterForm.UserId),
                    Name = _ccFilterForm.Name,
                    Remark = _ccFilterForm.Remark,
                    Enable = _ccFilterForm.Enable,
                    Action = string.IsNullOrWhiteSpace(_ccFilterForm.Action) ? "req_rate" : _ccFilterForm.Action,
                    MatchMode = string.IsNullOrWhiteSpace(_ccFilterForm.MatchMode) ? "simple" : _ccFilterForm.MatchMode,
                    Blacklist = _ccFilterForm.Blacklist,
                    WithinSecond = _ccFilterForm.WithinSecond,
                    MaxReq = _ccFilterForm.MaxReq,
                    MaxReqPerUri = _ccFilterForm.MaxReqPerUri,
                    Auth = IsUrlAuthAction(_ccFilterForm.Action)
                        ? JsonSerializer.SerializeToElement(_ccFilterForm.Auth, JsonOptions)
                        : null
                };

                if (_editorId > 0)
                {
                    await Api.PutAsync<object>($"rules/cc/filters/{_editorId}", request, Scope);
                }
                else
                {
                    await Api.PostAsync<object>("rules/cc/filters", request, Scope);
                }
            }
        }
        catch
        {
            await Js.InvokeVoidAsync("alert", "保存失败，请检查输入内容");
            _saving = false;
            return;
        }

        _saving = false;
        _editorVisible = false;
        await LoadEditorDependenciesAsync();
        await LoadAsync();
    }

    private async Task DeleteAsync(string type, long id)
    {
        var path = type switch
        {
            "acl" => $"rules/acl/{id}",
            "cc_group" => $"rules/cc/groups/{id}",
            "cc_matcher" => $"rules/cc/matchers/{id}",
            _ => $"rules/cc/filters/{id}"
        };

        var result = await DeleteWorkflowHelper.ConfirmAndRequestAsync(
            Api,
            Js,
            path,
            Scope,
            "确认删除该规则？",
            "规则删除任务已提交");
        if (!result.Success)
        {
            if (!result.Cancelled)
            {
                await Js.InvokeVoidAsync("alert", result.Message);
            }

            return;
        }

        await Js.InvokeVoidAsync("alert", result.Message);
        await LoadEditorDependenciesAsync();
        await LoadAsync();
        if (result.TaskId > 0)
        {
            await RefreshAfterDeleteTaskAsync();
        }
    }

    private async Task RefreshAfterDeleteTaskAsync()
    {
        await Task.Delay(1200);
        await LoadEditorDependenciesAsync();
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

