@page "/website/rules"
@using global::System.Text.Json
@using global::System.Text.Json.Serialization
@using Cnn.Common.Contracts
@using Cnn.Common.Contracts.Admin
@inject ApiClient Api
@inject ClientSession Session
@inject IJSRuntime Js

<div class="page-container">
    <div class="page-title">规则管理</div>

    <div class="tab-bar">
        <button class='tab-button @(_activeTopTab == "cc" ? "active" : "")' @onclick='@(() => SetTopTabAsync("cc"))'>CC规则</button>
        <button class='tab-button @(_activeTopTab == "acl" ? "active" : "")' @onclick='@(() => SetTopTabAsync("acl"))'>ACL规则</button>
    </div>

    @if (_activeTopTab == "cc")
    {
        @if (!_permissionLoaded)
        {
            <div class="alert alert-info">正在加载套餐权限...</div>
        }
        else if (!_canCustomCcRule)
        {
            <div class="alert alert-warning">当前套餐未开启自定义CC规则，请联系管理员开通套餐权限。</div>
        }
        else
        {
            <div class="tab-bar mt-2">
                <button class='tab-button @(_activeCcTab == "cc_group" ? "active" : "")' @onclick='@(() => SetCcTabAsync("cc_group"))'>规则组</button>
                <button class='tab-button @(_activeCcTab == "cc_matcher" ? "active" : "")' @onclick='@(() => SetCcTabAsync("cc_matcher"))'>匹配器</button>
                <button class='tab-button @(_activeCcTab == "cc_filter" ? "active" : "")' @onclick='@(() => SetCcTabAsync("cc_filter"))'>过滤器</button>
            </div>

            <div class="filter-bar">
                <InputText class="form-control" style="max-width: 220px" @bind-Value="_keyword" placeholder="名称" />
                @if (_activeCcTab == "cc_group")
                {
                    <select class="form-select" style="max-width: 120px" @bind="_ccStatus">
                        <option value="">全部状态</option>
                        <option value="on">启用</option>
                        <option value="off">禁用</option>
                    </select>
                }
                <button class="btn btn-primary" @onclick="SearchAsync">搜索</button>
                <button class="btn btn-outline-secondary" @onclick="OpenCreateAsync">新增</button>
            </div>

            @if (_activeCcTab == "cc_group")
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                @if (Session.IsAdmin) { <th>用户</th> }
                                <th>名称</th>
                                <th>系统规则</th>
                                <th>显示</th>
                                <th>状态</th>
                                <th>排序</th>
                                <th>创建时间</th>
                                <th>操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_ccGroupList.Count == 0)
                            {
                                <tr><td colspan="@(Session.IsAdmin ? 9 : 8)">暂无数据</td></tr>
                            }
                            else
                            {
                                @foreach (var item in _ccGroupList)
                                {
                                    <tr>
                                        <td>@item.Id</td>
                                        @if (Session.IsAdmin)
                                        {
                                            <td>@(item.IsSystem ? "系统" : (item.User?.Username ?? item.UserId.ToString()))</td>
                                        }
                                        <td>@item.Name</td>
                                        <td>@(item.IsSystem ? "是" : "否")</td>
                                        <td>@(item.IsVisible == true ? "是" : "否")</td>
                                        <td>@(item.IsOn == true ? "正常" : "禁用")</td>
                                        <td>@item.SortOrder</td>
                                        <td>@(item.CreatedAt.HasValue ? DateTimeOffset.FromUnixTimeSeconds(item.CreatedAt.Value).LocalDateTime.ToString("yyyy-MM-dd HH:mm") : item.CreateTime)</td>
                                        <td class="d-flex gap-2">
                                            <button class="btn btn-sm btn-outline-primary" @onclick='@(() => OpenEditAsync("cc_group", item.Id))'>编辑</button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick='@(() => DeleteAsync("cc_group", item.Id))'>删除</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (_activeCcTab == "cc_matcher")
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                @if (Session.IsAdmin) { <th>用户</th> }
                                <th>名称</th>
                                <th>系统规则</th>
                                <th>状态</th>
                                <th>创建时间</th>
                                <th>操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_ccMatcherList.Count == 0)
                            {
                                <tr><td colspan="@(Session.IsAdmin ? 7 : 6)">暂无数据</td></tr>
                            }
                            else
                            {
                                @foreach (var item in _ccMatcherList)
                                {
                                    <tr>
                                        <td>@item.Id</td>
                                        @if (Session.IsAdmin)
                                        {
                                            <td>@(item.IsSystem ? "系统" : (item.User?.Username ?? item.UserId.ToString()))</td>
                                        }
                                        <td>@item.Name</td>
                                        <td>@(item.IsSystem ? "是" : "否")</td>
                                        <td>@(item.IsOn == true ? "正常" : "禁用")</td>
                                        <td>@(item.CreatedAt.HasValue ? DateTimeOffset.FromUnixTimeSeconds(item.CreatedAt.Value).LocalDateTime.ToString("yyyy-MM-dd HH:mm") : item.CreateTime)</td>
                                        <td class="d-flex gap-2">
                                            <button class="btn btn-sm btn-outline-primary" @onclick='@(() => OpenEditAsync("cc_matcher", item.Id))'>编辑</button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick='@(() => DeleteAsync("cc_matcher", item.Id))'>删除</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                @if (Session.IsAdmin) { <th>用户</th> }
                                <th>名称</th>
                                <th>系统规则</th>
                                <th>动作</th>
                                <th>状态</th>
                                <th>创建时间</th>
                                <th>操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_ccFilterList.Count == 0)
                            {
                                <tr><td colspan="@(Session.IsAdmin ? 8 : 7)">暂无数据</td></tr>
                            }
                            else
                            {
                                @foreach (var item in _ccFilterList)
                                {
                                    <tr>
                                        <td>@item.Id</td>
                                        @if (Session.IsAdmin)
                                        {
                                            <td>@(item.IsSystem ? "系统" : (item.User?.Username ?? item.UserId.ToString()))</td>
                                        }
                                        <td>@item.Name</td>
                                        <td>@(item.IsSystem ? "是" : "否")</td>
                                        <td>@GetFilterActionLabel(item.Action ?? item.Type)</td>
                                        <td>@(item.IsOn == true ? "正常" : "禁用")</td>
                                        <td>@(item.CreatedAt.HasValue ? DateTimeOffset.FromUnixTimeSeconds(item.CreatedAt.Value).LocalDateTime.ToString("yyyy-MM-dd HH:mm") : item.CreateTime)</td>
                                        <td class="d-flex gap-2">
                                            <button class="btn btn-sm btn-outline-primary" @onclick='@(() => OpenEditAsync("cc_filter", item.Id))'>编辑</button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick='@(() => DeleteAsync("cc_filter", item.Id))'>删除</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    }
    else
    {
        <div class="filter-bar">
            <InputText class="form-control" style="max-width: 220px" @bind-Value="_keyword" placeholder="名称" />
            <button class="btn btn-primary" @onclick="SearchAsync">搜索</button>
            <button class="btn btn-outline-secondary" @onclick="OpenCreateAsync">新增</button>
        </div>

        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>ID</th>
                        @if (Session.IsAdmin) { <th>用户</th> }
                        <th>名称</th>
                        <th>备注</th>
                        <th>默认动作</th>
                        <th>启用</th>
                        <th>时间</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_aclList.Count == 0)
                    {
                        <tr><td colspan="@(Session.IsAdmin ? 8 : 7)">暂无数据</td></tr>
                    }
                    else
                    {
                        @foreach (var item in _aclList)
                        {
                            <tr>
                                <td>@item.Id</td>
                                @if (Session.IsAdmin)
                                {
                                    <td>@(item.UserId == 0 ? "系统" : (item.User?.Username ?? item.UserId.ToString()))</td>
                                }
                                <td>@item.Name</td>
                                <td>@item.Description</td>
                                <td>@item.DefaultAction</td>
                                <td>@(item.Enable == true ? "启用" : "禁用")</td>
                                <td>@item.CreateTime</td>
                                <td class="d-flex gap-2">
                                    <button class="btn btn-sm btn-outline-primary" @onclick='@(() => OpenEditAsync("acl", item.Id))'>编辑</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick='@(() => DeleteAsync("acl", item.Id))'>删除</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (_editorVisible)
{
    <div class="modal-backdrop">
        <div class="modal-panel">
            <div class="modal-header">
                <h5>@_editorTitle</h5>
                <button class="btn-close" @onclick="CloseEditor"></button>
            </div>
            <div class="modal-body">
                @if (_editorType == "acl")
                {
                    <div class="row g-3">
                        @if (Session.IsAdmin)
                        {
                            <div class="col-md-4">
                                <label class="form-label">用户</label>
                                @if (_editorId == 0)
                                {
                                    <div class="input-group mb-1">
                                        <InputText class="form-control" @bind-Value="_aclUserSearchKeyword" placeholder="输入ID、邮箱、用户名" />
                                        <button class="btn btn-outline-secondary" @onclick="AclSearchUsersAsync" disabled="@_aclUserSearching">搜索</button>
                                    </div>
                                    @if (_aclUserSearchResults.Count > 0)
                                    {
                                        <select class="form-select mt-1" size="3" @onchange="OnAclUserSelected">
                                            @foreach (var u in _aclUserSearchResults)
                                            {
                                                <option value="@u.Id">@($"{u.Name ?? u.Email} (ID: {u.Id})")</option>
                                            }
                                        </select>
                                    }
                                    <div class="form-text text-muted">不选则为系统规则</div>
                                    @if (_aclForm.UserId > 0)
                                    {
                                        <div class="form-text text-success">已选用户ID: @_aclForm.UserId</div>
                                    }
                                }
                                else
                                {
                                    <input class="form-control" readonly value="@(_aclForm.UserId > 0 ? $"ID: {_aclForm.UserId}" : "系统")" />
                                }
                            </div>
                        }
                        <div class="col-md-4">
                            <label class="form-label">名称</label>
                            <InputText class="form-control" @bind-Value="_aclForm.Name" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">备注</label>
                            <InputText class="form-control" @bind-Value="_aclForm.Description" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">默认动作</label>
                            <select class="form-select" @bind="_aclForm.DefaultAction">
                                <option value="allow">允许</option>
                                <option value="deny">拒绝</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">默认拒绝状态码</label>
                            <InputNumber class="form-control" @bind-Value="_aclForm.DefaultDenyStatus" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">启用</label>
                            <div class="form-check form-switch mt-2">
                                <InputCheckbox class="form-check-input" @bind-Value="_aclForm.Enable" />
                            </div>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">默认跳转URL(可选)</label>
                            <InputText class="form-control" @bind-Value="_aclForm.DefaultRedirectUrl" />
                        </div>
                        <div class="col-md-12">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label mb-0">规则列表</label>
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddAclRule">新增规则</button>
                            </div>
                            @if (_aclForm.Rules.Count == 0)
                            {
                                <div class="alert alert-light border">暂无规则，点击“新增规则”添加。</div>
                            }
                            @for (var i = 0; i < _aclForm.Rules.Count; i++)
                            {
                                var rule = _aclForm.Rules[i];
                                var ruleIndex = i;
                                var conditions = rule.Conditions as List<AclConditionDto> ?? rule.Conditions?.ToList() ?? new List<AclConditionDto>();
                                rule.Conditions = conditions;
                                <div class="border rounded p-2 mb-2">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="fw-semibold">规则 #@(ruleIndex + 1)</div>
                                        <div class="d-flex gap-2">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(ruleIndex == 0)" @onclick='@(() => MoveAclRule(ruleIndex, -1))'>上移</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(ruleIndex >= _aclForm.Rules.Count - 1)" @onclick='@(() => MoveAclRule(ruleIndex, 1))'>下移</button>
                                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick='@(() => RemoveAclRule(ruleIndex))'>删除</button>
                                        </div>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label">匹配条件</label>
                                        @if (conditions.Count == 0)
                                        {
                                            <div class="text-muted small mb-2">未设置条件时，表示匹配所有请求。</div>
                                        }
                                        @for (var j = 0; j < conditions.Count; j++)
                                        {
                                            var condition = conditions[j];
                                            var conditionIndex = j;
                                            <div class="row g-2 align-items-center mb-2">
                                                <div class="col-md-4">
                                                    <select class="form-select" @bind="condition.Item">
                                                        @foreach (var option in AclMatchItemOptions)
                                                        {
                                                            <option value="@option.Value">@option.Label</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-md-3">
                                                    <select class="form-select" @bind="condition.Operator">
                                                        @foreach (var option in AclOperatorOptions)
                                                        {
                                                            <option value="@option.Value">@option.Label</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-md-4">
                                                    <InputText class="form-control" @bind-Value="condition.Value" />
                                                </div>
                                                <div class="col-md-1">
                                                    <button type="button" class="btn btn-sm btn-outline-danger w-100" @onclick='@(() => RemoveAclCondition(ruleIndex, conditionIndex))'>删</button>
                                                </div>
                                            </div>
                                        }
                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='@(() => AddAclCondition(ruleIndex))'>添加条件</button>
                                    </div>
                                    <div class="row g-2">
                                        <div class="col-md-3">
                                            <label class="form-label">行为</label>
                                            <select class="form-select" @bind="rule.Action">
                                                <option value="allow">允许</option>
                                                <option value="deny">拒绝</option>
                                            </select>
                                        </div>
                                        @if (string.Equals(rule.Action, "deny", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <div class="col-md-3">
                                                <label class="form-label">拒绝状态码</label>
                                                <InputNumber class="form-control" @bind-Value="rule.DenyStatus" />
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label">跳转URL(可选)</label>
                                                <InputText class="form-control" @bind-Value="rule.RedirectUrl" />
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else if (_editorType == "cc_group")
                {
                    <div class="row g-3">
                        @if (Session.IsAdmin)
                        {
                            <div class="col-md-4">
                                <label class="form-label">规则归属</label>
                                <select class="form-select" @bind="_ccGroupForm.Type">
                                    <option value="system">系统规则</option>
                                    <option value="user">用户规则</option>
                                </select>
                            </div>
                            @if (_ccGroupForm.Type == "user")
                            {
                                <div class="col-md-8">
                                    <label class="form-label">用户</label>
                                    <div class="input-group mb-1">
                                        <InputText class="form-control" @bind-Value="_ccUserSearchKeyword" placeholder="输入ID、邮箱、用户名" />
                                        <button class="btn btn-outline-secondary" @onclick="CcSearchUsersAsync" disabled="@_ccUserSearching">搜索</button>
                                    </div>
                                    @if (_ccUserSearchResults.Count > 0)
                                    {
                                        <select class="form-select mt-1" size="3" @onchange="@(e => OnCcUserSelected(e, "group"))">
                                            @foreach (var u in _ccUserSearchResults)
                                            {
                                                <option value="@u.Id">@($"{u.Name ?? u.Email} (ID: {u.Id})")</option>
                                            }
                                        </select>
                                    }
                                    @if (_ccGroupForm.UserId > 0)
                                    {
                                        <div class="form-text text-success">已选用户ID: @_ccGroupForm.UserId</div>
                                    }
                                </div>
                            }
                        }
                        <div class="col-md-4">
                            <label class="form-label">名称</label>
                            <InputText class="form-control" @bind-Value="_ccGroupForm.Name" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">备注</label>
                            <InputText class="form-control" @bind-Value="_ccGroupForm.Remark" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">排序</label>
                            <InputNumber class="form-control" @bind-Value="_ccGroupForm.SortOrder" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">可见</label>
                            <div class="form-check form-switch mt-2">
                                <InputCheckbox class="form-check-input" @bind-Value="_ccGroupForm.IsVisible" />
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label mb-0">规则列表</label>
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddCcGroupRule">新增规则</button>
                            </div>
                            @if (_ccGroupForm.Rules.Count == 0)
                            {
                                <div class="alert alert-light border">暂无规则，点击“新增规则”添加。</div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered align-middle">
                                        <thead>
                                            <tr>
                                                <th>匹配器</th>
                                                <th>过滤器1</th>
                                                <th>过滤器2</th>
                                                <th>动作</th>
                                                <th>模式</th>
                                                <th>启用</th>
                                                <th>操作</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (var i = 0; i < _ccGroupForm.Rules.Count; i++)
                                            {
                                                var rule = _ccGroupForm.Rules[i];
                                                var ruleIndex = i;
                                                <tr>
                                                    <td>
                                                        <select class="form-select form-select-sm" @bind="rule.MatcherId">
                                                            <option value="0">未选择</option>
                                                            @foreach (var item in _ccMatcherOptions)
                                                            {
                                                                <option value="@item.Id">@($"{item.Name} ({item.Id})")</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td>
                                                        <select class="form-select form-select-sm" @bind="rule.Filter1Id">
                                                            <option value="0">未选择</option>
                                                            @foreach (var item in _ccFilterOptions)
                                                            {
                                                                <option value="@item.Id">@($"{item.Name} ({item.Id})")</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td>
                                                        <select class="form-select form-select-sm" @bind="rule.Filter2Id">
                                                            <option value="0">未选择</option>
                                                            @foreach (var item in _ccFilterOptions)
                                                            {
                                                                <option value="@item.Id">@($"{item.Name} ({item.Id})")</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td>
                                                        <select class="form-select form-select-sm" @bind="rule.Action">
                                                            <option value="block">拉黑</option>
                                                            <option value="log">只记录</option>
                                                            <option value="allow">放行</option>
                                                            <option value="captcha">验证码</option>
                                                        </select>
                                                    </td>
                                                    <td>
                                                        <select class="form-select form-select-sm" @bind="rule.Mode">
                                                            <option value="continue">继续下一条</option>
                                                            <option value="stop">停止匹配</option>
                                                        </select>
                                                    </td>
                                                    <td class="text-center">
                                                        <InputCheckbox class="form-check-input" @bind-Value="rule.IsOn" />
                                                    </td>
                                                    <td>
                                                        <div class="d-flex gap-1">
                                                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(ruleIndex == 0)" @onclick='@(() => MoveCcGroupRule(ruleIndex, -1))'>上</button>
                                                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(ruleIndex >= _ccGroupForm.Rules.Count - 1)" @onclick='@(() => MoveCcGroupRule(ruleIndex, 1))'>下</button>
                                                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick='@(() => RemoveCcGroupRule(ruleIndex))'>删</button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                }
                else if (_editorType == "cc_matcher")
                {
                    <div class="row g-3">
                        @if (Session.IsAdmin)
                        {
                            <div class="col-md-4">
                                <label class="form-label">规则归属</label>
                                <select class="form-select" @bind="_ccMatcherForm.Type">
                                    <option value="system">系统规则</option>
                                    <option value="user">用户规则</option>
                                </select>
                            </div>
                            @if (_ccMatcherForm.Type == "user")
                            {
                                <div class="col-md-8">
                                    <label class="form-label">用户</label>
                                    <div class="input-group mb-1">
                                        <InputText class="form-control" @bind-Value="_ccUserSearchKeyword" placeholder="输入ID、邮箱、用户名" />
                                        <button class="btn btn-outline-secondary" @onclick="CcSearchUsersAsync" disabled="@_ccUserSearching">搜索</button>
