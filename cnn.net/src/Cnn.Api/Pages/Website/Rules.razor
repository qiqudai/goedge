    }

    private void AddAclCondition(int ruleIndex)
    {
        if (ruleIndex < 0 || ruleIndex >= _aclForm.Rules.Count)
        {
            return;
        }

        var conditions = _aclForm.Rules[ruleIndex].Conditions as List<AclConditionDto>
            ?? _aclForm.Rules[ruleIndex].Conditions?.ToList()
            ?? new List<AclConditionDto>();
        conditions.Add(new AclConditionDto
        {
            Item = "ip",
            Operator = "eq",
            Value = string.Empty
        });
        _aclForm.Rules[ruleIndex].Conditions = conditions;
    }

    private void RemoveAclCondition(int ruleIndex, int conditionIndex)
    {
        if (ruleIndex < 0 || ruleIndex >= _aclForm.Rules.Count)
        {
            return;
        }

        var conditions = _aclForm.Rules[ruleIndex].Conditions as List<AclConditionDto>
            ?? _aclForm.Rules[ruleIndex].Conditions?.ToList()
            ?? new List<AclConditionDto>();

        if (conditionIndex < 0 || conditionIndex >= conditions.Count)
        {
            return;
        }

        conditions.RemoveAt(conditionIndex);
        _aclForm.Rules[ruleIndex].Conditions = conditions;
    }

