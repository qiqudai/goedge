    private static string NormalizeRuleType(string? raw, long userId)
    {
        if (string.Equals(raw, "system", StringComparison.OrdinalIgnoreCase))
        {
            return "system";
        }

        if (string.Equals(raw, "user", StringComparison.OrdinalIgnoreCase))
        {
            return "user";
        }

        return userId > 0 ? "user" : "system";
    }

    private static bool IsReqRateAction(string? action)
    {
        return string.Equals(action, "req_rate", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsChallengeAction(string? action)
    {
        return action is "silent_captcha"
            or "five_seconds"
            or "click_captcha"
            or "click_captcha_simple"
            or "slide_captcha"
            or "slide_captcha_simple"
            or "captcha"
            or "rotate_captcha"
            or "302";
    }

    private static bool IsUrlAuthAction(string? action)
    {
        return string.Equals(action, "url_auth", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetFilterActionLabel(string? action)
    {
        return action switch
        {
            "req_rate" => "请求频率",
            "silent_captcha" => "无感验证",
            "five_seconds" => "5秒盾",
            "click_captcha" => "点击验证",
            "click_captcha_simple" => "点击验证(简单)",
            "slide_captcha" => "滑动验证",
            "slide_captcha_simple" => "滑动验证(简单)",
            "captcha" => "验证码",
            "rotate_captcha" => "旋转图片",
            "302" => "302跳转",
            "url_auth" => "URL鉴权",
            _ => action ?? "-"
        };
    }

    private static void MoveItem<T>(List<T> list, int index, int offset)
    {
        var newIndex = index + offset;
        if (index < 0 || index >= list.Count || newIndex < 0 || newIndex >= list.Count)
        {
            return;
        }

        (list[index], list[newIndex]) = (list[newIndex], list[index]);
    }

    private static AclRuleDto CloneAclRule(AclRuleDto source)
    {
        return new AclRuleDto
        {
            Action = source.Action ?? "allow",
            DenyStatus = source.DenyStatus <= 0 ? 403 : source.DenyStatus,
            RedirectUrl = source.RedirectUrl ?? string.Empty,
            Conditions = (source.Conditions ?? Array.Empty<AclConditionDto>())
                .Select(condition => new AclConditionDto
                {
                    Item = condition.Item ?? "ip",
                    Operator = condition.Operator ?? "eq",
                    Value = condition.Value ?? string.Empty
                })
                .ToList()
        };
    }

    private static IReadOnlyList<AclRuleDto> NormalizeAclRules(IReadOnlyList<AclRuleDto> rules)
    {
        return rules.Select(rule => new AclRuleDto
        {
            Action = string.IsNullOrWhiteSpace(rule.Action) ? "allow" : rule.Action,
            DenyStatus = rule.DenyStatus <= 0 ? 403 : rule.DenyStatus,
            RedirectUrl = rule.RedirectUrl ?? string.Empty,
            Conditions = (rule.Conditions ?? Array.Empty<AclConditionDto>())
                .Select(condition => new AclConditionDto
                {
                    Item = string.IsNullOrWhiteSpace(condition.Item) ? "ip" : condition.Item,
                    Operator = string.IsNullOrWhiteSpace(condition.Operator) ? "eq" : condition.Operator,
                    Value = condition.Value ?? string.Empty
                })
                .ToList()
        }).ToList();
    }

    private List<CcGroupRuleEditorItem> ParseCcGroupRules(IReadOnlyList<JsonElement>? rules)
    {
        var result = new List<CcGroupRuleEditorItem>();
        if (rules == null)
        {
            return result;
        }

        foreach (var element in rules)
        {
            try
            {
                var parsed = element.Deserialize<CcGroupRuleEditorItem>(JsonOptions);
                if (parsed != null)
                {
                    parsed.Action = string.IsNullOrWhiteSpace(parsed.Action) ? "block" : parsed.Action;
                    parsed.Mode = string.IsNullOrWhiteSpace(parsed.Mode) ? "continue" : parsed.Mode;
                    result.Add(parsed);
                    continue;
                }
            }
            catch
            {
                // ignore and try manual fallback
            }

            result.Add(new CcGroupRuleEditorItem
            {
                MatcherId = GetLong(element, "matcher_id"),
                Filter1Id = GetLong(element, "filter1_id"),
                Filter2Id = GetLong(element, "filter2_id"),
                Action = GetString(element, "action", "block"),
                Mode = GetString(element, "mode", "continue"),
                IsOn = GetBool(element, "is_on", true)
            });
        }

        return result;
    }

    private List<CcMatcherRuleEditorItem> ParseCcMatcherRules(IReadOnlyList<JsonElement>? rules)
    {
        var result = new List<CcMatcherRuleEditorItem>();
        if (rules == null)
        {
            return result;
        }

        foreach (var element in rules)
        {
            try
            {
                var parsed = element.Deserialize<CcMatcherRuleEditorItem>(JsonOptions);
                if (parsed != null)
                {
                    parsed.Item = string.IsNullOrWhiteSpace(parsed.Item) ? "all" : parsed.Item;
                    parsed.Operator = string.IsNullOrWhiteSpace(parsed.Operator) ? "eq" : parsed.Operator;
                    parsed.Value ??= string.Empty;
                    result.Add(parsed);
                    continue;
                }
            }
            catch
            {
                // ignore and try manual fallback
            }

            result.Add(new CcMatcherRuleEditorItem
            {
                Item = GetString(element, "item", "all"),
                Operator = GetString(element, "operator", "eq"),
                Value = GetString(element, "value", string.Empty)
            });
        }

        return result;
    }

    private UrlAuthEditorModel ParseUrlAuth(JsonElement? auth)
    {
        if (!auth.HasValue || auth.Value.ValueKind is JsonValueKind.Null or JsonValueKind.Undefined)
        {
            return new UrlAuthEditorModel();
        }

        try
        {
            var parsed = auth.Value.Deserialize<UrlAuthEditorModel>(JsonOptions);
            if (parsed != null)
            {
                parsed.Method = string.IsNullOrWhiteSpace(parsed.Method) ? "A" : parsed.Method;
                parsed.SignParam = string.IsNullOrWhiteSpace(parsed.SignParam) ? "sign" : parsed.SignParam;
                parsed.TimeParam = string.IsNullOrWhiteSpace(parsed.TimeParam) ? "t" : parsed.TimeParam;
                if (parsed.MaxTimeDiff <= 0)
                {
                    parsed.MaxTimeDiff = 180;
                }
                if (parsed.MaxSignUsage <= 0)
                {
                    parsed.MaxSignUsage = 10;
                }
                parsed.Key ??= string.Empty;
                return parsed;
            }
        }
        catch
        {
            // ignore
        }

        return new UrlAuthEditorModel();
    }

    private static bool TryGetProperty(JsonElement element, string name, out JsonElement value)
    {
        if (element.ValueKind == JsonValueKind.Object)
        {
            foreach (var property in element.EnumerateObject())
            {
                if (string.Equals(property.Name, name, StringComparison.OrdinalIgnoreCase))
                {
                    value = property.Value;
                    return true;
                }
            }
        }

        value = default;
        return false;
    }

    private static string GetString(JsonElement element, string propertyName, string fallback)
    {
        if (!TryGetProperty(element, propertyName, out var value))
        {
            return fallback;
        }

        if (value.ValueKind == JsonValueKind.String)
        {
            return value.GetString() ?? fallback;
        }

        return value.ToString() ?? fallback;
    }

    private static long GetLong(JsonElement element, string propertyName)
    {
        if (!TryGetProperty(element, propertyName, out var value))
        {
            return 0;
        }

        if (value.ValueKind == JsonValueKind.Number && value.TryGetInt64(out var longValue))
        {
            return longValue;
        }

        if (value.ValueKind == JsonValueKind.String && long.TryParse(value.GetString(), out longValue))
        {
            return longValue;
        }

        return 0;
    }

    private static bool GetBool(JsonElement element, string propertyName, bool fallback)
    {
        if (!TryGetProperty(element, propertyName, out var value))
        {
            return fallback;
        }

        return value.ValueKind switch
        {
            JsonValueKind.True => true,
            JsonValueKind.False => false,
            JsonValueKind.String when bool.TryParse(value.GetString(), out var boolValue) => boolValue,
            JsonValueKind.Number when value.TryGetInt32(out var intValue) => intValue != 0,
            _ => fallback
        };
    }

