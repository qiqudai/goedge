                        <div class="col-md-8">
                            <label class="form-label">备注</label>
                            <InputText class="form-control" @bind-Value="_ccMatcherForm.Remark" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">启用</label>
                            <div class="form-check form-switch mt-2">
                                <InputCheckbox class="form-check-input" @bind-Value="_ccMatcherForm.IsOn" />
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label mb-0">匹配规则</label>
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddCcMatcherRule">新增规则</button>
                            </div>
                            @if (_ccMatcherForm.Rules.Count == 0)
