    private static string BuildDeleteBlockedMessage(string? message, IReadOnlyList<DeleteReferenceItem>? references)
    {
        var lines = new List<string>();
        if (!string.IsNullOrWhiteSpace(message))
        {
            lines.Add(message.Trim());
        }

        foreach (var item in references?.Take(5) ?? Array.Empty<DeleteReferenceItem>())
        {
            lines.Add($"- {item.DisplayName} [{item.Relation}]");
        }

        if ((references?.Count ?? 0) > 5)
        {
            lines.Add($"- 还有 {references!.Count - 5} 项依赖未展示");
        }

        return lines.Count == 0 ? "当前资源暂时无法删除" : string.Join("\n", lines);
    }

    private Task ShowErrorAsync(string err)
    {
        return Js.InvokeVoidAsync("alert", err).AsTask();
    }

    private static string FormatUser(CertItemDto item)
    {
        var name = string.IsNullOrWhiteSpace(item.UserName) ? "" : item.UserName.Trim();
        return string.IsNullOrWhiteSpace(name) ? $"uid: {item.UserId}" : $"{name} ({item.UserId})";
    }

    private static string FormatDefaultUser(UserItemDto user)
    {
        var name = string.IsNullOrWhiteSpace(user.Name) ? "-" : user.Name.Trim();
        var email = string.IsNullOrWhiteSpace(user.Email) ? "-" : user.Email.Trim();
        return $"{name} ({user.Id}) / {email}";
    }

    private static string FormatDate(DateTime? value)
    {
        if (value == null || value == DateTime.MinValue)
        {
            return "-";
        }

        return value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");
    }

    private static string DisplayState(CertItemDto item)
    {
        var state = item.State?.Trim().ToLowerInvariant() ?? string.Empty;
        var taskState = item.IssueTaskState?.Trim().ToLowerInvariant() ?? string.Empty;

        if ((taskState == "fail" || taskState == "retrying") && state != "ready" && state != "success")
        {
            return "fail";
        }

        if (state == "issuing" && (item.IssueTaskErrTimes ?? 0) > 0)
        {
            return "fail";
        }

        return state;
    }

    private static string StateBadgeClass(string state)
    {
        return state switch
        {
            "fail" => "text-bg-danger",
            "dns_pending" => "text-bg-warning",
            "issuing" => "text-bg-warning",
            "waiting" => "text-bg-secondary",
            "ready" => "text-bg-success",
            "success" => "text-bg-success",
            _ => "text-bg-info"
        };
    }

    private static string StateText(string state, bool enable)
    {
        if (!enable)
        {
            return "禁用";
        }

        return state switch
        {
            "dns_pending" => "DNS验证中",
            "waiting" => "待签发",
            "issuing" => "签发中",
            "ready" => "已签发",
            "success" => "已签发",
            "fail" => "失败",
            _ => "正常"
        };
    }

    private static string? IssueFailReason(CertItemDto item)
    {
        var state = DisplayState(item);
        if (state != "fail")
        {
            return null;
        }

        if (!string.IsNullOrWhiteSpace(item.IssueTaskRet))
        {
            return item.IssueTaskRet;
        }

        if (!string.IsNullOrWhiteSpace(item.Ret))
        {
            return item.Ret;
        }

        return null;
    }

    private static bool IsUploadType(string? type)
    {
        var normalized = type?.Trim().ToLowerInvariant() ?? string.Empty;
        return normalized is "upload" or "self";
    }

    private static bool HasWildcardDomain(string? domainRaw)
    {
        if (string.IsNullOrWhiteSpace(domainRaw))
        {
            return false;
        }

        var domains = domainRaw
            .Split(new[] { ',', '\n', '\r', '\t', ' ' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return domains.Any(d => d.StartsWith("*.", StringComparison.OrdinalIgnoreCase));
    }

    private sealed class CertEditModel
    {
        public long Id { get; set; }
        public long UserId { get; set; }
        public string? Name { get; set; }
        public string? Description { get; set; }
        public string? Type { get; set; } = "upload";
        public string? Domain { get; set; }
        public int DnsApi { get; set; }
        public string? CertPem { get; set; }
        public string? KeyPem { get; set; }
        public bool AutoRenew { get; set; } = true;

        public static CertEditModel FromItem(CertItemDto item)
        {
            return new CertEditModel
            {
                Id = item.Id,
                UserId = item.UserId,
                Name = item.Name,
                Description = item.Description,
                Type = item.Type,
                Domain = item.Domain,
                DnsApi = item.DnsApi,
                CertPem = item.CertPem,
                KeyPem = item.KeyPem,
                AutoRenew = item.AutoRenew
            };
        }

        public CertCreateRequest ToCreateRequest()
        {
            return new CertCreateRequest
            {
                UserId = UserId,
                Name = Name,
                Description = Description,
                Type = Type,
                Domain = Domain,
                DnsApi = DnsApi,
                CertPem = CertPem,
                KeyPem = KeyPem,
                AutoRenew = AutoRenew
            };
        }

        public CertUpdateRequest ToUpdateRequest()
        {
            return new CertUpdateRequest
            {
                UserId = UserId,
                Name = Name,
                Description = Description,
                Type = Type,
                Domain = Domain,
                DnsApi = DnsApi,
                CertPem = CertPem,
                KeyPem = KeyPem,
                AutoRenew = AutoRenew
            };
        }
    }
