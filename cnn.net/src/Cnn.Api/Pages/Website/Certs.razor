        await RefreshAsync();
    }

    private async Task RefreshAfterTaskAsync()
    {
        await Task.Delay(1200);
        await RefreshAsync();
        await InvokeAsync(StateHasChanged);
    }

    private static string ResolveBatchActionLabel(string action) => action switch
    {
        "enable" => "启用",
        "disable" => "禁用",
        "force_disable" => "强制禁用",
        "delete" => "删除",
        _ => action
    };

    private void OpenCreate()
    {
        _editing = new CertEditModel();
        _editorUserKeyword = string.Empty;
        _editorUsers.Clear();
        if (Session.IsAdmin)
        {
            _ = SearchEditorUsersAsync();
        }
        _editorVisible = true;
    }

    private void OpenEdit(CertItemDto item)
    {
        _editing = CertEditModel.FromItem(item);
        _editorUserKeyword = item.UserId > 0 ? item.UserId.ToString() : string.Empty;
        _editorUsers.Clear();
        if (Session.IsAdmin)
        {
            _ = SearchEditorUsersAsync();
            _ = LoadDnsApisAsync(item.UserId > 0 ? item.UserId : null);
        }
        _editorVisible = true;
    }

    private void CloseEditor()
    {
        _editorVisible = false;
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        if (Session.IsAdmin && _editing.UserId <= 0)
        {
            _saving = false;
            await Js.InvokeVoidAsync("alert", "管理员新增证书时必须先选择用户");
            return;
        }
        if (string.IsNullOrWhiteSpace(_editing.Domain))
        {
            _saving = false;
            await Js.InvokeVoidAsync("alert", "请填写证书域名");
            return;
        }
        if (IsUploadType(_editing.Type) && (string.IsNullOrWhiteSpace(_editing.CertPem) || string.IsNullOrWhiteSpace(_editing.KeyPem)))
        {
            _saving = false;
            await Js.InvokeVoidAsync("alert", "上传证书类型必须填写证书内容和私钥内容");
            return;
        }
        if (HasWildcardDomain(_editing.Domain) && _editing.DnsApi <= 0 && !IsUploadType(_editing.Type))
        {
            _saving = false;
            await Js.InvokeVoidAsync("alert", "包含泛域名时，证书申请必须指定 DNS API 账户");
            return;
        }

        ApiResponse<object>? result;
        var recreatedFromMissing = false;
        if (_editing.Id > 0)
        {
            result = await Api.PutAsync<object>($"certs/{_editing.Id}", _editing.ToUpdateRequest(), Scope);
            if (result?.Code == ErrorCodes.NotFound)
            {
                // If the original cert id was deleted, fall back to creating a new cert
                // so users can save uploaded cert content without manual re-add flow.
                result = await Api.PostAsync<object>("certs", _editing.ToCreateRequest(), Scope);
                recreatedFromMissing = result?.Code == ErrorCodes.Success;
            }
        }
        else
        {
            result = await Api.PostAsync<object>("certs", _editing.ToCreateRequest(), Scope);
        }
        _saving = false;
        if (result?.Code != ErrorCodes.Success)
        {
            await Js.InvokeVoidAsync("alert", result?.Message ?? "证书保存失败");
            return;
        }

        _editorVisible = false;
        if (recreatedFromMissing)
        {
            await Js.InvokeVoidAsync("alert", "原证书不存在，已按当前内容重建并保存");
        }
        else
        {
            await Js.InvokeVoidAsync("alert", _editing.Id > 0 ? "证书已更新" : "证书已创建");
        }
        await RefreshAsync();
    }

    private async Task DeleteAsync(CertItemDto item)
    {
        var result = await DeleteWorkflowHelper.ConfirmAndRequestAsync(
            Api,
            Js,
            $"certs/{item.Id}",
            Scope,
            "确认删除该证书？",
            "证书删除任务已提交");
        if (!result.Success)
        {
            if (!result.Cancelled)
            {
                await Js.InvokeVoidAsync("alert", result.Message);
            }

            return;
        }

        await Js.InvokeVoidAsync("alert", result.Message);
        await RefreshAsync();
        if (result.TaskId > 0)
        {
            await RefreshAfterTaskAsync();
        }
    }

    private async Task ReissueAsync(CertItemDto item)
    {
        var request = new CertReissueRequest { Ids = new List<long> { item.Id } };
        var result = await Api.PostAsync<object>("certs/reissue", request, Scope);
        if (result?.Code != ErrorCodes.Success)
        {
            await Js.InvokeVoidAsync("alert", result?.Message ?? "证书重签提交失败");
            return;
