@page "/website/purge"
@using Cnn.Common.Contracts
@inject ApiClient Api
@inject ClientSession Session
@inject IJSRuntime Js

<div class="page-container">
    <div class="page-title">刷新预热</div>

    <div class="tab-bar">
        <button class='tab-button @(_activeTab == "create" ? "active" : "")' @onclick='@(() => SetTabAsync("create"))'>刷新预热</button>
        <button class='tab-button @(_activeTab == "list" ? "active" : "")' @onclick='@(() => SetTabAsync("list"))'>操作记录</button>
    </div>

    @if (_activeTab == "create")
    {
        <div class="card config-card p-3">
            <div class="mb-3">
                <label class="form-label">操作类型</label>
                <div class="d-flex gap-3 flex-wrap">
                    <label class="form-check">
                        <input type="radio"
                               class="form-check-input"
                               name="purgeType"
                               checked="@(_taskType == "refresh_url")"
                               @onchange='@(() => OnTaskTypeChangedAsync("refresh_url"))' />
                        <span class="form-check-label">刷新URL</span>
                    </label>
                    <label class="form-check">
                        <input type="radio"
                               class="form-check-input"
                               name="purgeType"
                               checked="@(_taskType == "refresh_dir")"
                               @onchange='@(() => OnTaskTypeChangedAsync("refresh_dir"))' />
                        <span class="form-check-label">刷新目录</span>
                    </label>
                    <label class="form-check">
                        <input type="radio"
                               class="form-check-input"
                               name="purgeType"
                               checked="@(_taskType == "preheat")"
                               @onchange='@(() => OnTaskTypeChangedAsync("preheat"))' />
                        <span class="form-check-label">预热</span>
                    </label>
                </div>
            </div>

            <div class="mb-2">
                <label class="form-label">URL</label>
                <InputTextArea class="form-control" rows="12" @bind-Value="_urls" placeholder="URL或域名" />
            </div>

            <div class="small text-muted mb-3">
                @LimitText
                <button class="btn btn-sm btn-link p-0 ms-2" @onclick="RefreshUsageAsync">刷新</button>
            </div>

            <div>
                <button class="btn btn-primary" @onclick="SubmitAsync" disabled="@_submitLoading">提交</button>
            </div>
        </div>
    }
    else
    {
        <div class="filter-bar">
            <button class="btn btn-primary" @onclick="ResubmitBatchAsync" disabled="@(!_selectedIds.Any())">重新提交</button>
            <select class="form-select" style="max-width: 140px" @bind="_listType">
                <option value="">全部类型</option>
                <option value="refresh_url">刷新URL</option>
                <option value="refresh_dir">刷新目录</option>
                <option value="preheat">预热</option>
            </select>
            <InputText class="form-control" style="max-width: 220px" @bind-Value="_keyword" placeholder="URL或域名" @onkeydown="OnKeywordKeyDown" />
            <button class="btn btn-primary" @onclick="SearchAsync">搜索</button>
            <button class="btn btn-outline-secondary" @onclick="TogglePagingDiagnostics">
                @(_showPagingDiagnostics ? "隐藏分页诊断" : "显示分页诊断")
            </button>
        </div>

        @if (_showPagingDiagnostics)
        {
            <div class="alert alert-light py-2 px-3 mt-2 mb-2 small">
                <div><strong>分页诊断</strong></div>
                <div>stateKey: <code>website:purge:list:table</code></div>
                <div>pagingEnabled: <code>@(_pageQuery.PagingEnabled ? "true" : "false")</code></div>
                <div>page: <code>@_pageQuery.Page</code>, pageSize: <code>@_pageQuery.PageSize</code></div>
                <div>loaded: <code>@_items.Count</code>, total: <code>@_total</code></div>
            </div>
        }

        <TablePager @ref="_listTablePager"
                    StateKey="website:purge:list:table"
                    Total="_total"
                    DefaultPageSize="10"
                    UnpagedLimit="1000"
                    QueryChanged="OnListPageQueryChangedAsync">
            <ChildContent>
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th style="width: 44px">
                                    <input type="checkbox" class="form-check-input" checked="@AllSelected" @onchange="ToggleSelectAll" />
                                </th>
                                <th>任务ID</th>
                                <th>类型</th>
                                <th>URL</th>
                                <th>状态</th>
                                <th>创建时间</th>
                                <th>操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_listLoading)
                            {
                                <tr><td colspan="7">加载中...</td></tr>
                            }
                            else if (_items.Count == 0)
                            {
                                <tr><td colspan="7">暂无数据</td></tr>
                            }
                            else
                            {
                                @foreach (var item in _items)
                                {
                                    <tr>
                                        <td>
                                            <input type="checkbox" class="form-check-input" checked="@_selectedIds.Contains(item.Id)" @onchange="e => ToggleSelected(item.Id, e)" />
                                        </td>
                                        <td>@item.Id</td>
                                        <td>@FormatType(item.Type)</td>
                                        <td>
                                            <div style="max-width: 420px; white-space: pre-wrap; word-break: break-all;">
                                                @(string.IsNullOrWhiteSpace(item.Data) ? item.Name : item.Data)
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge @StateBadgeClass(item.State)">@FormatState(item.State)</span>
                                        </td>
                                        <td>@FormatTime(item.CreateAt)</td>
                                        <td>
                                            <button class="btn btn-sm btn-link" @onclick="() => ResubmitAsync(item.Id)">重新提交</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </ChildContent>
        </TablePager>
    }

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert alert-info mt-3">@_message</div>
    }
</div>

@code {
    private string _activeTab = "create";

    private bool _submitLoading;
    private bool _listLoading;
    private bool _showPagingDiagnostics = false;
    private string _taskType = "refresh_url";
    private string _urls = string.Empty;
    private TaskUsagePayload? _usage;

    private readonly List<TaskListItemDto> _items = new();
    private readonly HashSet<long> _selectedIds = new();
    private TablePageQuery _pageQuery = new() { PagingEnabled = true, Page = 1, PageSize = 10 };
    private long _total;
    private string _keyword = string.Empty;
    private string _listType = string.Empty;

    private string _message = string.Empty;
    private TablePager? _listTablePager;

    private ApiScope Scope => Session.IsAdmin ? ApiScope.Admin : ApiScope.User;

    private bool AllSelected => _items.Count > 0 && _items.All(item => _selectedIds.Contains(item.Id));

    private int CurrentLimit => _taskType switch
    {
        "refresh_url" => _usage?.Limits?.RefreshUrl ?? 0,
        "refresh_dir" => _usage?.Limits?.RefreshDir ?? 0,
        "preheat" => _usage?.Limits?.Preheat ?? 0,
        _ => 0
    };

    private int CurrentRemaining => _taskType switch
    {
        "refresh_url" => _usage?.Remaining?.RefreshUrl ?? 0,
        "refresh_dir" => _usage?.Remaining?.RefreshDir ?? 0,
        "preheat" => _usage?.Remaining?.Preheat ?? 0,
        _ => 0
    };

    private string LimitText => $"每日限额{CurrentLimit}次，今日剩余{CurrentRemaining}次";

    protected override async Task OnInitializedAsync()
    {
        await LoadUsageAsync();
    }

    private async Task SetTabAsync(string tab)
    {
        _activeTab = tab;
        _message = string.Empty;

        if (tab == "list")
        {
            if (_listTablePager != null)
            {
                await _listTablePager.RefreshAsync();
            }
        }
    }

    private async Task LoadUsageAsync()
    {
        var response = await Api.GetAsync<TaskUsagePayload>("tasks/usage", Scope);
        if (response?.Data != null)
        {
            _usage = response.Data;
        }
    }

    private Task RefreshUsageAsync()
    {
        return LoadUsageAsync();
    }

    private async Task OnTaskTypeChangedAsync(string type)
    {
        _taskType = type;
        await LoadUsageAsync();
    }

    private async Task SubmitAsync()
    {
        if (_submitLoading)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_urls))
        {
            _message = "请输入URL";
            return;
        }

        _submitLoading = true;
        var request = new TaskCreateRequest
        {
            Type = _taskType,
            Urls = _urls
        };

        var response = await Api.PostAsync<object>("tasks", request, Scope);
        _submitLoading = false;

        if (response == null || (response.Code != 0 && response.Code != 200))
        {
            _message = response?.Message ?? "提交失败";
            return;
        }

        _message = "提交成功，请到操作记录里查看进度";
        _urls = string.Empty;
        await LoadUsageAsync();
        await SetTabAsync("list");
    }

    private async Task LoadListAsync()
    {
        _listLoading = true;

        var query = new Dictionary<string, string?>
        {
            ["page"] = _pageQuery.Page.ToString(),
            ["pageSize"] = _pageQuery.PageSize.ToString(),
            ["keyword"] = _keyword,
            ["type"] = _listType
        };

        var response = await Api.GetAsync<TaskListResult>("tasks", Scope, query);

        _items.Clear();
        if (response?.Data?.List != null)
        {
            _items.AddRange(response.Data.List);
            _total = response.Data.Total;
        }
        else
        {
            _total = 0;
        }

        var currentIds = _items.Select(i => i.Id).ToHashSet();
        _selectedIds.RemoveWhere(id => !currentIds.Contains(id));

        _listLoading = false;
    }

    private async Task SearchAsync()
    {
        if (_listTablePager != null)
        {
            await _listTablePager.SearchAsync();
            return;
        }

        _pageQuery = new TablePageQuery
        {
            PagingEnabled = _pageQuery.PagingEnabled,
            Page = 1,
            PageSize = _pageQuery.PageSize
        };
        await LoadListAsync();
    }

    private async Task OnKeywordKeyDown(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Enter", StringComparison.OrdinalIgnoreCase))
        {
            await SearchAsync();
        }
    }

    private Task OnListPageQueryChangedAsync(TablePageQuery query)
    {
        _pageQuery = query;
        return LoadListAsync();
    }

    private void TogglePagingDiagnostics()
    {
        _showPagingDiagnostics = !_showPagingDiagnostics;
    }

    private void ToggleSelectAll(ChangeEventArgs args)
    {
        var checkedAll = args?.Value is bool b && b;
        if (!checkedAll)
        {
            _selectedIds.Clear();
            return;
        }

        foreach (var item in _items)
        {
            _selectedIds.Add(item.Id);
        }
    }

    private void ToggleSelected(long id, ChangeEventArgs args)
    {
        var isChecked = args?.Value is bool b && b;
        if (isChecked)
        {
            _selectedIds.Add(id);
        }
        else
        {
            _selectedIds.Remove(id);
        }
    }

    private async Task ResubmitAsync(long id)
    {
        var ok = await Js.InvokeAsync<bool>("confirm", "确认重新提交该任务？");
        if (!ok)
        {
            return;
        }

        var response = await Api.PostAsync<object>($"tasks/{id}/resubmit", null, Scope);
        _message = response?.Message ?? "重新提交成功";

        await LoadUsageAsync();
        await LoadListAsync();
    }

    private async Task ResubmitBatchAsync()
    {
        if (!_selectedIds.Any())
        {
            return;
        }

        var ok = await Js.InvokeAsync<bool>("confirm", "确认重新提交选中任务？");
        if (!ok)
        {
            return;
        }

        foreach (var id in _selectedIds.ToList())
        {
            await Api.PostAsync<object>($"tasks/{id}/resubmit", null, Scope);
        }

        _message = "重新提交成功";
        await LoadUsageAsync();
        await LoadListAsync();
    }

    private static string FormatType(string? type)
    {
        return type switch
        {
            "refresh_url" => "刷新URL",
            "refresh_dir" => "刷新目录",
            "preheat" => "预热",
            _ => type ?? "-"
        };
    }

    private static string FormatState(string? state)
    {
        return state switch
        {
            "waiting" => "等待",
            "running" => "处理中",
            "done" => "完成",
            "fail" => "失败",
            _ => state ?? "-"
        };
    }

    private static string StateBadgeClass(string? state)
    {
        return state switch
        {
            "waiting" => "text-bg-secondary",
            "running" => "text-bg-warning",
            "done" => "text-bg-success",
            "fail" => "text-bg-danger",
            _ => "text-bg-info"
        };
    }

    private static string FormatTime(DateTime? value)
    {
        if (value == null || value.Value == DateTime.MinValue)
        {
            return "-";
        }

        return value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");
    }
}
