@using Cnn.Common.Contracts.Admin
@inject ApiClient Api
@inject ClientSession Session
@inject IJSRuntime Js

<div class="filter-bar">
    <button class="btn btn-primary" @onclick="StartResolveAsync" disabled="@_resolving">
        @(_resolving ? "正在检测中..." : "开始检测")
    </button>

    <InputText class="form-control"
               style="max-width: 260px"
               @bind-Value="_keyword"
               @onkeydown="OnKeywordKeyDown"
               placeholder="输入域名搜索" />
    <button class="btn btn-primary" @onclick="SearchAsync">搜索</button>
    <button class="btn btn-outline-secondary" @onclick="TogglePagingDiagnostics">
        @(_showPagingDiagnostics ? "隐藏分页诊断" : "显示分页诊断")
    </button>
</div>

@if (_showPagingDiagnostics)
{
    <div class="alert alert-light py-2 px-3 mt-2 mb-2 small">
        <div><strong>分页诊断</strong></div>
        <div>stateKey: <code>website:resolve:table</code></div>
        <div>pagingEnabled: <code>@(_pageQuery.PagingEnabled ? "true" : "false")</code></div>
        <div>page: <code>@_pageQuery.Page</code>, pageSize: <code>@_pageQuery.PageSize</code></div>
        <div>loaded: <code>@_rows.Count</code>, total: <code>@_total</code></div>
    </div>
}

<TablePager @ref="_tablePager"
            StateKey="website:resolve:table"
            Total="_total"
            DefaultPageSize="10"
            UnpagedLimit="1000"
            QueryChanged="OnPageQueryChangedAsync">
    <ChildContent>
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th style="width: 44px">
                            <input type="checkbox" class="form-check-input" checked="@AllSelected" @onchange="ToggleSelectAll" />
                        </th>
                        <th>ID</th>
                        <th>网站ID</th>
                        <th>域名</th>
                        <th>CNAME</th>
                        <th>解析状态</th>
                        <th>DNS 接口</th>
                        <th>任务状态</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="8">加载中...</td></tr>
                    }
                    else if (_rows.Count == 0)
                    {
                        <tr><td colspan="8">暂无数据</td></tr>
                    }
                    else
                    {
                        @foreach (var row in _rows)
                        {
                            <tr>
                                <td>
                                    <input type="checkbox" class="form-check-input" checked="@_selectedIds.Contains(row.Id)" @onchange="e => ToggleSelected(row.Id, e)" />
                                </td>
                                <td>@row.Id</td>
                                <td>@row.SiteId</td>
                                <td>
                                    <span>@row.Domain</span>
                                    <button class="btn btn-sm btn-link p-0 ms-1" @onclick="() => CopyTextAsync(row.Domain)">复制</button>
                                    <button class="btn btn-sm btn-link p-0 ms-1" @onclick="() => OpenSiteAsync(row)">打开</button>
                                </td>
                                <td>
                                    <span>@row.Cname</span>
                                    @if (!string.IsNullOrWhiteSpace(row.Cname) && row.Cname != "-")
                                    {
                                        <button class="btn btn-sm btn-link p-0 ms-1" @onclick="() => CopyTextAsync(row.Cname)">复制</button>
                                    }
                                </td>
                                <td>
                                    <span class="badge @ResolveStateBadgeClass(row.ResolveStatus)">@ResolveStateText(row.ResolveStatus)</span>
                                    @if (!string.IsNullOrWhiteSpace(row.ResolvedCname) && row.ResolvedCname != "-")
                                    {
                                        <div class="small text-muted mt-1">解析CNAME: @row.ResolvedCname</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(row.ResolvedIps) && row.ResolvedIps != "-")
                                    {
                                        <div class="small text-muted mt-1">IP: @row.ResolvedIps</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(row.Error))
                                    {
                                        <div class="small text-danger mt-1">@row.Error</div>
                                    }
                                </td>
                                <td>@row.DnsApi</td>
                                <td>@row.TaskStatus</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </ChildContent>
</TablePager>

@code {
    private readonly List<ResolveRow> _rows = new();
    private readonly HashSet<long> _selectedIds = new();

    private bool _loading;
    private bool _resolving;
    private bool _showPagingDiagnostics;
    private TablePageQuery _pageQuery = new() { PagingEnabled = true, Page = 1, PageSize = 10 };
    private long _total;
    private string _keyword = string.Empty;
    private long _resolveRunId;
    private TablePager? _tablePager;
    private bool _initialAutoResolved;

    private bool AllSelected => _rows.Count > 0 && _rows.All(row => _selectedIds.Contains(row.Id));

    protected override Task OnInitializedAsync() => Task.CompletedTask;

    private ApiScope Scope => Session.IsAdmin ? ApiScope.Admin : ApiScope.User;

    private async Task LoadSitesAsync(bool autoResolve)
    {
        _loading = true;

        var query = new Dictionary<string, string?>
        {
            ["page"] = _pageQuery.Page.ToString(),
            ["pageSize"] = _pageQuery.PageSize.ToString(),
            ["keyword"] = _keyword,
            ["search_field"] = "domain"
        };

        var response = await Api.GetAsync<SiteListResult>("sites", Scope, query);

        _rows.Clear();
        var list = response?.Data?.List ?? Array.Empty<SiteListItem>();
        foreach (var item in list)
        {
            _rows.Add(new ResolveRow
            {
                Id = item.Id,
                SiteId = item.Id,
                Domain = ResolveMainDomain(item),
                Cname = string.IsNullOrWhiteSpace(item.Cname) ? "-" : item.Cname.Trim(),
                Https = item.Https,
                ResolveStatus = "default",
                DnsApi = "-",
                TaskStatus = "-",
                ResolvedCname = "-",
                ResolvedIps = "-"
            });
        }

        _total = response?.Data?.Total ?? 0;
        _loading = false;

        var currentIds = _rows.Select(r => r.Id).ToHashSet();
        _selectedIds.RemoveWhere(id => !currentIds.Contains(id));

        if (autoResolve && _rows.Count > 0)
        {
            await StartResolveAsync();
        }
    }

    private async Task StartResolveAsync()
    {
        if (_resolving || _rows.Count == 0)
        {
            return;
        }

        _resolving = true;
        _resolveRunId++;
        var currentRunId = _resolveRunId;

        const int batchSize = 5;
        for (var i = 0; i < _rows.Count; i += batchSize)
        {
            if (currentRunId != _resolveRunId)
            {
                break;
            }

            var chunk = _rows.Skip(i).Take(batchSize).ToList();
            await Task.WhenAll(chunk.Select(row => ResolveRowAsync(row, currentRunId)));
            await InvokeAsync(StateHasChanged);
        }

        _resolving = false;
    }

    private async Task ResolveRowAsync(ResolveRow row, long runId)
    {
        if (runId != _resolveRunId)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(row.Domain) || row.Domain == "-")
        {
            row.ResolveStatus = "default";
            row.Error = string.Empty;
            return;
        }

        row.ResolveStatus = "checking";
        row.Error = string.Empty;
        row.ResolvedCname = "-";
        row.ResolvedIps = "-";

        try
        {
            var query = new Dictionary<string, string?> { ["domain"] = row.Domain };
            var response = await Api.GetAsync<SiteResolveResult>("sites/resolve", Scope, query);

            if (response?.Code != 0 || response.Data == null)
            {
                row.ResolveStatus = "failed";
                row.Error = string.IsNullOrWhiteSpace(response?.Message) ? "查询失败" : response!.Message;
                return;
            }

            var result = response.Data;
            row.ResolvedCname = string.IsNullOrWhiteSpace(result.Cname) ? "-" : result.Cname.Trim();
            row.ResolvedIps = result.Ips.Count > 0 ? string.Join(", ", result.Ips) : "-";

            var expectedCname = NormalizeHost(row.Cname);
            var resolvedCname = NormalizeHost(result.Cname);

            if (!string.IsNullOrWhiteSpace(expectedCname) && expectedCname != "-")
            {
                row.ResolveStatus = string.Equals(expectedCname, resolvedCname, StringComparison.OrdinalIgnoreCase)
                    ? "success"
                    : "failed";
                return;
            }

            row.ResolveStatus = result.Ips.Count > 0 ? "success" : "failed";
        }
        catch
        {
            row.ResolveStatus = "failed";
            row.Error = "查询失败";
        }
    }

    private async Task SearchAsync()
    {
        if (_tablePager != null)
        {
            await _tablePager.SearchAsync();
            return;
        }

        _pageQuery = new TablePageQuery
        {
            PagingEnabled = _pageQuery.PagingEnabled,
            Page = 1,
            PageSize = _pageQuery.PageSize
        };
        await LoadSitesAsync(autoResolve: false);
    }

    private async Task OnKeywordKeyDown(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Enter", StringComparison.OrdinalIgnoreCase))
        {
            await SearchAsync();
        }
    }

    private Task OnPageQueryChangedAsync(TablePageQuery query)
    {
        _pageQuery = query;
        var autoResolve = !_initialAutoResolved;
        _initialAutoResolved = true;
        return LoadSitesAsync(autoResolve);
    }

    private void TogglePagingDiagnostics()
    {
        _showPagingDiagnostics = !_showPagingDiagnostics;
    }

    private void ToggleSelectAll(ChangeEventArgs args)
    {
        var checkedAll = args?.Value is bool b && b;
        if (!checkedAll)
        {
            _selectedIds.Clear();
            return;
        }

        foreach (var row in _rows)
        {
            _selectedIds.Add(row.Id);
        }
    }

    private void ToggleSelected(long id, ChangeEventArgs args)
    {
        var isChecked = args?.Value is bool b && b;
        if (isChecked)
        {
            _selectedIds.Add(id);
        }
        else
        {
            _selectedIds.Remove(id);
        }
    }

    private async Task CopyTextAsync(string? text)
    {
        if (string.IsNullOrWhiteSpace(text) || text == "-")
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch
        {
            await Js.InvokeVoidAsync("alert", "复制失败");
        }
    }

    private async Task OpenSiteAsync(ResolveRow row)
    {
        var host = NormalizeDomainForOpen(row.Domain);
        if (string.IsNullOrWhiteSpace(host))
        {
            return;
        }

        var scheme = row.Https ? "https" : "http";
        await Js.InvokeVoidAsync("open", $"{scheme}://{host}", "_blank");
    }

    private static string ResolveMainDomain(SiteListItem item)
    {
        if (!string.IsNullOrWhiteSpace(item.DomainDisplay))
        {
            return item.DomainDisplay
                .Split(new[] { ',', '，', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(domain => domain.Trim())
                .FirstOrDefault(domain => !string.IsNullOrWhiteSpace(domain)) ?? "-";
        }

        return item.Domains.FirstOrDefault(domain => !string.IsNullOrWhiteSpace(domain))?.Trim() ?? "-";
    }

    private static string NormalizeHost(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        return value.Trim().TrimEnd('.').ToLowerInvariant();
    }

    private static string? NormalizeDomainForOpen(string? value)
    {
        if (string.IsNullOrWhiteSpace(value) || value == "-")
        {
            return null;
        }

        var domain = value.Trim();
        if (domain.StartsWith("*.", StringComparison.Ordinal))
        {
            domain = domain[2..];
        }

        var slashIndex = domain.IndexOf('/');
        if (slashIndex >= 0)
        {
            domain = domain[..slashIndex];
        }

        return string.IsNullOrWhiteSpace(domain) ? null : domain;
    }

    private static string ResolveStateBadgeClass(string state)
    {
        return state switch
        {
            "checking" => "text-bg-warning",
            "success" => "text-bg-success",
            "failed" => "text-bg-danger",
            _ => "text-bg-secondary"
        };
    }

    private static string ResolveStateText(string state)
    {
        return state switch
        {
            "checking" => "检测中",
            "success" => "正常",
            "failed" => "异常",
            _ => "未检测"
        };
    }

    private sealed class ResolveRow
    {
        public long Id { get; set; }
        public long SiteId { get; set; }
        public string Domain { get; set; } = "-";
        public string Cname { get; set; } = "-";
        public bool Https { get; set; }
        public string ResolveStatus { get; set; } = "default";
        public string DnsApi { get; set; } = "-";
        public string TaskStatus { get; set; } = "-";
        public string ResolvedCname { get; set; } = "-";
        public string ResolvedIps { get; set; } = "-";
        public string Error { get; set; } = string.Empty;
    }
}
