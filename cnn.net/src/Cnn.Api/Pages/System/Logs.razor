@page "/system/logs"
@using Cnn.Common.Contracts.Admin
@using Cnn.Api.Services
@inject ApiClient Api

<div class="page-container">
    <div class="page-title">系统日志</div>

    <div class="filter-bar">
        <div class="btn-group" role="group">
            <button class='btn btn-outline-secondary @(IsRange("today") ? "active" : "")' @onclick='@(() => ApplyRangeAsync("today"))'>今天</button>
            <button class='btn btn-outline-secondary @(IsRange("week") ? "active" : "")' @onclick='@(() => ApplyRangeAsync("week"))'>最近7天</button>
            <button class='btn btn-outline-secondary @(IsRange("month") ? "active" : "")' @onclick='@(() => ApplyRangeAsync("month"))'>最近30天</button>
            <button class='btn btn-outline-secondary @(IsRange("custom") ? "active" : "")' @onclick='@(() => SetRange("custom"))'>自定义</button>
        </div>

        @if (_rangeType == "custom")
        {
            <input type="datetime-local" class="form-control" style="max-width: 200px" @bind="_customStart" />
            <input type="datetime-local" class="form-control" style="max-width: 200px" @bind="_customEnd" />
            <button class="btn btn-outline-primary" @onclick="ApplyCustomRange">应用</button>
        }

        <div class="flex-grow-1"></div>

        <div class="input-group" style="max-width: 320px;">
            <InputText class="form-control" @bind-Value="_keyword" placeholder="@SearchPlaceholder" />
            <button class="btn btn-outline-secondary" @onclick="SearchAsync">搜索</button>
        </div>
        <button class="btn btn-outline-secondary" @onclick="TogglePagingDiagnostics">
            @(_showPagingDiagnostics ? "隐藏分页诊断" : "显示分页诊断")
        </button>
    </div>

    @if (_showPagingDiagnostics)
    {
        <div class="alert alert-light py-2 px-3 mt-2 mb-2 small">
            <div><strong>分页诊断</strong></div>
            <div>stateKey: <code>system:logs:table</code></div>
            <div>pagingEnabled: <code>@(_pageQuery.PagingEnabled ? "true" : "false")</code></div>
            <div>page: <code>@_pageQuery.Page</code>, pageSize: <code>@_pageQuery.PageSize</code></div>
            <div>loaded: <code>@CurrentLoadedCount</code>, total: <code>@CurrentTotal</code></div>
        </div>
    }

    <div class="tab-bar">
        <button class='tab-button @(IsTab("login") ? "active" : "")' @onclick='@(() => SetTabAsync("login"))'>登录日志</button>
        <button class='tab-button @(IsTab("operation") ? "active" : "")' @onclick='@(() => SetTabAsync("operation"))'>操作日志</button>
        <button class='tab-button @(IsTab("backup") ? "active" : "")' @onclick='@(() => SetTabAsync("backup"))'>备份日志</button>
        <button class='tab-button @(IsTab("mail") ? "active" : "")' @onclick='@(() => SetTabAsync("mail"))'>发信日志</button>
    </div>

    <div class="table-responsive">
        @switch (_activeTab)
        {
            case "login":
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>用户ID</th>
                            <th>IP地址</th>
                            <th>地理位置</th>
                            <th>登录时间</th>
                            <th>登录状态</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_loading)
                        {
                            <tr><td colspan="5">加载中...</td></tr>
                        }
                        else if (_loginItems.Count == 0)
                        {
                            <tr><td colspan="5">暂无数据</td></tr>
                        }
                        else
                        {
                            @foreach (var item in _loginItems)
                            {
                                <tr>
                                    <td>@item.UserId @if (!string.IsNullOrWhiteSpace(item.Username)) { <span class="text-muted">(@item.Username)</span> }</td>
                                    <td>@item.Ip</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.PostContent) ? "-" : item.PostContent)</td>
                                    <td>@FormatTime(item.CreatedAt)</td>
                                    <td>
                                        <span class="badge @(item.Success ? "bg-success" : "bg-danger")">@(item.Success ? "成功" : "失败")</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                break;
            case "operation":
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>用户ID</th>
                            <th>类别</th>
                            <th>动作</th>
                            <th>变更内容</th>
                            <th>IP地址</th>
                            <th>进程</th>
                            <th>操作时间</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_loading)
                        {
                            <tr><td colspan="7">加载中...</td></tr>
                        }
                        else if (_operationItems.Count == 0)
                        {
                            <tr><td colspan="7">暂无数据</td></tr>
                        }
                        else
                        {
                            @foreach (var item in _operationItems)
                            {
                                <tr>
                                    <td>@item.UserId @if (!string.IsNullOrWhiteSpace(item.Username)) { <span class="text-muted">(@item.Username)</span> }</td>
                                    <td>@item.Type</td>
                                    <td>@item.Action</td>
                                    <td>@(ResolveOpContent(item))</td>
                                    <td>@item.Ip</td>
                                    <td>@item.Process</td>
                                    <td>@FormatTime(item.CreatedAt)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                break;
            case "backup":
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>备份时间</th>
                            <th>完成时间</th>
                            <th>状态</th>
                            <th>结果</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_loading)
                        {
                            <tr><td colspan="4">加载中...</td></tr>
                        }
                        else if (_backupItems.Count == 0)
                        {
                            <tr><td colspan="4">暂无数据</td></tr>
                        }
                        else
                        {
                            @foreach (var item in _backupItems)
                            {
                                <tr>
                                    <td>@FormatTime(item.CreatedAt)</td>
                                    <td>@FormatTime(item.FinishedAt)</td>
                                    <td><span class="badge @(item.Status == 1 ? "bg-success" : "bg-danger")">@(item.Status == 1 ? "成功" : "失败")</span></td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Result) ? "-" : item.Result)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                break;
            case "mail":
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>用户ID</th>
                            <th>消息ID</th>
                            <th>标题</th>
                            <th>媒介</th>
                            <th>失败次数</th>
                            <th>状态</th>
                            <th>原因</th>
                            <th>发送时间</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_loading)
                        {
                            <tr><td colspan="8">加载中...</td></tr>
                        }
                        else if (_mailItems.Count == 0)
                        {
                            <tr><td colspan="8">暂无数据</td></tr>
                        }
                        else
                        {
                            @foreach (var item in _mailItems)
                            {
                                <tr>
                                    <td>@item.UserId</td>
                                    <td>@item.MessageId</td>
                                    <td>@item.Subject</td>
                                    <td>@item.Medium</td>
                                    <td>@item.Fails</td>
                                    <td><span class="badge @(item.Status == 1 ? "bg-success" : "bg-danger")">@(item.Status == 1 ? "成功" : "失败")</span></td>
                                    <td>@item.Reason</td>
                                    <td>@FormatTime(item.CreatedAt)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                break;
        }
    </div>

    <TablePager @ref="_tablePager"
                StateKey="system:logs:table"
                Total="@CurrentTotal"
                DefaultPageSize="20"
                UnpagedLimit="1000"
                QueryChanged="OnPageQueryChangedAsync" />
</div>

@code {
    private string _activeTab = "login";
    private string _rangeType = "today";
    private bool _loading;
    private bool _showPagingDiagnostics;
    private TablePageQuery _pageQuery = new() { PagingEnabled = true, Page = 1, PageSize = 20 };
    private string _keyword = string.Empty;
    private DateTime? _customStart;
    private DateTime? _customEnd;
    private long _startTime;
    private long _endTime;

    private readonly List<LoginLogItem> _loginItems = new();
    private readonly List<OperationLogItem> _operationItems = new();
    private readonly List<BackupLogItem> _backupItems = new();
    private readonly List<MailLogItem> _mailItems = new();
    private long _loginTotal;
    private long _operationTotal;
    private long _backupTotal;
    private long _mailTotal;
    private TablePager? _tablePager;

    protected override Task OnInitializedAsync()
    {
        SetRange("today");
        return Task.CompletedTask;
    }

    private bool IsTab(string tab) => string.Equals(_activeTab, tab, StringComparison.OrdinalIgnoreCase);
    private bool IsRange(string type) => string.Equals(_rangeType, type, StringComparison.OrdinalIgnoreCase);

    private string SearchPlaceholder => _activeTab switch
    {
        "login" => "搜索 IP / 用户ID / 地理位置 / 状态",
        "operation" => "搜索 IP / 用户ID / 类型 / 动作",
        "backup" => "搜索 状态 / 结果",
        "mail" => "搜索 标题 / 用户ID / 消息ID / 状态 / 原因",
        _ => "关键词搜索"
    };

    private async Task SetTabAsync(string tab)
    {
        if (IsTab(tab))
        {
            return;
        }

        _activeTab = tab;
        _keyword = string.Empty;
        if (_tablePager != null)
        {
            await _tablePager.SearchAsync();
            return;
        }

        _pageQuery = new TablePageQuery
        {
            PagingEnabled = _pageQuery.PagingEnabled,
            Page = 1,
            PageSize = _pageQuery.PageSize
        };
        await FetchAsync();
    }

    private void SetRange(string type)
    {
        _rangeType = type;
        if (type == "custom")
        {
            return;
        }

        var now = DateTime.Now;
        DateTime start = now;
        if (type == "today")
        {
            start = now.Date;
        }
        else if (type == "week")
        {
            start = now.AddDays(-7);
        }
        else if (type == "month")
        {
            start = now.AddDays(-30);
        }

        _startTime = new DateTimeOffset(start).ToUnixTimeSeconds();
        _endTime = new DateTimeOffset(now).ToUnixTimeSeconds();
    }

    private async Task ApplyRangeAsync(string type)
    {
        SetRange(type);
        if (_tablePager != null)
        {
            await _tablePager.SearchAsync();
            return;
        }

        _pageQuery = new TablePageQuery
        {
            PagingEnabled = _pageQuery.PagingEnabled,
            Page = 1,
            PageSize = _pageQuery.PageSize
        };
        await FetchAsync();
    }

    private async Task ApplyCustomRange()
    {
        if (_customStart.HasValue && _customEnd.HasValue)
        {
            _startTime = new DateTimeOffset(_customStart.Value).ToUnixTimeSeconds();
            _endTime = new DateTimeOffset(_customEnd.Value).ToUnixTimeSeconds();
            if (_tablePager != null)
            {
                await _tablePager.SearchAsync();
                return;
            }

            _pageQuery = new TablePageQuery
            {
                PagingEnabled = _pageQuery.PagingEnabled,
                Page = 1,
                PageSize = _pageQuery.PageSize
            };
            await FetchAsync();
        }
    }

    private async Task FetchAsync()
    {
        if (_loading)
        {
            return;
        }

        _loading = true;
        StateHasChanged();

        var query = new Dictionary<string, string?>
        {
            ["page"] = _pageQuery.Page.ToString(),
            ["pageSize"] = _pageQuery.PageSize.ToString(),
            ["keyword"] = _keyword
        };

        if (_startTime > 0)
        {
            query["start_time"] = _startTime.ToString();
        }

        if (_endTime > 0)
        {
            query["end_time"] = _endTime.ToString();
        }

        switch (_activeTab)
        {
            case "login":
                await LoadLoginAsync(query);
                break;
            case "operation":
                await LoadOperationAsync(query);
                break;
            case "backup":
                await LoadBackupAsync(query);
                break;
            case "mail":
                await LoadMailAsync(query);
                break;
        }

        _loading = false;
    }

    private async Task LoadLoginAsync(Dictionary<string, string?> query)
    {
        var response = await Api.GetAsync<LoginLogListResult>("logs/login", ApiScope.Admin, query);
        _loginItems.Clear();
        if (response?.Data?.List != null)
        {
            _loginItems.AddRange(response.Data.List);
            _loginTotal = response.Data.Total;
        }
        else
        {
            _loginTotal = 0;
        }
    }

    private async Task LoadOperationAsync(Dictionary<string, string?> query)
    {
        var response = await Api.GetAsync<OperationLogListResult>("logs/operation", ApiScope.Admin, query);
        _operationItems.Clear();
        if (response?.Data?.List != null)
        {
            _operationItems.AddRange(response.Data.List);
            _operationTotal = response.Data.Total;
        }
        else
        {
            _operationTotal = 0;
        }
    }

    private async Task LoadBackupAsync(Dictionary<string, string?> query)
    {
        var response = await Api.GetAsync<BackupLogListResult>("logs/backup", ApiScope.Admin, query);
        _backupItems.Clear();
        if (response?.Data?.List != null)
        {
            _backupItems.AddRange(response.Data.List);
            _backupTotal = response.Data.Total;
        }
        else
        {
            _backupTotal = 0;
        }
    }

    private async Task LoadMailAsync(Dictionary<string, string?> query)
    {
        var response = await Api.GetAsync<MailLogListResult>("logs/mail", ApiScope.Admin, query);
        _mailItems.Clear();
        if (response?.Data?.List != null)
        {
            _mailItems.AddRange(response.Data.List);
            _mailTotal = response.Data.Total;
        }
        else
        {
            _mailTotal = 0;
        }
    }

    private async Task SearchAsync()
    {
        if (_tablePager != null)
        {
            await _tablePager.SearchAsync();
            return;
        }

        _pageQuery = new TablePageQuery
        {
            PagingEnabled = _pageQuery.PagingEnabled,
            Page = 1,
            PageSize = _pageQuery.PageSize
        };
        await FetchAsync();
    }

    private Task OnPageQueryChangedAsync(TablePageQuery query)
    {
        _pageQuery = query;
        return FetchAsync();
    }

    private void TogglePagingDiagnostics()
    {
        _showPagingDiagnostics = !_showPagingDiagnostics;
    }

    private long CurrentTotal => _activeTab switch
    {
        "login" => _loginTotal,
        "operation" => _operationTotal,
        "backup" => _backupTotal,
        "mail" => _mailTotal,
        _ => 0
    };

    private int CurrentLoadedCount => _activeTab switch
    {
        "login" => _loginItems.Count,
        "operation" => _operationItems.Count,
        "backup" => _backupItems.Count,
        "mail" => _mailItems.Count,
        _ => 0
    };

    private static string FormatTime(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "-";
        }

        if (DateTime.TryParse(value, out var parsed))
        {
            return parsed.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");
        }

        return value;
    }

    private static string ResolveOpContent(OperationLogItem item)
    {
        if (!string.IsNullOrWhiteSpace(item.Content))
        {
            return item.Content;
        }

        if (!string.IsNullOrWhiteSpace(item.Description))
        {
            return item.Description;
        }

        return "-";
    }
}
