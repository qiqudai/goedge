﻿@using global::System.Text.Json
@using Cnn.Common.Contracts.Admin
@inject Cnn.Api.Services.ConfigItemClient ConfigClient

<div class="card config-card">
    <div class="card-header">维护升级</div>
    <div class="card-body">
        <div class="form-check form-switch mb-2">
            <InputCheckbox class="form-check-input" @bind-Value="_maintenanceEnabled" />
            <label class="form-check-label">系统维护模式</label>
            <div class="form-text">开启后，用户访问将显示维护页面</div>
        </div>

        <div class="mb-3">
            <label class="form-label">维护公告</label>
            <InputText class="form-control" @bind-Value="_maintenanceMessage" />
        </div>

        <hr />

        <div class="form-check form-switch mb-3">
            <InputCheckbox class="form-check-input" @bind-Value="_autoUpgradeAgent" />
            <label class="form-check-label">Agent自动升级</label>
            <div class="form-text">开启后，节点Agent将尝试自动升级到最新版本</div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">保存</button>
            @if (_saving)
            {
                <span class="text-muted">保存中...</span>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert @_messageClass mt-3">@_message</div>
        }
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<ConfigItemDto> Items { get; set; } = Array.Empty<ConfigItemDto>();
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool _maintenanceEnabled;
    private string _maintenanceMessage = string.Empty;
    private bool _autoUpgradeAgent = true;
    private bool _saving;
    private string? _message;
    private string _messageClass = "alert-success";

    protected override void OnParametersSet()
    {
        if (Items.Count == 0)
        {
            return;
        }

        var maintainValue = Items.FirstOrDefault(i => i.Name == "maintain")?.Value;
        if (!string.IsNullOrWhiteSpace(maintainValue))
        {
            try
            {
                var obj = JsonSerializer.Deserialize<MaintenancePayload>(maintainValue, new JsonSerializerOptions(JsonSerializerDefaults.Web));
                if (obj != null)
                {
                    _maintenanceEnabled = obj.Enable == 1;
                    _maintenanceMessage = obj.Msg ?? string.Empty;
                }
            }
            catch
            {
                _maintenanceEnabled = false;
                _maintenanceMessage = string.Empty;
            }
        }

        var autoUpgrade = Items.FirstOrDefault(i => i.Name == "auto_upgrade_agent")?.Value;
        _autoUpgradeAgent = autoUpgrade == "1" || autoUpgrade?.Equals("true", StringComparison.OrdinalIgnoreCase) == true;
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        _message = null;

        var payload = new List<ConfigItemPayloadDto>
        {
            new()
            {
                Name = "maintain",
                Value = JsonSerializer.Serialize(new MaintenancePayload
                {
                    Enable = _maintenanceEnabled ? 1 : 0,
                    Msg = _maintenanceMessage
                }, new JsonSerializerOptions(JsonSerializerDefaults.Web))
            },
            new()
            {
                Name = "auto_upgrade_agent",
                Value = _autoUpgradeAgent ? "1" : "0"
            }
        };

        var ok = await ConfigClient.SaveAsync("system", "global", 0, payload);
        _saving = false;

        if (ok)
        {
            SetMessage(true, "保存成功");
            if (OnSaved.HasDelegate)
            {
                await OnSaved.InvokeAsync();
            }
        }
        else
        {
            SetMessage(false, "保存失败");
        }
    }

    private void SetMessage(bool success, string message)
    {
        _message = message;
        _messageClass = success ? "alert-success" : "alert-danger";
    }

    private sealed class MaintenancePayload
    {
        public int Enable { get; set; }
        public string? Msg { get; set; }
    }
}
