@using Cnn.Common.Contracts.Admin
@inject Cnn.Api.Services.ConfigItemClient ConfigClient

<div class="card config-card">
    <div class="card-header">数据清理</div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">清缓存/解锁IP记录</label>
                <div class="input-group">
                    <InputText class="form-control" @bind-Value="_form.CleanCacheDays" inputmode="numeric" />
                    <span class="input-group-text">天</span>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label">登录记录</label>
                <div class="input-group">
                    <InputText class="form-control" @bind-Value="_form.CleanLoginLogDays" inputmode="numeric" />
                    <span class="input-group-text">天</span>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label">操作记录</label>
                <div class="input-group">
                    <InputText class="form-control" @bind-Value="_form.CleanOpLogDays" inputmode="numeric" />
                    <span class="input-group-text">天</span>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label">网站访问日志(ES)</label>
                <div class="input-group">
                    <InputText class="form-control" @bind-Value="_form.CleanSiteLogDays" inputmode="numeric" />
                    <span class="input-group-text">天</span>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label">访问日志下载记录</label>
                <div class="input-group">
                    <InputText class="form-control" @bind-Value="_form.CleanAccessDownloadLogDays" inputmode="numeric" />
                    <span class="input-group-text">天</span>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label">节点监控数据</label>
                <div class="input-group">
                    <InputText class="form-control" @bind-Value="_form.CleanNodeMonitorDays" inputmode="numeric" />
                    <span class="input-group-text">天</span>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label">流量带宽历史</label>
                <div class="input-group">
                    <InputText class="form-control" @bind-Value="_form.CleanTrafficDays" inputmode="numeric" />
                    <span class="input-group-text">天</span>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label">节点流量历史</label>
                <div class="input-group">
                    <InputText class="form-control" @bind-Value="_form.CleanNodeTrafficDays" inputmode="numeric" />
                    <span class="input-group-text">天</span>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label">IP黑名单清理</label>
                <div class="input-group">
                    <InputText class="form-control" @bind-Value="_form.CleanBlacklistDays" inputmode="numeric" />
                    <span class="input-group-text">天</span>
                </div>
            </div>
        </div>

        <hr class="my-4" />
        <h6 class="mb-3">数据备份</h6>

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">备份频率</label>
                <div class="input-group">
                    <InputText class="form-control" @bind-Value="_form.BackupFrequency" inputmode="numeric" />
                    <span class="input-group-text">天</span>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label">保留天数</label>
                <div class="input-group">
                    <InputText class="form-control" @bind-Value="_form.BackupRetention" inputmode="numeric" />
                    <span class="input-group-text">天</span>
                </div>
            </div>
            <div class="col-12">
                <label class="form-label">备份目录</label>
                <InputText class="form-control" @bind-Value="_form.BackupDir" />
                <div class="form-text">推荐使用阿里云备份本地数据库文件，参考 https://help.aliyun.com/document_detail/461008.html</div>
            </div>
        </div>

        <div class="mt-3 d-flex align-items-center gap-2">
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">保存</button>
            @if (_saving)
            {
                <span class="text-muted">保存中...</span>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert @_messageClass mt-3">@_message</div>
        }
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<ConfigItemDto> Items { get; set; } = Array.Empty<ConfigItemDto>();
    [Parameter] public EventCallback OnSaved { get; set; }

    private readonly CleaningForm _form = new();
    private bool _saving;
    private string? _message;
    private string _messageClass = "alert-success";

    private static readonly Dictionary<string, string> KeyMap = new()
    {
        [nameof(CleaningForm.CleanCacheDays)] = "keep-task-log-days",
        [nameof(CleaningForm.CleanLoginLogDays)] = "keep-login-log-days",
        [nameof(CleaningForm.CleanOpLogDays)] = "keep-op-log-days",
        [nameof(CleaningForm.CleanSiteLogDays)] = "keep-access-log-days",
        [nameof(CleaningForm.CleanAccessDownloadLogDays)] = "keep-access-download-log-days",
        [nameof(CleaningForm.CleanNodeMonitorDays)] = "keep-node-log-days",
        [nameof(CleaningForm.CleanTrafficDays)] = "keep-traffic-history-days",
        [nameof(CleaningForm.CleanNodeTrafficDays)] = "keep-node-traffic-days",
        [nameof(CleaningForm.CleanBlacklistDays)] = "keep-blacklist-days",
        [nameof(CleaningForm.BackupFrequency)] = "backup_rate",
        [nameof(CleaningForm.BackupRetention)] = "backup_keep_days",
        [nameof(CleaningForm.BackupDir)] = "backup_dir"
    };

    protected override void OnParametersSet()
    {
        if (Items.Count == 0)
        {
            return;
        }

        foreach (var item in Items)
        {
            var key = KeyMap.FirstOrDefault(x => x.Value == item.Name).Key;
            if (string.IsNullOrWhiteSpace(key))
            {
                continue;
            }

            var value = item.Value ?? string.Empty;
            switch (key)
            {
                case nameof(CleaningForm.BackupDir):
                    _form.BackupDir = value;
                    break;
                case nameof(CleaningForm.BackupFrequency):
                    _form.BackupFrequency = value;
                    break;
                case nameof(CleaningForm.BackupRetention):
                    _form.BackupRetention = value;
                    break;
                default:
                    SetNumericField(key, value);
                    break;
            }
        }
    }

    private void SetNumericField(string key, string value)
    {
        switch (key)
        {
            case nameof(CleaningForm.CleanCacheDays):
                _form.CleanCacheDays = value;
                break;
            case nameof(CleaningForm.CleanLoginLogDays):
                _form.CleanLoginLogDays = value;
                break;
            case nameof(CleaningForm.CleanOpLogDays):
                _form.CleanOpLogDays = value;
                break;
            case nameof(CleaningForm.CleanSiteLogDays):
                _form.CleanSiteLogDays = value;
                break;
            case nameof(CleaningForm.CleanAccessDownloadLogDays):
                _form.CleanAccessDownloadLogDays = value;
                break;
            case nameof(CleaningForm.CleanNodeMonitorDays):
                _form.CleanNodeMonitorDays = value;
                break;
            case nameof(CleaningForm.CleanTrafficDays):
                _form.CleanTrafficDays = value;
                break;
            case nameof(CleaningForm.CleanNodeTrafficDays):
                _form.CleanNodeTrafficDays = value;
                break;
            case nameof(CleaningForm.CleanBlacklistDays):
                _form.CleanBlacklistDays = value;
                break;
        }
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        _message = null;

        var payload = new List<ConfigItemPayloadDto>
        {
            new() { Name = KeyMap[nameof(CleaningForm.CleanCacheDays)], Value = _form.CleanCacheDays },
            new() { Name = KeyMap[nameof(CleaningForm.CleanLoginLogDays)], Value = _form.CleanLoginLogDays },
            new() { Name = KeyMap[nameof(CleaningForm.CleanOpLogDays)], Value = _form.CleanOpLogDays },
            new() { Name = KeyMap[nameof(CleaningForm.CleanSiteLogDays)], Value = _form.CleanSiteLogDays },
            new() { Name = KeyMap[nameof(CleaningForm.CleanAccessDownloadLogDays)], Value = _form.CleanAccessDownloadLogDays },
            new() { Name = KeyMap[nameof(CleaningForm.CleanNodeMonitorDays)], Value = _form.CleanNodeMonitorDays },
            new() { Name = KeyMap[nameof(CleaningForm.CleanTrafficDays)], Value = _form.CleanTrafficDays },
            new() { Name = KeyMap[nameof(CleaningForm.CleanNodeTrafficDays)], Value = _form.CleanNodeTrafficDays },
            new() { Name = KeyMap[nameof(CleaningForm.CleanBlacklistDays)], Value = _form.CleanBlacklistDays },
            new() { Name = KeyMap[nameof(CleaningForm.BackupFrequency)], Value = _form.BackupFrequency },
            new() { Name = KeyMap[nameof(CleaningForm.BackupRetention)], Value = _form.BackupRetention },
            new() { Name = KeyMap[nameof(CleaningForm.BackupDir)], Value = _form.BackupDir }
        };

        var ok = await ConfigClient.SaveAsync("system", "global", 0, payload);
        _saving = false;

        if (ok)
        {
            SetMessage(true, "保存成功");
            if (OnSaved.HasDelegate)
            {
                await OnSaved.InvokeAsync();
            }
        }
        else
        {
            SetMessage(false, "保存失败");
        }
    }

    private void SetMessage(bool success, string message)
    {
        _message = message;
        _messageClass = success ? "alert-success" : "alert-danger";
    }

    private sealed class CleaningForm
    {
        public string CleanCacheDays { get; set; } = "30";
        public string CleanLoginLogDays { get; set; } = "30";
        public string CleanOpLogDays { get; set; } = "365";
        public string CleanSiteLogDays { get; set; } = "7";
        public string CleanAccessDownloadLogDays { get; set; } = "30";
        public string CleanNodeMonitorDays { get; set; } = "7";
        public string CleanTrafficDays { get; set; } = "90";
        public string CleanNodeTrafficDays { get; set; } = "45";
        public string CleanBlacklistDays { get; set; } = "7";
        public string BackupFrequency { get; set; } = "2";
        public string BackupRetention { get; set; } = "7";
        public string BackupDir { get; set; } = "/data/backup/cdn/";
    }
}
