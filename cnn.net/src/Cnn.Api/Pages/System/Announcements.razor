@page "/system/announcements"
@using Cnn.Common.Contracts.Admin
@using Cnn.Api.Services
@inject ApiClient Api
@inject IJSRuntime Js

<div class="page-container">
    <div class="page-title">公告管理</div>

    <div class="filter-bar">
        <InputText class="form-control" style="max-width: 240px" @bind-Value="_keyword" placeholder="标题/内容" />
        <button class="btn btn-primary" @onclick="SearchAsync">搜索</button>
        <button class="btn btn-success" @onclick="OpenCreate">新增公告</button>
        <button class="btn btn-outline-secondary" @onclick="TogglePagingDiagnostics">
            @(_showPagingDiagnostics ? "隐藏分页诊断" : "显示分页诊断")
        </button>
    </div>

    @if (_showPagingDiagnostics)
    {
        <div class="alert alert-light py-2 px-3 mt-2 mb-2 small">
            <div><strong>分页诊断</strong></div>
            <div>stateKey: <code>system:announcements:table</code></div>
            <div>pagingEnabled: <code>@(_pageQuery.PagingEnabled ? "true" : "false")</code></div>
            <div>page: <code>@_pageQuery.Page</code>, pageSize: <code>@_pageQuery.PageSize</code></div>
            <div>loaded: <code>@_items.Count</code>, total: <code>@_total</code></div>
        </div>
    }

    <TablePager @ref="_tablePager"
                StateKey="system:announcements:table"
                Total="_total"
                DefaultPageSize="20"
                UnpagedLimit="1000"
                QueryChanged="OnPageQueryChangedAsync">
        <ChildContent>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>标题</th>
                            <th>创建时间</th>
                            <th>状态</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_loading)
                        {
                            <tr><td colspan="5">加载中...</td></tr>
                        }
                        else if (_items.Count == 0)
                        {
                            <tr><td colspan="5">暂无数据</td></tr>
                        }
                        else
                        {
                            @foreach (var item in _items)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.Title</td>
                                    <td>@item.CreatedAt</td>
                                    <td>
                                        <span class="badge @(item.IsShow ? "bg-success" : "bg-secondary")">@(item.IsShow ? "显示" : "隐藏")</span>
                                    </td>
                                    <td>
                                        <button class="btn btn-link btn-sm" @onclick="() => OpenEdit(item)">编辑</button>
                                        <button class="btn btn-link btn-sm text-danger" @onclick="() => RemoveAsync(item)">删除</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </ChildContent>
    </TablePager>
</div>

@if (_editorVisible)
{
    <div class="modal-backdrop">
        <div class="modal-panel">
            <div class="modal-header">
                <h5>@(_editor.Id > 0 ? "编辑公告" : "新增公告")</h5>
                <button class="btn-close" @onclick="CloseEditor"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">标题</label>
                    <InputText class="form-control" @bind-Value="_editor.Title" />
                </div>
                <div class="mb-3">
                    <label class="form-label">内容</label>
                    <InputTextArea class="form-control" rows="6" @bind-Value="_editor.Content" />
                </div>
                <div class="form-check form-switch mb-2">
                    <InputCheckbox class="form-check-input" @bind-Value="_editor.IsShow" />
                    <label class="form-check-label">显示</label>
                </div>
                <div class="form-check form-switch mb-2">
                    <InputCheckbox class="form-check-input" @bind-Value="_editor.IsRed" />
                    <label class="form-check-label">红色</label>
                </div>
                <div class="form-check form-switch mb-2">
                    <InputCheckbox class="form-check-input" @bind-Value="_editor.IsBold" />
                    <label class="form-check-label">加粗</label>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-end gap-2">
                <button class="btn btn-secondary" @onclick="CloseEditor">取消</button>
                <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">保存</button>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<AnnouncementItemDto> _items = new();
    private bool _loading;
    private bool _showPagingDiagnostics;
    private TablePageQuery _pageQuery = new() { PagingEnabled = true, Page = 1, PageSize = 20 };
    private long _total;
    private string _keyword = string.Empty;
    private TablePager? _tablePager;

    private bool _editorVisible;
    private bool _saving;
    private AnnouncementEditor _editor = new();

    protected override Task OnInitializedAsync() => Task.CompletedTask;

    private async Task LoadAsync()
    {
        if (_loading)
        {
            return;
        }

        _loading = true;
        var query = new Dictionary<string, string?>
        {
            ["page"] = _pageQuery.Page.ToString(),
            ["pageSize"] = _pageQuery.PageSize.ToString(),
            ["keyword"] = _keyword
        };

        var response = await Api.GetAsync<AnnouncementListResult>("announcements", ApiScope.Admin, query);
        _items.Clear();
        if (response?.Data?.List != null)
        {
            _items.AddRange(response.Data.List);
            _total = response.Data.Total;
        }
        else
        {
            _total = 0;
        }

        _loading = false;
    }

    private async Task SearchAsync()
    {
        if (_tablePager != null)
        {
            await _tablePager.SearchAsync();
            return;
        }

        _pageQuery = new TablePageQuery
        {
            PagingEnabled = _pageQuery.PagingEnabled,
            Page = 1,
            PageSize = _pageQuery.PageSize
        };
        await LoadAsync();
    }

    private Task RefreshAsync()
    {
        if (_tablePager != null)
        {
            return _tablePager.RefreshAsync();
        }

        return LoadAsync();
    }

    private void OpenCreate()
    {
        _editor = new AnnouncementEditor
        {
            Id = 0,
            Title = string.Empty,
            Content = string.Empty,
            IsShow = true,
            IsRed = false,
            IsBold = false
        };
        _editorVisible = true;
    }

    private void OpenEdit(AnnouncementItemDto item)
    {
        _editor = new AnnouncementEditor
        {
            Id = item.Id,
            Title = item.Title ?? string.Empty,
            Content = item.Content ?? string.Empty,
            IsShow = item.IsShow,
            IsRed = item.IsRed,
            IsBold = item.IsBold
        };
        _editorVisible = true;
    }

    private void CloseEditor()
    {
        _editorVisible = false;
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        var payload = new AnnouncementUpsertRequest
        {
            Title = _editor.Title,
            Content = _editor.Content,
            IsShow = _editor.IsShow,
            IsRed = _editor.IsRed,
            IsBold = _editor.IsBold
        };

        if (_editor.Id > 0)
        {
            await Api.PutAsync<object>($"announcements/{_editor.Id}", payload, ApiScope.Admin);
        }
        else
        {
            await Api.PostAsync<object>("announcements", payload, ApiScope.Admin);
        }

        _saving = false;
        _editorVisible = false;
        await RefreshAsync();
    }

    private async Task RemoveAsync(AnnouncementItemDto item)
    {
        var ok = await Js.InvokeAsync<bool>("confirm", "确定删除该公告？");
        if (!ok)
        {
            return;
        }

        await Api.DeleteAsync<object>($"announcements/{item.Id}", null, ApiScope.Admin);
        await RefreshAsync();
    }

    private Task OnPageQueryChangedAsync(TablePageQuery query)
    {
        _pageQuery = query;
        return LoadAsync();
    }

    private void TogglePagingDiagnostics()
    {
        _showPagingDiagnostics = !_showPagingDiagnostics;
    }

    private sealed class AnnouncementEditor
    {
        public long Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Content { get; set; } = string.Empty;
        public bool IsShow { get; set; }
        public bool IsRed { get; set; }
        public bool IsBold { get; set; }
    }
}
