@page "/system/config"
@using Cnn.Common.Contracts.Admin
@using Cnn.Api.Pages.System.Config
@inject Cnn.Api.Services.ConfigItemClient ConfigClient

<div class="page-container">
    <div class="page-title">系统配置</div>

    <div class="tab-bar">
        <button class='tab-button @(IsActive("system") ? "active" : "")' @onclick='@(() => SetTabAsync("system"))'>系统配置</button>
        <button class='tab-button @(IsActive("cleaning") ? "active" : "")' @onclick='@(() => SetTabAsync("cleaning"))'>数据清理</button>
        <button class='tab-button @(IsActive("user") ? "active" : "")' @onclick='@(() => SetTabAsync("user"))'>用户相关</button>
        <button class='tab-button @(IsActive("notify") ? "active" : "")' @onclick='@(() => SetTabAsync("notify"))'>通知配置</button>
        <button class='tab-button @(IsActive("other") ? "active" : "")' @onclick='@(() => SetTabAsync("other"))'>其它配置</button>
    </div>

    @if (_loading)
    {
        <div class="card">加载中...</div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }
    else
    {
        <div class="tab-content">
            @if (_activeTab == "system")
            {
                <SystemConfigBasic Items="_items" OnSaved="LoadAsync" />
                <SystemConfigPackage Items="_items" OnSaved="LoadAsync" />
                <SystemConfigMaintenance Items="_items" OnSaved="LoadAsync" />
            }
            else if (_activeTab == "cleaning")
            {
                <SystemConfigCleaning Items="_items" OnSaved="LoadAsync" />
            }
            else if (_activeTab == "user")
            {
                <SystemConfigUser Items="_items" OnSaved="LoadAsync" />
            }
            else if (_activeTab == "notify")
            {
                <SystemConfigNotify Items="_items" OnSaved="LoadAsync" />
            }
            else if (_activeTab == "other")
            {
                <SystemConfigOther Items="_items" OnSaved="LoadAsync" />
            }
        </div>
    }
</div>

@code {
    private string _activeTab = "system";
    private bool _loading;
    private string? _error;
    private IReadOnlyList<ConfigItemDto> _items = Array.Empty<ConfigItemDto>();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private bool IsActive(string tab) => string.Equals(_activeTab, tab, StringComparison.OrdinalIgnoreCase);

    private async Task SetTabAsync(string tab)
    {
        if (IsActive(tab))
        {
            return;
        }

        _activeTab = tab;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            _items = await ConfigClient.GetAsync("system");
        }
        catch
        {
            _error = "加载系统配置失败";
        }
        finally
        {
            _loading = false;
        }
    }
}
