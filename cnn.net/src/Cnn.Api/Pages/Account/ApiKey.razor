@page "/account/apikey"
@using Cnn.Common.Contracts
@inject ApiClient Api
@inject IJSRuntime Js

<div class="page-container">
    <div class="page-title">API密钥</div>

    <div class="card config-card p-3">
        @if (_loading)
        {
            <div>加载中...</div>
        }
        else if (_data == null)
        {
            <div>未获取到API密钥</div>
        }
        else
        {
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">API Key</label>
                    <div class="input-group">
                        <InputText class="form-control" value="@_data.ApiKey" readonly />
                        <button class="btn btn-outline-secondary" type="button" @onclick="() => CopyAsync(_data.ApiKey)">复制</button>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">API Secret</label>
                    <div class="input-group">
                        <InputText class="form-control" value="@_data.ApiSecret" readonly />
                        <button class="btn btn-outline-secondary" type="button" @onclick="() => CopyAsync(_data.ApiSecret)">复制</button>
                    </div>
                </div>
                <div class="col-md-12">
                    <label class="form-label">IP白名单</label>
                    <InputTextArea class="form-control" @bind-Value="_apiIp" rows="4" placeholder="多个IP换行分隔" />
                </div>
            </div>

            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">保存</button>
                <button class="btn btn-outline-danger" @onclick="ResetSecretAsync" disabled="@_saving">重置密钥</button>
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert alert-info mt-3">@_message</div>
    }
</div>

@code {
    private ApiKeyDto? _data;
    private bool _loading;
    private bool _saving;
    private string _apiIp = string.Empty;
    private string _message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var response = await Api.GetAsync<ApiKeyDto>("api_key", ApiScope.User);
        _data = response?.Data;
        _apiIp = _data?.ApiIp ?? string.Empty;
        _loading = false;
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        var request = new ApiKeyUpdateRequest { ApiIp = _apiIp };
        var response = await Api.PutAsync<bool>("api_key", request, ApiScope.User);
        _message = response?.Message ?? "保存完成";
        _saving = false;
        await LoadAsync();
    }

    private async Task ResetSecretAsync()
    {
        if (_saving)
        {
            return;
        }

        var confirmed = await Js.InvokeAsync<bool>("confirm", "确定要重置 API 密钥吗？重置后旧密钥将立即失效。");
        if (!confirmed)
        {
            return;
        }

        _saving = true;
        var response = await Api.PostAsync<ApiKeySecretDto>("api_key/reset", null, ApiScope.User);
        if (response?.Data != null && _data != null)
        {
            _data.ApiSecret = response.Data.ApiSecret;
        }
        _message = response?.Message ?? "已重置";
        _saving = false;
    }

    private async Task CopyAsync(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", text);
            _message = "已复制到剪贴板";
        }
        catch
        {
            _message = "复制失败";
        }
    }
}

