@page "/account/subscribe"
@using Cnn.Common.Contracts
@inject ApiClient Api

<div class="page-container">
    <div class="page-title">消息订阅</div>

    <div class="card config-card p-3">
        @if (_loading)
        {
            <div>加载中...</div>
        }
        else if (_items.Count == 0)
        {
            <div>暂无订阅类型</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>类型</th>
                            <th>名称</th>
                            <th>短信</th>
                            <th>邮件</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _items)
                        {
                            <tr>
                                <td>@item.MsgType</td>
                                <td>@item.Name</td>
                                <td>
                                    <input type="checkbox" class="form-check-input" checked="@item.Phone" @onchange="e => TogglePhone(item, e)" />
                                </td>
                                <td>
                                    <input type="checkbox" class="form-check-input" checked="@item.Email" @onchange="e => ToggleEmail(item, e)" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">保存设置</button>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert alert-info mt-3">@_message</div>
    }
</div>

@code {
    private readonly List<MessageSubItemDto> _items = new();
    private bool _loading;
    private bool _saving;
    private string _message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var response = await Api.GetAsync<MessageSubListResult>("message_sub", ApiScope.User);
        _items.Clear();
        if (response?.Data?.List != null)
        {
            _items.AddRange(response.Data.List);
        }
        _loading = false;
    }

    private void TogglePhone(MessageSubItemDto item, ChangeEventArgs args)
    {
        item.Phone = args.Value?.ToString() == "true" || args.Value?.ToString() == "on";
    }

    private void ToggleEmail(MessageSubItemDto item, ChangeEventArgs args)
    {
        item.Email = args.Value?.ToString() == "true" || args.Value?.ToString() == "on";
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        var request = new MessageSubUpdateRequest
        {
            List = _items.Select(item => new MessageSubUpdateItem
            {
                MsgType = item.MsgType,
                Phone = item.Phone,
                Email = item.Email
            }).ToList()
        };

        var response = await Api.PutAsync<object>("message_sub", request, ApiScope.User);
        _message = response?.Message ?? "保存完成";
        _saving = false;
    }
}

