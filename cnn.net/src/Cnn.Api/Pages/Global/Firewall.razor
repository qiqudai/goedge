@page "/global/firewall"
@using Cnn.Common.Contracts.Admin
@inject ApiClient Api

<div class="page-container firewall-page">
    <div class="page-title">防火墙全局配置 (WAF)</div>

    <div class="tab-bar">
        <button class='tab-button @(IsTab("basic") ? "active" : "")' @onclick='@(() => SetTab("basic"))'>基础防护 & 拉黑策略</button>
        <button class='tab-button @(IsTab("access") ? "active" : "")' @onclick='@(() => SetTab("access"))'>安全控制 & 名单</button>
        <button class='tab-button @(IsTab("cc") ? "active" : "")' @onclick='@(() => SetTab("cc"))'>CC 防护 & 验证</button>
        <button class='tab-button @(IsTab("advanced") ? "active" : "")' @onclick='@(() => SetTab("advanced"))'>高级防护 & 系统</button>
    </div>

    @if (_loading)
    {
        <div class="card config-card">加载中...</div>
    }
    else
    {
        <div class="card config-card">
            <div class="card-body">
                @if (_activeTab == "basic")
                {
                    <div class="section">
                        <div class="section-title">全局 WAF 开启</div>
                        <div class="form-check form-switch">
                            <InputCheckbox class="form-check-input" @bind-Value="Waf.Enable" @onchange="QueueSaveAsync" />
                            <label class="form-check-label">开启</label>
                        </div>
                    </div>

                    <div class="section">
                        <div class="section-title">默认拉黑方式</div>
                        <InputRadioGroup @bind-Value="Waf.DefaultBlockAction" @bind-Value:after="QueueSaveAsync">
                            <label class="form-check">
                                <InputRadio class="form-check-input" Value='@("ipset")' />
                                <span class="form-check-label">IPSet (系统防火墙)</span>
                            </label>
                            <label class="form-check">
                                <InputRadio class="form-check-input" Value='@("disconnect")' />
                                <span class="form-check-label">断开连接</span>
                            </label>
                            <label class="form-check">
                                <InputRadio class="form-check-input" Value='@("page")' />
                                <span class="form-check-label">显示拦截页面</span>
                            </label>
                        </InputRadioGroup>
                        <div class="form-text">建议默认选非 IPSet 方式，配合自动 IPSet 切换使用。</div>
                    </div>

                    <div class="section">
                        <div class="section-title">IPSet 自动切换</div>
                        <div class="form-check form-switch">
                            <InputCheckbox class="form-check-input" @bind-Value="Waf.AutoIpSetEnable" @onchange="QueueSaveAsync" />
                            <label class="form-check-label">自动启用 IPSet</label>
                        </div>
                        @if (Waf.AutoIpSetEnable)
                        {
                            <div class="form-row">
                                <label class="form-label">触发阈值</label>
                                <InputNumber class="form-control" @bind-Value="Waf.AutoIpSetThreshold" @onblur="QueueSaveAsync" />
                                <span class="unit">次/秒</span>
                                <div class="form-text">当单站每秒拉黑次数超过阈值时，自动升级为 IPSet 拉黑。</div>
                            </div>
                        }
                    </div>

                    <div class="section">
                        <div class="section-title">拉黑页面限制 (防刷)</div>
                        <div class="form-check form-switch">
                            <InputCheckbox class="form-check-input" @bind-Value="Waf.BlockPageRateLimitEnable" @onchange="QueueSaveAsync" />
                            <label class="form-check-label">限制访问频率</label>
                        </div>
                        @if (Waf.BlockPageRateLimitEnable)
                        {
                            <div class="form-row">
                                <label class="form-label">频率阈值</label>
                                <InputNumber class="form-control" @bind-Value="Waf.BlockPageRateLimit" @onblur="QueueSaveAsync" />
                                <span class="unit">次/60秒</span>
                                <div class="form-text">单 IP 访问拉黑页面超过此频率，直接升级 IPSet 拉黑。</div>
                            </div>
                        }
                        <div class="form-check form-switch mt-2">
                            <InputCheckbox class="form-check-input" @bind-Value="Waf.BlockPageTrafficFree" @onchange="QueueSaveAsync" />
                            <label class="form-check-label">拉黑页不计流量</label>
                        </div>
                    </div>

                    <div class="section">
                        <div class="section-title">封禁与白名单时长</div>
                        <div class="form-row">
                            <label class="form-label">黑名单封禁时长</label>
                            <InputNumber class="form-control" @bind-Value="Waf.BlacklistTimeout" @onblur="QueueSaveAsync" />
                            <span class="unit">秒</span>
                        </div>
                        <div class="form-row">
                            <label class="form-label">临时白名单时长</label>
                            <InputNumber class="form-control" @bind-Value="Waf.TempWhitelistTimeout" @onblur="QueueSaveAsync" />
                            <span class="unit">秒</span>
                        </div>
                    </div>

                    <div class="section">
                        <div class="section-title">临时白名单自动加入条件(5秒内)</div>
                        <div class="form-row">
                            <label class="form-label">总请求数限制</label>
                            <InputNumber class="form-control" @bind-Value="Waf.TempWhitelistLimitTotal" @onblur="QueueSaveAsync" />
                        </div>
                        <div class="form-row">
                            <label class="form-label">同URL请求限制</label>
                            <InputNumber class="form-control" @bind-Value="Waf.TempWhitelistLimitUrl" @onblur="QueueSaveAsync" />
                        </div>
                    </div>
                }
                else if (_activeTab == "access")
                {
                    <div class="section">
                        <div class="section-title">黑白名单 (一行一个，支持 CIDR)</div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">白名单 IP</label>
                                <InputTextArea class="form-control" rows="10" @bind-Value="Waf.WhitelistIps" @onblur="QueueSaveAsync" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">黑名单 IP</label>
                                <InputTextArea class="form-control" rows="10" @bind-Value="Waf.BlacklistIps" @onblur="QueueSaveAsync" />
                            </div>
                        </div>
                    </div>

                    <div class="section">
                        <div class="section-title">系统安全</div>
                        <div class="form-check form-switch">
                            <InputCheckbox class="form-check-input" @bind-Value="Waf.PreventTlsHandshake" @onchange="QueueSaveAsync" />
                            <label class="form-check-label">防止 TLS 握手攻击</label>
                        </div>
                        <div class="form-check form-switch mt-2">
                            <InputCheckbox class="form-check-input" @bind-Value="Waf.BlockUnboundDomain" @onchange="QueueSaveAsync" />
                            <label class="form-check-label">禁止未绑定域名访问</label>
                            <span class="form-text">禁止直接通过节点 IP 访问。</span>
                        </div>
                        <div class="form-check form-switch mt-2">
                            <InputCheckbox class="form-check-input" @bind-Value="Waf.DisablePing" @onchange="QueueSaveAsync" />
                            <label class="form-check-label">禁止 PING</label>
                        </div>
                    </div>
                }
                else if (_activeTab == "cc")
                {
                    <div class="section">
                        <div class="section-title">默认页防护</div>
                        <InputRadioGroup @bind-Value="Waf.DefaultPageProtection" @bind-Value:after="QueueSaveAsync">
                            <label class="form-check">
                                <InputRadio class="form-check-input" Value='@("force")' />
                                <span class="form-check-label">强制开启</span>
                            </label>
                            <label class="form-check">
                                <InputRadio class="form-check-input" Value='@("auto")' />
                                <span class="form-check-label">自动开启</span>
                            </label>
                        </InputRadioGroup>
                        @if (string.Equals(Waf.DefaultPageProtection, "auto", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="form-row">
                                <label class="form-label">自动开启阈值</label>
                                <InputNumber class="form-control" @bind-Value="Waf.DefaultPageProtectionThreshold" @onblur="QueueSaveAsync" />
                                <span class="unit">请求/秒</span>
                            </div>
                        }
                    </div>

                    <div class="section">
                        <div class="section-title">反 CC 页面设置</div>
                        <div class="form-row">
                            <label class="form-label">验证方式</label>
                            <select class="form-select" @bind="Waf.AntiCcType" @bind:after="QueueSaveAsync">
                                <option value="slide">滑动验证</option>
                                <option value="click">点击验证</option>
                                <option value="5s">5秒盾 (自动跳转)</option>
                                <option value="rotate">图片旋转</option>
                                <option value="slide_simple">简单滑动</option>
                            </select>
                        </div>
                        <div class="form-row">
                            <label class="form-label">验证图片来源</label>
                            <InputRadioGroup @bind-Value="Waf.AntiCcImageSource" @bind-Value:after="QueueSaveAsync">
                                <label class="form-check">
                                    <InputRadio class="form-check-input" Value='@("system")' />
                                    <span class="form-check-label">系统默认</span>
                                </label>
                                <label class="form-check">
                                    <InputRadio class="form-check-input" Value='@("custom")' />
                                    <span class="form-check-label">自定义 URL</span>
                                </label>
                            </InputRadioGroup>
                        </div>
                        @if (string.Equals(Waf.AntiCcImageSource, "custom", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="form-row">
                                <label class="form-label">图片 URL</label>
                                <InputText class="form-control" @bind-Value="Waf.AntiCcImageCustomUrl" @onblur="QueueSaveAsync" />
                            </div>
                        }
                        <div class="form-check form-switch mt-2">
                            <InputCheckbox class="form-check-input" @bind-Value="Waf.AntiCcDebug" @onchange="QueueSaveAsync" />
                            <label class="form-check-label">开启调试日志</label>
                        </div>
                    </div>

                    <div class="section">
                        <div class="section-title">规则设置</div>
                        <div class="form-check form-switch">
                            <InputCheckbox class="form-check-input" @bind-Value="Waf.CcRuleAutoSwitch" @onchange="QueueSaveAsync" />
                            <label class="form-check-label">CC 规则自动切换</label>
                        </div>
                    </div>
                }
                else
                {
                    <div class="section">
                        <div class="section-title">系统配置</div>
                        <div class="form-row">
                            <label class="form-label">通讯密钥</label>
                            <InputText class="form-control" type="password" @bind-Value="Waf.SecretKey" @onblur="QueueSaveAsync" />
                        </div>
                        <div class="form-row">
                            <label class="form-label">节点日志清理</label>
                            <select class="form-select" @bind="Waf.NodeLogCleanStrategy" @bind:after="QueueSaveAsync">
                                <option value="none">不清理</option>
                                <option value="log_only">仅清理日志</option>
                                <option value="log_cache">清理日志和缓存</option>
                            </select>
                            <span class="form-text">当节点空间不足时触发。</span>
                        </div>
                    </div>

                    <div class="section">
                        <div class="section-title">特殊路径防护 (.well-known)</div>
                        <div class="form-row">
                            <label class="form-label">404 阈值</label>
                            <InputNumber class="form-control" @bind-Value="Waf.WellKnownProtectionThreshold" @onblur="QueueSaveAsync" />
                            <span class="unit">次/60秒</span>
                            <div class="form-text">超过阈值 IP 将不再回源 300 秒（防止 ACME 验证泛滥）。</div>
                        </div>
                    </div>

                    <div class="section">
                        <div class="section-title">内置资源防护 (防CC图片/JS)</div>
                        <div class="form-check form-switch">
                            <InputCheckbox class="form-check-input" @bind-Value="Waf.ResourceProtectionEnable" @onchange="QueueSaveAsync" />
                            <label class="form-check-label">开启防护</label>
                        </div>
                        <div class="form-row">
                            <label class="form-label">开启阈值</label>
                            <InputNumber class="form-control" @bind-Value="Waf.ResourceProtectionThreshold" @onblur="QueueSaveAsync" />
                            <span class="unit">QPS</span>
                        </div>
                        <div class="form-row">
                            <label class="form-label">拉黑时长</label>
                            <InputNumber class="form-control" @bind-Value="Waf.ResourceProtectionBlockTimeout" @onblur="QueueSaveAsync" />
                            <span class="unit">秒</span>
                        </div>

                        <div class="form-row">
                            <label class="form-label">限流规则</label>
                            <div class="table-responsive">
                                <table class="table table-sm table-striped">
                                    <thead>
                                        <tr>
                                            <th style="width: 160px">统计时长(秒)</th>
                                            <th style="width: 160px">最大请求数</th>
                                            <th>操作</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (_resourceRules.Count == 0)
                                        {
                                            <tr><td colspan="3">暂无规则</td></tr>
                                        }
                                        else
                                        {
                                            @for (var i = 0; i < _resourceRules.Count; i++)
                                            {
                                                var rule = _resourceRules[i];
                                                <tr>
                                                    <td>
                                                        <InputNumber class="form-control form-control-sm" @bind-Value="rule.Duration" @onblur="QueueSaveAsync" />
                                                    </td>
                                                    <td>
                                                        <InputNumber class="form-control form-control-sm" @bind-Value="rule.MaxRequests" @onblur="QueueSaveAsync" />
                                                    </td>
                                                    <td>
                                                        <button class="btn btn-link btn-sm text-danger" type="button" @onclick='@(() => RemoveRule(i))'>删除</button>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <button class="btn btn-outline-primary btn-sm" type="button" @onclick="AddRule">+ 添加规则</button>
                        </div>
                    </div>
                }

                <div class="mt-3 d-flex align-items-center gap-2">
                    <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">保存</button>
                    @if (_saving)
                    {
                        <span class="text-muted">保存中...</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <div class="alert @_messageClass mt-3">@_message</div>
                }
            </div>
        </div>
    }
</div>

@code {
    private bool _loading;
    private bool _saving;
    private bool _saveQueued;
    private string _activeTab = "basic";
    private string? _message;
    private string _messageClass = "alert-success";

    private GlobalConfigDto _config = new();
    private readonly List<ResourceRuleEdit> _resourceRules = new();

    private WafConfigDto Waf
    {
        get
        {
            if (_config.Waf == null)
            {
                _config.Waf = CreateDefaultWaf();
            }

            return _config.Waf;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_loading)
        {
            return;
        }

        _loading = true;
        var response = await Api.GetAsync<GlobalConfigDto>("global_config", ApiScope.Admin);
        _config = response?.Data ?? new GlobalConfigDto();
        EnsureDefaults();
        _loading = false;
    }

    private void EnsureDefaults()
    {
        if (_config.Waf == null)
        {
            _config.Waf = CreateDefaultWaf();
        }

        _config.Waf.ResourceProtectionRules ??= new List<ResourceRuleDto>();
        _resourceRules.Clear();
        foreach (var rule in _config.Waf.ResourceProtectionRules)
        {
            _resourceRules.Add(new ResourceRuleEdit { Duration = rule.Duration, MaxRequests = rule.MaxRequests });
        }
    }

    private static WafConfigDto CreateDefaultWaf()
    {
        return new WafConfigDto
        {
            Enable = false,
            DefaultBlockAction = "disconnect",
            AutoIpSetEnable = false,
            AutoIpSetThreshold = 60,
            BlockPageRateLimitEnable = false,
            BlockPageRateLimit = 60,
            BlockPageTrafficFree = false,
            BlacklistTimeout = 3600,
            TempWhitelistTimeout = 300,
            TempWhitelistLimitTotal = 20,
            TempWhitelistLimitUrl = 10,
            WhitelistIps = string.Empty,
            BlacklistIps = string.Empty,
            PreventTlsHandshake = false,
            BlockUnboundDomain = false,
            DisablePing = false,
            DefaultPageProtection = "auto",
            DefaultPageProtectionThreshold = 200,
            AntiCcType = "slide",
            AntiCcImageSource = "system",
            AntiCcImageCustomUrl = string.Empty,
            AntiCcDebug = false,
            CcRuleAutoSwitch = false,
            SecretKey = string.Empty,
            NodeLogCleanStrategy = "none",
            WellKnownProtectionThreshold = 60,
            ResourceProtectionEnable = false,
            ResourceProtectionThreshold = 200,
            ResourceProtectionBlockTimeout = 300,
            ResourceProtectionRules = new List<ResourceRuleDto>()
        };
    }

    private bool IsTab(string tab) => string.Equals(_activeTab, tab, StringComparison.OrdinalIgnoreCase);

    private void SetTab(string tab)
    {
        _activeTab = tab;
    }

    private void AddRule()
    {
        _resourceRules.Add(new ResourceRuleEdit { Duration = 60, MaxRequests = 100 });
        _ = QueueSaveAsync();
    }

    private void RemoveRule(int index)
    {
        if (index < 0 || index >= _resourceRules.Count)
        {
            return;
        }

        _resourceRules.RemoveAt(index);
        _ = QueueSaveAsync();
    }

    private async Task QueueSaveAsync()
    {
        if (_saving)
        {
            _saveQueued = true;
            return;
        }

        await SaveAsync();

        if (_saveQueued)
        {
            _saveQueued = false;
            await SaveAsync();
        }
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            _saveQueued = true;
            return;
        }

        _saving = true;
        _message = null;

        _config.Waf ??= CreateDefaultWaf();
        _config.Waf.ResourceProtectionRules = _resourceRules
            .Select(rule => new ResourceRuleDto(rule.Duration, rule.MaxRequests))
            .ToList();

        var response = await Api.PostAsync<object>("global_config", _config, ApiScope.Admin);
        _saving = false;

        if (response != null && (response.Code == 0 || response.Code == 200))
        {
            SetMessage(true, "WAF 配置已保存");
        }
        else
        {
            SetMessage(false, response?.Message ?? "保存失败");
        }
    }

    private void SetMessage(bool success, string message)
    {
        _message = message;
        _messageClass = success ? "alert-success" : "alert-danger";
    }

    private sealed class ResourceRuleEdit
    {
        public int Duration { get; set; }
        public int MaxRequests { get; set; }
    }
}
