@using Cnn.Common.Contracts.Admin
@inject ApiClient Api

<div class="card config-card default-cache">
    <div class="card-header">缓存默认配置</div>
    <div class="card-body">
        <div class="tab-bar sub-tabs">
            <button class='tab-button @(IsTab("website") ? "active" : "")' @onclick='@(() => SetTab("website"))'>网站默认配置</button>
            <button class='tab-button @(IsTab("api") ? "active" : "")' @onclick='@(() => SetTab("api"))'>API 默认配置</button>
            <button class='tab-button @(IsTab("download") ? "active" : "")' @onclick='@(() => SetTab("download"))'>下载默认配置</button>
        </div>

        @if (_loading)
        {
            <div>加载中...</div>
        }
        else
        {
            <div class="form-row">
                <label class="form-label">缓存开关</label>
                <InputCheckbox class="form-check-input" @bind-Value="CurrentTemplate.CacheEnable" @onchange="QueueSaveAsync" />
            </div>
            <div class="form-row">
                <label class="form-label">缓存 TTL (秒)</label>
                <InputNumber class="form-control" @bind-Value="CurrentTemplate.CacheTtl" @onblur="QueueSaveAsync" />
            </div>
            <div class="form-row">
                <label class="form-label">开启 Gzip</label>
                <InputCheckbox class="form-check-input" @bind-Value="CurrentTemplate.Gzip" @onchange="QueueSaveAsync" />
            </div>
            <div class="form-row">
                <label class="form-label">开启 WAF</label>
                <InputCheckbox class="form-check-input" @bind-Value="CurrentTemplate.WafEnable" @onchange="QueueSaveAsync" />
            </div>
        }

        <div class="mt-3 d-flex align-items-center gap-2">
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">保存</button>
            @if (_saving)
            {
                <span class="text-muted">保存中...</span>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert @_messageClass mt-3">@_message</div>
        }
    </div>
</div>

@code {
    private bool _loading;
    private bool _saving;
    private bool _saveQueued;
    private string _activeTab = "website";
    private string? _message;
    private string _messageClass = "alert-success";

    private GlobalConfigDto _config = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private bool IsTab(string tab) => string.Equals(_activeTab, tab, StringComparison.OrdinalIgnoreCase);

    private async Task SetTab(string tab)
    {
        _activeTab = tab;
        await LoadAsync();
    }

    private SiteTemplateDto CurrentTemplate
    {
        get
        {
            var defaults = EnsureDefaults();
            return _activeTab switch
            {
                "api" => defaults.Api!,
                "download" => defaults.Download!,
                _ => defaults.Website!
            };
        }
    }

    private DefaultSiteConfigDto EnsureDefaults()
    {
        _config.DefaultConfig ??= new DefaultSiteConfigDto();
        _config.DefaultConfig.Website ??= new SiteTemplateDto();
        _config.DefaultConfig.Api ??= new SiteTemplateDto();
        _config.DefaultConfig.Download ??= new SiteTemplateDto();
        return _config.DefaultConfig;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _message = null;

        var response = await Api.GetAsync<GlobalConfigDto>("global_config", ApiScope.Admin);
        _config = response?.Data ?? new GlobalConfigDto();
        EnsureDefaults();
        _loading = false;
    }

    private async Task QueueSaveAsync()
    {
        if (_saving)
        {
            _saveQueued = true;
            return;
        }

        await SaveAsync();

        if (_saveQueued)
        {
            _saveQueued = false;
            await SaveAsync();
        }
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            _saveQueued = true;
            return;
        }

        _saving = true;
        _message = null;

        var response = await Api.PostAsync<object>("global_config", _config, ApiScope.Admin);
        _saving = false;

        if (response != null && (response.Code == 0 || response.Code == 200))
        {
            SetMessage(true, "保存成功");
        }
        else
        {
            SetMessage(false, response?.Message ?? "保存失败");
        }
    }

    private void SetMessage(bool success, string message)
    {
        _message = message;
        _messageClass = success ? "alert-success" : "alert-danger";
    }
}

