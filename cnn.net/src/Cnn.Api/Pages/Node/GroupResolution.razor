﻿
@page "/node/groups/{GroupId:long}/resolution"
@using Cnn.Common.Contracts.Admin
@using Cnn.Api.Services
@inject ApiClient Api
@inject IJSRuntime Js
@inject NavigationManager Nav

@implements IDisposable

<div class="page-container">
    <div class="page-title">分组解析配置</div>

    <div class="filter-bar">
        <button class="btn btn-outline-secondary" @onclick="@(() => Nav.NavigateTo("/node/groups"))">返回</button>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <span class="text-muted">区域</span>
            <select class="form-select" style="max-width: 160px" @bind="_selectedRegionId" @bind:after="OnRegionChanged">
                <option value="0">全部</option>
                @foreach (var region in _regions)
                {
                    <option value="@region.Id">@region.Name</option>
                }
            </select>
            <span class="text-muted">分组</span>
            <select class="form-select" style="max-width: 220px" @bind="_selectedGroupId" @bind:after="OnGroupChanged">
                @foreach (var group in FilteredGroups)
                {
                    <option value="@group.Id">@group.Name</option>
                }
            </select>
        </div>
    </div>

    <div class="resolution-grid">
        <div class="card config-card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>未设置的IP</span>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary btn-sm" @onclick="@(() => AssignAsync(false))">批量添加</button>
                    <button class="btn btn-outline-primary btn-sm" @onclick="@(() => AssignAsync(true))">批量备用</button>
                </div>
            </div>
            <div class="card-body">
                <div class="filter-bar">
                    <InputText class="form-control" style="max-width: 200px" @bind-Value="_leftKeyword" placeholder="IP/名称搜索" />
                </div>
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th style="width: 50px">
                                    <input type="checkbox" class="form-check-input" checked="@LeftAllSelected" @onchange="ToggleLeftAll" />
                                </th>
                                <th>名称</th>
                                <th style="width: 160px">IP</th>
                                <th style="width: 100px">状态</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_loading)
                            {
                                <tr><td colspan="4">加载中...</td></tr>
                            }
                            else if (!FilteredAvailable.Any())
                            {
                                <tr><td colspan="4">暂无数据</td></tr>
                            }
                            else
                            {
                                @foreach (var item in FilteredAvailable)
                                {
                                    <tr>
                                        <td>
                                            <input type="checkbox" class="form-check-input" checked="@_leftSelected.Contains(GetAvailableKey(item))" @onchange="e => ToggleLeft(item, e)" />
                                        </td>
                                        <td>@item.Name</td>
                                        <td>@item.Ip</td>
                                        <td>
                                            <span class="status-dot @(item.Online ? "status-online" : "status-offline")"></span>
                                            <span>@(item.Online ? "在线" : "离线")</span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="card config-card">
            <div class="card-header">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="text-muted">当前线路</span>
                    <select class="form-select" style="max-width: 220px" @bind="_currentLineId" @bind:after="OnLineChanged">
                        <option value="all">全部</option>
                        <option value="default">默认</option>
                        <option value="telecom">电信</option>
                        <option value="unicom">联通</option>
                        <option value="mobile">移动</option>
                        <optgroup label="其他运营商">
                            <option value="other">其他运营商</option>
                            <option value="tie-tong">铁通</option>
                            <option value="broadcast">广电</option>
                            <option value="edu">教育网</option>
                        </optgroup>
                        <optgroup label="境内">
                            <option value="group_china">境内</option>
                            <option value="china">全部</option>
                            <option value="anhui">安徽</option>
                            <option value="beijing">北京</option>
                            <option value="chongqing">重庆</option>
                            <option value="fujian">福建</option>
                            <option value="gansu">甘肃</option>
                            <option value="guangdong">广东</option>
                            <option value="guangxi">广西</option>
                            <option value="guizhou">贵州</option>
                            <option value="hainan">海南</option>
                            <option value="hebei">河北</option>
                            <option value="heilongjiang">黑龙江</option>
                            <option value="henan">河南</option>
                            <option value="hubei">湖北</option>
                            <option value="hunan">湖南</option>
                            <option value="jiangsu">江苏</option>
                            <option value="jiangxi">江西</option>
                            <option value="jilin">吉林</option>
                            <option value="liaoning">辽宁</option>
                            <option value="neimenggu">内蒙古</option>
                            <option value="ningxia">宁夏</option>
                            <option value="qinghai">青海</option>
                            <option value="shaanxi">陕西</option>
                            <option value="shandong">山东</option>
                            <option value="shanghai">上海</option>
                            <option value="shanxi">山西</option>
                            <option value="sichuan">四川</option>
                            <option value="tianjin">天津</option>
                            <option value="xizang">西藏</option>
                            <option value="xinjiang">新疆</option>
                            <option value="yunnan">云南</option>
                            <option value="zhejiang">浙江</option>
                        </optgroup>
                        <option value="global">境外</option>
                        <optgroup label="搜索引擎">
                            <option value="search">搜索引擎</option>
                            <option value="baidu">百度</option>
                            <option value="google">谷歌</option>
                            <option value="youdao">有道</option>
                            <option value="bing">必应</option>
                            <option value="sogou">搜狗</option>
                            <option value="qh360">奇虎</option>
                        </optgroup>
                        <option value="line_group">线路分组</option>
                        <option value="custom">自定义线路</option>
                    </select>
                    <span class="text-muted small">线路为“全部”时，新增节点对所有线路生效。</span>
                </div>
            </div>
            <div class="card-body">
                <div class="filter-bar">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => RunActionAsync("enable"))">启用</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => RunActionAsync("disable"))">禁用</button>
                    <button class="btn btn-outline-danger btn-sm" @onclick="DeleteSelectedAsync">删除</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => RunActionAsync("set_backup"))">备用IP</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => RunActionAsync("unset_backup"))">取消备用</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => RunActionAsync("set_backup_default"))">备用默认解析</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => RunActionAsync("unset_backup_default"))">取消备用默认</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => PromptActionAsync("set_weight", "请输入权重"))">设置权重</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => PromptActionAsync("set_sort", "请输入排序值"))">修改排序</button>
                    <InputText class="form-control" style="max-width: 200px" @bind-Value="_rightKeyword" placeholder="IP/名称搜索" />
                </div>

                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th style="width: 50px">
                                    <input type="checkbox" class="form-check-input" checked="@RightAllSelected" @onchange="ToggleRightAll" />
                                </th>
                                <th style="width: 80px">ID</th>
                                <th style="width: 100px">线路</th>
                                <th>名称</th>
                                <th style="width: 160px">IP</th>
                                <th style="width: 100px">备用IP</th>
                                <th style="width: 120px">状态</th>
                                <th style="width: 80px">权重</th>
                                <th style="width: 80px">排序</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_loading)
                            {
                                <tr><td colspan="9">加载中...</td></tr>
                            }
                            else if (!FilteredAssigned.Any())
                            {
                                <tr><td colspan="9">暂无数据</td></tr>
                            }
                            else
                            {
                                @foreach (var item in FilteredAssigned)
                                {
                                    <tr>
                                        <td>
                                            <input type="checkbox" class="form-check-input" checked="@_rightSelected.Contains(item.Id)" @onchange="e => ToggleRight(item, e)" />
                                        </td>
                                        <td>@item.Id</td>
                                        <td>@item.LineName</td>
                                        <td>@item.Name</td>
                                        <td>@item.Ip</td>
                                        <td>@(item.IsBackup ? "是" : "否")</td>
                                        <td>
                                            <span class="status-dot @GetAssignedStatusClass(item)"></span>
                                            <span>@GetAssignedStatusText(item)</span>
                                        </td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Weight) ? "-" : item.Weight)</td>
                                        <td>@(item.SortOrder?.ToString() ?? "-")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public long GroupId { get; set; }

    private readonly List<RegionListItem> _regions = new();
    private readonly List<NodeGroupListItem> _groups = new();
    private readonly List<NodeGroupResolutionItem> _available = new();
    private readonly List<NodeGroupResolutionAssigned> _assigned = new();
    private readonly HashSet<long> _leftSelected = new();
    private readonly HashSet<long> _rightSelected = new();

    private long _selectedRegionId;
    private long _selectedGroupId;
    private string _currentLineId = "default";
    private string _leftKeyword = string.Empty;
    private string _rightKeyword = string.Empty;

    private bool _loading;
    private bool _fetching;
    private global::System.Timers.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await LoadRegionsAsync();
        await LoadGroupsAsync();
        ResolveGroupSelection();
        await LoadResolutionAsync();
        StartPolling();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (GroupId > 0 && GroupId != _selectedGroupId)
        {
            _selectedGroupId = GroupId;
            var match = _groups.FirstOrDefault(g => g.Id == _selectedGroupId);
            _selectedRegionId = match?.RegionId ?? 0;
            await LoadResolutionAsync();
        }
    }

    private IEnumerable<NodeGroupListItem> FilteredGroups => _selectedRegionId <= 0
        ? _groups
        : _groups.Where(group => (group.RegionId ?? 0) == _selectedRegionId);

    private IEnumerable<NodeGroupResolutionItem> FilteredAvailable => string.IsNullOrWhiteSpace(_leftKeyword)
        ? _available
        : _available.Where(item => (item.Name ?? string.Empty).Contains(_leftKeyword, StringComparison.OrdinalIgnoreCase)
            || (item.Ip ?? string.Empty).Contains(_leftKeyword, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<NodeGroupResolutionAssigned> FilteredAssigned => string.IsNullOrWhiteSpace(_rightKeyword)
        ? _assigned
        : _assigned.Where(item => (item.Name ?? string.Empty).Contains(_rightKeyword, StringComparison.OrdinalIgnoreCase)
            || (item.Ip ?? string.Empty).Contains(_rightKeyword, StringComparison.OrdinalIgnoreCase));

    private bool LeftAllSelected => FilteredAvailable.Any() && FilteredAvailable.All(item => _leftSelected.Contains(GetAvailableKey(item)));

    private bool RightAllSelected => FilteredAssigned.Any() && FilteredAssigned.All(item => _rightSelected.Contains(item.Id));

    private async Task LoadRegionsAsync()
    {
        var response = await Api.GetAsync<RegionListResult>("regions", ApiScope.Admin);
        _regions.Clear();
        if (response?.Data?.List != null)
        {
            _regions.AddRange(response.Data.List);
        }
    }

    private async Task LoadGroupsAsync()
    {
        var query = new Dictionary<string, string?>
        {
            ["page"] = "1",
            ["limit"] = "200"
        };

        var response = await Api.GetAsync<NodeGroupListResult>("node-groups", ApiScope.Admin, query);
        _groups.Clear();
        if (response?.Data?.List != null)
        {
            _groups.AddRange(response.Data.List);
        }
    }

    private void ResolveGroupSelection()
    {
        if (_groups.Count == 0)
        {
            _selectedGroupId = 0;
            _selectedRegionId = 0;
            return;
        }

        if (GroupId > 0)
        {
            _selectedGroupId = GroupId;
        }

        if (_selectedGroupId == 0 || _groups.All(g => g.Id != _selectedGroupId))
        {
            _selectedGroupId = _groups[0].Id;
        }

        var match = _groups.FirstOrDefault(g => g.Id == _selectedGroupId);
        _selectedRegionId = match?.RegionId ?? 0;
    }

    private async Task LoadResolutionAsync(bool showLoading = true)
    {
        if (_selectedGroupId <= 0 || _fetching)
        {
            return;
        }

        _fetching = true;
        if (showLoading)
        {
            _loading = true;
        }

        var query = new Dictionary<string, string?>
        {
            ["line_id"] = _currentLineId
        };

        var response = await Api.GetAsync<NodeGroupResolutionResult>($"node-groups/{_selectedGroupId}/resolution", ApiScope.Admin, query);
        _available.Clear();
        _assigned.Clear();
        if (response?.Data != null)
        {
            if (response.Data.Available != null)
            {
                _available.AddRange(response.Data.Available);
            }
            if (response.Data.Assigned != null)
            {
                _assigned.AddRange(response.Data.Assigned);
            }
        }

        _leftSelected.Clear();
        _rightSelected.Clear();
        _fetching = false;
        _loading = false;
    }

    private async Task OnRegionChanged()
    {
        if (!FilteredGroups.Any())
        {
            _selectedGroupId = 0;
            _available.Clear();
            _assigned.Clear();
            return;
        }

        if (FilteredGroups.All(g => g.Id != _selectedGroupId))
        {
            _selectedGroupId = FilteredGroups.First().Id;
        }

        Nav.NavigateTo($"/node/groups/{_selectedGroupId}/resolution", false);
        await LoadResolutionAsync();
    }

    private async Task OnGroupChanged()
    {
        if (_selectedGroupId <= 0)
        {
            return;
        }

        Nav.NavigateTo($"/node/groups/{_selectedGroupId}/resolution", false);
        await LoadResolutionAsync();
    }

    private async Task OnLineChanged()
    {
        await LoadResolutionAsync();
    }

    private long GetAvailableKey(NodeGroupResolutionItem item)
    {
        return item.NodeIpId > 0 ? item.NodeIpId : item.NodeId;
    }

    private void ToggleLeft(NodeGroupResolutionItem item, ChangeEventArgs args)
    {
        var key = GetAvailableKey(item);
        var isChecked = args.Value?.ToString() == "true" || args.Value?.ToString() == "on";
        if (isChecked)
        {
            _leftSelected.Add(key);
        }
        else
        {
            _leftSelected.Remove(key);
        }
    }

    private void ToggleLeftAll(ChangeEventArgs args)
    {
        var isChecked = args.Value?.ToString() == "true" || args.Value?.ToString() == "on";
        if (isChecked)
        {
            foreach (var item in FilteredAvailable)
            {
                _leftSelected.Add(GetAvailableKey(item));
            }
        }
        else
        {
            _leftSelected.Clear();
        }
    }

    private void ToggleRight(NodeGroupResolutionAssigned item, ChangeEventArgs args)
    {
        var isChecked = args.Value?.ToString() == "true" || args.Value?.ToString() == "on";
        if (isChecked)
        {
            _rightSelected.Add(item.Id);
        }
        else
        {
            _rightSelected.Remove(item.Id);
        }
    }

    private void ToggleRightAll(ChangeEventArgs args)
    {
        var isChecked = args.Value?.ToString() == "true" || args.Value?.ToString() == "on";
        if (isChecked)
        {
            foreach (var item in FilteredAssigned)
            {
                _rightSelected.Add(item.Id);
            }
        }
        else
        {
            _rightSelected.Clear();
        }
    }

    private async Task AssignAsync(bool setBackup)
    {
        if (_selectedGroupId <= 0)
        {
            return;
        }

        var selectedItems = FilteredAvailable.Where(item => _leftSelected.Contains(GetAvailableKey(item))).ToList();
        if (selectedItems.Count == 0)
        {
            await Js.InvokeVoidAsync("alert", "请选择要添加的节点");
            return;
        }

        if (selectedItems.Any(item => !item.Online))
        {
            await Js.InvokeVoidAsync("alert", "禁止添加不在线的节点");
            return;
        }

        var lineName = ResolveLineLabel(_currentLineId);
        var payload = new NodeGroupAssignRequest
        {
            LineId = _currentLineId,
            LineName = lineName,
            Items = selectedItems.Select(item => new NodeGroupAssignItem(item.NodeId, item.NodeIpId, item.Name, item.Ip)).ToList()
        };

        await Api.PostAsync<object>($"node-groups/{_selectedGroupId}/resolution/assign", payload, ApiScope.Admin);
        _leftSelected.Clear();
        await LoadResolutionAsync();

        if (setBackup)
        {
            await ApplyBackupAsync(selectedItems);
        }
    }

    private async Task ApplyBackupAsync(IReadOnlyList<NodeGroupResolutionItem> items)
    {
        if (items.Count == 0)
        {
            return;
        }

        var ids = _assigned.Where(assigned => items.Any(item => IsSameNode(item, assigned)))
            .Where(assigned => string.IsNullOrWhiteSpace(_currentLineId) || _currentLineId == "all" || string.Equals(assigned.LineId, _currentLineId, StringComparison.OrdinalIgnoreCase))
            .Select(assigned => assigned.Id)
            .ToList();

        if (ids.Count == 0)
        {
            return;
        }

        var payload = new NodeGroupActionRequest
        {
            Action = "set_backup",
            Ids = ids
        };

        await Api.PostAsync<object>($"node-groups/{_selectedGroupId}/resolution/action", payload, ApiScope.Admin);
        await LoadResolutionAsync();
    }

    private static bool IsSameNode(NodeGroupResolutionItem item, NodeGroupResolutionAssigned assigned)
    {
        return assigned.NodeId == item.NodeId && assigned.NodeIpId == item.NodeIpId;
    }

    private async Task RunActionAsync(string action)
    {
        if (!_rightSelected.Any())
        {
            await Js.InvokeVoidAsync("alert", "请选择要操作的节点");
            return;
        }

        var payload = new NodeGroupActionRequest
        {
            Action = action,
            Ids = _rightSelected.ToList()
        };

        await Api.PostAsync<object>($"node-groups/{_selectedGroupId}/resolution/action", payload, ApiScope.Admin);
        _rightSelected.Clear();
        await LoadResolutionAsync();
    }

    private async Task PromptActionAsync(string action, string prompt)
    {
        if (!_rightSelected.Any())
        {
            await Js.InvokeVoidAsync("alert", "请选择要操作的节点");
            return;
        }

        var value = await Js.InvokeAsync<string?>("prompt", prompt);
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        var payload = new NodeGroupActionRequest
        {
            Action = action,
            Ids = _rightSelected.ToList(),
            Value = value
        };

        await Api.PostAsync<object>($"node-groups/{_selectedGroupId}/resolution/action", payload, ApiScope.Admin);
        _rightSelected.Clear();
        await LoadResolutionAsync();
    }

    private async Task DeleteSelectedAsync()
    {
        if (!_rightSelected.Any())
        {
            await Js.InvokeVoidAsync("alert", "请选择要删除的节点");
            return;
        }

        var selected = FilteredAssigned.Where(item => _rightSelected.Contains(item.Id)).ToList();
        if (selected.Any(item => item.IsOn))
        {
            await Js.InvokeVoidAsync("alert", "请先禁用节点后再删除");
            return;
        }

        var confirm = await Js.InvokeAsync<bool>("confirm", "确认删除选中的节点？");
        if (!confirm)
        {
            return;
        }

        await RunActionAsync("delete");
    }

    private static string ResolveLineLabel(string lineId)
    {
        if (string.IsNullOrWhiteSpace(lineId))
        {
            return "默认";
        }

        var map = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["all"] = "全部",
            ["default"] = "默认",
            ["telecom"] = "电信",
            ["unicom"] = "联通",
            ["mobile"] = "移动",
            ["other"] = "其他运营商",
            ["tie-tong"] = "铁通",
            ["broadcast"] = "广电",
            ["edu"] = "教育网",
            ["group_china"] = "境内",
            ["china"] = "全部",
            ["anhui"] = "安徽",
            ["beijing"] = "北京",
            ["chongqing"] = "重庆",
            ["fujian"] = "福建",
            ["gansu"] = "甘肃",
            ["guangdong"] = "广东",
            ["guangxi"] = "广西",
            ["guizhou"] = "贵州",
            ["hainan"] = "海南",
            ["hebei"] = "河北",
            ["heilongjiang"] = "黑龙江",
            ["henan"] = "河南",
            ["hubei"] = "湖北",
            ["hunan"] = "湖南",
            ["jiangsu"] = "江苏",
            ["jiangxi"] = "江西",
            ["jilin"] = "吉林",
            ["liaoning"] = "辽宁",
            ["neimenggu"] = "内蒙古",
            ["ningxia"] = "宁夏",
            ["qinghai"] = "青海",
            ["shaanxi"] = "陕西",
            ["shandong"] = "山东",
            ["shanghai"] = "上海",
            ["shanxi"] = "山西",
            ["sichuan"] = "四川",
            ["tianjin"] = "天津",
            ["xizang"] = "西藏",
            ["xinjiang"] = "新疆",
            ["yunnan"] = "云南",
            ["zhejiang"] = "浙江",
            ["global"] = "境外",
            ["search"] = "搜索引擎",
            ["baidu"] = "百度",
            ["google"] = "谷歌",
            ["youdao"] = "有道",
            ["bing"] = "必应",
            ["sogou"] = "搜狗",
            ["qh360"] = "奇虎",
            ["line_group"] = "线路分组",
            ["custom"] = "自定义线路"
        };

        return map.TryGetValue(lineId, out var label) ? label : lineId;
    }

    private static string GetAssignedStatusText(NodeGroupResolutionAssigned item)
    {
        if (!item.IsOn)
        {
            return "禁用";
        }

        if (!item.NodeIsOn)
        {
            return "节点已禁用";
        }

        if (!item.Online)
        {
            return "节点离线";
        }

        return "启用";
    }

    private static string GetAssignedStatusClass(NodeGroupResolutionAssigned item)
    {
        if (!item.IsOn || !item.NodeIsOn || !item.Online)
        {
            return "status-offline";
        }

        return "status-online";
    }

    private void StartPolling()
    {
        if (_timer != null)
        {
            return;
        }

        _timer = new global::System.Timers.Timer(3000);
        _timer.Elapsed += async (_, _) => await InvokeAsync(() => LoadResolutionAsync(false));
        _timer.Start();
    }

    private void StopPolling()
    {
        if (_timer == null)
        {
            return;
        }

        _timer.Stop();
        _timer.Dispose();
        _timer = null;
    }

    public void Dispose()
    {
        StopPolling();
    }
}

