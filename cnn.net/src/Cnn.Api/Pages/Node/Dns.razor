    private sealed class DnsProviderForm
    {
        public string Name { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
        public Dictionary<string, string> Credentials { get; } = new(StringComparer.OrdinalIgnoreCase);
        public string Ttl { get; set; } = "600";
        public bool IpWeight { get; set; } = true;

        public void Reset()
        {
            Name = string.Empty;
            Type = string.Empty;
            Credentials.Clear();
            Ttl = "600";
            IpWeight = false;
        }
    }

