@page "/tasks"
@implements IDisposable
@using Cnn.Common.Contracts
@using Cnn.Api.Services
@using global::System.Globalization
@inject TaskApi Api
@inject TaskHubClient Hub
@inject IJSRuntime JS

<h3>任务列表</h3>

@if (_loading)
{
    <p>加载中...</p>
}
else
{
    var visibleItems = FilterByState(_items);
    <div class="mb-2">
        <div class="btn-group btn-group-sm" role="group">
            <button class="btn @(GetFilterButtonClass("all"))" @onclick='() => SetStateFilterAsync("all")'>全部</button>
            <button class="btn @(GetFilterButtonClass("fail"))" @onclick='() => SetStateFilterAsync("fail")'>失败</button>
            <button class="btn @(GetFilterButtonClass("retrying"))" @onclick='() => SetStateFilterAsync("retrying")'>重试中</button>
            <button class="btn @(GetFilterButtonClass("running"))" @onclick='() => SetStateFilterAsync("running")'>运行中</button>
            <button class="btn @(GetFilterButtonClass("waiting"))" @onclick='() => SetStateFilterAsync("waiting")'>等待中</button>
            <button class="btn @(GetFilterButtonClass("success"))" @onclick='() => SetStateFilterAsync("success")'>成功</button>
        </div>
        <span class="ms-2 text-muted small">当前: @GetFilterLabel(_stateFilter) (@visibleItems.Count / @_items.Count)</span>
    </div>

    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Type</th>
                <th>State</th>
                <th>Progress</th>
                <th>RetryAt</th>
                <th>Ret</th>
                <th>Targets</th>
                <th>Start</th>
                <th>End</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in visibleItems)
        {
            var summary = TaskTargetsJsonParser.ParseSummary(item.TargetsJson);
            var isExpanded = _expandedTaskIds.Contains(item.Id);
            var hasTargets = summary.Total > 0;
            <tr>
                <td>@item.Id</td>
                <td>@item.Type</td>
                <td>@item.State</td>
                <td>@item.Progress</td>
                <td>@FormatDate(item.RetryAt)</td>
                <td title="@item.Ret">@Truncate(item.Ret, 120)</td>
                <td>
                    @if (hasTargets)
                    {
                        var nodesForSummary = TaskTargetsJsonParser.ParseNodes(item.TargetsJson);
                        var failedSummary = TaskTargetsJsonParser.BuildFailedSummary(nodesForSummary);
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleExpand(item.Id)">
                            @(isExpanded ? "收起" : "展开")
                        </button>
                        <span class="ms-2">S:@summary.Success F:@summary.Fail P:@summary.Pending / T:@summary.Total</span>
                        @if (!string.IsNullOrWhiteSpace(failedSummary))
                        {
                            <div class="text-danger small mt-1" title="@failedSummary">失败摘要: @Truncate(failedSummary, 120)</div>
                        }
                    }
                    else
                    {
                        <span>-</span>
                    }
                </td>
                <td>@item.StartAt</td>
                <td>@item.EndAt</td>
            </tr>

            @if (isExpanded && hasTargets)
            {
                var failedOnly = _failedOnlyTaskIds.Contains(item.Id);
                var nodes = TaskTargetsJsonParser.ParseNodes(item.TargetsJson);
                var filteredNodes = failedOnly
                    ? nodes.Where(static n => string.Equals(n.State, "failed_final", StringComparison.OrdinalIgnoreCase)).ToList()
                    : nodes;
                <tr>
                    <td colspan="9">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <strong>节点明细</strong>
                            <label class="form-check-label">
                                <input class="form-check-input me-1"
                                       type="checkbox"
                                       checked="@failedOnly"
                                       @onchange="e => ToggleFailedOnly(item.Id, e.Value)" />
                                仅失败节点
                            </label>
                        </div>
                        <table class="table table-bordered table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Node</th>
                                    <th>State</th>
                                    <th>Tries</th>
                                    <th>RetryAt</th>
                                    <th>LastAt</th>
                                    <th>Progress</th>
                                    <th>Ret</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (filteredNodes.Count == 0)
                                {
                                    <tr>
                                        <td colspan="7">无匹配节点</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var node in filteredNodes)
                                    {
                                        <tr>
                                            <td>@node.NodeId</td>
                                            <td><span class="@GetStateBadgeClass(node.State)">@node.State</span></td>
                                            <td>@node.Tries</td>
                                            <td>@FormatUnix(node.RetryAt)</td>
                                            <td>@FormatUnix(node.LastAt)</td>
                                            <td>@(node.Progress?.ToString(CultureInfo.InvariantCulture) ?? "-")</td>
                                            <td title="@node.Ret">@Truncate(node.Ret, 120)</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
}
