@page "/plans/basic"
@using global::System.Text.Json
@using Cnn.Common.Contracts.Admin
@using Cnn.Api.Services.Deletion
@using Cnn.Api.Services.Tasks.Workflow
@inject ApiClient Api
@inject IJSRuntime Js

<div class="page-container">
    <div class="page-title">基础套餐</div>

    <div class="filter-bar">
        <button class="btn btn-primary" @onclick="OpenCreate">添加套餐</button>
        <button class="btn btn-outline-secondary" @onclick="RefreshAsync">刷新</button>
    </div>

    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>名称</th>
                    <th>分组</th>
                    <th>区域</th>
                    <th>月付</th>
                    <th>状态</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @if (_loading)
                {
                    <tr><td colspan="7">加载中...</td></tr>
                }
                else if (_items.Count == 0)
                {
                    <tr><td colspan="7">暂无数据</td></tr>
                }
                else
                {
                    @foreach (var item in _items)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Name</td>
                            <td>@item.Group</td>
                            <td>@item.Region</td>
                            <td>@item.PriceMonthly</td>
                            <td>@(item.Status ? "启用" : "禁用")</td>
                            <td class="d-flex gap-2 flex-wrap">
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEdit(item.Id)">管理</button>
                                <button class="btn btn-sm btn-outline-success" @onclick="() => OpenAssign(item)">分配</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(item)">删除</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (_editorVisible)
{
    <div class="modal-backdrop">
        <div class="modal-panel plan-editor">
            <div class="modal-header">
                <h5>@(_editing.Id > 0 ? "编辑套餐" : "添加套餐")</h5>
                <button class="btn-close" @onclick="CloseEditor"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">名称</label>
                        <InputText class="form-control" @bind-Value="_editing.Name" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">描述</label>
                        <InputText class="form-control" @bind-Value="_editing.Desc" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">分组</label>
                        <InputText class="form-control" @bind-Value="_editing.Group" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">区域</label>
                        <select class="form-select" @bind="_editing.Region">
                            <option value="0">请选择</option>
                            @foreach (var region in _regions)
                            {
                                <option value="@region.Id">@region.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">线路分组</label>
                        <select class="form-select" @bind="_editing.LineGroup">
                            <option value="0">请选择</option>
                            @foreach (var group in _nodeGroups)
                            {
                                <option value="@group.Id">@group.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">备用分组</label>
                        <select class="form-select" @bind="_editing.BackupGroup">
                            <option value="0">不设置</option>
                            @foreach (var group in _nodeGroups)
                            {
                                <option value="@group.Id">@group.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <hr />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">月流量</label>
                        <InputNumber class="form-control" @bind-Value="_editing.TrafficLimit" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">带宽(Mbps)</label>
                        <InputText class="form-control" @bind-Value="_editing.BandwidthLimit" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">连接数</label>
                        <InputNumber class="form-control" @bind-Value="_editing.ConnectionLimit" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">四层端口数</label>
                        <InputNumber class="form-control" @bind-Value="_editing.StreamPort" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">域名数</label>
                        <InputNumber class="form-control" @bind-Value="_editing.DomainLimit" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">HTTP端口数</label>
                        <InputNumber class="form-control" @bind-Value="_editing.HttpPort" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">自定义CC规则</label>
                        <div class="form-check form-switch">
                            <InputCheckbox class="form-check-input" @bind-Value="_editing.CustomCcRules" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">WebSocket</label>
                        <div class="form-check form-switch">
                            <InputCheckbox class="form-check-input" @bind-Value="_editing.Websocket" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">L2层代理</label>
                        <div class="form-check form-switch">
                            <InputCheckbox class="form-check-input" @bind-Value="_editing.L2Origin" />
                        </div>
                    </div>
                </div>

                <hr />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">月付</label>
                        <InputNumber class="form-control" @bind-Value="_editing.PriceMonthly" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">季度付</label>
                        <InputNumber class="form-control" @bind-Value="_editing.PriceQuarterly" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">年付</label>
                        <InputNumber class="form-control" @bind-Value="_editing.PriceYearly" />
                    </div>
                </div>

                <hr />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">CNAME主机名</label>
                        <InputText class="form-control" @bind-Value="_editing.CnameHostname2" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">CNAME域名</label>
                        <select class="form-select" @bind="_editing.CnameDomain">
                            <option value="">请选择</option>
                            @foreach (var cname in _cnameDomains)
                            {
                                <option value="@cname.Domain">@cname.Domain</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">CNAME模式</label>
                        <select class="form-select" @bind="_editing.CnameMode">
                            <option value="domain">按网站生成</option>
                            <option value="package">按套餐生成</option>
                        </select>
                    </div>
                </div>

                <hr />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">单用户购买数量</label>
                        <InputNumber class="form-control" @bind-Value="_editing.BuyNumLimit" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">有效期</label>
                        <InputText class="form-control" @bind-Value="_editing.ExpireText" placeholder="YYYY-MM-DD HH:mm:ss" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">实名校验</label>
                        <div class="form-check form-switch">
                            <InputCheckbox class="form-check-input" @bind-Value="_editing.IdVerify" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">续费提前天数</label>
                        <InputNumber class="form-control" @bind-Value="_editing.BeforeExpDaysRenew" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">排序</label>
                        <InputNumber class="form-control" @bind-Value="_editing.SortOrder" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">状态</label>
                        <div class="form-check form-switch">
                            <InputCheckbox class="form-check-input" @bind-Value="_editing.Status" />
                        </div>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">源IP限制</label>
                        <InputTextArea class="form-control" rows="3" @bind-Value="_editing.BackendIpLimit" />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">分配给用户 <span class="text-muted small">（用户ID，多个逗号分隔）</span></label>
                        <InputText class="form-control" @bind-Value="_editing.Owner" placeholder="输入用户ID，多个逗号分隔" />
                    </div>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-end gap-2">
                <button class="btn btn-secondary" @onclick="CloseEditor">取消</button>
                <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">保存</button>
            </div>
        </div>
    </div>
}

@if (_assignVisible)
{
    <div class="modal-backdrop">
        <div class="modal-panel">
            <div class="modal-header">
                <h5>分配套餐</h5>
                <button class="btn-close" @onclick="CloseAssign"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">套餐</label>
                    <input class="form-control" readonly value="@_assignPlanName" />
                </div>
                <div class="mb-3">
                    <label class="form-label">搜索用户</label>
                    <div class="input-group">
                        <InputText class="form-control" @bind-Value="_userSearchKeyword" placeholder="输入ID、邮箱、用户名、手机号" />
                        <button class="btn btn-outline-secondary" @onclick="SearchUsersAsync" disabled="@_userSearching">搜索</button>
                    </div>
                    @if (_userSearchResults.Count > 0)
                    {
                        <select class="form-select mt-1" size="4" @onchange="OnUserSelected">
                            @foreach (var u in _userSearchResults)
                            {
                                <option value="@u.Id">@($"{u.Name ?? u.Email} (ID: {u.Id})")</option>
                            }
                        </select>
                    }
                    @if (_assignUserId > 0)
                    {
                        <div class="form-text text-success">已选用户ID: @_assignUserId</div>
                    }
                </div>
                <div class="mb-3">
                    <label class="form-label">时长</label>
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        @foreach (var preset in new[] { ("1", "1个月"), ("3", "3个月"), ("12", "12个月"), ("custom", "自定义") })
                        {
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="durationPreset"
                                       id="dur_@preset.Item1"
                                       value="@preset.Item1"
                                       checked="@(_assignDurationMode == preset.Item1)"
                                       @onchange="@(() => OnDurationPresetChanged(preset.Item1))" />
                                <label class="form-check-label" for="dur_@preset.Item1">@preset.Item2</label>
                            </div>
                        }
                    </div>
                    @if (_assignDurationMode == "custom")
                    {
                        <InputNumber class="form-control" @bind-Value="_assignMonths" placeholder="月数" />
                    }
                </div>
                @if (_assignDurationMode == "custom")
                {
                    <div class="mb-3">
                        <label class="form-label">到期时间(可选)</label>
                        <InputText class="form-control" @bind-Value="_assignEndAt" placeholder="YYYY-MM-DD HH:mm:ss" />
                    </div>
                }
            </div>
            <div class="modal-footer d-flex justify-content-end gap-2">
                <button class="btn btn-secondary" @onclick="CloseAssign">取消</button>
                <button class="btn btn-primary" @onclick="SubmitAssignAsync" disabled="@_saving">确定</button>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<PlanItemDto> _items = new();
    private readonly List<RegionListItem> _regions = new();
    private readonly List<NodeGroupListItem> _nodeGroups = new();
    private readonly List<CnameDomainItem> _cnameDomains = new();
    private bool _loading;
    private bool _saving;
    private bool _editorVisible;
    private bool _assignVisible;

    private PlanEditModel _editing = new();
    private long _assignPlanId;
    private string _assignPlanName = string.Empty;
    private long _assignUserId;
    private string _assignDurationMode = "1";
    private int _assignMonths = 1;
    private string _assignEndAt = string.Empty;
    private string _userSearchKeyword = string.Empty;
    private bool _userSearching;
    private readonly List<UserItemDto> _userSearchResults = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await LoadDependenciesAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var response = await Api.GetAsync<PlanListResult>("plans", ApiScope.Admin);
        _items.Clear();
        if (response?.Data?.List != null)
        {
            _items.AddRange(response.Data.List);
        }
        _loading = false;
    }

    private Task RefreshAsync()
    {
        return LoadAsync();
    }

    private async Task LoadDependenciesAsync()
    {
        var regionResponse = await Api.GetAsync<RegionListResult>("regions", ApiScope.Admin);
        _regions.Clear();
        if (regionResponse?.Data?.List != null)
        {
            _regions.AddRange(regionResponse.Data.List);
        }

        var groupResponse = await Api.GetAsync<NodeGroupListResult>("node-groups", ApiScope.Admin);
        _nodeGroups.Clear();
        if (groupResponse?.Data?.List != null)
        {
            _nodeGroups.AddRange(groupResponse.Data.List);
        }

        var cnameResponse = await Api.GetAsync<CnameDomainListResult>("cname_domains", ApiScope.Admin);
        _cnameDomains.Clear();
        if (cnameResponse?.Data?.List != null)
        {
            _cnameDomains.AddRange(cnameResponse.Data.List);
        }
    }

    private void OpenCreate()
    {
        _editing = PlanEditModel.CreateDefault();
        _editorVisible = true;
    }

    private async Task OpenEdit(long id)
    {
        var response = await Api.GetAsync<PlanDetailDto>($"plans/{id}", ApiScope.Admin);
        if (response?.Data != null)
        {
            _editing = PlanEditModel.FromDto(response.Data);
            _editorVisible = true;
        }
    }

    private void CloseEditor()
    {
        _editorVisible = false;
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        var payload = _editing.ToRequest();
        if (_editing.Id > 0)
        {
            await Api.PutAsync<object>($"plans/{_editing.Id}", payload, ApiScope.Admin);
        }
        else
        {
            await Api.PostAsync<object>("plans", payload, ApiScope.Admin);
        }
        _saving = false;
        _editorVisible = false;
        await LoadAsync();
    }

    private async Task DeleteAsync(PlanItemDto item)
    {
        var result = await DeleteWorkflowHelper.ConfirmAndRequestAsync(
            Api,
            Js,
            $"plans/{item.Id}",
            ApiScope.Admin,
            "确认删除该套餐？",
            "套餐删除任务已提交");
        if (!result.Success)
        {
            if (!result.Cancelled)
            {
                await Js.InvokeVoidAsync("alert", result.Message);
            }

            return;
        }

        await Js.InvokeVoidAsync("alert", result.Message);
        await LoadAsync();
        if (result.TaskId > 0)
        {
            await RefreshAfterDeleteTaskAsync();
        }
    }

    private async Task RefreshAfterDeleteTaskAsync()
    {
        await Task.Delay(1200);
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private static string BuildDeleteBlockedMessage(string? message, IReadOnlyList<DeleteReferenceItem>? references)
    {
        var lines = new List<string>();
        if (!string.IsNullOrWhiteSpace(message))
        {
            lines.Add(message.Trim());
        }

        foreach (var item in references?.Take(5) ?? Array.Empty<DeleteReferenceItem>())
        {
            lines.Add($"- {item.DisplayName} [{item.Relation}]");
        }

        if ((references?.Count ?? 0) > 5)
        {
            lines.Add($"- 还有 {references!.Count - 5} 项依赖未展示");
        }

        return lines.Count == 0 ? "当前资源暂时无法删除" : string.Join("\n", lines);
    }

    private void OpenAssign(PlanItemDto item)
    {
        _assignPlanId = item.Id;
        _assignPlanName = item.Name ?? string.Empty;
        _assignUserId = 0;
        _assignDurationMode = "1";
        _assignMonths = 1;
        _assignEndAt = string.Empty;
        _userSearchKeyword = string.Empty;
        _userSearchResults.Clear();
        _assignVisible = true;
    }

    private void CloseAssign()
    {
        _assignVisible = false;
    }

    private void OnDurationPresetChanged(string mode)
    {
        _assignDurationMode = mode;
        _assignEndAt = string.Empty;
        _assignMonths = mode switch
        {
            "1" => 1,
            "3" => 3,
            "12" => 12,
            _ => _assignMonths
        };
    }

    private async Task SearchUsersAsync()
    {
        if (_userSearching || string.IsNullOrWhiteSpace(_userSearchKeyword))
        {
            return;
        }

        _userSearching = true;
        var query = new Dictionary<string, string?>
        {
            ["keyword"] = _userSearchKeyword,
            ["pageSize"] = "20"
        };
        var response = await Api.GetAsync<UserListResult>("users", ApiScope.Admin, query);
        _userSearchResults.Clear();
        if (response?.Data?.List != null)
        {
            _userSearchResults.AddRange(response.Data.List);
        }
        _userSearching = false;
    }

    private void OnUserSelected(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var id))
        {
            _assignUserId = id;
        }
    }

    private async Task SubmitAssignAsync()
    {
        if (_saving || _assignUserId <= 0)
        {
            return;
        }

        _saving = true;
        var request = new AssignUserPlanRequest
        {
            PlanId = _assignPlanId,
            UserId = _assignUserId
        };

        if (_assignDurationMode == "custom" && !string.IsNullOrWhiteSpace(_assignEndAt))
        {
            request.EndAt = _assignEndAt;
        }
        else
        {
            request.DurationMonths = _assignDurationMode == "custom" ? _assignMonths : int.Parse(_assignDurationMode);
        }

        await Api.PostAsync<object>("user_plans/assign", request, ApiScope.Admin);
        _saving = false;
        _assignVisible = false;
    }

    private sealed class PlanEditModel
    {
        public long Id { get; set; }
        public string? Name { get; set; }
        public string? Desc { get; set; }
        public string? Group { get; set; }
        public long Region { get; set; }
        public long LineGroup { get; set; }
        public long BackupGroup { get; set; }
        public long TrafficLimit { get; set; }
        public string? BandwidthLimit { get; set; }
        public long ConnectionLimit { get; set; }
        public long DomainLimit { get; set; }
        public bool CustomCcRules { get; set; }
        public bool Websocket { get; set; }
        public bool L2Origin { get; set; }
        public long PriceMonthly { get; set; }
        public long PriceQuarterly { get; set; }
        public long PriceYearly { get; set; }
        public int SortOrder { get; set; }
        public bool Status { get; set; }
        public long HttpPort { get; set; }
        public long StreamPort { get; set; }
        public string? CnameDomain { get; set; }
        public string? CnameHostname2 { get; set; }
        public string? CnameMode { get; set; }
        public long BuyNumLimit { get; set; }
        public string? BackendIpLimit { get; set; }
        public bool IdVerify { get; set; }
        public long BeforeExpDaysRenew { get; set; }
        public string? ExpireText { get; set; }
        public string? Owner { get; set; }

        public static PlanEditModel CreateDefault() => new()
        {
            Websocket = true,
            CustomCcRules = true,
            L2Origin = false,
            DomainLimit = 100,
            Status = true,
            CnameMode = "domain"
        };

        public static PlanEditModel FromDto(PlanDetailDto dto)
        {
            return new PlanEditModel
            {
                Id = dto.Id,
                Name = dto.Name,
                Desc = dto.Desc,
                Group = dto.Group,
                Region = dto.Region,
                LineGroup = dto.LineGroup,
                BackupGroup = dto.BackupGroup,
                TrafficLimit = dto.TrafficLimit,
                BandwidthLimit = dto.BandwidthLimit,
                ConnectionLimit = dto.ConnectionLimit,
                DomainLimit = dto.DomainLimit,
                CustomCcRules = dto.CustomCcRules,
                Websocket = dto.Websocket,
                L2Origin = dto.L2Origin,
                PriceMonthly = dto.PriceMonthly,
                PriceQuarterly = dto.PriceQuarterly,
                PriceYearly = dto.PriceYearly,
                SortOrder = dto.SortOrder,
                Status = dto.Status,
                HttpPort = dto.HttpPort,
                StreamPort = dto.StreamPort,
                CnameDomain = dto.CnameDomain,
                CnameHostname2 = dto.CnameHostname2,
                CnameMode = dto.CnameMode,
                BuyNumLimit = dto.BuyNumLimit,
                BackendIpLimit = dto.BackendIpLimit,
                IdVerify = dto.IdVerify,
                BeforeExpDaysRenew = dto.BeforeExpDaysRenew,
                ExpireText = dto.Expire?.ToString("yyyy-MM-dd HH:mm:ss"),
                Owner = dto.Owner
            };
        }

        public PlanDetailDto ToRequest()
        {
            DateTime? expire = null;
            if (!string.IsNullOrWhiteSpace(ExpireText) && DateTime.TryParse(ExpireText, out var parsed))
            {
                expire = parsed;
            }

            return new PlanDetailDto
            {
                Id = Id,
                Name = Name,
                Desc = Desc,
                Group = Group,
                Region = Region,
                LineGroup = LineGroup,
                BackupGroup = BackupGroup,
                TrafficLimit = TrafficLimit,
                BandwidthLimit = BandwidthLimit,
                ConnectionLimit = ConnectionLimit,
                DomainLimit = DomainLimit,
                CustomCcRules = CustomCcRules,
                Websocket = Websocket,
                L2Origin = L2Origin,
                PriceMonthly = PriceMonthly,
                PriceQuarterly = PriceQuarterly,
                PriceYearly = PriceYearly,
                SortOrder = SortOrder,
                Status = Status,
                HttpPort = HttpPort,
                StreamPort = StreamPort,
                CnameDomain = CnameDomain,
                CnameHostname2 = CnameHostname2,
                CnameMode = CnameMode,
                BuyNumLimit = BuyNumLimit,
                BackendIpLimit = BackendIpLimit,
                IdVerify = IdVerify,
                BeforeExpDaysRenew = BeforeExpDaysRenew,
                Expire = expire,
                Owner = Owner
            };
        }
    }

}
