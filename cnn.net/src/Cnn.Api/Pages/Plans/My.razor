@page "/plans/my"
@using Cnn.Common.Contracts
@using Cnn.Common.Contracts.Admin
@inject ApiClient Api
@inject IJSRuntime Js

<div class="page-container">
    <div class="page-title">我的套餐</div>

    <div class="filter-bar">
        <button class="btn btn-primary" @onclick="RefreshAsync">刷新</button>
        <button class="btn btn-outline-secondary" @onclick="TogglePagingDiagnostics">
            @(_showPagingDiagnostics ? "隐藏分页诊断" : "显示分页诊断")
        </button>
    </div>

    @if (_showPagingDiagnostics)
    {
        <div class="alert alert-light py-2 px-3 mt-2 mb-2 small">
            <div><strong>分页诊断</strong></div>
            <div>stateKey: <code>plans:my:table</code></div>
            <div>pagingEnabled: <code>@(_pageQuery.PagingEnabled ? "true" : "false")</code></div>
            <div>page: <code>@_pageQuery.Page</code>, pageSize: <code>@_pageQuery.PageSize</code></div>
            <div>loaded: <code>@_items.Count</code>, total: <code>@_total</code></div>
        </div>
    }

    <TablePager @ref="_tablePager"
                StateKey="plans:my:table"
                Total="_total"
                DefaultPageSize="20"
                UnpagedLimit="1000"
                QueryChanged="OnPageQueryChangedAsync">
        <ChildContent>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>名称</th>
                            <th>流量</th>
                            <th>带宽</th>
                            <th>域名数</th>
                            <th>到期时间</th>
                            <th>状态</th>
                            <th style="width:220px">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_loading)
                        {
                            <tr><td colspan="8">加载中...</td></tr>
                        }
                        else if (_items.Count == 0)
                        {
                            <tr><td colspan="8">暂无数据</td></tr>
                        }
                        else
                        {
                            @foreach (var item in _items)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>
                                        <button class="btn btn-link btn-sm p-0" @onclick="() => OpenDetail(item)">@(string.IsNullOrWhiteSpace(item.Name) ? $"套餐{item.Id}" : item.Name)</button>
                                    </td>
                                    <td>@FormatBytes(item.Traffic)</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Bandwidth) ? "不限" : item.Bandwidth)</td>
                                    <td>@(item.Domain <= 0 ? "不限" : item.Domain.ToString())</td>
                                    <td>@FormatDate(item.EndAt)</td>
                                    <td>
                                        @if (item.IsExpired)
                                        {
                                            <span class="badge bg-warning text-dark">已过期</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">正常</span>
                                        }
                                    </td>
                                    <td class="d-flex gap-1 flex-wrap">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenRename(item)">重命名</button>
                                        <button class="btn btn-sm btn-outline-success" @onclick="() => OpenRenew(item)">续费</button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenSwitch(item)">切换套餐</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </ChildContent>
    </TablePager>
</div>

@* 详情对话框 *@
@if (_detailVisible && _detail != null)
{
    <div class="modal-backdrop">
        <div class="modal-panel" style="max-width: 680px">
            <div class="modal-header">
                <h5>套餐详情</h5>
                <button class="btn-close" @onclick="@(() => _detailVisible = false)"></button>
            </div>
            <div class="modal-body">
                <div class="tab-bar mb-3">
                    <button class='tab-button @(_detailTab == "usage" ? "active" : "")' @onclick='@(() => _detailTab = "usage")'>用量统计</button>
                    <button class='tab-button @(_detailTab == "spec" ? "active" : "")' @onclick='@(() => _detailTab = "spec")'>套餐规格</button>
                </div>
                @if (_detailTab == "usage")
                {
                    <table class="table table-bordered table-sm">
                        <thead><tr><th>项目</th><th>总量</th><th>已使用</th><th>剩余</th></tr></thead>
                        <tbody>
                            <tr><td>流量</td><td>@FormatBytes(_detail.Traffic)</td><td>0</td><td>@FormatBytes(_detail.Traffic)</td></tr>
                            <tr><td>带宽</td><td>@(string.IsNullOrWhiteSpace(_detail.Bandwidth) ? "不限" : _detail.Bandwidth)</td><td>-</td><td>-</td></tr>
                            <tr><td>域名数</td><td>@(_detail.Domain <= 0 ? "不限" : _detail.Domain.ToString())</td><td>0</td><td>@(_detail.Domain <= 0 ? "不限" : _detail.Domain.ToString())</td></tr>
                            <tr><td>主域名</td><td>@(_detail.MainDomainLimit <= 0 ? "不限" : _detail.MainDomainLimit.ToString())</td><td>0</td><td>@(_detail.MainDomainLimit <= 0 ? "不限" : _detail.MainDomainLimit.ToString())</td></tr>
                            <tr><td>HTTP端口</td><td>@(_detail.HttpPort <= 0 ? "不限" : _detail.HttpPort.ToString())</td><td>-</td><td>-</td></tr>
                            <tr><td>Stream端口</td><td>@(_detail.StreamPort <= 0 ? "不限" : _detail.StreamPort.ToString())</td><td>-</td><td>-</td></tr>
                            <tr><td>连接数</td><td>@(_detail.Connection <= 0 ? "不限" : _detail.Connection.ToString())</td><td>0</td><td>@(_detail.Connection <= 0 ? "不限" : _detail.Connection.ToString())</td></tr>
                        </tbody>
                    </table>
                }
                else
                {
                    <table class="table table-bordered table-sm">
                        <tbody>
                            <tr><td style="width:140px">套餐名</td><td>@(string.IsNullOrWhiteSpace(_detail.Name) ? "-" : _detail.Name)</td></tr>
                            <tr><td>WebSocket</td><td>@(_detail.Websocket ? "开启" : "关闭")</td></tr>
                            <tr><td>自定义CC</td><td>@(_detail.CustomCcRule ? "开启" : "关闭")</td></tr>
                            <tr><td>IPv6</td><td>@(_detail.IPv6 ? "开启" : "关闭")</td></tr>
                            <tr><td>HTTP/3</td><td>@(_detail.Http3Enabled ? "开启" : "关闭")</td></tr>
                            <tr><td>L2回源</td><td>@(_detail.L2Origin ? "开启" : "关闭")</td></tr>
                            <tr><td>CNAME域名</td><td>@(string.IsNullOrWhiteSpace(_detail.CnameDomain) ? "-" : _detail.CnameDomain)</td></tr>
                            <tr><td>购买时间</td><td>@FormatDate(_detail.StartAt)</td></tr>
                            <tr><td>到期时间</td><td>@FormatDate(_detail.EndAt)</td></tr>
                        </tbody>
                    </table>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="@(() => _detailVisible = false)">关闭</button>
            </div>
        </div>
    </div>
}

@* 重命名对话框 *@
@if (_renameVisible)
{
    <div class="modal-backdrop">
        <div class="modal-panel">
            <div class="modal-header">
                <h5>重命名套餐</h5>
                <button class="btn-close" @onclick="CloseRename"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">新名称</label>
                    <InputText class="form-control" @bind-Value="_renameValue" />
                </div>
                @if (_currentItem?.IPv6 != null)
                {
                    <div class="form-check form-switch">
                        <InputCheckbox class="form-check-input" @bind-Value="_renameIPv6" />
                        <label class="form-check-label">开启 IPv6 <span class="text-muted small">（需节点支持）</span></label>
                    </div>
                }
            </div>
            <div class="modal-footer d-flex justify-content-end gap-2">
                <button class="btn btn-secondary" @onclick="CloseRename">取消</button>
                <button class="btn btn-primary" @onclick="SaveRenameAsync" disabled="@_saving">保存</button>
            </div>
        </div>
    </div>
}

@* 续费对话框 *@
@if (_renewVisible && _currentItem != null)
{
    <div class="modal-backdrop">
        <div class="modal-panel">
            <div class="modal-header">
                <h5>套餐续费</h5>
                <button class="btn-close" @onclick="CloseRenew"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">续费周期</label>
                    <div class="d-flex gap-3 flex-wrap">
                        @if (_currentItem.MonthPrice > 0)
                        {
                            <label class="form-check">
                                <input type="radio" class="form-check-input" name="renewPeriod" value="month" checked="@(_renewPeriod == "month")" @onchange="@(() => _renewPeriod = "month")" />
                                <span class="form-check-label">月付 ¥@((_currentItem.MonthPrice / 100m).ToString("F2"))</span>
                            </label>
                        }
                        @if (_currentItem.QuarterPrice > 0)
                        {
                            <label class="form-check">
                                <input type="radio" class="form-check-input" name="renewPeriod" value="quarter" checked="@(_renewPeriod == "quarter")" @onchange="@(() => _renewPeriod = "quarter")" />
                                <span class="form-check-label">季付 ¥@((_currentItem.QuarterPrice / 100m).ToString("F2"))</span>
                            </label>
                        }
                        @if (_currentItem.YearPrice > 0)
                        {
                            <label class="form-check">
                                <input type="radio" class="form-check-input" name="renewPeriod" value="year" checked="@(_renewPeriod == "year")" @onchange="@(() => _renewPeriod = "year")" />
                                <span class="form-check-label">年付 ¥@((_currentItem.YearPrice / 100m).ToString("F2"))</span>
                            </label>
                        }
                        <label class="form-check">
                            <input type="radio" class="form-check-input" name="renewPeriod" value="custom" checked="@(_renewPeriod == "custom")" @onchange="@(() => _renewPeriod = "custom")" />
                            <span class="form-check-label">自定义月数</span>
                        </label>
                    </div>
                </div>
                @if (_renewPeriod == "custom")
                {
                    <div class="mb-3">
                        <label class="form-label">月数</label>
                        <InputNumber class="form-control" @bind-Value="_renewMonths" min="1" />
                    </div>
                }
                <div class="mb-3">
                    <label class="form-label">优惠码 <span class="text-muted small">（选填）</span></label>
                    <InputText class="form-control" @bind-Value="_renewCoupon" placeholder="请输入优惠码" />
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-end gap-2">
                <button class="btn btn-secondary" @onclick="CloseRenew">取消</button>
                <button class="btn btn-primary" @onclick="SaveRenewAsync" disabled="@_saving">@(_saving ? "处理中..." : "确定续费")</button>
            </div>
        </div>
    </div>
}

@* 切换套餐对话框 *@
@if (_switchVisible)
{
    <div class="modal-backdrop">
        <div class="modal-panel">
            <div class="modal-header">
                <h5>切换套餐</h5>
                <button class="btn-close" @onclick="CloseSwitch"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">选择新套餐</label>
                    <select class="form-select" @bind="_switchPlanId">
                        <option value="0">请选择</option>
                        @foreach (var plan in _planOptions)
                        {
                            <option value="@plan.Id">
                                @plan.Name
                                @if (plan.PriceMonthly > 0)
                                {
                                    <text> — ¥@(plan.PriceMonthly.ToString("F2"))/月</text>
                                }
                            </option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-end gap-2">
                <button class="btn btn-secondary" @onclick="CloseSwitch">取消</button>
                <button class="btn btn-primary" @onclick="SaveSwitchAsync" disabled="@_saving">@(_saving ? "处理中..." : "确定")</button>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<UserPackageItemDto> _items = new();
    private readonly List<PlanItemDto> _planOptions = new();
    private bool _loading;
    private bool _saving;
    private bool _showPagingDiagnostics;
    private TablePageQuery _pageQuery = new() { PagingEnabled = true, Page = 1, PageSize = 20 };
    private int _total;
    private TablePager? _tablePager;

    private bool _detailVisible;
    private string _detailTab = "usage";
    private UserPackageItemDto? _detail;

    private bool _renameVisible;
    private bool _renewVisible;
    private bool _switchVisible;
    private long _currentId;
    private UserPackageItemDto? _currentItem;
    private string _renameValue = string.Empty;
    private bool _renameIPv6;
    private string _renewPeriod = "month";
    private int _renewMonths = 1;
    private string _renewCoupon = string.Empty;
    private long _switchPlanId;

    protected override async Task OnInitializedAsync()
    {
        await LoadPlansAsync();
    }

    private async Task LoadAsync()
    {
        if (_loading) return;
        _loading = true;
        var query = new Dictionary<string, string?>
        {
            ["page"] = _pageQuery.Page.ToString(),
            ["pageSize"] = _pageQuery.PageSize.ToString()
        };
        var response = await Api.GetAsync<UserPackageListResult>("user_packages", ApiScope.User, query);
        _items.Clear();
        if (response?.Data?.List != null)
        {
            _items.AddRange(response.Data.List);
            _total = _items.Count;
        }
        else
        {
            _total = 0;
        }
        _loading = false;
    }

    private async Task LoadPlansAsync()
    {
        var response = await Api.GetAsync<PlanListResult>("plans", ApiScope.User);
        _planOptions.Clear();
        if (response?.Data?.List != null)
        {
            _planOptions.AddRange(response.Data.List);
        }
    }

    private Task OnPageQueryChangedAsync(TablePageQuery query)
    {
        _pageQuery = query;
        return LoadAsync();
    }

    private void TogglePagingDiagnostics()
    {
        _showPagingDiagnostics = !_showPagingDiagnostics;
    }

    private Task RefreshAsync()
    {
        if (_tablePager != null)
        {
            return _tablePager.RefreshAsync();
        }

        return LoadAsync();
    }

    private void OpenDetail(UserPackageItemDto item)
    {
        _detail = item;
        _detailTab = "usage";
        _detailVisible = true;
    }

    private void OpenRename(UserPackageItemDto item)
    {
        _currentId = item.Id;
        _currentItem = item;
        _renameValue = item.Name ?? string.Empty;
        _renameIPv6 = item.IPv6;
        _renameVisible = true;
    }

    private void CloseRename() { _renameVisible = false; }

    private async Task SaveRenameAsync()
    {
        if (_saving) return;
        _saving = true;
        var request = new UserPackageUpdateRequest { Name = _renameValue, IPv6 = _renameIPv6 };
        await Api.PutAsync<object>($"user_packages/{_currentId}", request, ApiScope.User);
        _saving = false;
        _renameVisible = false;
        await RefreshAsync();
    }

    private void OpenRenew(UserPackageItemDto item)
    {
        _currentId = item.Id;
        _currentItem = item;
        _renewPeriod = item.MonthPrice > 0 ? "month" : item.QuarterPrice > 0 ? "quarter" : item.YearPrice > 0 ? "year" : "custom";
        _renewMonths = 1;
        _renewCoupon = string.Empty;
        _renewVisible = true;
    }

    private void CloseRenew() { _renewVisible = false; }

    private async Task SaveRenewAsync()
    {
        if (_saving) return;
        if (_renewPeriod == "custom" && _renewMonths <= 0) return;
        _saving = true;
        var request = _renewPeriod == "custom"
            ? new RenewUserPackageRequest { Months = _renewMonths }
            : new RenewUserPackageRequest { Period = _renewPeriod };
        await Api.PostAsync<object>($"user_packages/{_currentId}/renew", request, ApiScope.User);
        _saving = false;
        _renewVisible = false;
        await RefreshAsync();
    }

    private void OpenSwitch(UserPackageItemDto item)
    {
        _currentId = item.Id;
        _switchPlanId = 0;
        _switchVisible = true;
    }

    private void CloseSwitch() { _switchVisible = false; }

    private async Task SaveSwitchAsync()
    {
        if (_saving || _switchPlanId <= 0) return;
        _saving = true;
        var request = new SwitchUserPackageRequest { PackageId = _switchPlanId };
        await Api.PostAsync<object>($"user_packages/{_currentId}/switch", request, ApiScope.User);
        _saving = false;
        _switchVisible = false;
        await RefreshAsync();
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0) return "不限";
        if (bytes >= 1_000_000_000_000L) return $"{bytes / 1_000_000_000_000.0:F2} TB";
        if (bytes >= 1_000_000_000L) return $"{bytes / 1_000_000_000.0:F2} GB";
        if (bytes >= 1_000_000L) return $"{bytes / 1_000_000.0:F2} MB";
        return $"{bytes} B";
    }

    private static string FormatDate(DateTime? value)
    {
        if (value == null || value == DateTime.MinValue) return "-";
        return value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");
    }
}
