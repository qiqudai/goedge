 lg:px-8\"\u003e\n          \u003cdiv id=\"what-happened-section\" class=\"w-1/2 md:w-full\"\u003e\n            \u003ch2 class=\"text-3xl leading-tight font-normal mb-4 text-black-dark antialiased\" data-translate=\"what_happened\"\u003e什么问题?\u003c/h2\u003e\n            \u003cp\u003e您网站使用的套餐流量已用完。\u003c/p\u003e\n            \n          \u003c/div\u003e\n\n          \n          \u003cdiv id=\"resolution-copy-section\" class=\"w-1/2 mt-6 text-15 leading-normal\"\u003e\n            \u003ch2 class=\"text-3xl leading-tight font-normal mb-4 text-black-dark antialiased\" data-translate=\"what_can_i_do\"\u003e如何解决?\u003c/h2\u003e\n            \u003cp\u003e请登录CDN后台升级流量恢复。\u003c/p\u003e\n          \u003c/div\u003e\n          \n      \u003c/section\u003e\n\n      \u003cdiv class=\"cf-error-footer cf-wrapper w-240 lg:w-full py-10 sm:py-4 sm:px-8 mx-auto text-center sm:text-left border-solid border-0 border-t border-gray-300\"\u003e\n\n\u003c/div\u003e\u003c!-- /.error-footer --\u003e\n\n\n    \u003c/div\u003e\u003c!-- /#cf-error-details --\u003e\n  \u003c/div\u003e\u003c!-- /#cf-wrapper --\u003e\n\n\n\u003c/body\u003e\n\u003c/html\u003e\n\n"},"default_config":{"website":{"cache_enable":false,"cache_ttl":0,"gzip":false,"waf_enable":false,"ssl_ciphers":""},"api":{"cache_enable":false,"cache_ttl":0,"gzip":false,"waf_enable":false,"ssl_ciphers":""},"download":{"cache_enable":false,"cache_ttl":0,"gzip":false,"waf_enable":false,"ssl_ciphers":""}},"cc_rules":{"10028":[{"matcher_id":10027,"filter_id":10026,"action":"block","enabled":true}]},"cc_matchers":{"10027":{"id":10027,"data":"{\"rules\":[{\"key\":\"uri\",\"logic\":\"and\",\"operator\":\"equals\",\"value\":\"/\"}]}"}},"cc_filters":{"10026":{"id":10026,"type":"block","within_second":10,"max_req":1,"max_req_per_uri":1,"extra":"{\"blacklist\":true,\"match_mode\":\"and\"}"}},"nginx":{"logs_dir":"/usr/local/openresty/nginx/logs","worker_processes":"auto","worker_connections":51202,"worker_rlimit_nofile":51202,"worker_shutdown_timeout":"60s","resolver":"223.5.5.5 8.8.8.8","resolver_timeout":"5s","http":{"client_max_body_size":"10m","custom_snippet":"","default_type":"text/plain","gzip":"on","gzip_comp_level":1,"gzip_http_version":"1.0","gzip_min_length":"1k","gzip_vary":"on","keepalive_requests":100,"keepalive_timeout":"62s","large_client_header_buffers":"4 32k","log_not_found":"off","proxy_buffering":"on","proxy_cache_dir":"/data/nginx/cache/","proxy_cache_keys_zone_size":"1000M","proxy_cache_max_size":"100g","proxy_cache_methods":"GET HEAD","proxy_connect_timeout":"60s","proxy_http_version":"1.0","proxy_max_temp_file_size":"1024m","proxy_next_upstream":"error timeout","proxy_read_timeout":"60s","proxy_request_buffering":"on","proxy_send_timeout":"60s","server":"cdn","server_addr_outgoing":"1","server_names_hash_bucket_size":128,"server_names_hash_max_size":512,"server_tokens":"off"},"stream":{"proxy_connect_timeout":"60s","proxy_timeout":"10m"}}}