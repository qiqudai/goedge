    private async Task LoadCcRulesAsync()
    {
        var response = await Api.GetAsync<CcListResult<CcRuleGroupListItem>>("rules/cc/groups", ApiScope.Admin);
        var list = response?.Data?.List ?? Array.Empty<CcRuleGroupListItem>();
        if (list.Count == 0)
        {
            return;
        }

        _ccRules.Clear();
        foreach (var item in list)
        {
            if (item.Id <= 0)
            {
                continue;
            }
            _ccRules.Add(new CcRuleOption(item.Id, item.Name ?? $"规则 {item.Id}"));
        }
    }

    private void ToggleProtocol(List<string> list, string protocol, bool enabled)
    {
        if (enabled)
        {
            if (!list.Contains(protocol))
            {
                list.Add(protocol);
            }
        }
        else
        {
            list.Remove(protocol);
        }

        _ = QueueSaveAsync();
    }

    private async Task QueueSaveAsync()
    {
        if (_saving)
        {
            _saveQueued = true;
            return;
        }

        await SaveAsync();

        if (_saveQueued)
        {
            _saveQueued = false;
            await SaveAsync();
        }
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            _saveQueued = true;
            return;
        }

        _saving = true;
        _message = null;

        var payload = new Dictionary<string, object?>
        {
            ["http_listen-port"] = _form.HttpListen,
            ["https_listen-port"] = _form.HttpsListen,
            ["https_listen-hsts"] = _form.HttpsHsts,
            ["https_listen-http2"] = _form.HttpsHttp2,
            ["https_listen-http3"] = _form.HttpsHttp3,
            ["https_listen-force_ssl_enable"] = _form.HttpsForce,
            ["https_listen-ssl_protocols"] = string.Join(' ', _form.SslProtocols),
            ["https_listen-ssl_ciphers"] = _form.SslCiphers,
            ["https_listen-ssl_prefer_server_ciphers"] = _form.SslPreferServerCiphers ? "on" : "off",
            ["https_listen-ocsp_stapling"] = _form.OcspStapling,
            ["backend_protocol"] = _form.BackendProtocol,
            ["backend_http_port"] = _form.BackendHttpPort,
            ["backend_https_port"] = _form.BackendHttpsPort,
            ["proxy_timeout"] = _form.ProxyTimeout,
            ["connect_timeout"] = _form.ConnectTimeout,
            ["proxy_ssl_protocols"] = string.Join(' ', _form.ProxySslProtocols),
            ["proxy_cache"] = JsonSerializer.Serialize(_form.CacheRules, JsonOptions),
            ["origin_headers"] = JsonSerializer.Serialize(_form.OriginHeaders, JsonOptions),
            ["log_request_header"] = _form.LogRequestHeader,
            ["log_response_header"] = _form.LogResponseHeader,
            ["log_request_body"] = _form.LogRequestBody,
            ["post_size_limit"] = _form.PostSizeLimit,
            ["balance_way"] = _form.BalanceWay,
            ["cc_default_rule"] = _form.CcDefaultRule,
            ["security_bot"] = _form.SecurityBot,
            ["gzip_enable"] = _form.GzipEnable,
            ["gzip_types"] = _form.GzipTypes,
            ["websocket_enable"] = _form.WebsocketEnable,
            ["security_shield_proxy"] = _form.SecurityShieldProxy,
            ["realtime_send"] = _form.RealtimeSend,
            ["realtime_return"] = _form.RealtimeReturn,
            ["ipv6_enable"] = _form.Ipv6Enable
        };

        var request = new SiteDefaultCreateRequest
        {
            ScopeName = "global",
            ScopeId = 0,
            Data = payload
        };

        var response = await Api.PostAsync<object>("site_defaults", request, ApiScope.Admin);
        _saving = false;

        if (response != null && (response.Code == 0 || response.Code == 200))
        {
            SetMessage(true, "保存成功");
        }
        else
        {
            SetMessage(false, response?.Message ?? "保存失败");
        }
    }

