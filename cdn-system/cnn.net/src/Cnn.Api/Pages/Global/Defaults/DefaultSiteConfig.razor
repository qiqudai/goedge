    private void SaveCacheRule()
    {
        var form = _cacheDialog.Form;
        var ttl = ConvertUnitToSeconds(form.TtlValue, form.TtlUnit);
        var rule = new CacheRule
        {
            Type = form.Type,
            Value = form.Value ?? string.Empty,
            Ttl = ttl.ToString(),
            IgnoreQuery = form.IgnoreQuery,
            ForceCache = form.ForceCache,
            EnableRange = form.EnableRange,
            IgnoreVary = form.IgnoreVary,
            SkipConditions = form.SkipConditions.Select(item => new CacheSkipCondition(item.Type, item.Value)).ToList()
        };

        if (_cacheDialog.Mode == "edit" && _cacheDialog.Index >= 0)
        {
            _form.CacheRules[_cacheDialog.Index] = rule;
        }
        else
        {
            _form.CacheRules.Add(rule);
        }

        _cacheDialog.Visible = false;
        _ = QueueSaveAsync();
    }

    private void RemoveCacheRule(int index)
    {
        if (index < 0 || index >= _form.CacheRules.Count)
        {
            return;
        }

        _form.CacheRules.RemoveAt(index);
        _ = QueueSaveAsync();
    }

    private void ApplyCachePreset()
    {
        if (string.IsNullOrWhiteSpace(_cachePreset))
        {
            return;
        }

        CacheRule? rule = _cachePreset switch
        {
            "index" => new CacheRule { Type = "index", Value = string.Empty, Ttl = "86400" },
            "all" => new CacheRule { Type = "all", Value = string.Empty, Ttl = "259200" },
            "static" => new CacheRule { Type = "suffix", Value = "jpg|jpeg|png|gif|ico|css|js|svg|bmp|webp|woff|woff2", Ttl = "604800", IgnoreQuery = true },
            "video" => new CacheRule { Type = "suffix", Value = "mp4|avi|mov|webm|m3u8|ts", Ttl = "2592000" },
            "wordpress" => new CacheRule { Type = "all", Value = string.Empty, Ttl = "259200" },
            _ => null
        };

        if (rule != null)
        {
            _form.CacheRules.Add(rule);
            _ = QueueSaveAsync();
        }

        _cachePreset = string.Empty;
    }

