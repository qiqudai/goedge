    private static string FormatTtl(string ttl)
    {
        if (!int.TryParse(ttl, out var seconds))
        {
            return ttl;
        }
        if (seconds <= 0)
        {
            return "0 秒";
        }
        if (seconds % 86400 == 0)
        {
            return (seconds / 86400) + " 天";
        }
        if (seconds % 3600 == 0)
        {
            return (seconds / 3600) + " 小时";
        }
        if (seconds % 60 == 0)
        {
            return (seconds / 60) + " 分钟";
        }
        return seconds + " 秒";
    }

    private static string ReadString(Dictionary<string, string> map, string key, string fallback)
    {
        return map.TryGetValue(key, out var value) && !string.IsNullOrWhiteSpace(value) ? value : fallback;
    }

    private static long ParseLong(string? value, long fallback)
    {
        return long.TryParse(value, out var parsed) ? parsed : fallback;
    }

    private static bool ParseBool(string? value, bool fallback)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return fallback;
        }

        var text = value.Trim().ToLowerInvariant();
        if (text is "1" or "true" or "on" or "yes")
        {
            return true;
        }
        if (text is "0" or "false" or "off" or "no")
        {
            return false;
        }

        return fallback;
    }

    private static List<string> SplitProtocols(string value)
    {
        return value.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(item => item.Trim())
            .Where(item => !string.IsNullOrWhiteSpace(item))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static List<CacheRule> ParseCacheRules(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return new List<CacheRule>();
        }

        try
        {
            using var doc = JsonDocument.Parse(raw);
            if (doc.RootElement.ValueKind != JsonValueKind.Array)
            {
                return new List<CacheRule>();
            }

            var list = new List<CacheRule>();
            foreach (var item in doc.RootElement.EnumerateArray())
            {
                var rule = NormalizeCacheRule(item);
                if (rule != null)
                {
                    list.Add(rule);
                }
            }
            return list;
        }
        catch
        {
            return new List<CacheRule>();
        }
    }

    private static CacheRule? NormalizeCacheRule(JsonElement element)
    {
        if (element.ValueKind != JsonValueKind.Object)
        {
            return null;
        }

        var ttl = GetString(element, "ttl") ?? GetString(element, "expire") ?? GetString(element, "cache_time") ?? "86400";
        var value = GetString(element, "value") ?? GetString(element, "content") ?? string.Empty;
        var rule = new CacheRule
        {
            Type = GetString(element, "type") ?? "index",
            Value = value,
            Ttl = string.IsNullOrWhiteSpace(ttl) ? "86400" : ttl,
            IgnoreQuery = GetBool(element, "ignore_query"),
            ForceCache = GetBool(element, "force_cache"),
            EnableRange = GetBool(element, "enable_range"),
            IgnoreVary = GetBool(element, "ignore_vary")
        };

        if (element.TryGetProperty("skip_conditions", out var conditions) && conditions.ValueKind == JsonValueKind.Array)
        {
            foreach (var cond in conditions.EnumerateArray())
            {
                var type = GetString(cond, "type") ?? string.Empty;
                var val = GetString(cond, "value") ?? string.Empty;
                if (!string.IsNullOrWhiteSpace(type) && !string.IsNullOrWhiteSpace(val))
                {
                    rule.SkipConditions.Add(new CacheSkipCondition(type, val));
                }
            }
        }

        return rule;
    }

    private static List<OriginHeader> ParseOriginHeaders(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return new List<OriginHeader>();
        }

        try
        {
            var parsed = JsonSerializer.Deserialize<List<OriginHeader>>(raw, JsonOptions);
            return parsed ?? new List<OriginHeader>();
        }
        catch
        {
            return new List<OriginHeader>();
        }
    }

    private static string? GetString(JsonElement element, string key)
    {
        if (element.ValueKind != JsonValueKind.Object)
        {
            return null;
        }

        if (element.TryGetProperty(key, out var property))
        {
            return property.ValueKind switch
            {
                JsonValueKind.String => property.GetString(),
                JsonValueKind.Number => property.ToString(),
                JsonValueKind.True => "true",
                JsonValueKind.False => "false",
                _ => property.ToString()
            };
        }

        return null;
    }

    private static bool GetBool(JsonElement element, string key)
    {
        if (element.ValueKind != JsonValueKind.Object)
        {
            return false;
        }

        if (!element.TryGetProperty(key, out var property))
        {
            return false;
        }

        return property.ValueKind switch
        {
            JsonValueKind.True => true,
            JsonValueKind.False => false,
            JsonValueKind.Number => property.GetInt32() != 0,
            JsonValueKind.String => ParseBool(property.GetString(), false),
            _ => false
        };
    }

    private static (string Value, string Unit) ConvertSecondsToUnit(string ttl)
    {
        if (!int.TryParse(ttl, out var seconds) || seconds <= 0)
        {
            return ("0", "second");
        }
        if (seconds % 86400 == 0)
        {
            return ((seconds / 86400).ToString(), "day");
        }
        if (seconds % 3600 == 0)
        {
            return ((seconds / 3600).ToString(), "hour");
        }
        if (seconds % 60 == 0)
        {
            return ((seconds / 60).ToString(), "minute");
        }
        return (seconds.ToString(), "second");
    }

    private static int ConvertUnitToSeconds(string value, string unit)
    {
        if (!int.TryParse(value, out var v))
        {
            return 0;
        }

        return unit switch
        {
            "day" => v * 86400,
            "hour" => v * 3600,
            "minute" => v * 60,
            "second" => v,
            _ => v
        };
    }

