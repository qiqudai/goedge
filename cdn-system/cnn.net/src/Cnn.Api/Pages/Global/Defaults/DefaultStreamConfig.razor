@using Cnn.Common.Contracts.Admin
@inject Cnn.Api.Services.ConfigItemClient ConfigClient

<div class="card config-card default-stream">
    <div class="card-header">转发默认配置</div>
    <div class="card-body">
        @if (_loading)
        {
            <div>加载中...</div>
        }
        else
        {
            <div class="form-row">
                <label class="form-label">监听协议</label>
                <InputRadioGroup @bind-Value="_form.ListenProtocol" @bind-Value:after="QueueSaveAsync">
                    <label class="form-check">
                        <InputRadio class="form-check-input" Value='@("tcp")' />
                        <span class="form-check-label">TCP</span>
                    </label>
                    <label class="form-check">
                        <InputRadio class="form-check-input" Value='@("udp")' />
                        <span class="form-check-label">UDP</span>
                    </label>
                </InputRadioGroup>
            </div>

            <div class="form-row">
                <label class="form-label">负载方式</label>
                <InputRadioGroup @bind-Value="_form.BalanceWay" @bind-Value:after="QueueSaveAsync">
                    <label class="form-check">
                        <InputRadio class="form-check-input" Value='@("rr")' />
                        <span class="form-check-label">轮询</span>
                    </label>
                    <label class="form-check">
                        <InputRadio class="form-check-input" Value='@("ip_hash")' />
                        <span class="form-check-label">定源</span>
                    </label>
                </InputRadioGroup>
            </div>

            <div class="form-check form-switch mt-2">
                <InputCheckbox class="form-check-input" @bind-Value="_form.ProxyProtocol" @onchange="QueueSaveAsync" />
                <label class="form-check-label">开启 proxy protocol</label>
            </div>
        }

        <div class="mt-3 d-flex align-items-center gap-2">
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">保存</button>
            @if (_saving)
            {
                <span class="text-muted">保存中...</span>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert @_messageClass mt-3">@_message</div>
        }
    </div>
</div>

@code {
    private bool _loading;
    private bool _saving;
    private bool _saveQueued;
    private string? _message;
    private string _messageClass = "alert-success";

    private readonly StreamForm _form = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _message = null;

        try
        {
            var items = await ConfigClient.GetAsync("stream_default_config", "global", 0);
            foreach (var item in items)
            {
                switch (item.Name)
                {
                    case "listen_protocol":
                        _form.ListenProtocol = item.Value ?? _form.ListenProtocol;
                        break;
                    case "balance_way":
                        _form.BalanceWay = item.Value ?? _form.BalanceWay;
                        break;
                    case "proxy_protocol":
                        _form.ProxyProtocol = string.Equals(item.Value, "1", StringComparison.OrdinalIgnoreCase);
                        break;
                }
            }
        }
        catch
        {
            SetMessage(false, "加载默认转发配置失败");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task QueueSaveAsync()
    {
        if (_saving)
        {
            _saveQueued = true;
            return;
        }

        await SaveAsync();

        if (_saveQueued)
        {
            _saveQueued = false;
            await SaveAsync();
        }
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            _saveQueued = true;
            return;
        }

        _saving = true;
        _message = null;

        var items = new List<ConfigItemPayloadDto>
        {
            new() { Name = "listen_protocol", Value = _form.ListenProtocol },
            new() { Name = "balance_way", Value = _form.BalanceWay },
            new() { Name = "proxy_protocol", Value = _form.ProxyProtocol ? "1" : "0" }
        };

        var ok = await ConfigClient.SaveAsync("stream_default_config", "global", 0, items);
        _saving = false;

        SetMessage(ok, ok ? "保存成功" : "保存失败");
    }

    private void SetMessage(bool success, string message)
    {
        _message = message;
        _messageClass = success ? "alert-success" : "alert-danger";
    }

    private sealed class StreamForm
    {
        public string ListenProtocol { get; set; } = "tcp";
        public string BalanceWay { get; set; } = "rr";
        public bool ProxyProtocol { get; set; }
    }
}

