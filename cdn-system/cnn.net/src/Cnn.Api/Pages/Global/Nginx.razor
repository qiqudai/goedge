@page "/global/nginx"
@using global::System.Text.Json
@using global::System.Text.Json.Nodes
@using Cnn.Common.Contracts.Admin
@inject Cnn.Api.Services.ConfigItemClient ConfigClient

<div class="page-container nginx-page">
    <div class="page-title">Nginx 全局配置</div>

    @if (_loading)
    {
        <div class="card config-card">加载中...</div>
    }
    else
    {
        <div class="card config-card">
            <div class="card-body">
                <div class="section">
                    <div class="section-title">工作进程配置</div>
                    <div class="form-row">
                        <label class="form-label">工作进程数</label>
                        <InputText class="form-control" style="width: 200px;" @bind-Value="_form.WorkerProcesses" @onblur="QueueSaveAsync" />
                        <div class="form-text">建议设置为 CPU 核心数或 "auto"。</div>
                    </div>
                    <div class="form-row">
                        <label class="form-label">工作进程连接数</label>
                        <InputNumber class="form-control" style="width: 200px;" @bind-Value="_form.WorkerConnections" @onblur="QueueSaveAsync" />
                        <div class="form-text">每个工作进程的最大连接数。</div>
                    </div>
                    <div class="form-row">
                        <label class="form-label">打开文件数限制</label>
                        <InputNumber class="form-control" style="width: 200px;" @bind-Value="_form.WorkerRlimitNofile" @onblur="QueueSaveAsync" />
                        <div class="form-text">最大打开文件描述符数 (ulimit -n)。</div>
                    </div>
                    <div class="form-row">
                        <label class="form-label">优雅退出超时</label>
                        <InputText class="form-control" style="width: 200px;" @bind-Value="_form.WorkerShutdownTimeout" @onblur="QueueSaveAsync" />
                        <div class="form-text">如 "60s"。</div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">路径配置</div>
                    <div class="form-row">
                        <label class="form-label">日志目录</label>
                        <InputText class="form-control" style="width: 320px;" @bind-Value="_form.LogDirectory" @onblur="QueueSaveAsync" />
                        <div class="form-text">访问日志与错误日志的存放目录。</div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">其他设置</div>
                    <div class="form-row">
                        <label class="form-label">Keepalive 超时</label>
                        <InputNumber class="form-control" style="width: 200px;" @bind-Value="_form.KeepaliveTimeout" @onblur="QueueSaveAsync" />
                        <span class="unit">秒</span>
                    </div>
                    <div class="form-check form-switch mt-2">
                        <InputCheckbox class="form-check-input" @bind-Value="_form.Gzip" @onchange="QueueSaveAsync" />
                        <label class="form-check-label">开启 Gzip</label>
                    </div>
                    <div class="form-row mt-2">
                        <label class="form-label">可缓存状态码</label>
                        <InputText class="form-control" style="width: 280px;" @bind-Value="_form.CacheValidStatuses" @onblur="QueueSaveAsync" placeholder="200 302" />
                        <div class="form-text">仅这些回源状态码允许写入缓存，空格或逗号分隔</div>
                    </div>
                    <div class="form-check form-switch mt-2">
                        <InputCheckbox class="form-check-input" @bind-Value="_form.Cache404RevalidateEnable" @onchange="QueueSaveAsync" />
                        <label class="form-check-label">404 缓存探测开关</label>
                    </div>
                    <div class="form-row mt-2">
                        <label class="form-label">404 探测触发时长</label>
                        <InputNumber class="form-control" style="width: 200px;" @bind-Value="_form.Cache404RevalidateAfter" @onblur="QueueSaveAsync" />
                        <span class="unit">秒</span>
                    </div>
                    <div class="form-row mt-2">
                        <label class="form-label">同键探测间隔</label>
                        <InputNumber class="form-control" style="width: 200px;" @bind-Value="_form.Cache404ProbeInterval" @onblur="QueueSaveAsync" />
                        <span class="unit">秒</span>
                    </div>
                    <div class="form-row mt-2">
                        <label class="form-label">探测超时</label>
                        <InputNumber class="form-control" style="width: 200px;" @bind-Value="_form.Cache404ProbeTimeoutMs" @onblur="QueueSaveAsync" />
                        <span class="unit">毫秒</span>
                    </div>
                    <div class="form-row mt-2">
                        <label class="form-label">自定义配置片段 (HTTP 块)</label>
                        <InputTextArea class="form-control" rows="6" @bind-Value="_form.CustomSnippet" @onblur="QueueSaveAsync" />
                    </div>
                </div>

                <div class="mt-3 d-flex align-items-center gap-2">
                    <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">保存</button>
                    @if (_saving)
                    {
                        <span class="text-muted">保存中...</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <div class="alert @_messageClass mt-3">@_message</div>
                }
            </div>
        </div>
    }
</div>

@code {
    private bool _loading;
    private bool _saving;
    private bool _saveQueued;
    private string? _message;
    private string _messageClass = "alert-success";

    private JsonObject _raw = new();
    private readonly NginxForm _form = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _message = null;

        try
        {
            var items = await ConfigClient.GetAsync("nginx_config", "global", 0);
            var item = items.FirstOrDefault(i => i.Name == "nginx-config-file");
            _raw = ParseJson(item?.Value);
            ApplyFromRaw();
        }
        catch
        {
            _raw = new JsonObject();
            ApplyFromRaw();
            SetMessage(false, "加载 Nginx 配置失败");
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFromRaw()
    {
        var http = GetObject(_raw, "http");

        _form.WorkerProcesses = ReadString(_raw, "worker_processes", "auto");
        _form.WorkerConnections = ReadInt(_raw, "worker_connections", 51200);
        _form.WorkerRlimitNofile = ReadInt(_raw, "worker_rlimit_nofile", 51200);
        _form.WorkerShutdownTimeout = ReadString(_raw, "worker_shutdown_timeout", "60s");
        _form.LogDirectory = ReadString(_raw, "logs_dir", string.Empty);
        _form.KeepaliveTimeout = ParseKeepaliveTimeout(ReadString(http, "keepalive_timeout", "60"), 60);
        _form.Gzip = ParseBool(ReadString(http, "gzip", "on"), true);
        _form.CacheValidStatuses = ReadString(http, "proxy_cache_valid_statuses", "200 302");
        if (string.IsNullOrWhiteSpace(_form.CacheValidStatuses))
            _form.CacheValidStatuses = ReadString(http, "cache_valid_statuses", "200 302");
        _form.Cache404RevalidateEnable = ParseBool(ReadString(http, "cache_404_revalidate_enable", "true"), true);
        _form.Cache404RevalidateAfter = ReadInt(http, "cache_404_revalidate_after", 5);
        _form.Cache404ProbeInterval = ReadInt(http, "cache_404_probe_interval", 3);
        _form.Cache404ProbeTimeoutMs = ReadInt(http, "cache_404_probe_timeout_ms", 1200);
        _form.CustomSnippet = ReadString(http, "custom_snippet", string.Empty);
    }

    private async Task QueueSaveAsync()
    {
        if (_saving)
        {
            _saveQueued = true;
            return;
        }

        await SaveAsync();

        if (_saveQueued)
        {
            _saveQueued = false;
            await SaveAsync();
        }
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            _saveQueued = true;
            return;
        }

        _saving = true;
        _message = null;

        var http = EnsureObject(_raw, "http");
        _raw["worker_processes"] = _form.WorkerProcesses?.Trim() ?? string.Empty;
        _raw["worker_connections"] = _form.WorkerConnections;
        _raw["worker_rlimit_nofile"] = _form.WorkerRlimitNofile;
        _raw["worker_shutdown_timeout"] = _form.WorkerShutdownTimeout?.Trim() ?? string.Empty;
        _raw["logs_dir"] = _form.LogDirectory?.Trim() ?? string.Empty;
        http["keepalive_timeout"] = FormatKeepaliveTimeout(_form.KeepaliveTimeout);
        http["gzip"] = _form.Gzip ? "on" : "off";
        http["proxy_cache_valid_statuses"] = _form.CacheValidStatuses?.Trim() ?? "200 302";
        http["cache_404_revalidate_enable"] = _form.Cache404RevalidateEnable;
        http["cache_404_revalidate_after"] = _form.Cache404RevalidateAfter;
        http["cache_404_probe_interval"] = _form.Cache404ProbeInterval;
        http["cache_404_probe_timeout_ms"] = _form.Cache404ProbeTimeoutMs;
        http["custom_snippet"] = _form.CustomSnippet ?? string.Empty;

        var payload = new List<ConfigItemPayloadDto>
        {
            new()
            {
                Name = "nginx-config-file",
                Value = _raw.ToJsonString(),
                Enable = true
            }
        };

        var ok = await ConfigClient.SaveAsync("nginx_config", "global", 0, payload);
        _saving = false;

        SetMessage(ok, ok ? "Nginx 配置已保存" : "保存失败");
    }

    private static JsonObject ParseJson(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return new JsonObject();
        }

        try
        {
            return JsonNode.Parse(raw) as JsonObject ?? new JsonObject();
        }
        catch
        {
            return new JsonObject();
        }
    }

    private static JsonObject GetObject(JsonObject root, string key)
    {
        if (root.TryGetPropertyValue(key, out var node) && node is JsonObject obj)
        {
            return obj;
        }

        return new JsonObject();
    }

    private static JsonObject EnsureObject(JsonObject root, string key)
    {
        if (root.TryGetPropertyValue(key, out var node) && node is JsonObject obj)
        {
            return obj;
        }

        var created = new JsonObject();
        root[key] = created;
        return created;
    }

    private static string ReadString(JsonObject? obj, string key, string fallback)
    {
        if (obj != null && obj.TryGetPropertyValue(key, out var node) && node != null)
        {
            return node.ToString();
        }

        return fallback;
    }

    private static int ReadInt(JsonObject? obj, string key, int fallback)
    {
        if (obj == null || !obj.TryGetPropertyValue(key, out var node) || node == null)
        {
            return fallback;
        }

        if (node is JsonValue value && value.TryGetValue<int>(out var intValue))
        {
            return intValue;
        }

        return int.TryParse(node.ToString(), out var parsed) ? parsed : fallback;
    }

    private static bool ParseBool(string? raw, bool fallback)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return fallback;
        }

        var value = raw.Trim().ToLowerInvariant();
        if (value is "on" or "true" or "1" or "yes")
        {
            return true;
        }
        if (value is "off" or "false" or "0" or "no")
        {
            return false;
        }

        return fallback;
    }

    private static int ParseKeepaliveTimeout(string? raw, int fallback)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return fallback;
        }

        var text = raw.Trim();
        if (int.TryParse(text, out var value))
        {
            return value;
        }

        var digits = new string(text.TakeWhile(char.IsDigit).ToArray());
        return int.TryParse(digits, out value) ? value : fallback;
    }

    private static string FormatKeepaliveTimeout(int value)
    {
        return value <= 0 ? string.Empty : $"{value}s";
    }

    private void SetMessage(bool success, string message)
    {
        _message = message;
        _messageClass = success ? "alert-success" : "alert-danger";
    }

    private sealed class NginxForm
    {
        public string WorkerProcesses { get; set; } = "auto";
        public int WorkerConnections { get; set; } = 51200;
        public int WorkerRlimitNofile { get; set; } = 51200;
        public string WorkerShutdownTimeout { get; set; } = "60s";
        public string LogDirectory { get; set; } = string.Empty;
        public int KeepaliveTimeout { get; set; } = 60;
        public bool Gzip { get; set; } = true;
        public string CacheValidStatuses { get; set; } = "200 302";
        public bool Cache404RevalidateEnable { get; set; } = true;
        public int Cache404RevalidateAfter { get; set; } = 5;
        public int Cache404ProbeInterval { get; set; } = 3;
        public int Cache404ProbeTimeoutMs { get; set; } = 1200;
        public string CustomSnippet { get; set; } = string.Empty;
    }
}

