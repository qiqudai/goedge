        }

        var list = new List<OriginItem>();
        foreach (var line in lines)
        {
            var existed = _model.Origin.List.FirstOrDefault(v => string.Equals(v.Address?.Trim(), line, StringComparison.OrdinalIgnoreCase));
            list.Add(new OriginItem
            {
                Address = line,
                Weight = existed?.Weight ?? "10",
                Enable = existed?.Enable ?? true
            });
        }

        _model.Origin.List = list;
    }

