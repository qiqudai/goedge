    private static Dictionary<string, object?>? AsMap(object? raw)
    {
        if (raw is Dictionary<string, object?> dict)
        {
            return dict;
        }

        if (raw is JsonElement element && element.ValueKind == JsonValueKind.Object)
        {
            return ToMap(element);
        }

        return null;
    }

    private static Dictionary<string, object?> ToMap(JsonElement element)
    {
        var result = new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);
        foreach (var prop in element.EnumerateObject())
        {
            result[prop.Name] = ConvertElement(prop.Value);
        }
        return result;
    }

    private static object? ConvertElement(JsonElement element)
    {
        return element.ValueKind switch
        {
            JsonValueKind.Object => ToMap(element),
            JsonValueKind.Array => element.EnumerateArray().Select(ConvertElement).ToList(),
            JsonValueKind.String => element.GetString(),
            JsonValueKind.Number => element.TryGetInt64(out var l) ? l : element.TryGetDouble(out var d) ? d : element.ToString(),
            JsonValueKind.True => true,
            JsonValueKind.False => false,
            _ => null
        };
    }

    private static Dictionary<string, object?> GetMap(Dictionary<string, object?>? parent, string key)
    {
        if (parent == null)
        {
            return new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);
        }

        if (!parent.TryGetValue(key, out var raw) || raw == null)
        {
            return new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);
        }

        return AsMap(raw) ?? new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);
    }

    private static string GetString(Dictionary<string, object?>? map, string key, string fallback)
    {
        if (map == null || !map.TryGetValue(key, out var raw) || raw == null)
        {
            return fallback;
        }

        return raw switch
        {
            string text => string.IsNullOrWhiteSpace(text) ? fallback : text,
            JsonElement element when element.ValueKind == JsonValueKind.String => element.GetString() ?? fallback,
            _ => raw.ToString() ?? fallback
        };
    }

    private static bool GetBool(Dictionary<string, object?>? map, string key, bool fallback)
    {
        if (map == null || !map.TryGetValue(key, out var raw) || raw == null)
        {
            return fallback;
        }

        if (raw is bool b)
        {
            return b;
        }

        if (raw is JsonElement element)
        {
            if (element.ValueKind == JsonValueKind.True) return true;
            if (element.ValueKind == JsonValueKind.False) return false;
            if (element.ValueKind == JsonValueKind.String)
            {
                var text = element.GetString()?.Trim();
                return text is "1" or "true" or "yes" or "on";
            }
        }

        var value = raw.ToString()?.Trim().ToLowerInvariant();
        return value is "1" or "true" or "yes" or "on";
    }

    private static int GetInt(Dictionary<string, object?>? map, string key, int fallback)
    {
        if (map == null || !map.TryGetValue(key, out var raw) || raw == null)
        {
            return fallback;
        }

        if (raw is int i) return i;
        if (raw is long l) return l > int.MaxValue ? int.MaxValue : (int)l;
        if (raw is JsonElement element)
        {
            if (element.ValueKind == JsonValueKind.Number && element.TryGetInt32(out var n)) return n;
            if (element.ValueKind == JsonValueKind.String && int.TryParse(element.GetString(), out var p)) return p;
        }

        return int.TryParse(raw.ToString(), out var parsed) ? parsed : fallback;
    }

    private static long GetLong(Dictionary<string, object?>? map, string key, long fallback)
    {
        if (map == null || !map.TryGetValue(key, out var raw) || raw == null)
        {
            return fallback;
        }

        if (raw is long l) return l;
        if (raw is int i) return i;
        if (raw is JsonElement element)
        {
            if (element.ValueKind == JsonValueKind.Number && element.TryGetInt64(out var n)) return n;
            if (element.ValueKind == JsonValueKind.String && long.TryParse(element.GetString(), out var p)) return p;
        }

        return long.TryParse(raw.ToString(), out var parsed) ? parsed : fallback;
    }

    private static List<string> ReadStringList(Dictionary<string, object?>? map, string key)
    {
        if (map == null || !map.TryGetValue(key, out var raw) || raw == null)
        {
            return new List<string>();
        }

        if (raw is List<object?> list)
        {
            return list.Select(v => v?.ToString()?.Trim() ?? string.Empty).Where(v => !string.IsNullOrWhiteSpace(v)).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        }

        if (raw is JsonElement element && element.ValueKind == JsonValueKind.Array)
        {
            return element.EnumerateArray().Select(v => v.ToString().Trim()).Where(v => !string.IsNullOrWhiteSpace(v)).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        }

        var text = raw.ToString() ?? string.Empty;
        return SplitByComma(text);
    }

    private static List<OriginItem> ReadOriginList(Dictionary<string, object?> origin, IReadOnlyList<string> fallbackBackends)
    {
        var result = new List<OriginItem>();
        if (origin.TryGetValue("list", out var raw) && raw is List<object?> list)
        {
            foreach (var item in list)
            {
                var map = AsMap(item);
                if (map == null)
                {
                    continue;
                }

                var addr = GetString(map, "address", string.Empty).Trim();
                if (string.IsNullOrWhiteSpace(addr))
                {
                    continue;
                }

                result.Add(new OriginItem
                {
                    Address = addr,
                    Weight = GetInt(map, "weight", 10).ToString(),
                    Enable = GetBool(map, "enable", true)
                });
            }
        }

        if (result.Count == 0)
        {
            foreach (var backend in fallbackBackends)
            {
                if (!string.IsNullOrWhiteSpace(backend))
                {
                    result.Add(new OriginItem { Address = backend.Trim(), Weight = "10", Enable = true });
                }
            }
        }

        if (result.Count == 0)
        {
            result.Add(new OriginItem());
        }

        return result;
    }

    private static List<CacheRuleItem> ReadCacheRules(Dictionary<string, object?> cache)
    {
        var result = new List<CacheRuleItem>();
        if (!cache.TryGetValue("rules", out var raw) || raw == null)
        {
            return result;
        }

        if (raw is List<object?> list)
        {
            foreach (var item in list)
            {
                var map = AsMap(item);
                if (map == null)
                {
                    continue;
                }

                result.Add(new CacheRuleItem
                {
                    Type = GetString(map, "type", "suffix"),
                    Value = GetString(map, "value", string.Empty),
                    Ttl = GetInt(map, "ttl", 3600),
                    TtlUnit = GetString(map, "unit", "s"),
                    IgnoreQuery = GetBool(map, "ignore_query", false),
                    ForceCache = GetBool(map, "force_cache", false),
                    Slice = GetBool(map, "slice", false),
                    IgnoreVary = GetBool(map, "ignore_vary", false)
                });
            }
        }

        return result;
    }

    private static List<RedirectRuleItem> ReadRedirectRules(Dictionary<string, object?> adv, string key)
    {
        var result = new List<RedirectRuleItem>();
        if (!adv.TryGetValue(key, out var raw) || raw == null)
        {
            return result;
        }

        if (raw is List<object?> list)
        {
            foreach (var item in list)
            {
                var map = AsMap(item);
                if (map == null)
                {
                    continue;
                }

                result.Add(new RedirectRuleItem
                {
                    Match = GetString(map, "match", string.Empty),
                    Redirect = GetString(map, "redirect", string.Empty),
                    Code = GetString(map, "code", "301"),
                    Conditions = ReadRedirectConditions(map)
                });
            }
        }

        return result;
    }

    private static List<RedirectConditionItem> ReadRedirectConditions(Dictionary<string, object?> map)
    {
        var result = new List<RedirectConditionItem>();
        if (!map.TryGetValue("conditions", out var raw) || raw == null)
        {
            return result;
        }

        if (raw is List<object?> list)
        {
            foreach (var item in list)
            {
                var condition = AsMap(item);
                if (condition == null)
                {
                    continue;
                }

                var key = GetString(condition, "key", GetString(condition, "item", string.Empty));
                var value = GetString(condition, "value", string.Empty);
                if (string.IsNullOrWhiteSpace(key) || string.IsNullOrWhiteSpace(value))
                {
                    continue;
                }

                result.Add(new RedirectConditionItem
                {
                    Key = key,
                    Value = value
                });
            }
        }

        return result;
    }

    private static List<HeaderRuleItem> ReadHeaderRules(Dictionary<string, object?> adv, string key)
    {
        var result = new List<HeaderRuleItem>();
        if (!adv.TryGetValue(key, out var raw) || raw == null)
        {
            return result;
        }

        if (raw is List<object?> list)
        {
            foreach (var item in list)
            {
                var map = AsMap(item);
                if (map == null)
                {
                    continue;
                }

                result.Add(new HeaderRuleItem
                {
                    Name = GetString(map, "name", string.Empty),
                    Value = GetString(map, "value", string.Empty)
                });
            }
        }

        return result;
    }

    private static List<string> SplitLines(string? raw)
    {
        return (raw ?? string.Empty)
            .Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(v => v.Trim())
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static List<string> SplitTokens(string? raw)
    {
        return (raw ?? string.Empty)
            .Split(new[] { ' ', '\t', '\r', '\n', ',' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(v => v.Trim())
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static List<string> SplitByComma(string? raw)
    {
        return (raw ?? string.Empty)
            .Split(new[] { ',', ' ', '\t', '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(v => v.Trim())
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static int ParseIntSafe(string? raw, int fallback)
    {
        return int.TryParse(raw?.Trim(), out var parsed) && parsed > 0 ? parsed : fallback;
    }

