@using global::System.Globalization
@using global::System.Text.Json
@using Cnn.Common.Contracts
@using Cnn.Common.Contracts.Admin
@inject ApiClient Api
@inject ClientSession Session
@inject IJSRuntime Js

<div class="card config-card p-3">
    <div class="filter-bar">
        <button class="btn btn-primary" @onclick="OpenCreate">新增默认设置</button>
        <button class="btn btn-outline-danger" disabled="@(!_selectedKeys.Any())" @onclick="DeleteSelectedAsync">删除</button>
    </div>

    <div class="table-responsive mt-2">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th style="width: 44px">
                        <input type="checkbox" class="form-check-input" checked="@AllSelected" @onchange="ToggleSelectAll" />
                    </th>
                    <th>设置项</th>
                    <th>设置值</th>
                    <th>范围</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @if (_loading)
                {
                    <tr><td colspan="5">加载中...</td></tr>
                }
                else if (_items.Count == 0)
                {
                    <tr><td colspan="5">暂无数据</td></tr>
                }
                else
                {
                    @foreach (var item in _items)
                    {
                        var key = RowKey(item);
                        <tr>
                            <td>
                                <input type="checkbox" class="form-check-input" checked="@_selectedKeys.Contains(key)" @onchange="e => ToggleSelected(key, e)" />
                            </td>
                            <td>@SettingLabel(item.Name)</td>
                            <td style="max-width: 420px; white-space: pre-wrap; word-break: break-all;">@FormatDisplayValue(item)</td>
                            <td>@ScopeLabel(item)</td>
                            <td class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEdit(item)">编辑</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteOneAsync(item)">删除</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_messageOk ? "alert-success" : "alert-danger") mt-2">@_message</div>
    }
</div>

@if (_editorVisible)
{
    <div class="modal-backdrop">
        <div class="modal-panel" style="max-width: 760px; width: 100%;">
            <div class="modal-header">
                <h5>@(_editMode == "edit" ? "编辑默认设置" : "新增默认设置")</h5>
                <button class="btn-close" @onclick="CloseEditor"></button>
            </div>

            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-12">
                        <label class="form-label">设置项</label>
                        <select class="form-select" @bind="_form.Name" @bind:after="OnNameChangedAsync" disabled="@(_editMode == "edit")">
                            <option value="">请选择</option>
                            @foreach (var option in _options)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label">适用范围</label>
                        <div class="d-flex gap-3">
                            <label class="form-check">
                                <input type="radio" class="form-check-input" name="scope" checked="@(_form.Scope == "global")" @onchange='@(() => _form.Scope = "global")' />
                                <span class="form-check-label">全局</span>
                            </label>
                            <label class="form-check">
                                <input type="radio" class="form-check-input" name="scope" checked="@(_form.Scope == "group")" @onchange='@(() => _form.Scope = "group")' />
                                <span class="form-check-label">分组</span>
                            </label>
                        </div>
                    </div>

                    @if (Session.IsAdmin)
                    {
                        <div class="col-md-12">
                            <label class="form-label">所属用户</label>
                            <div class="d-flex gap-2">
                                <InputText class="form-control" @bind-Value="_userKeyword" placeholder="搜索用户ID/邮箱/用户名/手机号" @onkeydown="OnUserKeywordKeyDown" />
                                <button class="btn btn-outline-secondary text-nowrap" @onclick="SearchUsersAsync">搜索</button>
                            </div>
                            <select class="form-select mt-2" @bind="_form.UserId">
                                <option value="0">请选择用户</option>
                                @foreach (var user in _users)
                                {
                                    <option value="@user.Id">@FormatUser(user)</option>
                                }
                            </select>
                            <div class="form-text">管理员必须指定用户</div>
                        </div>
                    }

                    @if (_form.Scope == "group")
                    {
                        <div class="col-md-12">
                            <label class="form-label">网站分组</label>
                            <select class="form-select" @bind="_form.GroupId">
                                <option value="0">请选择分组</option>
                                @foreach (var group in _groups)
                                {
                                    <option value="@group.Id">@group.Name</option>
                                }
                            </select>
                        </div>
                    }

                    <div class="col-md-12">
                        <label class="form-label">设置值</label>

                        @if (CurrentType == "bool")
                        {
                            <div class="form-check form-switch">
                                <InputCheckbox class="form-check-input" @bind-Value="_form.BoolValue" />
                            </div>
                        }
                        else if (CurrentType == "number")
                        {
                            <InputText class="form-control" @bind-Value="_form.NumberValue" />
                        }
                        else if (CurrentType == "select")
                        {
                            <select class="form-select" @bind="_form.SelectValue">
                                <option value="">请选择</option>
                                @foreach (var choice in CurrentChoices)
                                {
                                    <option value="@choice.Value">@choice.Label</option>
                                }
                            </select>
                        }
                        else if (CurrentType == "multi")
                        {
                            <div class="d-flex flex-wrap gap-3">
                                @foreach (var choice in CurrentChoices)
                                {
                                    var selected = _form.MultiValues.Contains(choice.Value, StringComparer.OrdinalIgnoreCase);
                                    <label class="form-check">
                                        <input type="checkbox" class="form-check-input" checked="@selected" @onchange="e => ToggleMulti(choice.Value, e)" />
                                        <span class="form-check-label">@choice.Label</span>
                                    </label>
                                }
                            </div>
                        }
                        else if (CurrentType == "lines")
                        {
                            <InputTextArea class="form-control" rows="4" @bind-Value="_form.TextValue" placeholder="每行一个值" />
                        }
                        else if (CurrentType == "region")
                        {
                            <InputTextArea class="form-control" rows="3" @bind-Value="_form.RegionValue" placeholder="国家代码，逗号分隔，如: CN,US,TH" />
                        }
                        else if (CurrentType == "headers")
                        {
                            <div class="d-flex flex-column gap-2">
                                @for (var i = 0; i < _form.Headers.Count; i++)
                                {
                                    var header = _form.Headers[i];
                                    <div class="d-flex gap-2">
                                        <InputText class="form-control" @bind-Value="header.Name" placeholder="请求头名称" />
                                        <InputText class="form-control" @bind-Value="header.Value" placeholder="值" />
                                        <button class="btn btn-outline-danger" @onclick="() => RemoveHeader(i)">删</button>
                                    </div>
                                }
                                <button class="btn btn-outline-secondary align-self-start" @onclick="AddHeader">+ 添加请求头</button>
                            </div>
                        }
                        else
                        {
                            <InputText class="form-control" @bind-Value="_form.TextValue" />
                        }
                    </div>
                </div>
            </div>

            <div class="modal-footer d-flex justify-content-end gap-2">
                <button class="btn btn-secondary" @onclick="CloseEditor">取消</button>
                <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">确定</button>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<SiteDefaultItemDto> _items = new();
    private readonly HashSet<string> _selectedKeys = new(StringComparer.OrdinalIgnoreCase);

    private bool _loading;
    private bool _saving;
    private string _message = string.Empty;
    private bool _messageOk;

    private bool _editorVisible;
    private string _editMode = "create";
    private string _originalName = string.Empty;
    private string _oldScopeName = "global";
    private long _oldScopeId;

    private readonly EditorForm _form = new();

    private string _userKeyword = string.Empty;
    private readonly List<UserItemDto> _users = new();
    private readonly List<SiteGroupDto> _groups = new();
    private readonly List<DnsApiItemDto> _dnsApis = new();
    private readonly List<CcRuleGroupListItem> _ccGroups = new();

    private ApiScope Scope => Session.IsAdmin ? ApiScope.Admin : ApiScope.User;

    private bool AllSelected => _items.Count > 0 && _items.All(item => _selectedKeys.Contains(RowKey(item)));

    private IReadOnlyList<SettingOption> _options => Options;

    private string CurrentType => CurrentOption?.Type ?? "text";

    private SettingOption? CurrentOption => _options.FirstOrDefault(option => option.Value == _form.Name);

    private IReadOnlyList<ChoiceOption> CurrentChoices
    {
        get
        {
            if (CurrentOption == null)
            {
                return Array.Empty<ChoiceOption>();
            }

            if (string.Equals(CurrentOption.ChoicesKey, "cc_rules", StringComparison.OrdinalIgnoreCase))
            {
                var list = new List<ChoiceOption> { new("不设置", "0") };
                list.AddRange(_ccGroups.Select(group => new ChoiceOption(group.Name ?? $"规则{group.Id}", group.Id.ToString(CultureInfo.InvariantCulture))));
                return list;
            }

            if (string.Equals(CurrentOption.ChoicesKey, "dns_providers", StringComparison.OrdinalIgnoreCase))
            {
                return _dnsApis.Select(api => new ChoiceOption(api.Name ?? $"DNS{api.Id}", api.Id.ToString(CultureInfo.InvariantCulture))).ToList();
            }

            return CurrentOption.Choices;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDependenciesAsync();
        await LoadAsync();
    }

    private async Task LoadDependenciesAsync()
    {
        var groupQuery = new Dictionary<string, string?>
        {
            ["page"] = "1",
            ["pageSize"] = "1000"
        };

        var groupResp = await Api.GetAsync<SiteGroupListResult>("site_groups", Scope, groupQuery);
        _groups.Clear();
        if (groupResp?.Data?.List != null)
        {
            _groups.AddRange(groupResp.Data.List);
        }

        var dnsResp = await Api.GetAsync<DnsApiListResult>("dnsapi", Scope);
        _dnsApis.Clear();
        if (dnsResp?.Data?.List != null)
        {
            _dnsApis.AddRange(dnsResp.Data.List);
        }

        var ccQuery = new Dictionary<string, string?>
        {
            ["page"] = "1",
            ["pageSize"] = "200"
        };
        var ccResp = await Api.GetAsync<CcListResult<CcRuleGroupListItem>>("rules/cc/groups", Scope, ccQuery);
        _ccGroups.Clear();
        if (ccResp?.Data?.List != null)
        {
            _ccGroups.AddRange(ccResp.Data.List);
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;

        var response = await Api.GetAsync<SiteDefaultListResult>("site_defaults", Scope);
        _items.Clear();
        if (response?.Data?.List != null)
        {
            _items.AddRange(response.Data.List);
        }

        var keys = _items.Select(RowKey).ToHashSet(StringComparer.OrdinalIgnoreCase);
        _selectedKeys.RemoveWhere(key => !keys.Contains(key));

        _loading = false;
    }

    private void OpenCreate()
    {
        _editMode = "create";
        _originalName = string.Empty;
        _oldScopeName = "global";
        _oldScopeId = 0;
        ResetForm();
        _editorVisible = true;
    }

    private void OpenEdit(SiteDefaultItemDto item)
    {
        _editMode = "edit";
        _originalName = item.Name ?? string.Empty;
        _oldScopeName = NormalizeScope(item.ScopeName);
        _oldScopeId = item.ScopeId;

        ResetForm();
        _form.Name = item.Name ?? string.Empty;
        _form.Scope = item.ScopeName == "group" ? "group" : "global";
        _form.GroupId = item.ScopeName == "group" ? item.ScopeId : 0;
        _form.UserId = item.UserId;

        if (Session.IsAdmin && item.UserId > 0 && _users.All(user => user.Id != item.UserId))
        {
            _users.Insert(0, new UserItemDto
            {
                Id = item.UserId,
                Name = item.UserName,
                Email = string.Empty
            });
        }

        HydrateValue(item.Name, item.Value);
        _editorVisible = true;
    }

    private void CloseEditor()
    {
        _editorVisible = false;
    }

    private async Task OnNameChangedAsync()
    {
        _form.NumberValue = "0";
        _form.BoolValue = false;
        _form.SelectValue = string.Empty;
        _form.MultiValues.Clear();
        _form.TextValue = string.Empty;
        _form.RegionValue = string.Empty;
        _form.Headers.Clear();
        if (CurrentType == "headers")
        {
            _form.Headers.Add(new HeaderItem());
        }
        await Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_form.Name))
        {
            SetMessage(false, "请选择设置项");
            return;
        }

        if (_form.Scope == "group" && _form.GroupId <= 0)
        {
            SetMessage(false, "请选择分组");
            return;
        }

        if (Session.IsAdmin && _form.UserId <= 0)
        {
            SetMessage(false, "请选择用户");
            return;
        }

        _saving = true;

        var scopeId = _form.Scope == "group"
            ? _form.GroupId
            : (Session.IsAdmin ? _form.UserId : 0);

        if (_editMode == "edit")
        {
            var request = new SiteDefaultUpdateRequest
            {
                UserId = Session.IsAdmin ? _form.UserId : null,
                Value = BuildValue(),
                ScopeName = _form.Scope,
                ScopeId = scopeId,
                OldScopeName = _oldScopeName,
                OldScopeId = _oldScopeId
            };

            var response = await Api.PutAsync<object>($"site_defaults/{Uri.EscapeDataString(_originalName)}", request, Scope);
            _saving = false;

            if (response == null || (response.Code != 0 && response.Code != 200))
            {
                SetMessage(false, response?.Message ?? "保存失败");
                return;
            }
        }
        else
        {
            var request = new SiteDefaultCreateRequest
            {
                UserId = Session.IsAdmin ? _form.UserId : null,
                Name = _form.Name,
                Value = BuildValue(),
                ScopeName = _form.Scope,
                ScopeId = scopeId
            };

            var response = await Api.PostAsync<object>("site_defaults", request, Scope);
            _saving = false;

            if (response == null || (response.Code != 0 && response.Code != 200))
            {
                SetMessage(false, response?.Message ?? "保存失败");
                return;
            }
        }

        _editorVisible = false;
        SetMessage(true, "保存成功");
        await LoadAsync();
    }

    private async Task DeleteOneAsync(SiteDefaultItemDto item)
    {
        var ok = await Js.InvokeAsync<bool>("confirm", "确定删除该设置？");
        if (!ok)
        {
            return;
        }

        var path = BuildDeletePath(item);
        var response = await Api.DeleteAsync<object>(path, null, Scope);
        if (response == null || (response.Code != 0 && response.Code != 200))
        {
            SetMessage(false, response?.Message ?? "删除失败");
            return;
        }

        SetMessage(true, "删除成功");
        await LoadAsync();
    }

    private async Task DeleteSelectedAsync()
    {
        if (!_selectedKeys.Any())
        {
            return;
        }

        var ok = await Js.InvokeAsync<bool>("confirm", $"确定删除选中的{_selectedKeys.Count}个设置？");
        if (!ok)
        {
            return;
        }

        var selected = _items.Where(item => _selectedKeys.Contains(RowKey(item))).ToList();
        foreach (var item in selected)
        {
            await Api.DeleteAsync<object>(BuildDeletePath(item), null, Scope);
        }

        SetMessage(true, "批量删除成功");
        await LoadAsync();
    }

    private async Task SearchUsersAsync()
    {
        if (!Session.IsAdmin)
        {
            return;
        }

        var query = new Dictionary<string, string?>
        {
            ["page"] = "1",
            ["pageSize"] = "20",
            ["keyword"] = _userKeyword
        };

        var response = await Api.GetAsync<UserListResult>("users", ApiScope.Admin, query);
        _users.Clear();
        if (response?.Data?.List != null)
        {
            _users.AddRange(response.Data.List);
        }
    }

    private async Task OnUserKeywordKeyDown(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Enter", StringComparison.OrdinalIgnoreCase))
        {
            await SearchUsersAsync();
        }
    }

    private static string FormatUser(UserItemDto user)
    {
        var name = string.IsNullOrWhiteSpace(user.Name) ? "-" : user.Name.Trim();
        var email = string.IsNullOrWhiteSpace(user.Email) ? "-" : user.Email.Trim();
        return $"{name} ({user.Id}) / {email}";
    }

    private static string NormalizeScope(string? scope)
    {
        return string.Equals(scope, "group", StringComparison.OrdinalIgnoreCase) ? "group" : "global";
    }

    private string BuildDeletePath(SiteDefaultItemDto item)
    {
        var scopeName = NormalizeScope(item.ScopeName);
        var scopeId = item.ScopeId;

        var builder = new List<string>
        {
            $"scope_name={Uri.EscapeDataString(scopeName)}",
            $"scope_id={scopeId}"
        };

        if (Session.IsAdmin && item.UserId > 0)
        {
            builder.Add($"user_id={item.UserId}");
        }

        return $"site_defaults/{Uri.EscapeDataString(item.Name ?? string.Empty)}?{string.Join("&", builder)}";
    }

    private void ResetForm()
    {
        _form.Name = string.Empty;
        _form.Scope = "global";
        _form.GroupId = 0;
        _form.UserId = 0;
        _form.NumberValue = "0";
        _form.BoolValue = false;
        _form.SelectValue = string.Empty;
        _form.MultiValues.Clear();
        _form.TextValue = string.Empty;
        _form.RegionValue = string.Empty;
        _form.Headers.Clear();
    }

    private string BuildValue()
    {
        return CurrentType switch
        {
            "number" => string.IsNullOrWhiteSpace(_form.NumberValue) ? "0" : _form.NumberValue.Trim(),
            "bool" => _form.BoolValue ? "1" : "0",
            "select" => _form.SelectValue,
            "multi" => string.Join(' ', _form.MultiValues.Where(value => !string.IsNullOrWhiteSpace(value))),
            "lines" => _form.TextValue,
            "headers" => JsonSerializer.Serialize(_form.Headers.Where(h => !string.IsNullOrWhiteSpace(h.Name))),
            "region" => string.IsNullOrWhiteSpace(_form.RegionValue)
                ? "none"
                : string.Join(',', _form.RegionValue.Split(new[] { ',', '\n', '\r', ' ' }, StringSplitOptions.RemoveEmptyEntries).Select(x => x.Trim())),
            _ => _form.TextValue
        };
    }

    private void HydrateValue(string? name, string? value)
    {
        var option = _options.FirstOrDefault(item => item.Value == name);
        var type = option?.Type ?? "text";
        var raw = value ?? string.Empty;

        if (type == "number")
        {
            _form.NumberValue = string.IsNullOrWhiteSpace(raw) ? "0" : raw;
            return;
        }

        if (type == "bool")
        {
            _form.BoolValue = raw == "1" || raw.Equals("true", StringComparison.OrdinalIgnoreCase) || raw.Equals("on", StringComparison.OrdinalIgnoreCase);
            return;
        }

        if (type == "select")
        {
            _form.SelectValue = raw;
            return;
        }

        if (type == "multi")
        {
            _form.MultiValues = raw.Split(new[] { ' ', ',', ';', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(item => item.Trim())
                .Where(item => !string.IsNullOrWhiteSpace(item))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
            return;
        }

        if (type == "headers")
        {
            _form.Headers.Clear();
            try
            {
                var parsed = JsonSerializer.Deserialize<List<HeaderItem>>(raw, new JsonSerializerOptions(JsonSerializerDefaults.Web));
                if (parsed != null)
                {
                    _form.Headers.AddRange(parsed.Where(h => h != null));
                }
            }
            catch
            {
                // ignore parse error
            }

            if (_form.Headers.Count == 0)
            {
                _form.Headers.Add(new HeaderItem());
            }
            return;
        }

        if (type == "region")
        {
            _form.RegionValue = raw == "none" ? string.Empty : raw;
            return;
        }

        _form.TextValue = raw;
    }

    private void AddHeader()
    {
        _form.Headers.Add(new HeaderItem());
    }

    private void RemoveHeader(int index)
    {
        if (index < 0 || index >= _form.Headers.Count)
        {
            return;
        }

        _form.Headers.RemoveAt(index);
    }

    private void ToggleMulti(string value, ChangeEventArgs args)
    {
        var isChecked = args?.Value is bool b && b;
        if (isChecked)
        {
            if (!_form.MultiValues.Contains(value, StringComparer.OrdinalIgnoreCase))
            {
                _form.MultiValues.Add(value);
            }
        }
        else
        {
            _form.MultiValues.RemoveAll(v => string.Equals(v, value, StringComparison.OrdinalIgnoreCase));
        }
    }

    private void ToggleSelectAll(ChangeEventArgs args)
    {
        var checkedAll = args?.Value is bool b && b;
        if (!checkedAll)
        {
            _selectedKeys.Clear();
            return;
        }

        foreach (var item in _items)
        {
            _selectedKeys.Add(RowKey(item));
        }
    }

    private void ToggleSelected(string key, ChangeEventArgs args)
    {
        var isChecked = args?.Value is bool b && b;
        if (isChecked)
        {
            _selectedKeys.Add(key);
        }
        else
        {
            _selectedKeys.Remove(key);
        }
    }

    private void SetMessage(bool ok, string message)
    {
        _messageOk = ok;
        _message = message;
    }

    private static string RowKey(SiteDefaultItemDto item)
    {
        return $"{item.Name}|{item.ScopeName}|{item.ScopeId}|{item.UserId}";
    }

    private string ScopeLabel(SiteDefaultItemDto item)
    {
        if (string.Equals(item.ScopeName, "group", StringComparison.OrdinalIgnoreCase))
        {
            if (!string.IsNullOrWhiteSpace(item.GroupName))
            {
                return $"分组({item.GroupName})";
            }
            return "分组";
        }

        return "全局";
    }

    private string SettingLabel(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return string.Empty;
        }

        return _options.FirstOrDefault(option => option.Value == name)?.Label ?? name;
    }

    private string FormatDisplayValue(SiteDefaultItemDto item)
    {
        var option = _options.FirstOrDefault(o => o.Value == item.Name);
        if (option == null)
        {
            return item.Value ?? string.Empty;
        }

        var raw = item.Value ?? string.Empty;

        if (option.Type == "bool")
        {
            return raw == "1" || raw.Equals("true", StringComparison.OrdinalIgnoreCase) || raw.Equals("on", StringComparison.OrdinalIgnoreCase)
                ? "是"
                : "否";
        }

        if (option.Type == "select")
        {
            var match = CurrentChoicesForOption(option).FirstOrDefault(choice => string.Equals(choice.Value, raw, StringComparison.OrdinalIgnoreCase));
            return match?.Label ?? raw;
        }

        if (option.Type == "headers")
        {
            try
            {
                var parsed = JsonSerializer.Deserialize<List<HeaderItem>>(raw, new JsonSerializerOptions(JsonSerializerDefaults.Web));
                if (parsed != null && parsed.Count > 0)
                {
                    return string.Join("; ", parsed.Where(h => !string.IsNullOrWhiteSpace(h.Name)).Select(h => $"{h.Name}: {h.Value}"));
                }
            }
            catch
            {
                // ignore parse error
            }
        }

        if (option.Type == "region")
        {
            return string.Equals(raw, "none", StringComparison.OrdinalIgnoreCase) ? "不设置" : raw;
        }

        return raw;
    }

    private IReadOnlyList<ChoiceOption> CurrentChoicesForOption(SettingOption option)
    {
        if (string.Equals(option.ChoicesKey, "cc_rules", StringComparison.OrdinalIgnoreCase))
        {
            var list = new List<ChoiceOption> { new("不设置", "0") };
            list.AddRange(_ccGroups.Select(group => new ChoiceOption(group.Name ?? $"规则{group.Id}", group.Id.ToString(CultureInfo.InvariantCulture))));
            return list;
        }

        if (string.Equals(option.ChoicesKey, "dns_providers", StringComparison.OrdinalIgnoreCase))
        {
            return _dnsApis.Select(api => new ChoiceOption(api.Name ?? $"DNS{api.Id}", api.Id.ToString(CultureInfo.InvariantCulture))).ToList();
        }

        return option.Choices;
    }

    private sealed class EditorForm
    {
        public string Name { get; set; } = string.Empty;
        public string Scope { get; set; } = "global";
        public long GroupId { get; set; }
        public long UserId { get; set; }

        public string NumberValue { get; set; } = "0";
        public bool BoolValue { get; set; }
        public string SelectValue { get; set; } = string.Empty;
        public List<string> MultiValues { get; set; } = new();
        public string TextValue { get; set; } = string.Empty;
        public string RegionValue { get; set; } = string.Empty;
        public List<HeaderItem> Headers { get; set; } = new();
    }

    private sealed class HeaderItem
    {
        public string? Name { get; set; }
        public string? Value { get; set; }
    }

    private sealed record ChoiceOption(string Label, string Value);

    private sealed class SettingOption
    {
        public SettingOption(string label, string value, string type, IReadOnlyList<ChoiceOption>? choices = null, string? choicesKey = null)
        {
            Label = label;
            Value = value;
            Type = type;
            Choices = choices ?? Array.Empty<ChoiceOption>();
            ChoicesKey = choicesKey;
        }

        public string Label { get; }
        public string Value { get; }
        public string Type { get; }
        public IReadOnlyList<ChoiceOption> Choices { get; }
        public string? ChoicesKey { get; }
    }

