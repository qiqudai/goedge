    private static string BuildCurrentCsv(IReadOnlyList<BlockCurrentItem> rows)
    {
        var sb = new StringBuilder();
        sb.AppendLine("site_id,domain,ip,location,filter,block_time,release_time");
        foreach (var item in rows)
        {
            sb.AppendLine(string.Join(',',
                Csv(item.SiteId.ToString()),
                Csv(item.Domain),
                Csv(item.Ip),
                Csv(item.Location),
                Csv(item.Filter),
                Csv(FormatTime(item.BlockTime)),
                Csv(FormatTime(item.ReleaseTime))));
        }

        return sb.ToString();
    }

    private static string BuildHistoryCsv(IReadOnlyList<BlockHistoryItem> rows)
    {
        var sb = new StringBuilder();
        sb.AppendLine("site_id,domain,ip,location,filter,block_time,unblock_type");
        foreach (var item in rows)
        {
            sb.AppendLine(string.Join(',',
                Csv(item.SiteId.ToString()),
                Csv(item.Domain),
                Csv(item.Ip),
                Csv(item.Location),
                Csv(item.Filter),
                Csv(FormatTime(item.BlockTime)),
                Csv(item.IsManual ? "manual" : "auto")));
        }

        return sb.ToString();
    }

    private static string Csv(string? value)
    {
        var escaped = (value ?? string.Empty).Replace("\"", "\"\"");
        return $"\"{escaped}\"";
    }

    private static string? EmptyToNull(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? null : value;
    }

    private static string FormatTime(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "-";
        }

        if (DateTime.TryParse(value, out var parsed))
        {
            return parsed.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");
        }

        return value;
    }

    private sealed class BlockPageQuery
    {
        public int Page { get; set; } = 1;
        public int PageSize { get; set; } = 10;
    }

