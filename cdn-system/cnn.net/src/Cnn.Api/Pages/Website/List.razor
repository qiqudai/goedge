    private async Task SubmitBatchAsync()
    {
        if (_saving)
        {
            return;
        }

        if (!_selectedIds.Any())
        {
            return;
        }

        _saving = true;

        SiteBatchUpdateRequest? request = null;

        if (_batchMode == "settings")
        {
            request = BuildCommonBatchRequest();
            if (request == null)
            {
                _saving = false;
                await Js.InvokeVoidAsync("alert", "请先勾选至少一个修改项");
                return;
            }
        }
        else if (_batchMode == "json")
        {
            try
            {
                request = JsonSerializer.Deserialize<SiteBatchUpdateRequest>(_batchJson, new JsonSerializerOptions(JsonSerializerDefaults.Web));
            }
            catch
            {
                _saving = false;
                await Js.InvokeVoidAsync("alert", "JSON格式错误");
                return;
            }

            request ??= new SiteBatchUpdateRequest();
        }
        else if (_batchMode == "cname-domain")
        {
            if (string.IsNullOrWhiteSpace(_batchCnameDomain))
            {
                _saving = false;
                await Js.InvokeVoidAsync("alert", "请选择 CNAME 域名");
                return;
            }

            request = new SiteBatchUpdateRequest
            {
                CnameDomain = _batchCnameDomain.Trim()
            };
        }
        else if (_batchMode == "cname-mode")
        {
            request = new SiteBatchUpdateRequest
            {
                CnameMode = string.IsNullOrWhiteSpace(_batchCnameMode) ? "custom" : _batchCnameMode.Trim()
            };
        }
        else if (_batchMode == "node-group")
        {
            if (_batchEnableBackupGroup && _batchBackupNodeGroupId <= 0)
            {
                _saving = false;
                await Js.InvokeVoidAsync("alert", "启用备用线路组时，请选择备用线路组");
                return;
            }

            if (_batchRegionId <= 0 && _batchNodeGroupId <= 0 && !_batchEnableBackupGroup)
            {
                _saving = false;
                await Js.InvokeVoidAsync("alert", "请至少选择一个线路分组修改项");
                return;
            }

            request = new SiteBatchUpdateRequest
            {
                RegionId = _batchRegionId > 0 ? _batchRegionId : null,
                NodeGroupId = _batchNodeGroupId > 0 ? _batchNodeGroupId : null,
                BackupNodeGroupId = _batchEnableBackupGroup && _batchBackupNodeGroupId > 0 ? _batchBackupNodeGroupId : null,
                EnableBackupGroup = _batchEnableBackupGroup ? true : null
            };
        }

        if (request == null)
        {
            _saving = false;
            return;
        }

        request.Ids = _selectedIds.ToList();
        var result = await Api.PostAsync<object>("sites/batch_update", request, Scope);
        _saving = false;
        if (result?.Code != ErrorCodes.Success)
        {
            await Js.InvokeVoidAsync("alert", result?.Message ?? "批量修改提交失败");
            return;
        }

        _batchVisible = false;
        _selectedIds.Clear();
        await Js.InvokeVoidAsync("alert", "批量修改已提交");
        await RefreshListAsync();
    }

    private SiteBatchUpdateRequest? BuildCommonBatchRequest()
    {
        var request = new SiteBatchUpdateRequest();
        var hasAny = false;
        Dictionary<string, object?>? settings = null;

        if (_batchFlags.UserPackageId)
        {
            request.UserPackageId = _batchForm.UserPackageId;
            hasAny = true;
        }

        if (_batchFlags.GroupIds)
        {
            request.GroupIds = _batchForm.GroupIds.Count > 0 ? _batchForm.GroupIds.ToList() : Array.Empty<long>();
            request.GroupId = request.GroupIds.FirstOrDefault();
            hasAny = true;
        }

        if (_batchFlags.DnsProviderId)
        {
            request.DnsProviderId = _batchForm.DnsProviderId;
            hasAny = true;
        }

        if (_batchFlags.HttpListen)
        {
            request.HttpListen = ParseFields(_batchForm.HttpListenInput);
            hasAny = true;
        }

        if (_batchFlags.HttpsListen)
        {
            request.HttpsListen = ParseFields(_batchForm.HttpsListenInput);
            hasAny = true;
        }

        if (_batchFlags.HttpEnable)
        {
            settings ??= new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);
            settings["http_enable"] = _batchForm.HttpEnable;
            hasAny = true;
        }

        if (_batchFlags.HttpsEnable)
        {
            settings = SetNestedSetting(settings, new[] { "https", "enable" }, _batchForm.HttpsEnable);
            hasAny = true;
        }

        if (_batchFlags.HttpsForce)
        {
            settings = SetNestedSetting(settings, new[] { "https", "force" }, _batchForm.HttpsForce);
            settings = SetNestedSetting(settings, new[] { "https", "redirect_port" }, string.IsNullOrWhiteSpace(_batchForm.HttpsForcePort) ? "443" : _batchForm.HttpsForcePort.Trim());
            hasAny = true;
        }

        if (_batchFlags.HttpsHsts)
        {
            settings = SetNestedSetting(settings, new[] { "https", "hsts" }, _batchForm.HttpsHsts);
            hasAny = true;
        }

        if (_batchFlags.HttpsHttp2)
        {
            settings = SetNestedSetting(settings, new[] { "https", "http2" }, _batchForm.HttpsHttp2);
            hasAny = true;
        }

        if (_batchFlags.HttpsHttp3)
        {
            settings = SetNestedSetting(settings, new[] { "https", "http3" }, _batchForm.HttpsHttp3);
            hasAny = true;
        }

        if (_batchFlags.HttpsOcsp)
        {
            settings = SetNestedSetting(settings, new[] { "https", "ocsp_stapling" }, _batchForm.HttpsOcsp);
            hasAny = true;
        }

        if (_batchFlags.BackendProtocol)
        {
            request.BackendProtocol = string.IsNullOrWhiteSpace(_batchForm.BackendProtocol) ? null : _batchForm.BackendProtocol.Trim();
            settings ??= new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);
            settings["backend_protocol"] = request.BackendProtocol;
            hasAny = true;
        }

        if (_batchFlags.BalanceWay)
        {
            request.BalanceWay = string.IsNullOrWhiteSpace(_batchForm.BalanceWay) ? null : _batchForm.BalanceWay.Trim();
            hasAny = true;
        }

        if (_batchFlags.Backends)
        {
            request.Backends = ParseFields(_batchForm.BackendsInput);
            hasAny = true;
        }

        if (settings is { Count: > 0 })
        {
            request.Settings = settings;
        }

        return hasAny ? request : null;
    }

