    private static List<string> ParseFields(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return new List<string>();
        }

        return raw.Split(new[] { '\n', '\r', ',', ';', ' ' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(item => item.Trim())
            .Where(item => !string.IsNullOrWhiteSpace(item))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static string BuildSimpleBatchCreateData(string? domainsRaw, string? backendsRaw)
    {
        var domains = ParseFields(domainsRaw);
        var backends = ParseFields(backendsRaw);
        if (domains.Count == 0)
        {
            return string.Empty;
        }

        var backendSegment = backends.Count > 0 ? $"|ip={string.Join(",", backends)}" : string.Empty;
        var lines = domains.Select(domain => $"domain={domain}{backendSegment}");
        return string.Join('\n', lines);
    }

    private static string? ValidateBatchCreateData(string mode, string data)
    {
        if (string.IsNullOrWhiteSpace(data))
        {
            return "请输入网站数据";
        }

        var lines = data.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(line => line.Trim())
            .Where(line => !string.IsNullOrWhiteSpace(line))
            .ToList();
        if (lines.Count == 0)
        {
            return "请输入网站数据";
        }

        foreach (var line in lines)
        {
            var segments = line.Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            var domainSegment = segments.FirstOrDefault(segment => segment.StartsWith("domain=", StringComparison.OrdinalIgnoreCase));
            if (string.IsNullOrWhiteSpace(domainSegment))
            {
                return mode == "advanced" ? "高级模式每行都必须包含 domain=..." : "批量数据格式不正确";
            }

            var domains = domainSegment["domain=".Length..]
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(domain => !string.IsNullOrWhiteSpace(domain))
                .ToList();
            if (domains.Count == 0)
            {
                return "每行至少需要一个有效域名";
            }

            var invalidDomain = domains.FirstOrDefault(domain => !IsValidBatchDomain(domain));
            if (!string.IsNullOrWhiteSpace(invalidDomain))
            {
                return $"域名格式不正确：{invalidDomain}";
            }

            var ipSegment = segments.FirstOrDefault(segment => segment.StartsWith("ip=", StringComparison.OrdinalIgnoreCase));
            if (string.IsNullOrWhiteSpace(ipSegment) || string.IsNullOrWhiteSpace(ipSegment["ip=".Length..]))
            {
                return "每行都必须包含 ip=源站";
            }
        }

        return null;
    }

    private static bool IsValidBatchDomain(string domain)
    {
        if (string.IsNullOrWhiteSpace(domain))
        {
            return false;
        }

        var trimmed = domain.Trim();
        if (global::System.Net.IPAddress.TryParse(trimmed, out _))
        {
            return true;
        }

        return global::System.Text.RegularExpressions.Regex.IsMatch(
            trimmed,
            @"^(?:\*\.)?(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\.)+[a-zA-Z]{2,}$");
    }

