    private async Task SubmitBatchCreateAsync()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        try
        {
            if (Session.IsAdmin && _batchCreate.UserId <= 0)
            {
                await Js.InvokeVoidAsync("alert", "管理员批量添加时必须指定用户ID");
                return;
            }

            var data = _batchCreate.Mode == "advanced"
                ? (_batchCreate.AdvancedData ?? string.Empty).Trim()
                : BuildSimpleBatchCreateData(_batchCreate.SimpleDomains, _batchCreate.SimpleBackends);

            if (string.IsNullOrWhiteSpace(data))
            {
                await Js.InvokeVoidAsync("alert", "请填写批量创建数据");
                return;
            }

            var validationError = ValidateBatchCreateData(_batchCreate.Mode, data);
            if (!string.IsNullOrWhiteSpace(validationError))
            {
                await Js.InvokeVoidAsync("alert", validationError);
                return;
            }

            var request = new SiteBatchCreateRequest
            {
                UserId = Session.IsAdmin ? _batchCreate.UserId : 0,
                UserPackageId = _batchCreate.UserPackageId,
                GroupId = _batchCreate.GroupId,
                DnsProviderId = _batchCreate.DnsProviderId,
                NodeGroupId = _batchCreate.NodeGroupId,
                Data = data,
                IgnoreError = _batchCreate.IgnoreError
            };

            var response = await Api.PostAsync<SiteBatchCreateResult>("sites/batch", request, Scope);
            if (response == null || (response.Code != 0 && response.Code != 200) || response.Data == null)
            {
                await Js.InvokeVoidAsync("alert", response?.Message ?? "批量创建提交失败");
                return;
            }

            _batchCreateResult = response.Data;
            await RefreshBatchProgressAsync();
            await Js.InvokeVoidAsync("alert", $"批量创建任务已提交。批次ID：{response.Data.BatchId}，任务数：{response.Data.Created}");
            await LoadDomainUsageAsync();
            await RefreshListAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task RefreshBatchProgressAsync()
    {
        if (_batchCreateResult == null || string.IsNullOrWhiteSpace(_batchCreateResult.BatchId) || _batchProgressLoading)
        {
            return;
        }

        _batchProgressLoading = true;
        try
        {
            var response = await Api.GetAsync<SiteBatchProgressResult>($"sites/batch/{_batchCreateResult.BatchId}/progress", Scope);
            if (response?.Data != null)
            {
                _batchProgress = response.Data;
            }
        }
        finally
        {
            _batchProgressLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        if (_editorDomainUsage?.Exceeded == true)
        {
            _saving = false;
            await Js.InvokeVoidAsync("alert", _editorDomainUsage.Message ?? "域名数量超过套餐限制");
            return;
        }

        ApiResponse<object>? result;
        if (_editing.Id > 0)
        {
            var request = _editing.ToUpdateRequest();
            result = await Api.PutAsync<object>($"sites/{_editing.Id}", request, Scope);
        }
        else
        {
            if (Session.IsAdmin && _editing.UserId <= 0)
            {
                _saving = false;
                await Js.InvokeVoidAsync("alert", "请选择所属用户");
                return;
            }

            var request = _editing.ToCreateRequest();
            result = await Api.PostAsync<object>("sites", request, Scope);
        }

        if (result?.Code != ErrorCodes.Success)
        {
            _saving = false;
            await Js.InvokeVoidAsync("alert", result?.Message ?? "网站保存失败");
            return;
        }

        _saving = false;
        _editorVisible = false;
        await Js.InvokeVoidAsync("alert", _editing.Id > 0 ? "网站已更新" : "网站已创建");
        await RefreshListAsync();
        await LoadDomainUsageAsync();
    }

