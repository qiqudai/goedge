    private sealed class SiteEditModel
    {
        public long Id { get; set; }
        public long UserId { get; set; }
        public long UserPackageId { get; set; }
        public long GroupId { get; set; }
        public List<long> GroupIds { get; set; } = new();
        public long NodeGroupId { get; set; }
        public long DnsProviderId { get; set; }
        public string SiteType { get; set; } = "website";
        public string DomainsInput { get; set; } = string.Empty;
        public string BackendsInput { get; set; } = string.Empty;
        public bool Enable { get; set; } = true;

        public static SiteEditModel FromItem(SiteListItem item)
        {
            return new SiteEditModel
            {
                Id = item.Id,
                UserId = item.UserId,
                UserPackageId = item.UserPackageId,
                GroupId = item.GroupId,
                GroupIds = item.GroupIds?.Where(id => id > 0).Distinct().ToList() ?? new List<long>(),
                NodeGroupId = item.NodeGroupId,
                DnsProviderId = item.DnsProviderId,
                SiteType = item.Settings != null && item.Settings.TryGetValue("site_type", out var val) ? val?.ToString() ?? "website" : "website",
                DomainsInput = item.Domains.Count > 0 ? string.Join("\n", item.Domains) : string.Empty,
                BackendsInput = item.Backends.Count > 0 ? string.Join("\n", item.Backends) : string.Empty,
                Enable = item.Status
            };
        }

        public SiteCreateRequest ToCreateRequest()
        {
            return new SiteCreateRequest
            {
                UserId = UserId,
                UserPackageId = UserPackageId,
                GroupId = GroupIds.FirstOrDefault(),
                GroupIds = GroupIds,
                NodeGroupId = NodeGroupId,
                DnsProviderId = DnsProviderId,
                SiteType = SiteType,
                DomainsInput = DomainsInput,
                BackendsInput = BackendsInput
            };
        }

        public SiteUpdateRequest ToUpdateRequest()
        {
            var domains = SplitLines(DomainsInput);
            var backends = SplitLines(BackendsInput);
            var settings = new Dictionary<string, object?>
            {
                ["site_type"] = string.IsNullOrWhiteSpace(SiteType) ? "website" : SiteType.Trim()
            };

            return new SiteUpdateRequest
            {
                UserPackageId = UserPackageId > 0 ? UserPackageId : null,
                GroupId = GroupIds.FirstOrDefault() > 0 ? GroupIds.FirstOrDefault() : null,
                GroupIds = GroupIds.Count > 0 ? GroupIds : null,
                DnsProviderId = DnsProviderId > 0 ? DnsProviderId : null,
                Domains = domains.Count > 0 ? domains : null,
                Backends = backends.Count > 0 ? backends : null,
                Enable = Enable,
                Settings = settings
            };
        }

        private static List<string> SplitLines(string? raw)
        {
            if (string.IsNullOrWhiteSpace(raw))
            {
                return new List<string>();
            }

            return raw.Split(new[] { '\n', '\r', ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(item => item.Trim())
                .Where(item => !string.IsNullOrWhiteSpace(item))
                .ToList();
        }
    }

