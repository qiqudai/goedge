    private Task BatchSingleActionAsync(long id, string action)
    {
        if (action == "delete")
        {
            return DeleteSingleSiteAsync(id);
        }

        return BatchActionAsync(action, new[] { id });
    }

    private async Task DeleteSingleSiteAsync(long id)
    {
        var result = await DeleteWorkflowHelper.ConfirmAndRequestAsync(
            Api,
            Js,
            $"sites/{id}",
            Scope,
            "确认删除该网站？",
            "网站删除任务已提交");
        if (!result.Success)
        {
            if (!result.Cancelled)
            {
                await Js.InvokeVoidAsync("alert", result.Message);
            }

            return;
        }

        await Js.InvokeVoidAsync("alert", result.Message);
        await RefreshListAsync();
        if (result.TaskId > 0)
        {
            await RefreshAfterTaskAsync();
        }
    }

    private async Task BatchActionAsync(string action, IReadOnlyList<long>? idsOverride = null)
    {
        var ids = (idsOverride ?? _selectedIds.ToList()).Where(id => id > 0).Distinct().ToList();
        if (ids.Count == 0)
        {
            return;
        }

        var needConfirm = action is "delete" or "clear_cache";
        if (needConfirm)
        {
            var text = action == "delete"
                ? $"确认删除选中的 {ids.Count} 个网站？"
                : $"确认清空选中的 {ids.Count} 个网站缓存？";
            var ok = await Js.InvokeAsync<bool>("confirm", text);
            if (!ok)
            {
                return;
            }
        }

        var request = new SiteBatchActionRequest
        {
            Action = action,
            Ids = ids
        };
        var response = await Api.PostAsync<SiteBatchActionResult>("sites/batch_action", request, Scope);
        if (response == null || response.Code != ErrorCodes.Success)
        {
            await Js.InvokeVoidAsync("alert", response?.Message ?? "网站批量操作提交失败");
            return;
        }

        var taskId = response.Data?.TaskId ?? 0;
        if (action == "clear_cache")
        {
            if (taskId > 0)
            {
                await Js.InvokeVoidAsync("alert", $"已创建清缓存任务：{taskId}");
            }
            else
            {
                await Js.InvokeVoidAsync("alert", "清缓存任务已提交");
            }
        }
        else if (taskId > 0)
        {
            await Js.InvokeVoidAsync("alert", $"批量{ResolveActionLabel(action)}任务已提交：{taskId}");
        }

        _selectedIds.Clear();
        await RefreshListAsync();
        if (taskId > 0)
        {
            await RefreshAfterTaskAsync();
        }
    }

    private async Task RefreshAfterTaskAsync()
    {
        await Task.Delay(1200);
        await RefreshListAsync();
        await InvokeAsync(StateHasChanged);
    }

    private static string ResolveActionLabel(string action) => action switch
    {
        "enable" => "启用",
        "disable" => "禁用",
        "delete" => "删除",
        "unlock" => "解除黑名单",
        "clear_cache" => "清缓存",
        _ => action
    };

    private IEnumerable<UserItemDto> FilterUsers(string keyword)
    {
        if (string.IsNullOrWhiteSpace(keyword))
        {
            return _users;
        }

        var kw = keyword.Trim();
        return _users.Where(user =>
            user.Id.ToString().Contains(kw, StringComparison.OrdinalIgnoreCase) ||
            (!string.IsNullOrWhiteSpace(user.Name) && user.Name.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrWhiteSpace(user.Email) && user.Email.Contains(kw, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrWhiteSpace(user.Phone) && user.Phone.Contains(kw, StringComparison.OrdinalIgnoreCase)));
    }

