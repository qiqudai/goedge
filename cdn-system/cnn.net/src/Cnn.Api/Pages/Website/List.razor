    private static Dictionary<string, object?> SetNestedSetting(
        Dictionary<string, object?>? target,
        IReadOnlyList<string> path,
        object? value)
    {
        target ??= new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);
        if (path == null || path.Count == 0)
        {
            return target;
        }

        Dictionary<string, object?> current = target;
        for (var i = 0; i < path.Count - 1; i++)
        {
            var key = path[i];
            if (!current.TryGetValue(key, out var nextRaw) || nextRaw is not Dictionary<string, object?> next)
            {
                next = new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);
                current[key] = next;
            }

            current = next;
        }

        current[path[^1]] = value;
        return target;
    }

