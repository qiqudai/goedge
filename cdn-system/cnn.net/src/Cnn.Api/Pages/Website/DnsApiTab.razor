@using global::System.Text.Json
@using Cnn.Common.Contracts
@using Cnn.Common.Contracts.Admin
@inject ApiClient Api
@inject ClientSession Session
@inject IJSRuntime Js

<MudStack Spacing="2" Class="dnsapi-section">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
        @if (Session.IsAdmin)
        {
            <MudSelect T="long"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Style="min-width:280px;"
                       @bind-Value="_selectedUserId"
                       @bind-Value:after="OnSelectedUserChangedAsync">
                <MudSelectItem Value="0">全部用户</MudSelectItem>
                @foreach (var user in _users)
                {
                    <MudSelectItem Value="@user.Id">@FormatUser(user)</MudSelectItem>
                }
            </MudSelect>
        }
        <MudTextField T="string"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Placeholder="搜索名称或 DNS 类型"
                      Style="min-width:240px;"
                      @bind-Value="_keyword"
                      @onkeydown="HandleKeywordKeydown" />
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="SearchAsync">
            搜索
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreate">
            添加 DNS 接口
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Error"
                   Disabled="@(!_selectedIds.Any())"
                   OnClick="DeleteBatchAsync">
            删除
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="RefreshAsync">
            刷新
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   OnClick="TogglePagingDiagnostics">
            @(_showPagingDiagnostics ? "隐藏分页诊断" : "显示分页诊断")
        </MudButton>
    </MudStack>

    @if (_showPagingDiagnostics)
    {
        <MudPaper Outlined="true" Class="pa-2">
            <MudText Typo="Typo.subtitle2">分页诊断</MudText>
            <MudText Typo="Typo.body2">stateKey: <code>website:dnsapi:table</code></MudText>
            <MudText Typo="Typo.body2">pagingEnabled: <code>@(_pageQuery.PagingEnabled ? "true" : "false")</code></MudText>
            <MudText Typo="Typo.body2">page: <code>@_pageQuery.Page</code>, pageSize: <code>@_pageQuery.PageSize</code></MudText>
            <MudText Typo="Typo.body2">loaded: <code>@_items.Count</code>, total: <code>@_total</code></MudText>
        </MudPaper>
    }

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <MudAlert Severity="@_messageSeverity" Variant="Variant.Filled" Dense="true">@_message</MudAlert>
    }

    <TablePager @ref="_tablePager"
                StateKey="website:dnsapi:table"
                Total="_total"
                DefaultPageSize="20"
                UnpagedLimit="1000"
                QueryChanged="OnPageQueryChangedAsync">
        <ChildContent>
            <MudTable Items="_items"
                      Dense="true"
                      Hover="true"
                      Striped="true"
                      Loading="@_loading">
                <HeaderContent>
                    <MudTh Style="width:56px">
                        <MudCheckBox T="bool" Value="@AllSelected" ValueChanged="ToggleAllChecked" />
                    </MudTh>
                    <MudTh Style="width:80px">ID</MudTh>
                    @if (Session.IsAdmin)
                    {
                        <MudTh Style="width:240px">用户</MudTh>
                    }
                    <MudTh>名称</MudTh>
                    <MudTh Style="width:180px">DNS</MudTh>
                    <MudTh>备注</MudTh>
                    <MudTh Style="width:160px">操作</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudCheckBox T="bool"
                                     Value="@_selectedIds.Contains(context.Id)"
                                     ValueChanged="value => ToggleChecked(context.Id, value)" />
                    </MudTd>
                    <MudTd>@context.Id</MudTd>
                    @if (Session.IsAdmin)
                    {
                        <MudTd>@FormatOwner(context.UserId)</MudTd>
                    }
                    <MudTd>@(string.IsNullOrWhiteSpace(context.Name) ? "-" : context.Name)</MudTd>
                    <MudTd>@FormatDnsType(context.Type)</MudTd>
                    <MudTd>@(string.IsNullOrWhiteSpace(context.Remark) ? "-" : context.Remark)</MudTd>
                    <MudTd>
                        <MudStack Row="true" Spacing="1">
                            <MudButton Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="@(() => OpenEdit(context))">
                                编辑
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(() => DeleteAsync(context))">
                                删除
                            </MudButton>
                        </MudStack>
                    </MudTd>
                </RowTemplate>
                <LoadingContent>
                    <MudText Typo="Typo.body2" Class="pa-3">加载中...</MudText>
                </LoadingContent>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Class="pa-3">暂无数据</MudText>
                </NoRecordsContent>
            </MudTable>
        </ChildContent>
    </TablePager>
</MudStack>

<MudOverlay Visible="@_editorVisible" DarkBackground="true" AutoClose="false" ZIndex="1200">
    <MudPaper Elevation="8" Class="pa-4 mx-auto my-8" Style="width:min(620px,96vw);">
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6">@(_editing.Id > 0 ? "编辑 DNS 接口" : "添加 DNS 接口")</MudText>
            <MudTextField T="string"
                          Label="名称"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          @bind-Value="_editing.Name" />
            <MudTextField T="string"
                          Label="备注"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          @bind-Value="_editing.Remark" />
            @if (Session.IsAdmin)
            {
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                    <MudTextField T="string"
                                  Label="用户搜索"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Placeholder="输入ID/邮箱/用户名/手机号"
                                  @bind-Value="_editorUserKeyword" />
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               OnClick="SearchEditorUsersAsync">
                        搜索
                    </MudButton>
                </MudStack>
                <MudSelect T="long"
                           Label="目标用户(可选)"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           @bind-Value="_editing.UserId">
                    <MudSelectItem Value="0">不指定</MudSelectItem>
                    @foreach (var user in _editorUsers)
                    {
                        <MudSelectItem Value="@user.Id">@FormatUser(user)</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudSelect T="string"
                       Label="DNS"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Value="_editing.Type"
                       ValueChanged="OnTypeChangedAsync">
                <MudSelectItem Value="@string.Empty">请选择</MudSelectItem>
                @foreach (var item in _types)
                {
                    <MudSelectItem Value="@item.Type">@item.Name</MudSelectItem>
                }
            </MudSelect>

            @if (CurrentType?.Fields?.Count > 0)
            {
                @foreach (var field in CurrentType.Fields)
                {
                    <MudTextField T="string"
                                  Label="@GetFieldLabel(_editing.Type, field)"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Value="@GetCredential(field)"
                                  ValueChanged="value => SetCredential(field, value)" />
                }
            }

            <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CloseEditor">取消</MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@_saving"
                           OnClick="SaveAsync">
                    保存
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>
</MudOverlay>

@code {
    private readonly List<DnsApiItemDto> _items = new();
    private readonly List<DnsApiTypeItem> _types = new();
    private readonly List<UserItemDto> _users = new();
    private readonly List<UserItemDto> _editorUsers = new();
    private readonly HashSet<long> _selectedIds = new();
    private bool _loading;
    private bool _saving;
    private bool _showPagingDiagnostics;
    private bool _editorVisible;
    private DnsApiEditor _editing = new();
    private string _editorUserKeyword = string.Empty;
    private string _keyword = string.Empty;
    private long _selectedUserId;
    private long _total;
    private TablePager? _tablePager;
    private TablePageQuery _pageQuery = new() { PagingEnabled = true, Page = 1, PageSize = 20 };
    private string? _message;
    private Severity _messageSeverity = Severity.Success;

    private ApiScope Scope => Session.IsAdmin ? ApiScope.Admin : ApiScope.User;

    private bool AllSelected => _items.Count > 0 && _items.All(item => _selectedIds.Contains(item.Id));

    private DnsApiTypeItem? CurrentType =>
        _types.FirstOrDefault(item => string.Equals(item.Type, _editing.Type, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadTypesAsync();
        if (Session.IsAdmin)
        {
            await LoadUsersAsync();
        }
        if (Session.IsAdmin)
        {
            await SearchEditorUsersAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _message = null;

        Dictionary<string, string?> query = new()
        {
            ["page"] = _pageQuery.Page.ToString(),
            ["pageSize"] = _pageQuery.PageSize.ToString(),
            ["keyword"] = string.IsNullOrWhiteSpace(_keyword) ? null : _keyword.Trim()
        };
        if (Session.IsAdmin && _selectedUserId > 0)
        {
            query["user_id"] = _selectedUserId.ToString();
        }

        var response = await Api.GetAsync<DnsApiListResult>("dnsapi", Scope, query);
        _selectedIds.Clear();
        _items.Clear();
        _total = 0;
        if (response?.Code == ErrorCodes.Success && response.Data?.List != null)
        {
            _items.AddRange(response.Data.List);
            _total = response.Data.Total;
        }
        else if (response != null)
        {
            SetMessage(false, response.Message);
        }
        else
        {
            SetMessage(false, "请求失败，请稍后重试");
        }

        _loading = false;
    }

    private Task OnSelectedUserChangedAsync()
    {
        if (_tablePager != null)
        {
            return _tablePager.SearchAsync();
        }

        _selectedIds.Clear();
        return LoadAsync();
    }

    private Task SearchAsync()
    {
        if (_tablePager != null)
        {
            return _tablePager.SearchAsync();
        }

        _selectedIds.Clear();
        return LoadAsync();
    }

    private Task HandleKeywordKeydown(KeyboardEventArgs args)
    {
        if (!string.Equals(args.Key, "Enter", StringComparison.OrdinalIgnoreCase))
        {
            return Task.CompletedTask;
        }

        return SearchAsync();
    }

    private Task OnPageQueryChangedAsync(TablePageQuery query)
    {
        _pageQuery = query;
        return LoadAsync();
    }

    private Task RefreshAsync()
    {
        if (_tablePager != null)
        {
            return _tablePager.RefreshAsync();
        }

        return LoadAsync();
    }

    private void TogglePagingDiagnostics()
    {
        _showPagingDiagnostics = !_showPagingDiagnostics;
    }

    private async Task LoadUsersAsync()
    {
        var query = new Dictionary<string, string?>
        {
            ["pageSize"] = "200"
        };
        var response = await Api.GetAsync<UserListResult>("users", ApiScope.Admin, query);
        _users.Clear();
        if (response?.Data?.List != null)
        {
            _users.AddRange(response.Data.List.OrderBy(x => x.Name ?? string.Empty).ThenBy(x => x.Id));
        }
    }

    private async Task LoadTypesAsync()
    {
        var providerRes = await Api.GetAsync<DnsProviderTypesResult>("dns/providers/types", Scope);
        var dnsApiRes = await Api.GetAsync<DnsApiTypesResult>("dnsapi/types", Scope);

        var allTypes = dnsApiRes?.Data?.Types ?? Array.Empty<DnsApiTypeItem>();
        var providerTypes = providerRes?.Data?.Types ?? Array.Empty<DnsProviderTypeItem>();
        var allow = providerTypes.Select(item => item.Type).Where(item => !string.IsNullOrWhiteSpace(item)).ToHashSet(StringComparer.OrdinalIgnoreCase);

        _types.Clear();
        if (allow.Count > 0)
        {
            _types.AddRange(allTypes.Where(item => allow.Contains(item.Type)));
        }
        else
        {
            _types.AddRange(allTypes);
        }
    }

    private void ToggleAllChecked(bool value)
    {
        if (value)
        {
            foreach (var item in _items)
            {
                _selectedIds.Add(item.Id);
            }

            return;
        }

        _selectedIds.Clear();
    }

    private void ToggleChecked(long id, bool value)
    {
        if (value)
        {
            _selectedIds.Add(id);
        }
        else
        {
            _selectedIds.Remove(id);
        }
    }

    private void OpenCreate()
    {
        _editing = new DnsApiEditor();
        if (Session.IsAdmin && _selectedUserId > 0)
        {
            _editing.UserId = _selectedUserId;
        }
        _editorUserKeyword = string.Empty;
        _editorUsers.Clear();
        if (Session.IsAdmin)
        {
            _ = SearchEditorUsersAsync();
        }
        _editorVisible = true;
    }

    private void OpenEdit(DnsApiItemDto item)
    {
        _editing = new DnsApiEditor
        {
            Id = item.Id,
            UserId = item.UserId,
            Name = item.Name ?? string.Empty,
            Remark = item.Remark ?? string.Empty,
            Type = item.Type ?? string.Empty
        };
        _editorUserKeyword = item.UserId > 0 ? item.UserId.ToString() : string.Empty;
        _editorUsers.Clear();
        if (Session.IsAdmin)
        {
            _ = SearchEditorUsersAsync();
        }

        if (!string.IsNullOrWhiteSpace(item.Auth))
        {
            try
            {
                using var doc = JsonDocument.Parse(item.Auth);
                if (doc.RootElement.ValueKind == JsonValueKind.Object)
                {
                    foreach (var prop in doc.RootElement.EnumerateObject())
                    {
                        _editing.Credentials[prop.Name] = prop.Value.ToString();
                    }
                }
            }
            catch
            {
                // ignore auth parse failures
            }
        }

        _editorVisible = true;
    }

    private void CloseEditor()
    {
        _editorVisible = false;
    }

    private Task OnTypeChangedAsync(string? type)
    {
        _editing.Type = type ?? string.Empty;
        _editing.Credentials = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        return Task.CompletedTask;
    }

    private string GetCredential(string field)
    {
        return _editing.Credentials.TryGetValue(field, out var value) ? value : string.Empty;
    }

    private void SetCredential(string field, string? value)
    {
        _editing.Credentials[field] = value ?? string.Empty;
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_editing.Name))
        {
            SetMessage(false, "请填写名称");
            return;
        }

        if (string.IsNullOrWhiteSpace(_editing.Type))
        {
            SetMessage(false, "请选择DNS类型");
            return;
        }

        var auth = JsonSerializer.Serialize(_editing.Credentials ?? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase));
        _saving = true;

        ApiResponse<object>? result;
        if (_editing.Id > 0)
        {
            var request = new DnsApiUpdateRequest
            {
                Name = _editing.Name?.Trim(),
                Remark = _editing.Remark?.Trim(),
                Type = _editing.Type?.Trim(),
                Auth = auth
            };
            result = await Api.PutAsync<object>($"dnsapi/{_editing.Id}", request, Scope);
        }
        else
        {
            var request = new DnsApiCreateRequest
            {
                UserId = Session.IsAdmin ? _editing.UserId : 0,
                Name = _editing.Name?.Trim(),
                Remark = _editing.Remark?.Trim(),
                Type = _editing.Type?.Trim(),
                Auth = auth
            };
            result = await Api.PostAsync<object>("dnsapi", request, Scope);
        }

        _saving = false;
        if (result?.Code != ErrorCodes.Success)
        {
            SetMessage(false, result?.Message ?? "保存失败");
            return;
        }

        SetMessage(true, result.Message);
        _editorVisible = false;
        await RefreshAsync();
    }

    private async Task SearchEditorUsersAsync()
    {
        if (!Session.IsAdmin)
        {
            return;
        }

        var query = new Dictionary<string, string?>
        {
            ["page"] = "1",
            ["pageSize"] = "50",
            ["keyword"] = _editorUserKeyword
        };

        var response = await Api.GetAsync<UserListResult>("users", ApiScope.Admin, query);
        _editorUsers.Clear();
        if (response?.Data?.List != null)
        {
            _editorUsers.AddRange(response.Data.List);
        }
    }

    private async Task DeleteAsync(DnsApiItemDto item)
    {
        var ok = await Js.InvokeAsync<bool>("confirm", "确认删除该 DNS 接口?");
        if (!ok)
        {
            return;
        }

        var result = await Api.DeleteAsync<object>($"dnsapi/{item.Id}", null, Scope);
        if (result?.Code != ErrorCodes.Success)
        {
            SetMessage(false, result?.Message ?? "删除失败");
            return;
        }

        SetMessage(true, result.Message);
        await RefreshAsync();
    }

    private async Task DeleteBatchAsync()
    {
        if (_selectedIds.Count == 0)
        {
            return;
        }

        var ok = await Js.InvokeAsync<bool>("confirm", $"确定删除选中的 {_selectedIds.Count} 个 DNS 接口?");
        if (!ok)
        {
            return;
        }

        foreach (var id in _selectedIds.ToList())
        {
            var result = await Api.DeleteAsync<object>($"dnsapi/{id}", null, Scope);
            if (result?.Code != ErrorCodes.Success)
            {
                SetMessage(false, result?.Message ?? $"删除失败(ID={id})");
                await RefreshAsync();
                return;
            }
        }

        SetMessage(true, "批量删除成功");
        await RefreshAsync();
    }

    private void SetMessage(bool success, string? message)
    {
        _messageSeverity = success ? Severity.Success : Severity.Error;
        _message = string.IsNullOrWhiteSpace(message) ? (success ? "操作已完成" : "操作失败，请稍后重试") : message;
    }

    private string FormatDnsType(string? type)
    {
        if (string.IsNullOrWhiteSpace(type))
        {
            return "-";
        }

        var match = _types.FirstOrDefault(item => string.Equals(item.Type, type, StringComparison.OrdinalIgnoreCase));
        return match?.Name ?? type;
    }

    private string FormatOwner(long userId)
    {
        var user = _users.FirstOrDefault(x => x.Id == userId);
        if (user == null)
        {
            return $"ID {userId}";
        }

        return FormatUser(user);
    }

    private static string GetFieldLabel(string? type, string field)
    {
        var t = type?.Trim().ToLowerInvariant() ?? string.Empty;
        return (t, field.ToLowerInvariant()) switch
        {
            ("aliyun", "access_key_id") => "AccessKey ID",
            ("aliyun", "access_key_secret") => "AccessKey Secret",
            ("huawei", "access_key_id") => "Access Key ID",
            ("huawei", "secret_access_key") => "Secret Access Key",
            ("cloudflare", "email") => "邮箱",
            ("cloudflare", "api_key") => "API Key",
            ("dnspod", "id") => "ID",
            ("dnspod", "token") => "Token",
            ("dnspod_intl", "id") => "ID",
            ("dnspod_intl", "token") => "Token",
            ("godaddy", "api_key") => "Key",
            ("godaddy", "api_secret") => "Secret",
            _ => field.ToUpperInvariant()
        };
    }

    private static string FormatUser(UserItemDto user)
    {
        var name = string.IsNullOrWhiteSpace(user.Name) ? "-" : user.Name.Trim();
        var email = string.IsNullOrWhiteSpace(user.Email) ? "-" : user.Email.Trim();
        return $"{name} ({user.Id}) / {email}";
    }

    private sealed class DnsApiEditor
    {
        public long Id { get; set; }
        public long UserId { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Remark { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
        public Dictionary<string, string> Credentials { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    }
}
