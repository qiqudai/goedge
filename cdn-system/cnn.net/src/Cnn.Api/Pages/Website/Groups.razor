@page "/website/groups"
@using Cnn.Common.Contracts
@using Cnn.Common.Contracts.Admin
@using Cnn.Api.Services.Deletion
@using Cnn.Api.Services.Tasks.Workflow
@inject ApiClient Api
@inject ClientSession Session
@inject IJSRuntime Js

<MudStack Spacing="2" Class="page-container">
    <MudText Typo="Typo.h5">网站分组</MudText>

    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="groups-toolbar">
        <MudStack Row="true" Spacing="1">
            @if (Session.IsAdmin)
            {
                <MudSelect T="long"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Style="min-width:280px;"
                           @bind-Value="_selectedUserId"
                           @bind-Value:after="OnSelectedUserChangedAsync">
                    <MudSelectItem Value="0">请选择用户</MudSelectItem>
                    @foreach (var user in _users)
                    {
                        <MudSelectItem Value="@user.Id">@FormatUserOption(user)</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreate">
                添加分组
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Error"
                       Disabled="@(!_selectedIds.Any())"
                       OnClick="BatchDeleteAsync">
                删除分组
            </MudButton>
        </MudStack>

        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
            <MudTextField T="string"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Placeholder="输入分组名称搜索"
                          Style="min-width:220px;"
                          @bind-Value="_query.Keyword"
                          @onkeydown="HandleKeywordKeydown" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SearchAsync">搜索</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="RefreshAsync">刷新</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="TogglePagingDiagnostics">
                @(_showPagingDiagnostics ? "隐藏分页诊断" : "显示分页诊断")
            </MudButton>
        </MudStack>
    </MudStack>

    @if (_showPagingDiagnostics)
    {
        <MudPaper Outlined="true" Class="pa-2">
            <MudText Typo="Typo.subtitle2">分页诊断</MudText>
            <MudText Typo="Typo.body2">stateKey: <code>website:groups:table</code></MudText>
            <MudText Typo="Typo.body2">pagingEnabled: <code>@(_pageQuery.PagingEnabled ? "true" : "false")</code></MudText>
            <MudText Typo="Typo.body2">page: <code>@_pageQuery.Page</code>, pageSize: <code>@_pageQuery.PageSize</code></MudText>
            <MudText Typo="Typo.body2">loaded: <code>@_items.Count</code>, total: <code>@_total</code></MudText>
        </MudPaper>
    }

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <MudAlert Severity="@_messageSeverity" Variant="Variant.Filled" Dense="true">
            @_message
        </MudAlert>
    }

    <TablePager @ref="_tablePager"
                StateKey="website:groups:table"
                Total="_total"
                DefaultPageSize="10"
                UnpagedLimit="1000"
                QueryChanged="OnPageQueryChangedAsync">
        <ChildContent>
            <MudTable Items="_items"
                      Dense="true"
                      Hover="true"
                      Striped="true"
                      Loading="@_loading">
                <HeaderContent>
                    <MudTh Style="width:56px">
                        <MudCheckBox T="bool" Value="@AllSelected" ValueChanged="ToggleAllChecked" />
                    </MudTh>
                    <MudTh Style="width:100px">ID</MudTh>
                    @if (Session.IsAdmin)
                    {
                        <MudTh>用户</MudTh>
                    }
                    <MudTh>分组名称</MudTh>
                    <MudTh>备注</MudTh>
                    <MudTh Style="width:180px">操作</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudCheckBox T="bool"
                                     Value="@_selectedIds.Contains(context.Id)"
                                     ValueChanged="value => ToggleChecked(context.Id, value)" />
                    </MudTd>
                    <MudTd>@context.Id</MudTd>
                    @if (Session.IsAdmin)
                    {
                        <MudTd>@FormatOwner(context.UserId)</MudTd>
                    }
                    <MudTd>@(string.IsNullOrWhiteSpace(context.Name) ? "-" : context.Name)</MudTd>
                    <MudTd>@(string.IsNullOrWhiteSpace(context.Remark) ? "-" : context.Remark)</MudTd>
                    <MudTd>
                        <MudStack Row="true" Spacing="1">
                            <MudButton Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="@(() => OpenEdit(context))">
                                编辑
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(() => DeleteAsync(context))">
                                删除
                            </MudButton>
                        </MudStack>
                    </MudTd>
                </RowTemplate>
                <LoadingContent>
                    <MudText Typo="Typo.body2" Class="pa-3">加载中...</MudText>
                </LoadingContent>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Class="pa-3">暂无数据</MudText>
                </NoRecordsContent>
            </MudTable>
        </ChildContent>
    </TablePager>
</MudStack>

<MudOverlay Visible="@_editorVisible" DarkBackground="true" AutoClose="false" ZIndex="1200">
    <MudPaper Elevation="8" Class="pa-4 mx-auto my-8" Style="width:min(560px,96vw);">
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6">@(_editing.Id > 0 ? "编辑分组" : "添加分组")</MudText>
            @if (Session.IsAdmin)
            {
                <MudSelect T="long"
                           Label="用户"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           @bind-Value="_editing.UserId">
                    <MudSelectItem Value="0">请选择用户</MudSelectItem>
                    @foreach (var user in _users)
                    {
                        <MudSelectItem Value="@user.Id">@FormatUserOption(user)</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudTextField Label="名称" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_editing.Name" />
            <MudTextField Label="备注" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" @bind-Value="_editing.Remark" />
            <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CloseEditor">取消</MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@_saving"
                           OnClick="SaveAsync">
                    保存
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>
</MudOverlay>

@code {
    private readonly List<SiteGroupDto> _items = new();
    private readonly List<UserItemDto> _users = new();
    private readonly HashSet<long> _selectedIds = new();
    private readonly GroupQuery _query = new();
    private bool _loading;
    private bool _saving;
    private bool _editorVisible;
    private bool _showPagingDiagnostics;
    private int _total;
    private long _selectedUserId;
    private TablePageQuery _pageQuery = new() { PagingEnabled = true, Page = 1, PageSize = 10 };
    private SiteGroupDto _editing = new();
    private string? _message;
    private Severity _messageSeverity = Severity.Success;
    private TablePager? _tablePager;

    protected override async Task OnInitializedAsync()
    {
        if (Session.IsAdmin)
        {
            await LoadUsersAsync();
        }
    }

    private ApiScope Scope => Session.IsAdmin ? ApiScope.Admin : ApiScope.User;

    private bool AllSelected => _items.Count > 0 && _items.All(item => _selectedIds.Contains(item.Id));

    private async Task LoadAsync()
    {
        _loading = true;
        _message = null;

        if (Session.IsAdmin && _selectedUserId <= 0)
        {
            _items.Clear();
            _selectedIds.Clear();
            _total = 0;
            _loading = false;
            return;
        }

        var query = new Dictionary<string, string?>
        {
            ["page"] = _query.Page.ToString(),
            ["pageSize"] = _query.PageSize.ToString(),
            ["keyword"] = _query.Keyword
        };
        if (Session.IsAdmin && _selectedUserId > 0)
        {
            query["user_id"] = _selectedUserId.ToString();
        }

        var response = await Api.GetAsync<SiteGroupListResult>("site_groups", Scope, query);
        _items.Clear();
        _selectedIds.Clear();
        if (response?.Code == ErrorCodes.Success && response.Data?.List != null)
        {
            _items.AddRange(response.Data.List);
            _total = response.Data.Total;
        }
        else
        {
            _total = 0;
            SetMessage(false, response?.Message ?? "请求失败，请刷新后重试");
        }

        _loading = false;
    }

    private Task OnSelectedUserChangedAsync()
    {
        _selectedIds.Clear();
        if (_tablePager != null)
        {
            return _tablePager.SearchAsync();
        }

        _query.Page = 1;
        return LoadAsync();
    }

    private async Task LoadUsersAsync()
    {
        var query = new Dictionary<string, string?>
        {
            ["pageSize"] = "200"
        };
        var response = await Api.GetAsync<UserListResult>("users", ApiScope.Admin, query);
        _users.Clear();
        if (response?.Data?.List != null)
        {
            _users.AddRange(response.Data.List.OrderBy(x => x.Name ?? string.Empty).ThenBy(x => x.Id));
        }
    }

    private async Task SearchAsync()
    {
        if (_tablePager != null)
        {
            await _tablePager.SearchAsync();
            return;
        }

        _query.Page = 1;
        await RefreshAsync();
    }

    private Task RefreshAsync()
    {
        if (_tablePager != null)
        {
            return _tablePager.RefreshAsync();
        }

        return LoadAsync();
    }

    private Task HandleKeywordKeydown(KeyboardEventArgs args)
    {
        if (!string.Equals(args.Key, "Enter", StringComparison.OrdinalIgnoreCase))
        {
            return Task.CompletedTask;
        }

        return SearchAsync();
    }

    private Task OnPageQueryChangedAsync(TablePageQuery query)
    {
        _pageQuery = query;
        _query.Page = query.Page;
        _query.PageSize = query.PageSize;
        return LoadAsync();
    }

    private void TogglePagingDiagnostics()
    {
        _showPagingDiagnostics = !_showPagingDiagnostics;
    }

    private void ToggleAllChecked(bool value)
    {
        if (value)
        {
            foreach (var item in _items)
            {
                _selectedIds.Add(item.Id);
            }

            return;
        }

        _selectedIds.Clear();
    }

    private void ToggleChecked(long id, bool value)
    {
        if (value)
        {
            _selectedIds.Add(id);
        }
        else
        {
            _selectedIds.Remove(id);
        }
    }

    private void OpenCreate()
    {
        _editing = new SiteGroupDto
        {
            UserId = Session.IsAdmin ? _selectedUserId : (Session.UserId ?? 0)
        };
        _editorVisible = true;
    }

    private void OpenEdit(SiteGroupDto item)
    {
        _editing = new SiteGroupDto
        {
            Id = item.Id,
            UserId = item.UserId,
            Name = item.Name,
            Remark = item.Remark
        };
        _editorVisible = true;
    }

    private void CloseEditor()
    {
        _editorVisible = false;
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_editing.Name))
        {
            SetMessage(false, "名称不能为空");
            return;
        }
        if (Session.IsAdmin && _editing.UserId <= 0)
        {
            SetMessage(false, "请选择用户");
            return;
        }

        _saving = true;
        var request = new SiteGroupUpsertRequest
        {
            UserId = Session.IsAdmin ? _editing.UserId : null,
            Name = _editing.Name,
            Remark = _editing.Remark
        };

        ApiResponse<object>? result;
        if (_editing.Id > 0)
        {
            result = await Api.PutAsync<object>($"site_groups/{_editing.Id}", request, Scope);
        }
        else
        {
            result = await Api.PostAsync<object>("site_groups", request, Scope);
        }

        _saving = false;
        if (result?.Code != ErrorCodes.Success)
        {
            SetMessage(false, result?.Message ?? "保存失败，请稍后重试");
            return;
        }

        SetMessage(true, result.Message);
        _editorVisible = false;
        await RefreshAsync();
    }

    private async Task DeleteAsync(SiteGroupDto item)
    {
        if (!Session.IsAdmin)
        {
            await DeleteDirectAsync(item.Id);
            return;
        }

        var result = await DeleteWorkflowHelper.ConfirmAndRequestAsync(
            Api,
            Js,
            $"site_groups/{item.Id}",
            ApiScope.Admin,
            "确认删除该分组?",
            "网站分组删除任务已提交");
        if (!result.Success)
        {
            if (!result.Cancelled)
            {
                SetMessage(false, result.Message);
            }

            return;
        }

        SetMessage(true, result.Message);
        await RefreshAsync();
        if (result.TaskId > 0)
        {
            await RefreshAfterDeleteTaskAsync();
        }
    }

    private async Task BatchDeleteAsync()
    {
        if (_selectedIds.Count == 0)
        {
            return;
        }

        var ok = await Js.InvokeAsync<bool>("confirm", $"确认删除选中的 {_selectedIds.Count} 个分组?");
        if (!ok)
        {
            return;
        }

        if (!Session.IsAdmin)
        {
            foreach (var id in _selectedIds.ToList())
            {
                await DeleteDirectAsync(id);
            }

            SetMessage(true, "批量删除成功");
            await RefreshAsync();
            return;
        }

        var taskIds = new List<long>();
        foreach (var id in _selectedIds.ToList())
        {
            var previewResult = await DeleteWorkflowHelper.PreviewAsync(Api, $"site_groups/{id}", ApiScope.Admin, $"无法获取删除预览(ID={id})");
            if (!previewResult.Success)
            {
                SetMessage(false, previewResult.Message);
                await RefreshAsync();
                return;
            }
        }

        foreach (var id in _selectedIds.ToList())
        {
            var result = await DeleteWorkflowHelper.RequestAsync(Api, $"site_groups/{id}", ApiScope.Admin, "网站分组删除任务已提交");
            if (!result.Success)
            {
                SetMessage(false, result.Message);
                await RefreshAsync();
                return;
            }

            if (result.TaskId > 0)
            {
                taskIds.Add(result.TaskId);
            }
        }

        SetMessage(true, taskIds.Count > 0 ? $"批量删除任务已提交，共 {taskIds.Count} 个任务" : "批量删除任务已提交");
        await RefreshAsync();
        if (taskIds.Count > 0)
        {
            await RefreshAfterDeleteTaskAsync();
        }
    }

    private async Task DeleteDirectAsync(long id)
    {
        var result = await Api.DeleteAsync<object>($"site_groups/{id}", null, Scope);
        if (result?.Code != ErrorCodes.Success)
        {
            SetMessage(false, result?.Message ?? $"删除失败(ID={id})");
            throw new InvalidOperationException(result?.Message ?? "delete failed");
        }
    }

    private async Task RefreshAfterDeleteTaskAsync()
    {
        await Task.Delay(1200);
        await RefreshAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void SetMessage(bool success, string? message)
    {
        _messageSeverity = success ? Severity.Success : Severity.Error;
        _message = string.IsNullOrWhiteSpace(message) ? (success ? "操作已完成" : "操作失败，请稍后重试") : message;
    }

    private string FormatOwner(long userId)
    {
        var user = _users.FirstOrDefault(x => x.Id == userId);
        if (user == null)
        {
            return $"ID {userId}";
        }

        return FormatUserOption(user);
    }

    private static string FormatUserOption(UserItemDto user)
    {
        var name = string.IsNullOrWhiteSpace(user.Name) ? "-" : user.Name.Trim();
        var email = string.IsNullOrWhiteSpace(user.Email) ? "-" : user.Email.Trim();
        return $"{name} ({user.Id}) / {email}";
    }

    private sealed class GroupQuery
    {
        public string Keyword { get; set; } = string.Empty;
        public int Page { get; set; } = 1;
        public int PageSize { get; set; } = 10;
    }
}
