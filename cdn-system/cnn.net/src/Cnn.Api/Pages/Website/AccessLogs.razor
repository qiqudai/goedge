@page "/website/logs/access"
@using global::System.Text
@using Cnn.Common.Contracts
@using Cnn.Common.Contracts.Admin
@inject ApiClient Api
@inject ClientSession Session
@inject IJSRuntime Js

<div class="page-container">
    <div class="page-title">访问日志</div>

    <div class="tab-bar">
        <button class='tab-button @(IsTab("query") ? "active" : "")' @onclick='@(() => SetTab("query"))'>日志查询</button>
        <button class='tab-button @(IsTab("history") ? "active" : "")' @onclick='@(() => SetTab("history"))'>申请记录</button>
    </div>

    @if (_activeTab == "query")
    {
        <div class="filter-bar">
            <input class="form-control" style="max-width: 220px" list="access-log-domains" @bind="_filters.Domain" placeholder="所有域名" />
            <datalist id="access-log-domains">
                @foreach (var domain in _domainOptions)
                {
                    <option value="@domain"></option>
                }
            </datalist>
            <InputText class="form-control" style="max-width: 220px" @bind-Value="_filters.Keyword" placeholder="域名/URI/IP" />
            <button class="btn btn-primary" @onclick="SearchAsync">搜索</button>
            <button class="btn btn-outline-secondary" @onclick="DownloadAsync">申请下载</button>
            <button class="btn btn-outline-secondary" @onclick="ToggleAdvanced">高级搜索 @(_advancedVisible ? "▲" : "▼")</button>
            <button class="btn btn-outline-secondary" @onclick="TogglePagingDiagnostics">
                @(_showPagingDiagnostics ? "隐藏分页诊断" : "显示分页诊断")
            </button>
        </div>

        @if (_showPagingDiagnostics)
        {
            <div class="alert alert-light py-2 px-3 mt-2 mb-2 small">
                <div><strong>分页诊断</strong></div>
                <div>stateKey: <code>website:access_logs:query:table</code></div>
                <div>pagingEnabled: <code>@(_queryPageQuery.PagingEnabled ? "true" : "false")</code></div>
                <div>page: <code>@_queryPageQuery.Page</code>, pageSize: <code>@_queryPageQuery.PageSize</code></div>
                <div>loaded: <code>@_items.Count</code>, total: <code>@_total</code></div>
            </div>
        }

        @if (_advancedVisible)
        {
            <div class="card config-card p-3">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">时间范围</label>
                        <div class="d-flex gap-2">
                            <input type="datetime-local" class="form-control" @bind="_filters.StartTime" />
                            <input type="datetime-local" class="form-control" @bind="_filters.EndTime" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">域名匹配</label>
                        <select class="form-select" @bind="_filters.DomainMode">
                            <option value="exact">精确</option>
                            <option value="fuzzy">模糊</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">客户端IP</label>
                        <InputText class="form-control" @bind-Value="_filters.ClientIp" placeholder="请输入IP地址" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">请求地址</label>
                        <InputText class="form-control" @bind-Value="_filters.Uri" placeholder="不包含域名部分的URI" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">URI匹配</label>
                        <select class="form-select" @bind="_filters.UriMode">
                            <option value="fuzzy">模糊</option>
                            <option value="exact">精确</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">请求方法</label>
                        <select class="form-select" @bind="_filters.Method">
                            <option value="">全部</option>
                            <option value="GET">GET</option>
                            <option value="POST">POST</option>
                            <option value="HEAD">HEAD</option>
                            <option value="PUT">PUT</option>
                            <option value="DELETE">DELETE</option>
                            <option value="OPTIONS">OPTIONS</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">状态码</label>
                        <InputText class="form-control" @bind-Value="_filters.Status" placeholder="如 200" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">状态范围</label>
                        <div class="d-flex gap-2">
                            <InputText class="form-control" @bind-Value="_filters.StatusMin" placeholder="最小" />
                            <InputText class="form-control" @bind-Value="_filters.StatusMax" placeholder="最大" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">访问端口</label>
                        <InputText class="form-control" @bind-Value="_filters.Port" placeholder="端口" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">节点ID</label>
                        <InputText class="form-control" @bind-Value="_filters.NodeId" placeholder="节点ID" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">节点IP</label>
                        <InputText class="form-control" @bind-Value="_filters.NodeIp" placeholder="节点IP" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">协议</label>
                        <select class="form-select" @bind="_filters.Scheme">
                            <option value="">全部</option>
                            <option value="http">http</option>
                            <option value="https">https</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">缓存状态</label>
                        <select class="form-select" @bind="_filters.CacheStatus">
                            <option value="">全部</option>
                            <option value="HIT">HIT</option>
                            <option value="MISS">MISS</option>
                            <option value="EXPIRED">EXPIRED</option>
                            <option value="STALE">STALE</option>
                            <option value="BYPASS">BYPASS</option>
                            <option value="REVALIDATED">REVALIDATED</option>
                            <option value="UPDATING">UPDATING</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">来源</label>
                        <InputText class="form-control" @bind-Value="_filters.Referer" placeholder="来源地址" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">浏览器</label>
                        <InputText class="form-control" @bind-Value="_filters.UserAgent" placeholder="浏览器标识" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">SSL协议</label>
                        <InputText class="form-control" @bind-Value="_filters.SslProtocol" placeholder="SSL协议" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">SSL套件</label>
                        <InputText class="form-control" @bind-Value="_filters.SslCipher" placeholder="SSL套件" />
                    </div>
                    <div class="col-12 d-flex gap-2">
                        <button class="btn btn-outline-secondary" @onclick="ResetFiltersAsync">重置</button>
                        <button class="btn btn-link" @onclick="HideAdvanced">收起搜索</button>
                    </div>
                </div>
            </div>
        }

        @if (HasActiveFilters)
        {
            <div class="d-flex flex-wrap gap-2">
                @if (_filters.StartTime.HasValue || _filters.EndTime.HasValue)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ClearTimeRange">时间范围: @TimeRangeText x</button>
                }
                @if (!string.IsNullOrWhiteSpace(_filters.Domain))
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ClearDomain">域名: @_filters.Domain x</button>
                }
                @if (!string.IsNullOrWhiteSpace(_filters.Keyword))
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ClearKeyword">关键字: @_filters.Keyword x</button>
                }
                <button class="btn btn-sm btn-link" @onclick="ResetFiltersAsync">清除</button>
            </div>
        }

        <TablePager @ref="_queryTablePager"
                    StateKey="website:access_logs:query:table"
                    Total="_total"
                    DefaultPageSize="20"
                    UnpagedLimit="1000"
                    QueryChanged="OnQueryPageQueryChangedAsync">
            <ChildContent>
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>时间</th>
                                <th>域名</th>
                                <th>协议</th>
                                <th>方法</th>
                                <th>URI</th>
                                <th>状态码</th>
                                <th>客户端IP</th>
                                <th>字节数</th>
                                <th>耗时</th>
                                <th>回源耗时</th>
                                <th>回源地址</th>
                                <th>缓存状态</th>
                                <th>来源</th>
                                <th>浏览器</th>
                                <th>节点ID</th>
                                <th>节点IP</th>
                                <th>SSL协议</th>
                                <th>SSL套件</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_loading)
                            {
                                <tr><td colspan="18">加载中...</td></tr>
                            }
                            else if (_items.Count == 0)
                            {
                                <tr><td colspan="18">暂无数据</td></tr>
                            }
                            else
                            {
                                @foreach (var row in _items)
                                {
                                    <tr>
                                        <td>@FormatTime(row.Timestamp)</td>
                                        <td>@(string.IsNullOrWhiteSpace(row.Host) ? "-" : row.Host)</td>
                                        <td>@(string.IsNullOrWhiteSpace(row.Scheme) ? "-" : row.Scheme)</td>
                                        <td>@(string.IsNullOrWhiteSpace(row.Method) ? "-" : row.Method)</td>
                                        <td>@(string.IsNullOrWhiteSpace(row.Uri) ? "-" : row.Uri)</td>
                                        <td><span class="@GetStatusClass(row.Status)">@row.Status</span></td>
                                        <td>@(string.IsNullOrWhiteSpace(row.RemoteAddr) ? "-" : row.RemoteAddr)</td>
                                        <td>@row.Bytes</td>
                                        <td>@FormatDuration(row.RequestTime)</td>
                                        <td>@FormatDuration(row.UpstreamResponseTime)</td>
                                        <td>@(string.IsNullOrWhiteSpace(row.UpstreamAddr) ? "-" : row.UpstreamAddr)</td>
                                        <td>@(string.IsNullOrWhiteSpace(row.UpstreamCacheStatus) ? "-" : row.UpstreamCacheStatus)</td>
                                        <td>@(string.IsNullOrWhiteSpace(row.HttpReferer) ? "-" : row.HttpReferer)</td>
                                        <td>@(string.IsNullOrWhiteSpace(row.HttpUserAgent) ? "-" : row.HttpUserAgent)</td>
                                        <td>@(string.IsNullOrWhiteSpace(row.NodeId) ? "-" : row.NodeId)</td>
                                        <td>@(string.IsNullOrWhiteSpace(row.NodeIp) ? "-" : row.NodeIp)</td>
                                        <td>@(string.IsNullOrWhiteSpace(row.SslProtocol) ? "-" : row.SslProtocol)</td>
                                        <td>@(string.IsNullOrWhiteSpace(row.SslCipher) ? "-" : row.SslCipher)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </ChildContent>
        </TablePager>
    }
    else
    {
        <div class="filter-bar">
            <InputText class="form-control" style="max-width: 260px" @bind-Value="_downloadQuery.Keyword" placeholder="文件名/申请ID" />
            <select class="form-select" style="max-width: 160px" @bind="_downloadQuery.State">
                <option value="">全部状态</option>
                <option value="pending">处理中</option>
                <option value="done">已完成</option>
                <option value="failed">失败</option>
            </select>
            <button class="btn btn-primary" @onclick="SearchDownloadsAsync">搜索</button>
            <button class="btn btn-outline-secondary" @onclick="TogglePagingDiagnostics">
                @(_showPagingDiagnostics ? "隐藏分页诊断" : "显示分页诊断")
            </button>
        </div>

        @if (_showPagingDiagnostics)
        {
            <div class="alert alert-light py-2 px-3 mt-2 mb-2 small">
                <div><strong>分页诊断</strong></div>
                <div>stateKey: <code>website:access_logs:history:table</code></div>
                <div>pagingEnabled: <code>@(_historyPageQuery.PagingEnabled ? "true" : "false")</code></div>
                <div>page: <code>@_historyPageQuery.Page</code>, pageSize: <code>@_historyPageQuery.PageSize</code></div>
                <div>loaded: <code>@_downloadItems.Count</code>, total: <code>@_downloadTotal</code></div>
            </div>
        }

        <TablePager @ref="_historyTablePager"
                    StateKey="website:access_logs:history:table"
                    Total="_downloadTotal"
                    DefaultPageSize="20"
                    UnpagedLimit="1000"
                    QueryChanged="OnDownloadPageQueryChangedAsync">
            <ChildContent>
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>文件名</th>
                                <th>状态</th>
                                <th>行数</th>
                                <th>申请时间</th>
                                <th>完成时间</th>
                                <th>错误信息</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_loading)
                            {
                                <tr><td colspan="7">加载中...</td></tr>
                            }
                            else if (_downloadItems.Count == 0)
                            {
                                <tr><td colspan="7">暂无申请记录</td></tr>
                            }
                            else
                            {
                                @foreach (var row in _downloadItems)
                                {
                                    <tr>
                                        <td>@row.Id</td>
                                        <td>@(string.IsNullOrWhiteSpace(row.FileName) ? "-" : row.FileName)</td>
                                        <td>@GetDownloadStateText(row.State)</td>
                                        <td>@row.Rows</td>
                                        <td>@FormatTime(row.CreatedAt)</td>
                                        <td>@FormatTime(row.FinishedAt)</td>
                                        <td>@(string.IsNullOrWhiteSpace(row.Error) ? "-" : row.Error)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </ChildContent>
        </TablePager>
    }
</div>

@code {
    private const int ExportPageSize = 200;
    private const int ExportMaxRows = 5000;

    private string _activeTab = "query";
    private bool _loading;
    private bool _advancedVisible = true;
    private bool _showPagingDiagnostics;
    private long _total;
    private readonly List<AccessLogItem> _items = new();
    private readonly List<AccessLogDownloadItem> _downloadItems = new();
    private long _downloadTotal;
    private readonly List<string> _domainOptions = new();
    private AccessLogFilters _filters = new();
    private DownloadHistoryFilters _downloadQuery = new();
    private TablePageQuery _queryPageQuery = new() { PagingEnabled = true, Page = 1, PageSize = 20 };
    private TablePageQuery _historyPageQuery = new() { PagingEnabled = true, Page = 1, PageSize = 20 };
    private TablePager? _queryTablePager;
    private TablePager? _historyTablePager;

    protected override async Task OnInitializedAsync()
    {
        await LoadDomainsAsync();
    }

    private ApiScope Scope => Session.IsAdmin ? ApiScope.Admin : ApiScope.User;

    private bool IsTab(string tab) => string.Equals(_activeTab, tab, StringComparison.OrdinalIgnoreCase);

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_filters.Domain)
        || !string.IsNullOrWhiteSpace(_filters.Keyword)
        || _filters.StartTime.HasValue
        || _filters.EndTime.HasValue;

    private string TimeRangeText => $"{FormatTimeValue(_filters.StartTime)} - {FormatTimeValue(_filters.EndTime)}";

    private async Task SetTab(string tab)
    {
        if (IsTab(tab))
        {
            return;
        }

        _activeTab = tab;
        if (_activeTab == "query")
        {
            if (_queryTablePager != null)
            {
                await _queryTablePager.RefreshAsync();
            }
        }
        else
        {
            if (_historyTablePager != null)
            {
                await _historyTablePager.RefreshAsync();
            }
        }
    }

    private void ToggleAdvanced()
    {
        _advancedVisible = !_advancedVisible;
    }

    private void HideAdvanced()
    {
        _advancedVisible = false;
    }

    private void ClearTimeRange()
    {
        _filters.StartTime = null;
        _filters.EndTime = null;
    }

    private void ClearDomain()
    {
        _filters.Domain = string.Empty;
    }

    private void ClearKeyword()
    {
        _filters.Keyword = string.Empty;
    }

    private async Task ResetFiltersAsync()
    {
        _filters = new AccessLogFilters();
        if (_queryTablePager != null)
        {
            await _queryTablePager.SearchAsync();
            return;
        }

        await LoadAsync();
    }

    private async Task SearchAsync()
    {
        if (_queryTablePager != null)
        {
            await _queryTablePager.SearchAsync();
            return;
        }

        _queryPageQuery = new TablePageQuery
        {
            PagingEnabled = _queryPageQuery.PagingEnabled,
            Page = 1,
            PageSize = _queryPageQuery.PageSize
        };
        await LoadAsync();
    }

    private async Task SearchDownloadsAsync()
    {
        if (_historyTablePager != null)
        {
            await _historyTablePager.SearchAsync();
            return;
        }

        _downloadQuery.Page = 1;
        await LoadDownloadHistoryAsync();
    }

    private Task OnQueryPageQueryChangedAsync(TablePageQuery query)
    {
        _queryPageQuery = query;
        return LoadAsync();
    }

    private Task OnDownloadPageQueryChangedAsync(TablePageQuery query)
    {
        _historyPageQuery = query;
        _downloadQuery.Page = query.Page;
        _downloadQuery.PageSize = query.PageSize;
        return LoadDownloadHistoryAsync();
    }

    private void TogglePagingDiagnostics()
    {
        _showPagingDiagnostics = !_showPagingDiagnostics;
    }

    private async Task DownloadAsync()
    {
        var fileName = $"access-logs-{DateTime.Now:yyyyMMddHHmmss}.csv";
        long applyId = 0;
        var applyResponse = await Api.PostAsync<AccessLogDownloadApplyResult>("logs/access/downloads", new AccessLogDownloadApplyRequest
        {
            Query = BuildApplyQueryModel(),
            StartTime = _filters.StartTime?.ToString("yyyy-MM-dd HH:mm:ss"),
            EndTime = _filters.EndTime?.ToString("yyyy-MM-dd HH:mm:ss"),
            FileName = fileName
        }, Scope);

        if (applyResponse?.Code != ErrorCodes.Success || applyResponse.Data == null)
        {
            await Js.InvokeVoidAsync("alert", applyResponse?.Message ?? "创建下载申请失败");
            return;
        }

        applyId = applyResponse.Data.Id;
        var rows = new List<AccessLogItem>();
        var page = 1;
        var success = true;
        string? error = null;
        while (rows.Count < ExportMaxRows)
        {
            var query = BuildQuery(page, ExportPageSize);
            var response = await Api.GetAsync<AccessLogListResult>("logs/access", Scope, query);
            var batch = response?.Data?.List?.ToList() ?? new List<AccessLogItem>();
            if (batch.Count == 0)
            {
                break;
            }

            rows.AddRange(batch);
            if (batch.Count < ExportPageSize)
            {
                break;
            }

            page++;
        }

        if (rows.Count == 0 && success)
        {
            await Js.InvokeVoidAsync("alert", "当前筛选条件下暂无可下载日志");
        }
        else
        {
            if (rows.Count > ExportMaxRows)
            {
                rows = rows.Take(ExportMaxRows).ToList();
            }

            var csv = BuildAccessCsv(rows);
            await Js.InvokeVoidAsync("cnn.downloadText", fileName, csv, "text/csv;charset=utf-8");
            if (rows.Count >= ExportMaxRows)
            {
                await Js.InvokeVoidAsync("alert", $"下载已完成（最多导出 {ExportMaxRows} 条）");
            }
        }

        if (applyId > 0)
        {
            var complete = await Api.PutAsync<bool>($"logs/access/downloads/{applyId}", new AccessLogDownloadCompleteRequest
            {
                Success = success,
                Rows = rows.Count,
                Error = error
            }, Scope);

            if (complete?.Code != ErrorCodes.Success)
            {
                await Js.InvokeVoidAsync("alert", complete?.Message ?? "更新下载记录失败");
            }
        }

        if (IsTab("history"))
        {
            await LoadDownloadHistoryAsync();
        }
    }

    private async Task LoadAsync()
    {
        if (_loading)
        {
            return;
        }

        _loading = true;
        var query = BuildQuery();
        var response = await Api.GetAsync<AccessLogListResult>("logs/access", Scope, query);
        _items.Clear();
        if (response?.Data?.List != null)
        {
            _items.AddRange(response.Data.List);
            _total = response.Data.Total;
        }
        else
        {
            _total = 0;
        }

        _loading = false;
    }

    private Dictionary<string, string?> BuildQuery()
    {
        return BuildQuery(_queryPageQuery.Page, _queryPageQuery.PageSize);
    }

    private Dictionary<string, string?> BuildQuery(int page, int pageSize)
    {
        var query = new Dictionary<string, string?>
        {
            ["page"] = page.ToString(),
            ["pageSize"] = pageSize.ToString(),
            ["domain"] = EmptyToNull(_filters.Domain),
            ["domain_mode"] = EmptyToNull(_filters.DomainMode),
            ["keyword"] = EmptyToNull(_filters.Keyword),
            ["client_ip"] = EmptyToNull(_filters.ClientIp),
            ["uri"] = EmptyToNull(_filters.Uri),
            ["uri_mode"] = EmptyToNull(_filters.UriMode),
            ["method"] = EmptyToNull(_filters.Method),
            ["status"] = EmptyToNull(_filters.Status),
            ["status_min"] = EmptyToNull(_filters.StatusMin),
            ["status_max"] = EmptyToNull(_filters.StatusMax),
            ["port"] = EmptyToNull(_filters.Port),
            ["node_id"] = EmptyToNull(_filters.NodeId),
            ["node_ip"] = EmptyToNull(_filters.NodeIp),
            ["scheme"] = EmptyToNull(_filters.Scheme),
            ["cache_status"] = EmptyToNull(_filters.CacheStatus),
            ["referer"] = EmptyToNull(_filters.Referer),
            ["user_agent"] = EmptyToNull(_filters.UserAgent),
            ["ssl_protocol"] = EmptyToNull(_filters.SslProtocol),
            ["ssl_cipher"] = EmptyToNull(_filters.SslCipher)
        };

        if (_filters.StartTime.HasValue && _filters.EndTime.HasValue)
        {
            query["start_time"] = _filters.StartTime.Value.ToString("yyyy-MM-dd HH:mm:ss");
            query["end_time"] = _filters.EndTime.Value.ToString("yyyy-MM-dd HH:mm:ss");
        }

        return query;
    }

    private AccessLogQuery BuildApplyQueryModel()
    {
        return new AccessLogQuery
        {
            Domain = EmptyToNull(_filters.Domain),
            DomainMode = EmptyToNull(_filters.DomainMode),
            Keyword = EmptyToNull(_filters.Keyword),
            ClientIp = EmptyToNull(_filters.ClientIp),
            Uri = EmptyToNull(_filters.Uri),
            UriMode = EmptyToNull(_filters.UriMode),
            Method = EmptyToNull(_filters.Method),
            Status = EmptyToNull(_filters.Status),
            StatusMin = EmptyToNull(_filters.StatusMin),
            StatusMax = EmptyToNull(_filters.StatusMax),
            Port = EmptyToNull(_filters.Port),
            NodeId = EmptyToNull(_filters.NodeId),
            NodeIp = EmptyToNull(_filters.NodeIp),
            Scheme = EmptyToNull(_filters.Scheme),
            CacheStatus = EmptyToNull(_filters.CacheStatus),
            Referer = EmptyToNull(_filters.Referer),
            UserAgent = EmptyToNull(_filters.UserAgent),
            SslProtocol = EmptyToNull(_filters.SslProtocol),
            SslCipher = EmptyToNull(_filters.SslCipher)
        };
    }

    private async Task LoadDownloadHistoryAsync()
    {
        if (_loading)
        {
            return;
        }

        _loading = true;
        var query = new Dictionary<string, string?>
        {
            ["page"] = _downloadQuery.Page.ToString(),
            ["pageSize"] = _downloadQuery.PageSize.ToString(),
            ["keyword"] = EmptyToNull(_downloadQuery.Keyword),
            ["state"] = EmptyToNull(_downloadQuery.State)
        };
        var response = await Api.GetAsync<AccessLogDownloadListResult>("logs/access/downloads", Scope, query);
        _downloadItems.Clear();
        if (response?.Data?.List != null)
        {
            _downloadItems.AddRange(response.Data.List);
            _downloadTotal = response.Data.Total;
        }
        else
        {
            _downloadTotal = 0;
        }

        _loading = false;
    }

    private static string BuildAccessCsv(IReadOnlyList<AccessLogItem> rows)
    {
        var sb = new StringBuilder();
        sb.AppendLine("timestamp,host,scheme,method,uri,status,remote_addr,bytes,request_time,upstream_response_time,upstream_addr,cache_status,referer,user_agent,node_id,node_ip,ssl_protocol,ssl_cipher");
        foreach (var row in rows)
        {
            sb.AppendLine(string.Join(',',
                Csv(FormatTime(row.Timestamp)),
                Csv(row.Host),
                Csv(row.Scheme),
                Csv(row.Method),
                Csv(row.Uri),
                Csv(row.Status.ToString()),
                Csv(row.RemoteAddr),
                Csv(row.Bytes.ToString()),
                Csv(row.RequestTime.ToString("0.###")),
                Csv(row.UpstreamResponseTime.ToString("0.###")),
                Csv(row.UpstreamAddr),
                Csv(row.UpstreamCacheStatus),
                Csv(row.HttpReferer),
                Csv(row.HttpUserAgent),
                Csv(row.NodeId),
                Csv(row.NodeIp),
                Csv(row.SslProtocol),
                Csv(row.SslCipher)));
        }

        return sb.ToString();
    }

    private static string Csv(string? value)
    {
        var escaped = (value ?? string.Empty).Replace("\"", "\"\"");
        return $"\"{escaped}\"";
    }

    private async Task LoadDomainsAsync()
    {
        var query = new Dictionary<string, string?>
        {
            ["page"] = "1",
            ["pageSize"] = "200"
        };
        var response = await Api.GetAsync<DomainListResult>("domains", Scope, query);
        _domainOptions.Clear();
        if (response?.Data?.List == null)
        {
            return;
        }

        foreach (var item in response.Data.List)
        {
            if (!string.IsNullOrWhiteSpace(item.Name))
            {
                _domainOptions.Add(item.Name.Trim());
            }
        }
    }

    private static string? EmptyToNull(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? null : value;
    }

    private static string FormatTimeValue(DateTime? value)
    {
        if (!value.HasValue)
        {
            return "-";
        }

        return value.Value.ToString("yyyy-MM-dd HH:mm:ss");
    }

    private static string FormatTime(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "-";
        }

        if (DateTime.TryParse(value, out var parsed))
        {
            return parsed.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");
        }

        return value;
    }

    private static string FormatDuration(double value)
    {
        if (value <= 0)
        {
            return "-";
        }

        return value.ToString("0.###");
    }

    private static string GetStatusClass(int status)
    {
        if (status >= 200 && status < 300)
        {
            return "text-success";
        }

        if (status >= 300 && status < 400)
        {
            return "text-warning";
        }

        if (status >= 400 && status < 500)
        {
            return "text-danger";
        }

        if (status >= 500)
        {
            return "text-danger fw-bold";
        }

        return string.Empty;
    }

    private static string GetDownloadStateText(string? state)
    {
        var normalized = state?.Trim().ToLowerInvariant() ?? string.Empty;
        return normalized switch
        {
            "done" => "已完成",
            "failed" => "失败",
            "pending" => "处理中",
            _ => string.IsNullOrWhiteSpace(state) ? "-" : state
        };
    }

