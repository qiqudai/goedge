@page "/system/upgrade"
@using global::System.Net.Http.Headers
@using Cnn.Common.Contracts.Admin
@using Cnn.Api.Services
@inject ApiClient Api
@inject IJSRuntime Js

@implements IDisposable

<div class="page-container">
    <div class="page-title">维护升级</div>

    <div class="tab-bar">
        <button class='tab-button @(IsTab("versions") ? "active" : "")' @onclick='@(() => SetTabAsync("versions"))'>版本管理</button>
        <button class='tab-button @(IsTab("sync") ? "active" : "")' @onclick='@(() => SetTabAsync("sync"))'>同步升级</button>
    </div>

    @if (_activeTab == "versions")
    {
        <div class="card config-card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>边缘节点版本管理</span>
                <button class="btn btn-link" @onclick="LoadVersionsAsync">刷新</button>
            </div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                    <InputText class="form-control" style="max-width: 240px" @bind-Value="_uploadVersion" placeholder="版本号，如 1.2.3" />
                    <InputFile OnChange="OnFileSelected" accept=".tar.gz,.zip" />
                    <button class="btn btn-primary" @onclick="UploadAsync" disabled="@_uploading">上传新版本</button>
                    <span class="text-muted">文件名将自动包含版本号，上传后写入数据库。</span>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>版本号</th>
                                <th>状态</th>
                                <th>灰度比例 %</th>
                                <th>上传时间</th>
                                <th>操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_versions.Count == 0)
                            {
                                <tr><td colspan="5">暂无数据</td></tr>
                            }
                            else
                            {
                                @foreach (var item in _versions)
                                {
                                    <tr>
                                        <td>@item.Version</td>
                                        <td>
                                            <span class="badge @GetVersionBadge(item.Status)">@GetStatusLabel(item.Status)</span>
                                        </td>
                                        <td>
                                            @if (string.Equals(item.Status, "gray", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <div class="d-flex align-items-center gap-2">
                                                    <input type="number" class="form-control form-control-sm" style="max-width: 100px" @bind="item.GrayPercent" />
                                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => UpdateGrayAsync(item)">更新</button>
                                                </div>
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }
                                        </td>
                                        <td>@item.UploadTime</td>
                                        <td>
                                            @if (!string.Equals(item.Status, "stable", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <button class="btn btn-sm btn-success" @onclick="() => SetStableAsync(item)">设为稳定版</button>
                                            }
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenSync(item)">同步此版本</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card config-card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>同步升级</span>
                <div class="d-flex gap-2">
                    <select class="form-select" style="max-width: 240px" @bind="_selectedVersion">
                        <option value="">选择版本</option>
                        @foreach (var item in _versions)
                        {
                            <option value="@item.Version">@item.Version</option>
                        }
                    </select>
                    <button class="btn btn-primary" @onclick="LoadNodesAsync" disabled="@string.IsNullOrWhiteSpace(_selectedVersion)">刷新节点</button>
                </div>
            </div>
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <span class="text-muted">区域分组:</span>
                        @foreach (var region in _regions)
                        {
                            <label class="form-check form-check-inline">
                                <input type="checkbox" class="form-check-input" checked="@_selectedRegions.Contains(region.Id)" @onchange="e => ToggleRegion(region, e)" />
                                <span class="form-check-label">@region.Name</span>
                            </label>
                        }
                    </div>
                    <button class="btn btn-primary" disabled="@(!_selectedNodeIds.Any() || string.IsNullOrWhiteSpace(_selectedVersion))" @onclick="UpgradeSelectedAsync">批量升级</button>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th></th>
                                <th>名称</th>
                                <th>IP</th>
                                <th>区域</th>
                                <th>所属分组</th>
                                <th>当前版本</th>
                                <th>最新版本</th>
                                <th>状态</th>
                                <th>操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_nodeRows.Count == 0)
                            {
                                <tr><td colspan="9">暂无数据</td></tr>
                            }
                            else
                            {
                                @foreach (var row in _nodeRows)
                                {
                                    <tr>
                                        <td>
                                            <input type="checkbox" class="form-check-input" checked="@row.Selected" @onchange="e => ToggleNode(row, e)" />
                                        </td>
                                        <td>@row.Name</td>
                                        <td>@row.Ip</td>
                                        <td>@row.RegionName</td>
                                        <td>@row.GroupName</td>
                                        <td>@row.CurrentVersion</td>
                                        <td>@row.LatestVersion</td>
                                        <td>
                                            <span class="badge @GetNodeStatusBadge(row)">@GetNodeStatusText(row)</span>
                                        </td>
                                        <td>
                                            <button class="btn btn-link btn-sm" @onclick="() => ShowLog(row)">日志</button>
                                            <button class="btn btn-link btn-sm" @onclick="() => UpgradeSingleAsync(row)">升级</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string _activeTab = "versions";
    private readonly List<AgentPackageItemView> _versions = new();
    private IBrowserFile? _uploadFile;
    private string _uploadVersion = string.Empty;
    private bool _uploading;

    private string _selectedVersion = string.Empty;
    private readonly List<NodeRow> _nodeRows = new();
    private readonly HashSet<long> _selectedNodeIds = new();
    private readonly HashSet<int> _selectedRegions = new();
    private readonly List<RegionGroup> _regions = new();
    private long _upgradeTaskId;
    private global::System.Timers.Timer? _pollTimer;
    private readonly Dictionary<long, AgentPackageUpgradeNodeDto> _upgradeStatus = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadVersionsAsync();
    }

    private bool IsTab(string tab) => string.Equals(_activeTab, tab, StringComparison.OrdinalIgnoreCase);

    private async Task SetTabAsync(string tab)
    {
        _activeTab = tab;
        if (_activeTab == "sync" && _versions.Count == 0)
        {
            await LoadVersionsAsync();
        }
    }

    private async Task LoadVersionsAsync()
    {
        var response = await Api.GetAsync<AgentPackageListResult>("packages", ApiScope.Admin);
        _versions.Clear();
        if (response?.Data?.List != null)
        {
            foreach (var item in response.Data.List)
            {
                _versions.Add(new AgentPackageItemView(item));
            }
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs args)
    {
        _uploadFile = args.File;
    }

    private async Task UploadAsync()
    {
        if (_uploading)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_uploadVersion) || _uploadFile == null)
        {
            await Js.InvokeVoidAsync("alert", "请先选择版本号和文件");
            return;
        }

        _uploading = true;
        using var content = new MultipartFormDataContent();
        content.Add(new StringContent(_uploadVersion), "version");

        await using var stream = _uploadFile.OpenReadStream(1024L * 1024L * 500L);
        using var fileContent = new StreamContent(stream);
        fileContent.Headers.ContentType = new MediaTypeHeaderValue(_uploadFile.ContentType);
        content.Add(fileContent, "file", _uploadFile.Name);

        var response = await Api.PostFormAsync<AgentPackageItemDto>("packages", content, ApiScope.Admin);
        if (response?.Data == null)
        {
            await Js.InvokeVoidAsync("alert", response?.Message ?? "上传失败");
        }
        else
        {
            _uploadVersion = string.Empty;
            _uploadFile = null;
            await LoadVersionsAsync();
        }

        _uploading = false;
    }

    private async Task UpdateGrayAsync(AgentPackageItemView item)
    {
        var payload = new AgentPackageGrayRequest { Version = item.Version, Percent = item.GrayPercent };
        await Api.PostAsync<object>("packages/grayscale", payload, ApiScope.Admin);
        await LoadVersionsAsync();
    }

    private async Task SetStableAsync(AgentPackageItemView item)
    {
        var payload = new AgentPackageStableRequest { Version = item.Version };
        await Api.PostAsync<object>("packages/stable", payload, ApiScope.Admin);
        await LoadVersionsAsync();
    }

    private async Task OpenSync(AgentPackageItemView item)
    {
        _activeTab = "sync";
        _selectedVersion = item.Version ?? string.Empty;
        await LoadNodesAsync();
    }

    private async Task LoadNodesAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedVersion))
        {
            return;
        }

        var query = new Dictionary<string, string?> { ["version"] = _selectedVersion };
        var response = await Api.GetAsync<AgentPackageNodeListResult>("packages/nodes", ApiScope.Admin, query);
        _nodeRows.Clear();
        _selectedNodeIds.Clear();
        _selectedRegions.Clear();
        _regions.Clear();
        _upgradeStatus.Clear();

        if (response?.Data?.List != null)
        {
            var sorted = response.Data.List
                .OrderBy(x => x.RegionName ?? string.Empty)
                .ThenBy(x => x.GroupName ?? string.Empty)
                .ThenBy(x => x.Name ?? string.Empty);
            foreach (var item in sorted)
            {
                var row = new NodeRow(item);
                _nodeRows.Add(row);
            }
        }

        BuildRegions();
        StopPolling();
    }

    private void BuildRegions()
    {
        var map = new Dictionary<int, RegionGroup>();
        foreach (var row in _nodeRows)
        {
            var id = row.RegionId ?? 0;
            if (!map.TryGetValue(id, out var group))
            {
                group = new RegionGroup
                {
                    Id = id,
                    Name = string.IsNullOrWhiteSpace(row.RegionName) ? "未分配" : row.RegionName
                };
                map[id] = group;
            }
            group.NodeIds.Add(row.Id);
        }

        _regions.AddRange(map.Values.OrderBy(x => x.Name));
    }

    private void ToggleRegion(RegionGroup region, ChangeEventArgs args)
    {
        var checkedValue = args.Value?.ToString();
        var isChecked = checkedValue == "true" || checkedValue == "on";
        if (isChecked)
        {
            _selectedRegions.Add(region.Id);
        }
        else
        {
            _selectedRegions.Remove(region.Id);
        }

        foreach (var row in _nodeRows)
        {
            var match = (row.RegionId ?? 0) == region.Id;
            if (match)
            {
                row.Selected = isChecked;
                UpdateSelected(row);
            }
        }
    }

    private void ToggleNode(NodeRow row, ChangeEventArgs args)
    {
        var checkedValue = args.Value?.ToString();
        row.Selected = checkedValue == "true" || checkedValue == "on";
        UpdateSelected(row);
    }

    private void UpdateSelected(NodeRow row)
    {
        if (row.Selected)
        {
            _selectedNodeIds.Add(row.Id);
        }
        else
        {
            _selectedNodeIds.Remove(row.Id);
        }
    }

    private async Task UpgradeSelectedAsync()
    {
        if (!_selectedNodeIds.Any())
        {
            return;
        }
        var confirm = await Js.InvokeAsync<bool>("confirm", $"确认升级选中节点到版本 {_selectedVersion} ?");
        if (!confirm)
        {
            return;
        }

        await StartUpgradeAsync(_selectedNodeIds.ToList());
    }

    private async Task UpgradeSingleAsync(NodeRow row)
    {
        var confirm = await Js.InvokeAsync<bool>("confirm", $"确认升级节点 {row.Name} 到版本 {_selectedVersion} ?");
        if (!confirm)
        {
            return;
        }

        await StartUpgradeAsync(new List<long> { row.Id });
    }

    private async Task StartUpgradeAsync(List<long> nodeIds)
    {
        if (string.IsNullOrWhiteSpace(_selectedVersion))
        {
            await Js.InvokeVoidAsync("alert", "请选择版本");
            return;
        }

        var payload = new AgentPackageUpgradeRequest { Version = _selectedVersion, NodeIds = nodeIds };
        var response = await Api.PostAsync<AgentPackageUpgradeResult>("packages/upgrade", payload, ApiScope.Admin);
        var taskId = response?.Data?.TaskId ?? 0;
        if (taskId > 0)
        {
            _upgradeTaskId = taskId;
            StartPolling();
        }
    }

    private void StartPolling()
    {
        StopPolling();
        _pollTimer = new global::System.Timers.Timer(3000);
        _pollTimer.Elapsed += async (_, _) => await InvokeAsync(FetchUpgradeStatusAsync);
        _pollTimer.Start();
        _ = FetchUpgradeStatusAsync();
    }

    private void StopPolling()
    {
        if (_pollTimer == null)
        {
            return;
        }

        _pollTimer.Stop();
        _pollTimer.Dispose();
        _pollTimer = null;
    }

    private async Task FetchUpgradeStatusAsync()
    {
        if (_upgradeTaskId <= 0)
        {
            return;
        }

        var query = new Dictionary<string, string?> { ["task_id"] = _upgradeTaskId.ToString() };
        var response = await Api.GetAsync<AgentPackageUpgradeStatusResult>("packages/upgrade/status", ApiScope.Admin, query);
        if (response?.Data?.Nodes == null)
        {
            return;
        }

        _upgradeStatus.Clear();
        foreach (var node in response.Data.Nodes)
        {
            if (long.TryParse(node.NodeId, out var id))
            {
                _upgradeStatus[id] = node;
            }
        }

        foreach (var row in _nodeRows)
        {
            if (_upgradeStatus.TryGetValue(row.Id, out var status))
            {
                row.UpgradeState = status.State ?? string.Empty;
                row.Progress = status.Progress;
                row.UpgradeMessage = status.Message ?? string.Empty;
                row.UpgradeRet = status.Ret ?? string.Empty;
            }
        }

        StateHasChanged();
    }

    private string GetNodeStatusText(NodeRow row)
    {
        if (row.UpgradeState == "running")
        {
            return $"升级中 {row.Progress}%";
        }
        if (row.UpgradeState == "success")
        {
            return "已完成";
        }
        if (row.UpgradeState == "failed_final")
        {
            return "升级失败";
        }

        return row.Status switch
        {
            "upgrade_available" => "待升级",
            "up_to_date" => "已最新",
            _ => "空闲"
        };
    }

    private string GetNodeStatusBadge(NodeRow row)
    {
        if (row.UpgradeState == "running") return "bg-warning";
        if (row.UpgradeState == "success") return "bg-success";
        if (row.UpgradeState == "failed_final") return "bg-danger";

        return row.Status switch
        {
            "upgrade_available" => "bg-warning",
            "up_to_date" => "bg-success",
            _ => "bg-secondary"
        };
    }

    private string GetStatusLabel(string? status)
    {
        return status switch
        {
            "stable" => "稳定版",
            "gray" => "灰度",
            "history" => "历史",
            _ => status ?? "普通"
        };
    }

    private string GetVersionBadge(string? status)
    {
        return status switch
        {
            "stable" => "bg-success",
            "gray" => "bg-warning",
            "history" => "bg-secondary",
            _ => "bg-light text-dark"
        };
    }

    private async Task ShowLog(NodeRow row)
    {
        var message = string.IsNullOrWhiteSpace(row.UpgradeRet) ? row.UpgradeMessage : row.UpgradeRet;
        if (string.IsNullOrWhiteSpace(message))
        {
            await Js.InvokeVoidAsync("alert", "暂无日志");
            return;
        }

        await Js.InvokeVoidAsync("alert", message);
    }

    public void Dispose()
    {
        StopPolling();
    }

    private sealed class AgentPackageItemView
    {
        public AgentPackageItemView(AgentPackageItemDto dto)
        {
            Version = dto.Version ?? string.Empty;
            Status = dto.Status ?? string.Empty;
            GrayPercent = dto.GrayPercent;
            UploadTime = dto.UploadTime ?? string.Empty;
        }

        public string Version { get; }
        public string Status { get; }
        public int GrayPercent { get; set; }
        public string UploadTime { get; }
    }

    private sealed class NodeRow
    {
        public NodeRow(AgentPackageNodeDto dto)
        {
            Id = dto.Id;
            Name = dto.Name ?? string.Empty;
            Ip = dto.Ip ?? string.Empty;
            RegionId = dto.RegionId;
            RegionName = dto.RegionName ?? string.Empty;
            GroupName = dto.GroupName ?? string.Empty;
            CurrentVersion = dto.CurrentVersion ?? string.Empty;
            LatestVersion = dto.LatestVersion ?? string.Empty;
            Status = dto.Status ?? string.Empty;
            Online = dto.Online;
        }

        public long Id { get; }
        public string Name { get; }
        public string Ip { get; }
        public int? RegionId { get; }
        public string RegionName { get; }
        public string GroupName { get; }
        public string CurrentVersion { get; }
        public string LatestVersion { get; }
        public string Status { get; }
        public bool Online { get; }
        public bool Selected { get; set; }
        public string UpgradeState { get; set; } = string.Empty;
        public int Progress { get; set; }
        public string UpgradeMessage { get; set; } = string.Empty;
        public string UpgradeRet { get; set; } = string.Empty;
    }

    private sealed class RegionGroup
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public List<long> NodeIds { get; } = new();
    }
}
