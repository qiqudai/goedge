@page "/system/tasks"
@using Cnn.Common.Contracts
@using Cnn.Api.Services
@inject ApiClient Api
@inject IJSRuntime Js

<div class="page-container">
    <div class="page-title">后台任务</div>

    <div class="filter-bar">
        <select class="form-select" style="max-width: 160px" @bind="_filters.Type">
            <option value="">类型</option>
            <option value="refresh_url">刷新URL</option>
            <option value="refresh_dir">刷新目录</option>
            <option value="preheat">预热</option>
        </select>
        <InputText class="form-control" @bind-Value="_filters.Keyword" placeholder="关键词" />
        <div class="form-check d-flex align-items-center">
            <input id="only-failed-target-tasks"
                   class="form-check-input"
                   type="checkbox"
                   checked="@_filters.OnlyTasksWithFailedTargets"
                   @onchange="OnOnlyFailedTargetTasksChanged" />
            <label class="form-check-label ms-2" for="only-failed-target-tasks">仅看含失败节点任务</label>
        </div>
        <button class="btn btn-primary" @onclick="SearchAsync" disabled="@_loading">搜索</button>
        <button class="btn btn-outline-secondary" @onclick="TogglePagingDiagnostics">
            @(_showPagingDiagnostics ? "隐藏分页诊断" : "显示分页诊断")
        </button>
    </div>

    @if (_showPagingDiagnostics)
    {
        <div class="alert alert-light py-2 px-3 mt-2 mb-2 small">
            <div><strong>分页诊断</strong></div>
            <div>stateKey: <code>system:tasks:table</code></div>
            <div>pagingEnabled: <code>@(_pageQuery.PagingEnabled ? "true" : "false")</code></div>
            <div>page: <code>@_pageQuery.Page</code>, pageSize: <code>@_pageQuery.PageSize</code></div>
            <div>loaded: <code>@_items.Count</code>, total: <code>@_total</code></div>
        </div>
    }

    <TablePager @ref="_tablePager"
                StateKey="system:tasks:table"
                Total="_total"
                DefaultPageSize="20"
                UnpagedLimit="1000"
                QueryChanged="OnPageQueryChangedAsync">
        <ChildContent>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>优先级</th>
                            <th>名称</th>
                            <th>类型</th>
                            <th>资源ID</th>
                            <th>依赖</th>
                            <th>开始时间</th>
                            <th>耗时</th>
                            <th>状态</th>
                            <th>失败次数</th>
                            <th>结果</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_loading)
                        {
                            <tr><td colspan="12">加载中...</td></tr>
                        }
                        else if (_items.Count == 0)
                        {
                            <tr><td colspan="12">暂无数据</td></tr>
                        }
                        else
                        {
                            @foreach (var item in _items.Where(ShouldShowTask))
                            {
                                var targetSummary = GetTargetSummary(item);
                                var targetNodes = GetTargetNodes(item);
                                var hasTargets = targetSummary.Total > 0;
                                var isExpanded = _expandedTaskIds.Contains(item.Id);
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@(item.Pry?.ToString() ?? "-")</td>
                                    <td>@item.Name</td>
                                    <td><span class="badge bg-light text-dark">@FormatType(item.Type)</span></td>
                                    <td>@(item.Pid?.ToString() ?? "-")</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Depend) ? "-" : item.Depend)</td>
                                    <td>@FormatDate(item.StartAt)</td>
                                    <td>@FormatDuration(item)</td>
                                    <td><span class="badge @GetStateBadge(item.State)">@FormatState(item.State)</span></td>
                                    <td>@(item.ErrTimes?.ToString() ?? "0")</td>
                                    <td class="small">
                                        <div>@FormatRet(item)</div>
                                        @if (hasTargets)
                                        {
                                            <div class="mt-1">
                                                <span class="text-muted">节点: @targetSummary.Total</span>
                                                @if (targetSummary.FailCount > 0)
                                                {
                                                    <span class="ms-2 text-danger fw-semibold">
                                                        失败: @targetSummary.FailCount
                                                        @if (!string.IsNullOrWhiteSpace(targetSummary.FailNodePreview))
                                                        {
                                                            <span>(@targetSummary.FailNodePreview)</span>
                                                        }
                                                    </span>
                                                }
                                            </div>
                                            <div class="mt-1">
                                                <button class="btn btn-link btn-sm p-0" @onclick="() => ToggleTargets(item.Id)">
                                                    @(isExpanded ? "收起节点详情" : "展开节点详情")
                                                </button>
                                                @if (targetSummary.FailCount > 0)
                                                {
                                                    <button class="btn btn-link btn-sm p-0 ms-3" @onclick="ToggleShowFailedNodesOnly">
                                                        @(_showFailedNodesOnly ? "显示全部节点" : "仅显示失败节点")
                                                    </button>
                                                }
                                            </div>
                                            @if (isExpanded)
                                            {
                                                <div class="mt-1 border rounded p-2 bg-light">
                                                    @foreach (var node in targetNodes.Where(ShouldShowNode))
                                                    {
                                                        <div class="mb-1">
                                                            <code>@node.NodeId</code>
                                                            <span class="ms-1 badge @GetTargetStateBadge(node.State)">@FormatTargetState(node.State)</span>
                                                            <span class="ms-2">tries=@node.Tries</span>
                                                            <span class="ms-2">retry_at=@(node.RetryAt.HasValue ? node.RetryAt.Value.ToString("HH:mm:ss") : "-")</span>
                                                            <span class="ms-2 @(node.IsFailed ? "text-danger" : "text-muted")">ret=@(string.IsNullOrWhiteSpace(node.RetSummary) ? "-" : node.RetSummary)</span>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-link btn-sm" @onclick="() => ResubmitAsync(item)">重试</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </ChildContent>
    </TablePager>
</div>

@code {
    private readonly List<TaskListItemDto> _items = new();
    private readonly HashSet<long> _expandedTaskIds = new();
    private readonly Dictionary<long, IReadOnlyList<TaskTargetNodeView>> _targetNodeCache = new();
    private long _total;
    private bool _loading;
    private bool _showFailedNodesOnly;
    private bool _showPagingDiagnostics = false;
    private readonly TaskFilters _filters = new();
    private TablePageQuery _pageQuery = new() { PagingEnabled = true, Page = 1, PageSize = 20 };
    private TablePager? _tablePager;

    protected override Task OnInitializedAsync() => Task.CompletedTask;

    private async Task LoadAsync()
    {
        if (_loading)
        {
            return;
        }

        _loading = true;
        StateHasChanged();

        var query = new Dictionary<string, string?>
        {
            ["page"] = _pageQuery.Page.ToString(),
            ["pageSize"] = _pageQuery.PageSize.ToString()
        };

        if (!string.IsNullOrWhiteSpace(_filters.Keyword))
        {
            query["keyword"] = _filters.Keyword;
        }

        if (!string.IsNullOrWhiteSpace(_filters.Type))
        {
            query["type"] = _filters.Type;
        }

        var response = await Api.GetAsync<TaskListResult>("tasks", ApiScope.Admin, query);
        _items.Clear();
        _expandedTaskIds.Clear();
        _targetNodeCache.Clear();
        if (response?.Data?.List != null)
        {
            _items.AddRange(response.Data.List);
            _total = response.Data.Total;
        }
        else
        {
            _total = 0;
        }

        _loading = false;
    }

    private async Task ResubmitAsync(TaskListItemDto item)
    {
        var confirm = await Js.InvokeAsync<bool>("confirm", "确定要重新提交该任务吗？");
        if (!confirm)
        {
            return;
        }

        await Api.PostAsync<object>($"tasks/{item.Id}/resubmit", null, ApiScope.Admin);
        await RefreshAsync();
    }

    private Task OnPageQueryChangedAsync(TablePageQuery query)
    {
        _pageQuery = query;
        return LoadAsync();
    }

    private async Task SearchAsync()
    {
        if (_tablePager != null)
        {
            await _tablePager.SearchAsync();
            return;
        }

        _pageQuery = new TablePageQuery
        {
            PagingEnabled = _pageQuery.PagingEnabled,
            Page = 1,
            PageSize = _pageQuery.PageSize
        };
        await LoadAsync();
    }

    private Task RefreshAsync()
    {
        if (_tablePager != null)
        {
            return _tablePager.RefreshAsync();
        }

        return LoadAsync();
    }

    private void OnOnlyFailedTargetTasksChanged(ChangeEventArgs args)
    {
        _filters.OnlyTasksWithFailedTargets = args.Value is bool b && b;
    }

    private void TogglePagingDiagnostics()
    {
        _showPagingDiagnostics = !_showPagingDiagnostics;
    }

    private bool ShouldShowTask(TaskListItemDto item)
    {
        if (!_filters.OnlyTasksWithFailedTargets)
        {
            return true;
        }

        var summary = GetTargetSummary(item);
        return summary.FailCount > 0;
    }

    private void ToggleTargets(long? id)
    {
        if (id is null or <= 0)
        {
            return;
        }

        if (!_expandedTaskIds.Add(id.Value))
        {
            _expandedTaskIds.Remove(id.Value);
        }
    }

    private void ToggleShowFailedNodesOnly()
    {
        _showFailedNodesOnly = !_showFailedNodesOnly;
    }

    private bool ShouldShowNode(TaskTargetNodeView node)
        => !_showFailedNodesOnly || node.IsFailed;

    private static string GetTargetStateBadge(string? state)
        => IsFailedState(state) ? "bg-danger" : "bg-secondary";

    private static string FormatTargetState(string? state)
        => string.IsNullOrWhiteSpace(state) ? "-" : state!;

    private static string FormatType(string? type)
        => type switch
        {
            "refresh_url" => "刷新URL",
            "refresh_dir" => "刷新目录",
            "preheat" => "预热",
            "deploy_cert" => "部署证书",
            _ => type ?? "-"
        };

    private static string FormatState(string? state)
        => state switch
        {
            "waiting" => "等待中",
            "running" => "执行中",
            "done" => "完成",
            "fail" => "失败",
            _ => state ?? "-"
        };

    private static string GetStateBadge(string? state)
        => state switch
        {
            "waiting" => "bg-secondary",
            "running" => "bg-primary",
            "done" => "bg-success",
            "fail" => "bg-danger",
            _ => "bg-light text-dark"
        };

    private static string FormatDate(DateTime? value)
    {
        if (value == null || value.Value == DateTime.MinValue)
        {
            return "-";
        }

        return value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");
    }

    private static string FormatDuration(TaskListItemDto item)
    {
        if (item.StartAt == null || item.StartAt.Value == DateTime.MinValue)
        {
            return "-";
        }

        var start = item.StartAt.Value;
        var end = item.EndAt.HasValue && item.EndAt.Value > DateTime.MinValue
            ? item.EndAt.Value
            : DateTime.UtcNow;

        if (end < start)
        {
            return "-";
        }

        var diff = end - start;
        if (diff.TotalMilliseconds < 1000)
        {
            return $"{diff.TotalMilliseconds:0}ms";
        }

        return $"{diff.TotalSeconds:0.0}s";
    }

    private static string FormatRet(TaskListItemDto item)
    {
        var raw = item.Ret?.Trim();
        if (string.IsNullOrWhiteSpace(raw))
        {
            return "-";
        }

        var (message, diagnostics) = SplitRetDiagnostics(raw);
        if (diagnostics == null)
        {
            return raw;
        }

        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(message))
        {
            parts.Add(message);
        }

        if (!string.IsNullOrWhiteSpace(diagnostics.RetCode))
        {
            parts.Add($"code={diagnostics.RetCode}");
        }

        if (!string.IsNullOrWhiteSpace(diagnostics.ErrorType))
        {
            parts.Add($"type={diagnostics.ErrorType}");
        }

        if (diagnostics.IsRetryable.HasValue)
        {
            parts.Add(diagnostics.IsRetryable.Value ? "retryable=yes" : "retryable=no");
        }

        if (diagnostics.Attempt.HasValue && diagnostics.MaxAttempts.HasValue)
        {
            parts.Add($"attempt={diagnostics.Attempt}/{diagnostics.MaxAttempts}");
        }

        if (diagnostics.NextBackoffMs.HasValue)
        {
            parts.Add($"next={Math.Max(0, diagnostics.NextBackoffMs.Value / 1000)}s");
        }
        else if (item.RetryAt.HasValue && item.RetryAt.Value > DateTime.Now)
        {
            var wait = (item.RetryAt.Value - DateTime.Now).TotalSeconds;
            if (wait > 0)
            {
                parts.Add($"retry_at={item.RetryAt.Value:HH:mm:ss} (~{wait:0}s)");
            }
        }

        return parts.Count == 0 ? raw : string.Join(" | ", parts);
    }

    private TaskTargetSummary GetTargetSummary(TaskListItemDto item)
    {
        var nodes = GetTargetNodes(item);
        if (nodes.Count == 0)
        {
            return TaskTargetSummary.Empty;
        }

        var failNodes = nodes.Where(static n => n.IsFailed).Select(static n => n.NodeId).Take(3).ToList();
        var failCount = nodes.Count(static n => n.IsFailed);
        return new TaskTargetSummary(
            nodes.Count,
            failCount,
            failNodes.Count == 0 ? string.Empty : string.Join(", ", failNodes));
    }

    private IReadOnlyList<TaskTargetNodeView> GetTargetNodes(TaskListItemDto item)
    {
        var id = item.Id;
        if (id <= 0)
        {
            return ParseTargetNodes(item.TargetsJson);
        }

        if (_targetNodeCache.TryGetValue(id, out var cached))
        {
            return cached;
        }

        var parsed = ParseTargetNodes(item.TargetsJson);
        _targetNodeCache[id] = parsed;
        return parsed;
    }

    private static IReadOnlyList<TaskTargetNodeView> ParseTargetNodes(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return Array.Empty<TaskTargetNodeView>();
        }

        try
        {
            using var doc = global::System.Text.Json.JsonDocument.Parse(raw);
            var root = doc.RootElement;
            if (!root.TryGetProperty("nodes", out var nodes) || nodes.ValueKind != global::System.Text.Json.JsonValueKind.Object)
            {
                return Array.Empty<TaskTargetNodeView>();
            }

            var result = new List<TaskTargetNodeView>();
            foreach (var node in nodes.EnumerateObject().OrderBy(static x => x.Name, StringComparer.Ordinal))
            {
                var value = node.Value;
                var state = value.TryGetProperty("state", out var stateEl) && stateEl.ValueKind == global::System.Text.Json.JsonValueKind.String
                    ? stateEl.GetString()
                    : null;
                var tries = value.TryGetProperty("tries", out var triesEl) && triesEl.TryGetInt32(out var triesValue)
                    ? triesValue
                    : 0;
                DateTime? retryAt = null;
                if (value.TryGetProperty("retry_at", out var retryAtEl) && retryAtEl.TryGetInt64(out var retryAtValue) && retryAtValue > 0)
                {
                    retryAt = DateTimeOffset.FromUnixTimeSeconds(retryAtValue).LocalDateTime;
                }

                var retSummary = string.Empty;
                if (value.TryGetProperty("ret", out var retEl) && retEl.ValueKind == global::System.Text.Json.JsonValueKind.String)
                {
                    retSummary = SummarizeTargetRet(retEl.GetString());
                }

                var isFailed = IsFailedState(state) || !string.IsNullOrWhiteSpace(retSummary);
                result.Add(new TaskTargetNodeView(node.Name, state, tries, retryAt, retSummary, isFailed));
            }

            return result;
        }
        catch
        {
            return Array.Empty<TaskTargetNodeView>();
        }
    }

    private static bool IsFailedState(string? state)
        => !string.IsNullOrWhiteSpace(state) && state.Contains("fail", StringComparison.OrdinalIgnoreCase);

    private static string SummarizeTargetRet(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return string.Empty;
        }

        var trimmed = raw.Trim();
        var (message, diagnostics) = SplitRetDiagnostics(trimmed);
        if (diagnostics == null)
        {
            return Shrink(trimmed, 48);
        }

        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(diagnostics.RetCode))
        {
            parts.Add($"code={diagnostics.RetCode}");
        }

        if (!string.IsNullOrWhiteSpace(diagnostics.ErrorType))
        {
            parts.Add($"type={diagnostics.ErrorType}");
        }

        if (!string.IsNullOrWhiteSpace(message))
        {
            parts.Add(Shrink(message, 32));
        }

        return parts.Count == 0 ? string.Empty : string.Join(", ", parts);
    }

    private static string Shrink(string value, int max)
    {
        if (string.IsNullOrWhiteSpace(value) || max <= 0 || value.Length <= max)
        {
            return value;
        }

        return value[..(max - 3)] + "...";
    }

    private static (string Message, TaskRetDiagnostics? Diagnostics) SplitRetDiagnostics(string raw)
    {
        var sep = raw.LastIndexOf(" | {", StringComparison.Ordinal);
        if (sep <= 0)
        {
            return (raw, null);
        }

        var message = raw[..sep].Trim();
        var json = raw[(sep + 3)..].Trim();
        if (json.StartsWith('{'))
        {
            try
            {
                var diagnostics = ParseDiagnostics(json);
                return (message, diagnostics);
            }
            catch
            {
                return (raw, null);
            }
        }

        return (raw, null);
    }

    private static TaskRetDiagnostics? ParseDiagnostics(string json)
    {
        using var doc = global::System.Text.Json.JsonDocument.Parse(json);
        var root = doc.RootElement;
        if (root.ValueKind != global::System.Text.Json.JsonValueKind.Object)
        {
            return null;
        }

        var diagnostics = new TaskRetDiagnostics();
        if (root.TryGetProperty("ret_code", out var retCode) && retCode.ValueKind == global::System.Text.Json.JsonValueKind.String)
        {
            diagnostics.RetCode = retCode.GetString();
        }

        if (root.TryGetProperty("error_type", out var errorType) && errorType.ValueKind == global::System.Text.Json.JsonValueKind.String)
        {
            diagnostics.ErrorType = errorType.GetString();
        }

        if (root.TryGetProperty("is_retryable", out var isRetryable) &&
            (isRetryable.ValueKind == global::System.Text.Json.JsonValueKind.True || isRetryable.ValueKind == global::System.Text.Json.JsonValueKind.False))
        {
            diagnostics.IsRetryable = isRetryable.GetBoolean();
        }

        if (root.TryGetProperty("attempt", out var attempt) && attempt.TryGetInt32(out var attemptValue))
        {
            diagnostics.Attempt = attemptValue;
        }

        if (root.TryGetProperty("max_attempts", out var maxAttempts) && maxAttempts.TryGetInt32(out var maxAttemptsValue))
        {
            diagnostics.MaxAttempts = maxAttemptsValue;
        }

        if (root.TryGetProperty("next_backoff_ms", out var nextBackoff) && nextBackoff.TryGetInt32(out var nextBackoffValue))
        {
            diagnostics.NextBackoffMs = nextBackoffValue;
        }

        return diagnostics;
    }

    private sealed class TaskRetDiagnostics
    {
        public string? RetCode { get; set; }

        public string? ErrorType { get; set; }

        public bool? IsRetryable { get; set; }

        public int? Attempt { get; set; }

        public int? MaxAttempts { get; set; }

        public int? NextBackoffMs { get; set; }
    }

    private sealed class TaskFilters
    {
        public string Type { get; set; } = string.Empty;
        public string Keyword { get; set; } = string.Empty;
        public bool OnlyTasksWithFailedTargets { get; set; }
    }

    private sealed record TaskTargetNodeView(
        string NodeId,
        string? State,
        int Tries,
        DateTime? RetryAt,
        string? RetSummary,
        bool IsFailed);

    private sealed record TaskTargetSummary(
        int Total,
        int FailCount,
        string FailNodePreview)
    {
        public static readonly TaskTargetSummary Empty = new(0, 0, string.Empty);
    }
}
