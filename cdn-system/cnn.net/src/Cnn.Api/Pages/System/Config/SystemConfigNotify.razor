﻿@using global::System.Text.Json
@using Cnn.Common.Contracts.Admin
@using Cnn.Api.Models
@inject Cnn.Api.Services.ConfigItemClient ConfigClient

<div class="card config-card">
    <div class="card-header">通知配置</div>
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label">通知时间段</label>
            <InputRadioGroup class="d-flex gap-3" @bind-Value="_notificationPeriod">
                <InputRadio class="form-check-input" Value='@("all")' /> <span class="me-3">全天</span>
                <InputRadio class="form-check-input" Value='@("custom")' /> <span>自定义</span>
            </InputRadioGroup>
            @if (_notificationPeriod == "custom")
            {
                <div class="mt-2" style="max-width: 160px;">
                    <InputText class="form-control" @bind-Value="_notificationPeriodCustom" placeholder="8-22" />
                </div>
            }
        </div>

        <NotifyItemEditor Model="@GetItem("traffic-exceed-notify")" Title="流量已超限通知" Variables="@TrafficExceedVars" />
        <NotifyItemEditor Model="@GetItem("traffic-exceeding-notify")" Title="流量即将超限通知" Variables="@TrafficExceedingVars" ShowRemainTraffic="true" />
        <NotifyItemEditor Model="@GetItem("package-expire-notify")" Title="套餐过期通知" Variables="@PackageVars" />
        <NotifyItemEditor Model="@GetItem("package-expiring-notify")" Title="套餐即将过期通知" Variables="@PackageExpiringVars" ShowDays="true" />
        <NotifyItemEditor Model="@GetItem("cc-switch-notify")" Title="网站CC规则自动切换通知" Variables="@CcSwitchVars" />
        <NotifyItemEditor Model="@GetItem("bandwidth-exceed-notify")" Title="套餐带宽超限通知" Variables="@PackageVars" />
        <NotifyItemEditor Model="@GetItem("conn-exceed-notify")" Title="连接数超限通知" Variables="@PackageVars" />
        <NotifyItemEditor Model="@GetItem("cert-expire-notify")" Title="证书已过期通知" Variables="@CertVars" />
        <NotifyItemEditor Model="@GetItem("cert-expiring-notify")" Title="证书即将过期通知" Variables="@CertExpiringVars" ShowDays="true" />
        <NotifyItemEditor Model="@GetItem("account-auth2-notify")" Title="二次验证通知" Variables="@Auth2Vars" />

        <div class="mt-3 d-flex align-items-center gap-2">
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">保存</button>
            @if (_saving)
            {
                <span class="text-muted">保存中...</span>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert @_messageClass mt-3">@_message</div>
        }
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<ConfigItemDto> Items { get; set; } = Array.Empty<ConfigItemDto>();
    [Parameter] public EventCallback OnSaved { get; set; }

    private readonly Dictionary<string, NotifyItemModel> _items = new(StringComparer.OrdinalIgnoreCase);
    private string _notificationPeriod = "all";
    private string _notificationPeriodCustom = "8-22";
    private bool _saving;
    private string? _message;
    private string _messageClass = "alert-success";

    private static readonly string[] NotifyKeys =
    {
        "traffic-exceed-notify",
        "traffic-exceeding-notify",
        "package-expire-notify",
        "package-expiring-notify",
        "cc-switch-notify",
        "bandwidth-exceed-notify",
        "conn-exceed-notify",
        "cert-expire-notify",
        "cert-expiring-notify",
        "account-auth2-notify"
    };

    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web)
    {
        PropertyNameCaseInsensitive = true
    };

    private static readonly string[] TrafficExceedVars = { "{{username}}", "{{package_id}}", "{{package_name}}" };
    private static readonly string[] TrafficExceedingVars = { "{{username}}", "{{package_id}}", "{{package_name}}", "{{traffic_remain}}" };
    private static readonly string[] PackageVars = { "{{username}}", "{{package_id}}", "{{package_name}}" };
    private static readonly string[] PackageExpiringVars = { "{{username}}", "{{package_id}}", "{{package_name}}", "{{remain_days}}" };
    private static readonly string[] CcSwitchVars = { "{{username}}", "{{domain}}", "{{curr_qps}}", "{{qps_limit}}", "{{rule_name}}" };
    private static readonly string[] CertVars = { "{{username}}", "{{cert_id}}", "{{cert_name}}", "{{domain}}" };
    private static readonly string[] CertExpiringVars = { "{{username}}", "{{cert_id}}", "{{cert_name}}", "{{domain}}", "{{remain_days}}" };
    private static readonly string[] Auth2Vars = { "{{username}}", "{{ip}}", "{{time}}", "{{code}}" };

    protected override void OnParametersSet()
    {
        if (Items.Count == 0)
        {
            return;
        }

        foreach (var key in NotifyKeys)
        {
            var raw = Items.FirstOrDefault(i => i.Name == key)?.Value;
            if (string.IsNullOrWhiteSpace(raw))
            {
                continue;
            }

            try
            {
                var model = JsonSerializer.Deserialize<NotifyItemModel>(raw, JsonOptions) ?? new NotifyItemModel();
                if (model.Methods == null)
                {
                    model.Methods = new List<string>();
                }
                _items[key] = model;
            }
            catch
            {
                _items[key] = new NotifyItemModel();
            }
        }

        var period = Items.FirstOrDefault(i => i.Name == "notification-period")?.Value;
        if (!string.IsNullOrWhiteSpace(period))
        {
            _notificationPeriod = period;
        }

        var custom = Items.FirstOrDefault(i => i.Name == "notification-period-custom")?.Value;
        if (!string.IsNullOrWhiteSpace(custom))
        {
            _notificationPeriodCustom = custom;
        }
    }

    private NotifyItemModel GetItem(string key)
    {
        if (!_items.TryGetValue(key, out var model))
        {
            model = new NotifyItemModel();
            _items[key] = model;
        }

        return model;
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        _message = null;

        var payload = new List<ConfigItemPayloadDto>();
        foreach (var key in NotifyKeys)
        {
            payload.Add(new ConfigItemPayloadDto
            {
                Name = key,
                Value = JsonSerializer.Serialize(GetItem(key), JsonOptions)
            });
        }

        payload.Add(new ConfigItemPayloadDto { Name = "notification-period", Value = _notificationPeriod });
        payload.Add(new ConfigItemPayloadDto { Name = "notification-period-custom", Value = _notificationPeriodCustom });

        var ok = await ConfigClient.SaveAsync("system", "global", 0, payload);
        _saving = false;

        if (ok)
        {
            SetMessage(true, "保存成功");
            if (OnSaved.HasDelegate)
            {
                await OnSaved.InvokeAsync();
            }
        }
        else
        {
            SetMessage(false, "保存失败");
        }
    }

    private void SetMessage(bool success, string message)
    {
        _message = message;
        _messageClass = success ? "alert-success" : "alert-danger";
    }
}
