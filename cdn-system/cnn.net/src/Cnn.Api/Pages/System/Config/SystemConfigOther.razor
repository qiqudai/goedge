@using Cnn.Common.Contracts
@using Cnn.Common.Contracts.Admin
@using Cnn.Api.Services
@inject Cnn.Api.Services.ConfigItemClient ConfigClient
@inject Cnn.Api.Services.ApiClient Api
@inject IJSRuntime Js

<div class="card config-card">
    <div class="card-header">其它配置</div>
    <div class="card-body">
        <h6 class="mb-3">主控获取源IP</h6>
        <div class="mb-3">
            <label class="form-label">Master IP Header</label>
            <InputText class="form-control" @bind-Value="_form.MasterClientIpHeader" placeholder="如：X-Real-IP" />
        </div>

        <hr />
        <h6 class="mb-3">记录相关</h6>
        <div class="mb-3">
            <label class="form-label">记录定时修复</label>
            <InputRadioGroup class="d-flex gap-3" @bind-Value="_form.RecordRepairEnable">
                <label class="form-check">
                    <InputRadio class="form-check-input" Value='@("0")' />
                    <span class="form-check-label">关闭</span>
                </label>
                <label class="form-check">
                    <InputRadio class="form-check-input" Value='@("1")' />
                    <span class="form-check-label">定时修复记录</span>
                </label>
                <label class="form-check">
                    <InputRadio class="form-check-input" Value='@("2")' />
                    <span class="form-check-label">Scheduled repair and purge</span>
                </label>
            </InputRadioGroup>
        </div>
        <div class="mb-3">
            <label class="form-label">DNS记录保护</label>
            <InputText class="form-control" @bind-Value="_form.DnsRsProtect" placeholder="输入主机名即域名的前面部分,多个以逗号分隔" />
        </div>

        <hr />
        <h6 class="mb-3">配置同步</h6>
        <div class="mb-3">
            <label class="form-label">Max sites per sync</label>
            <InputText class="form-control" @bind-Value="_form.MaxSiteStreamSyncOneTime" inputmode="numeric" />
        </div>
        <div class="mb-3">
            <label class="form-label">同步范围</label>
            <InputRadioGroup class="d-flex gap-3" @bind-Value="_form.SyncSiteConfigScope">
                <label class="form-check">
                    <InputRadio class="form-check-input" Value='@("region")' />
                    <span class="form-check-label">By region</span>
                </label>
                <label class="form-check">
                    <InputRadio class="form-check-input" Value='@("group")' />
                    <span class="form-check-label">按线路组</span>
                </label>
            </InputRadioGroup>
        </div>

        <hr />
        <h6 class="mb-3">证书部署策略</h6>
        <div class="mb-3">
            <label class="form-label">deploy_cert 任务完成策略</label>
            <InputRadioGroup class="d-flex gap-3" @bind-Value="_form.DeployCertCompletionPolicy">
                <label class="form-check">
                    <InputRadio class="form-check-input" Value='@("strict_all_success")' />
                    <span class="form-check-label">严格全成功（默认）</span>
                </label>
                <label class="form-check">
                    <InputRadio class="form-check-input" Value='@("allow_partial_failures")' />
                    <span class="form-check-label">容忍部分失败</span>
                </label>
            </InputRadioGroup>
            <div class="form-text mt-2">
                严格模式下任一节点永久失败即整任务失败；容忍模式下“至少一个节点成功”即可标记任务成功，并在结果中附带失败节点摘要。
            </div>
        </div>

        <hr />
        <h6 class="mb-3">资源限制</h6>
        <div class="mb-3">
            <label class="form-label">Resource ranking size</label>
            <InputText class="form-control" @bind-Value="_form.ResRankSize" inputmode="numeric" />
        </div>

        <hr />
        <h6 class="mb-3">HTTP 代理设置</h6>
        <div class="mb-3">
            <label class="form-label">HTTP 代理</label>
            <InputText class="form-control" @bind-Value="_form.HttpProxy" placeholder="格式：http://用户:密码@代理ip:代理端口" />
            <div class="form-text">当设置时，用户添加的 DNS 接口使用代理连接，系统提供的免费代理：http://cdn:6d0d3e31@proxy.lotcdn.com:8888</div>
        </div>

        <hr />
        <h6 class="mb-3">API密钥</h6>
        <div class="form-check form-switch mb-3">
            <InputCheckbox class="form-check-input" @bind-Value="_form.ApiKeyStatus" @onchange="OnApiKeyToggleAsync" />
            <label class="form-check-label">API Key Status</label>
        </div>
        @if (_form.ApiKeyStatus)
        {
            <div class="mb-3">
                <label class="form-label">API 密钥</label>
                <div class="d-flex align-items-center gap-2">
                    <span>@_apiKey.ApiKey</span>
                    <button class="btn btn-link btn-sm" type="button" @onclick="() => CopyAsync(_apiKey.ApiKey)">复制</button>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">API 密钥密码</label>
                <div class="d-flex align-items-center gap-2">
                    <span>@_apiKey.ApiSecret</span>
                    <button class="btn btn-link btn-sm" type="button" @onclick="() => CopyAsync(_apiKey.ApiSecret)">复制</button>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">API IP Allowlist</label>
                <InputText class="form-control" @bind-Value="_apiKey.ApiIp" placeholder="多个IP以|分隔 (例如: 1.2.3.4|5.6.7.8)" />
                <div class="form-text">只允许指定IP访问API，留空表示不限制</div>
            </div>
            <div class="mb-3">
                <button class="btn btn-outline-danger btn-sm" type="button" @onclick="ResetSecretAsync">重置密钥</button>
            </div>
        }

        <hr />
        <h6 class="mb-3">流量计算</h6>
        <div class="mb-3">
            <label class="form-label">TCP系数</label>
            <InputRadioGroup class="d-flex gap-3" @bind-Value="_form.TcpTrafficFactor">
                <label class="form-check">
                    <InputRadio class="form-check-input" Value='@("1")' />
                    <span class="form-check-label">1.0</span>
                </label>
                <label class="form-check">
                    <InputRadio class="form-check-input" Value='@("1.1")' />
                    <span class="form-check-label">1.1</span>
                </label>
            </InputRadioGroup>
            <div class="form-text mt-2">
                由于TCP/IP包头和TCP重传等原因，实际节点流量消耗要比从Nginx日志文件里统计的要大，所以提供一个系数可选择。
                tcp系数为1.0时只统计应用层流量；1.1时在应用层流量基础上增加10%。
            </div>
        </div>

        <hr />
        <h6 class="mb-3">默认HTTPS证书</h6>
        <div class="alert alert-info">此证书用于节点未匹配到站点证书时的默认HTTPS响应</div>
        <div class="mb-3">
            <label class="form-label">证书内容 (PEM)</label>
            <InputTextArea class="form-control" rows="6" @bind-Value="_form.CertContent" placeholder="-----BEGIN CERTIFICATE-----..." />
        </div>
        <div class="mb-3">
            <label class="form-label">私钥内容 (PEM)</label>
            <InputTextArea class="form-control" rows="6" @bind-Value="_form.KeyContent" placeholder="-----BEGIN PRIVATE KEY-----..." />
        </div>
        <div class="alert alert-warning">保存后需要重启Master服务生效</div>

        <div class="mt-3 d-flex align-items-center gap-2">
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">保存</button>
            @if (_saving)
            {
                <span class="text-muted">保存中...</span>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert @_messageClass mt-3">@_message</div>
        }
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<ConfigItemDto> Items { get; set; } = Array.Empty<ConfigItemDto>();
    [Parameter] public EventCallback OnSaved { get; set; }

    private readonly OtherConfigForm _form = new();
    private ApiKeyDto _apiKey = new();
    private bool _saving;
    private string? _message;
    private string _messageClass = "alert-success";

    protected override async Task OnParametersSetAsync()
    {
        if (Items.Count == 0)
        {
            return;
        }

        _form.MasterClientIpHeader = GetValue("master_client_ip_header", _form.MasterClientIpHeader);
        _form.RecordRepairEnable = GetValue("record-repair-enable", _form.RecordRepairEnable);
        _form.DnsRsProtect = GetValue("dns_rs_protect", _form.DnsRsProtect);
        _form.MaxSiteStreamSyncOneTime = GetValue("max_site_stream_sync_one_time", _form.MaxSiteStreamSyncOneTime);
        _form.SyncSiteConfigScope = GetValue("sync-site-config-scope", _form.SyncSiteConfigScope);
        _form.DeployCertCompletionPolicy = GetValue("deploy_cert_completion_policy", _form.DeployCertCompletionPolicy);
        _form.ResRankSize = GetValue("res_rank_size", _form.ResRankSize);
        _form.HttpProxy = GetValue("http_proxy", _form.HttpProxy);
        _form.ApiKeyStatus = GetBool("api_key_status", _form.ApiKeyStatus);
        _form.TcpTrafficFactor = GetValue("tcp_traffic_factor", _form.TcpTrafficFactor);
        _form.CertContent = GetValue("https_cert", _form.CertContent);
        _form.KeyContent = GetValue("https_key", _form.KeyContent);

        _form.PackageExpireCloseSite = GetValue("package_expire_close_site", _form.PackageExpireCloseSite);
        _form.TrafficExcceedCloseSite = GetValue("traffic_excceed_close_site", _form.TrafficExcceedCloseSite);
        _form.PackageAllowUpgrade = GetValue("package_allow_upgrade", _form.PackageAllowUpgrade);
        _form.PackageAllowDowngrade = GetValue("package_allow_downgrade", _form.PackageAllowDowngrade);
        _form.NodeHealthCheck = GetValue("node_health_check", _form.NodeHealthCheck);
        _form.NodeMaxFailed = GetValue("node_max_failed", _form.NodeMaxFailed);
        _form.AutoUpgradeAgent = GetValue("auto_upgrade_agent", _form.AutoUpgradeAgent);
        _form.DeleteConfigDelayed = GetValue("delete_config_delayed", _form.DeleteConfigDelayed);

        if (_form.ApiKeyStatus)
        {
            await LoadApiKeyAsync();
        }
    }

    private string GetValue(string name, string fallback)
        => Items.FirstOrDefault(i => i.Name == name)?.Value ?? fallback;

    private bool GetBool(string name, bool fallback)
    {
        var value = Items.FirstOrDefault(i => i.Name == name)?.Value;
        if (string.IsNullOrWhiteSpace(value))
        {
            return fallback;
        }

        return value == "1" || value.Equals("true", StringComparison.OrdinalIgnoreCase);
    }

    private async Task LoadApiKeyAsync()
    {
        var response = await Api.GetAsync<ApiKeyDto>("api_key", ApiScope.Admin);
        if (response?.Data != null)
        {
            _apiKey = response.Data;
        }
    }

    private async Task OnApiKeyToggleAsync(ChangeEventArgs args)
    {
        if (_form.ApiKeyStatus)
        {
            await LoadApiKeyAsync();
        }
    }

    private async Task ResetSecretAsync()
    {
        var confirm = await Js.InvokeAsync<bool>("confirm", "Reset API secret? Old secret becomes invalid immediately.");
        if (!confirm)
        {
            return;
        }

        var response = await Api.PostAsync<ApiKeySecretDto>("api_key/reset", null, ApiScope.Admin);
        if (response?.Data?.ApiSecret != null)
        {
            _apiKey.ApiSecret = response.Data.ApiSecret;
            SetMessage(true, "Secret reset");
        }
        else
        {
            SetMessage(false, "重置失败");
        }
    }

    private async Task CopyAsync(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", value);
            SetMessage(true, "已复制");
        }
        catch
        {
            SetMessage(false, "复制失败");
        }
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        _message = null;

        var payload = new List<ConfigItemPayloadDto>
        {
            new() { Name = "master_client_ip_header", Value = _form.MasterClientIpHeader },
            new() { Name = "record-repair-enable", Value = _form.RecordRepairEnable },
            new() { Name = "dns_rs_protect", Value = _form.DnsRsProtect },
            new() { Name = "max_site_stream_sync_one_time", Value = _form.MaxSiteStreamSyncOneTime },
            new() { Name = "sync-site-config-scope", Value = _form.SyncSiteConfigScope },
            new() { Name = "deploy_cert_completion_policy", Value = _form.DeployCertCompletionPolicy },
            new() { Name = "res_rank_size", Value = _form.ResRankSize },
            new() { Name = "http_proxy", Value = _form.HttpProxy },
            new() { Name = "api_key_status", Value = _form.ApiKeyStatus ? "1" : "0" },
            new() { Name = "tcp_traffic_factor", Value = _form.TcpTrafficFactor },
            new() { Name = "https_cert", Value = _form.CertContent },
            new() { Name = "https_key", Value = _form.KeyContent },
            new() { Name = "package_expire_close_site", Value = _form.PackageExpireCloseSite },
            new() { Name = "traffic_excceed_close_site", Value = _form.TrafficExcceedCloseSite },
            new() { Name = "package_allow_upgrade", Value = _form.PackageAllowUpgrade },
            new() { Name = "package_allow_downgrade", Value = _form.PackageAllowDowngrade },
            new() { Name = "node_health_check", Value = _form.NodeHealthCheck },
            new() { Name = "node_max_failed", Value = _form.NodeMaxFailed },
            new() { Name = "auto_upgrade_agent", Value = _form.AutoUpgradeAgent },
            new() { Name = "delete_config_delayed", Value = _form.DeleteConfigDelayed }
        };

        var ok = await ConfigClient.SaveAsync("system", "global", 0, payload);
        if (ok && _form.ApiKeyStatus)
        {
            await Api.PutAsync<bool>("api_key", new ApiKeyUpdateRequest { ApiIp = _apiKey.ApiIp }, ApiScope.Admin);
        }

        _saving = false;

        if (ok)
        {
            SetMessage(true, "保存成功");
            if (OnSaved.HasDelegate)
            {
                await OnSaved.InvokeAsync();
            }
        }
        else
        {
            SetMessage(false, "保存失败");
        }
    }

    private void SetMessage(bool success, string message)
    {
        _message = message;
        _messageClass = success ? "alert-success" : "alert-danger";
    }

    private sealed class OtherConfigForm
    {
        public string MasterClientIpHeader { get; set; } = "X-Real-IP";
        public string RecordRepairEnable { get; set; } = "0";
        public string DnsRsProtect { get; set; } = string.Empty;
        public string MaxSiteStreamSyncOneTime { get; set; } = "1000";
        public string SyncSiteConfigScope { get; set; } = "group";
        public string DeployCertCompletionPolicy { get; set; } = "strict_all_success";
        public string ResRankSize { get; set; } = "100";
        public string HttpProxy { get; set; } = string.Empty;
        public bool ApiKeyStatus { get; set; }
        public string TcpTrafficFactor { get; set; } = "1.1";
        public string CertContent { get; set; } = string.Empty;
        public string KeyContent { get; set; } = string.Empty;
        public string PackageExpireCloseSite { get; set; } = "1";
        public string TrafficExcceedCloseSite { get; set; } = "0";
        public string PackageAllowUpgrade { get; set; } = "0";
        public string PackageAllowDowngrade { get; set; } = "0";
        public string NodeHealthCheck { get; set; } = "1";
        public string NodeMaxFailed { get; set; } = "2";
        public string AutoUpgradeAgent { get; set; } = "0";
        public string DeleteConfigDelayed { get; set; } = string.Empty;
    }
}
