@using Cnn.Common.Contracts.Admin
@inject Cnn.Api.Services.ConfigItemClient ConfigClient

<div class="card config-card">
    <div class="card-header">套餐控制</div>
    <div class="card-body">
        <div class="form-check form-switch mb-2">
            <InputCheckbox class="form-check-input" @bind-Value="_packageExpireCloseSite" />
            <label class="form-check-label">套餐到期关闭网站</label>
            <div class="form-text">开启后，过期套餐的网站将无法访问</div>
        </div>

        <div class="form-check form-switch mb-2">
            <InputCheckbox class="form-check-input" @bind-Value="_trafficExceedCloseSite" />
            <label class="form-check-label">流量超限关闭网站</label>
            <div class="form-text">开启后，超出套餐流量限制的网站将无法访问</div>
        </div>

        <div class="form-check form-switch mb-2">
            <InputCheckbox class="form-check-input" @bind-Value="_allowUpgrade" />
            <label class="form-check-label">允许自主升级</label>
        </div>

        <div class="form-check form-switch mb-3">
            <InputCheckbox class="form-check-input" @bind-Value="_allowDowngrade" />
            <label class="form-check-label">允许自主降级</label>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">保存</button>
            @if (_saving)
            {
                <span class="text-muted">保存中...</span>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert @_messageClass mt-3">@_message</div>
        }
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<ConfigItemDto> Items { get; set; } = Array.Empty<ConfigItemDto>();
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool _packageExpireCloseSite;
    private bool _trafficExceedCloseSite;
    private bool _allowUpgrade;
    private bool _allowDowngrade;
    private bool _saving;
    private string? _message;
    private string _messageClass = "alert-success";

    protected override void OnParametersSet()
    {
        if (Items.Count == 0)
        {
            return;
        }

        _packageExpireCloseSite = ReadBool("package_expire_close_site");
        _trafficExceedCloseSite = ReadBool("traffic_excceed_close_site");
        _allowUpgrade = ReadBool("package_allow_upgrade", true);
        _allowDowngrade = ReadBool("package_allow_downgrade");
    }

    private bool ReadBool(string key, bool defaultValue = false)
    {
        var value = Items.FirstOrDefault(i => i.Name == key)?.Value;
        if (string.IsNullOrWhiteSpace(value))
        {
            return defaultValue;
        }

        return value == "1" || value.Equals("true", StringComparison.OrdinalIgnoreCase);
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        _message = null;

        var payload = new List<ConfigItemPayloadDto>
        {
            new() { Name = "package_expire_close_site", Value = _packageExpireCloseSite ? "1" : "0" },
            new() { Name = "traffic_excceed_close_site", Value = _trafficExceedCloseSite ? "1" : "0" },
            new() { Name = "package_allow_upgrade", Value = _allowUpgrade ? "1" : "0" },
            new() { Name = "package_allow_downgrade", Value = _allowDowngrade ? "1" : "0" }
        };

        var ok = await ConfigClient.SaveAsync("system", "global", 0, payload);
        _saving = false;

        if (ok)
        {
            SetMessage(true, "保存成功");
            if (OnSaved.HasDelegate)
            {
                await OnSaved.InvokeAsync();
            }
        }
        else
        {
            SetMessage(false, "保存失败");
        }
    }

    private void SetMessage(bool success, string message)
    {
        _message = message;
        _messageClass = success ? "alert-success" : "alert-danger";
    }
}
