@page "/account/profile"
@using Cnn.Common.Contracts
@inject ApiClient Api
@inject IJSRuntime Js

<div class="page-container">
    <div class="page-title">个人资料</div>

    @if (_loading)
    {
        <div class="text-muted">加载中...</div>
    }
    else if (_profile == null)
    {
        <div class="alert alert-warning">未获取到用户信息</div>
    }
    else
    {
        @* 基础信息卡片 *@
        <div class="card config-card p-4 mb-3">
            <div class="row g-3 align-items-center">
                <div class="col-md-3">
                    <div class="profile-item">
                        <span class="profile-label">用户名:</span>
                        <span class="profile-value">@(_profile.Name ?? "-")</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="profile-item">
                        <span class="profile-label">余额:</span>
                        <span class="profile-value">@FormatBalance(_profile.Balance)</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="profile-item">
                        <span class="profile-label">QQ:</span>
                        @if (!_editingQq)
                        {
                            <span class="profile-value">@(string.IsNullOrWhiteSpace(_profile.Qq) ? "未设置" : _profile.Qq)</span>
                            <button class="btn btn-link btn-sm py-0" @onclick="StartEditQq">编辑</button>
                        }
                        else
                        {
                            <input class="form-control form-control-sm d-inline-block" style="width:140px;" @bind="_qqInput" placeholder="请输入QQ" />
                            <button class="btn btn-primary btn-sm ms-1" @onclick="SaveQqAsync">保存</button>
                        }
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="profile-item">
                        <span class="profile-label">密码:</span>
                        <span class="profile-value">******</span>
                        <button class="btn btn-link btn-sm py-0" @onclick="() => _showPasswordDialog = true">修改</button>
                    </div>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_profile.CreateAt))
            {
                <div class="text-muted small mt-2">注册时间：@_profile.CreateAt</div>
            }
        </div>

        @* 实名认证卡片 *@
        <div class="card config-card p-4 mb-3">
            <div class="section-title mb-3">实名认证</div>
            <ul class="nav nav-tabs mb-3">
                <li class="nav-item">
                    <button class='nav-link @(_verifyTab == "personal" ? "active" : "")' @onclick='@(() => _verifyTab = "personal")'>个人认证</button>
                </li>
                <li class="nav-item">
                    <button class='nav-link @(_verifyTab == "company" ? "active" : "")' @onclick='@(() => _verifyTab = "company")'>企业认证</button>
                </li>
            </ul>

            @if (_verifyTab == "personal")
            {
                <div class="section-form">
                    <div class="mb-3">
                        <label class="form-label">姓名</label>
                        <input class="form-control" @bind="_certName" placeholder="请输入姓名" style="max-width:360px;" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">身份证号</label>
                        <input class="form-control" @bind="_certNo" placeholder="请输入身份证号" style="max-width:360px;" />
                    </div>
                    <button class="btn btn-primary" @onclick="SaveCertAsync" disabled="@_saving">保存</button>
                </div>
            }
            else
            {
                <div class="section-form">
                    <div class="mb-3">
                        <label class="form-label">企业名称</label>
                        <input class="form-control" @bind="_companyName" placeholder="请输入企业名称" style="max-width:360px;" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">统一社会信用代码</label>
                        <input class="form-control" @bind="_companyCode" placeholder="请输入信用代码" style="max-width:360px;" />
                    </div>
                    <button class="btn btn-primary" @onclick="SaveCompanyCertAsync" disabled="@_saving">保存</button>
                </div>
            }
        </div>

        @* 手机绑定卡片 *@
        <div class="card config-card p-4 mb-3">
            <div class="section-title mb-3">手机绑定</div>
            <div class="section-form">
                <div class="mb-3">
                    <label class="form-label">手机号</label>
                    <input class="form-control" @bind="_phoneInput" placeholder="请输入手机号" style="max-width:360px;" />
                </div>
                <div class="mb-3">
                    <label class="form-label">验证码</label>
                    <div class="d-flex gap-2" style="max-width:360px;">
                        <input class="form-control" @bind="_phoneCode" placeholder="请输入验证码" />
                        <button class="btn btn-outline-secondary" disabled>获取验证码</button>
                    </div>
                </div>
                <button class="btn btn-primary" @onclick="SavePhoneAsync" disabled="@_saving">保存</button>
            </div>
        </div>

        @* 邮箱绑定卡片 *@
        <div class="card config-card p-4 mb-3">
            <div class="section-title mb-3">邮箱绑定</div>
            <div class="section-form">
                <div class="mb-3">
                    <label class="form-label">邮箱</label>
                    <input class="form-control" @bind="_emailInput" placeholder="请输入邮箱" style="max-width:360px;" />
                </div>
                <div class="mb-3">
                    <label class="form-label">验证码</label>
                    <div class="d-flex gap-2" style="max-width:360px;">
                        <input class="form-control" @bind="_emailCode" placeholder="请输入验证码" />
                        <button class="btn btn-outline-secondary" disabled>获取验证码</button>
                    </div>
                </div>
                <button class="btn btn-primary" @onclick="SaveEmailAsync" disabled="@_saving">保存</button>
            </div>
        </div>

        @* 安全设置卡片 *@
        <div class="card config-card p-4 mb-3">
            <div class="section-title mb-3">安全设置</div>
            <div class="section-form">
                <div class="mb-3">
                    <label class="form-label">IP白名单</label>
                    <textarea class="form-control" @bind="_whiteIp" rows="3" placeholder="多个IP换行分隔" style="max-width:360px;"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label d-block">登录验证</label>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="loginVerify" value="none"
                               checked="@(_loginCaptcha == "none" || string.IsNullOrWhiteSpace(_loginCaptcha))"
                               @onchange='@(() => _loginCaptcha = "none")' />
                        <label class="form-check-label">不设置</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="loginVerify" value="sms"
                               checked="@(_loginCaptcha == "sms")"
                               @onchange='@(() => _loginCaptcha = "sms")' />
                        <label class="form-check-label">短信验证</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="loginVerify" value="email"
                               checked="@(_loginCaptcha == "email")"
                               @onchange='@(() => _loginCaptcha = "email")' />
                        <label class="form-check-label">邮箱验证</label>
                    </div>
                </div>
                <button class="btn btn-primary" @onclick="SaveSecurityAsync" disabled="@_saving">保存</button>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert alert-info mt-2">@_message</div>
    }
</div>

@* 修改密码 Dialog *@
@if (_showPasswordDialog)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.4);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">修改密码</h5>
                    <button type="button" class="btn-close" @onclick="() => _showPasswordDialog = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">旧密码</label>
                        <input class="form-control" type="password" @bind="_password.Current" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">新密码</label>
                        <input class="form-control" type="password" @bind="_password.Next" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">确认新密码</label>
                        <input class="form-control" type="password" @bind="_password.Confirm" />
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_passwordError))
                    {
                        <div class="text-danger small">@_passwordError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _showPasswordDialog = false">取消</button>
                    <button class="btn btn-primary" @onclick="SavePasswordAsync" disabled="@_passwordSaving">确定</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private UserProfileDto? _profile;
    private bool _loading;
    private bool _saving;
    private bool _passwordSaving;
    private string _message = string.Empty;

    // QQ 内联编辑
    private bool _editingQq;
    private string _qqInput = string.Empty;

    // 实名认证
    private string _verifyTab = "personal";
    private string _certName = string.Empty;
    private string _certNo = string.Empty;
    private string _companyName = string.Empty;
    private string _companyCode = string.Empty;

    // 手机绑定
    private string _phoneInput = string.Empty;
    private string _phoneCode = string.Empty;

    // 邮箱绑定
    private string _emailInput = string.Empty;
    private string _emailCode = string.Empty;

    // 安全设置
    private string _whiteIp = string.Empty;
    private string _loginCaptcha = string.Empty;

    // 密码修改
    private bool _showPasswordDialog;
    private string _passwordError = string.Empty;
    private PasswordEditModel _password = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var response = await Api.GetAsync<UserProfileDto>("profile", ApiScope.User);
        _profile = response?.Data;
        if (_profile != null)
        {
            _qqInput = _profile.Qq ?? string.Empty;
            _certName = _profile.CertName ?? string.Empty;
            _certNo = _profile.CertNo ?? string.Empty;
            _companyName = _profile.CertName ?? string.Empty;
            _companyCode = _profile.CertNo ?? string.Empty;
            _phoneInput = _profile.Phone ?? string.Empty;
            _emailInput = _profile.Email ?? string.Empty;
            _whiteIp = _profile.WhiteIp ?? string.Empty;
            _loginCaptcha = _profile.LoginCaptcha ?? "none";
        }
        _loading = false;
    }

    private void StartEditQq()
    {
        _qqInput = _profile?.Qq ?? string.Empty;
        _editingQq = true;
    }

    private async Task SaveQqAsync()
    {
        _editingQq = false;
        if (_profile == null) return;
        await SaveProfileFieldsAsync(qq: _qqInput);
    }

    private async Task SaveCertAsync()
    {
        await SaveProfileFieldsAsync(certName: _certName, certNo: _certNo);
    }

    private async Task SaveCompanyCertAsync()
    {
        await SaveProfileFieldsAsync(certName: _companyName, certNo: _companyCode);
    }

    private async Task SavePhoneAsync()
    {
        await SaveProfileFieldsAsync(phone: _phoneInput);
    }

    private async Task SaveEmailAsync()
    {
        await SaveProfileFieldsAsync(email: _emailInput);
    }

    private async Task SaveSecurityAsync()
    {
        await SaveProfileFieldsAsync(whiteIp: _whiteIp, loginCaptcha: _loginCaptcha);
    }

    private async Task SaveProfileFieldsAsync(
        string? qq = null, string? email = null, string? phone = null,
        string? certName = null, string? certNo = null,
        string? whiteIp = null, string? loginCaptcha = null)
    {
        if (_saving || _profile == null) return;
        _saving = true;
        _message = string.Empty;

        var request = new UpdateProfileRequest
        {
            Email = email ?? _profile.Email ?? string.Empty,
            Phone = phone ?? _profile.Phone ?? string.Empty,
            Qq = qq ?? _profile.Qq ?? string.Empty,
            CertName = certName ?? _profile.CertName ?? string.Empty,
            CertNo = certNo ?? _profile.CertNo ?? string.Empty,
            WhiteIp = whiteIp ?? _profile.WhiteIp ?? string.Empty,
            LoginCaptcha = loginCaptcha ?? _profile.LoginCaptcha ?? string.Empty
        };

        var response = await Api.PutAsync<bool>("profile", request, ApiScope.User);
        _message = response?.Code == 200 ? "保存成功" : (response?.Message ?? "保存完成");
        _saving = false;
        await LoadAsync();
    }

    private async Task SavePasswordAsync()
    {
        _passwordError = string.Empty;
        if (string.IsNullOrWhiteSpace(_password.Current) || string.IsNullOrWhiteSpace(_password.Next))
        {
            _passwordError = "请输入完整信息";
            return;
        }
        if (!string.Equals(_password.Next, _password.Confirm, StringComparison.Ordinal))
        {
            _passwordError = "两次密码不一致";
            return;
        }

        _passwordSaving = true;
        var request = new UpdatePasswordRequest
        {
            Current = _password.Current,
            Next = _password.Next
        };
        var response = await Api.PutAsync<bool>("password", request, ApiScope.User);
        _passwordSaving = false;
        _showPasswordDialog = false;
        _password = new PasswordEditModel();
        _message = response?.Code == 200 ? "密码已更新" : (response?.Message ?? "操作完成");
    }

    private static string FormatBalance(long? balance)
    {
        return $"{((balance ?? 0) / 100m):F2}元";
    }

    private sealed class PasswordEditModel
    {
        public string Current { get; set; } = string.Empty;
        public string Next { get; set; } = string.Empty;
        public string Confirm { get; set; } = string.Empty;
    }
}
