@page "/account/messages"
@using Cnn.Common.Contracts
@inject ApiClient Api
@inject IJSRuntime Js

<div class="page-container">
    <div class="page-title">消息记录</div>

    <div class="filter-bar">
        <select class="form-select" style="max-width: 160px" @bind="_type">
            <option value="">全部类型</option>
            <option value="package-expire">套餐到期</option>
            <option value="traffic-exceed">流量超限</option>
            <option value="connection-exceed">连接数超限</option>
            <option value="bandwidth-exceed">带宽超限</option>
            <option value="cc-switch">防护规则切换</option>
            <option value="cert-expire">证书到期</option>
        </select>
        <InputText class="form-control" style="max-width: 220px" @bind-Value="_keyword" placeholder="关键字" />
        <button class="btn btn-primary" @onclick="SearchAsync">搜索</button>
        <button class="btn btn-outline-secondary" @onclick="TogglePagingDiagnostics">
            @(_showPagingDiagnostics ? "隐藏分页诊断" : "显示分页诊断")
        </button>
    </div>

    @if (_showPagingDiagnostics)
    {
        <div class="alert alert-light py-2 px-3 mt-2 mb-2 small">
            <div><strong>分页诊断</strong></div>
            <div>stateKey: <code>account:messages:table</code></div>
            <div>pagingEnabled: <code>@(_pageQuery.PagingEnabled ? "true" : "false")</code></div>
            <div>page: <code>@_pageQuery.Page</code>, pageSize: <code>@_pageQuery.PageSize</code></div>
            <div>loaded: <code>@_items.Count</code>, total: <code>@_total</code></div>
        </div>
    }

    <TablePager @ref="_tablePager"
                StateKey="account:messages:table"
                Total="_total"
                DefaultPageSize="20"
                UnpagedLimit="1000"
                QueryChanged="OnPageQueryChangedAsync">
        <ChildContent>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>标题</th>
                            <th>类型</th>
                            <th>网站ID</th>
                            <th>时间</th>
                            <th>状态</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_loading)
                        {
                            <tr><td colspan="7">加载中...</td></tr>
                        }
                        else if (_items.Count == 0)
                        {
                            <tr><td colspan="7">暂无数据</td></tr>
                        }
                        else
                        {
                            @foreach (var item in _items)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>
                                        <a href="#" class="text-decoration-none" @onclick="() => OpenDetailAsync(item)" @onclick:preventDefault>
                                            @item.Title
                                        </a>
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(item.TypeLabel) ? item.Type : item.TypeLabel)</td>
                                    <td>@(item.SiteId > 0 ? item.SiteId.ToString() : "-")</td>
                                    <td>@item.CreatedAt</td>
                                    <td>
                                        @if (item.IsRead)
                                        {
                                            <span class="badge bg-secondary">已读</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">未读</span>
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenDetailAsync(item)">详情</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </ChildContent>
    </TablePager>
</div>

@if (_detailVisible && _detail != null)
{
    <div class="modal-backdrop">
        <div class="modal-panel" style="max-width: 560px">
            <div class="modal-header">
                <h5>@_detail.Title</h5>
                <button class="btn-close" @onclick="CloseDetail"></button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrWhiteSpace(_detail.Content))
                {
                    <div class="mb-3">
                        <div class="text-muted small mb-1">邮件内容</div>
                        <div>@((MarkupString)_detail.Content)</div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(_detail.Phone))
                {
                    <div class="mb-3">
                        <div class="text-muted small mb-1">短信内容</div>
                        <div>@_detail.Phone</div>
                    </div>
                }
                @if (string.IsNullOrWhiteSpace(_detail.Content) && string.IsNullOrWhiteSpace(_detail.Phone))
                {
                    <p class="text-muted">暂无内容</p>
                }
            </div>
            <div class="modal-footer d-flex justify-content-end">
                <button class="btn btn-secondary" @onclick="CloseDetail">关闭</button>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<MessageItemDto> _items = new();
    private bool _loading;
    private bool _showPagingDiagnostics;
    private string _keyword = string.Empty;
    private string _type = string.Empty;
    private TablePageQuery _pageQuery = new() { PagingEnabled = true, Page = 1, PageSize = 20 };
    private long _total;
    private TablePager? _tablePager;

    private bool _detailVisible;
    private MessageItemDto? _detail;

    protected override Task OnInitializedAsync() => Task.CompletedTask;

    private async Task LoadAsync()
    {
        if (_loading)
        {
            return;
        }

        _loading = true;
        var query = new Dictionary<string, string?>
        {
            ["page"] = _pageQuery.Page.ToString(),
            ["pageSize"] = _pageQuery.PageSize.ToString(),
            ["type"] = _type,
            ["keyword"] = _keyword
        };

        var response = await Api.GetAsync<MessageListResult>("messages", ApiScope.User, query);
        _items.Clear();
        if (response?.Data?.List != null)
        {
            _items.AddRange(response.Data.List);
            _total = response.Data.Total;
        }
        else
        {
            _total = 0;
        }
        _loading = false;
    }

    private async Task SearchAsync()
    {
        if (_tablePager != null)
        {
            await _tablePager.SearchAsync();
            return;
        }

        _pageQuery = new TablePageQuery
        {
            PagingEnabled = _pageQuery.PagingEnabled,
            Page = 1,
            PageSize = _pageQuery.PageSize
        };
        await LoadAsync();
    }

    private Task OnPageQueryChangedAsync(TablePageQuery query)
    {
        _pageQuery = query;
        return LoadAsync();
    }

    private void TogglePagingDiagnostics()
    {
        _showPagingDiagnostics = !_showPagingDiagnostics;
    }

    private async Task OpenDetailAsync(MessageItemDto item)
    {
        _detail = item;
        _detailVisible = true;

        if (!item.IsRead)
        {
            await Api.PostAsync<object>($"messages/{item.Id}/read", null, ApiScope.User);
            item.IsRead = true;
        }
    }

    private void CloseDetail()
    {
        _detailVisible = false;
        _detail = null;
    }
}
