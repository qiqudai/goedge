@page "/finance/orders"
@using Cnn.Common.Contracts
@inject ApiClient Api
@inject ClientSession Session
@inject IJSRuntime Js

<PageTitle>订单管理</PageTitle>

@if (!Session.IsAdmin)
{
    <p class="text-danger">无权限</p>
    return;
}

<div class="page-header">
    <h5 class="page-title">订单管理</h5>
</div>

<div class="filter-bar">
    <InputText class="form-control" style="max-width:240px" @bind-Value="_keyword" placeholder="用户名/用户ID" />
    <button class="btn btn-primary" @onclick="SearchAsync">搜索</button>
    <button class="btn btn-outline-secondary" @onclick="RefreshAsync">刷新</button>
    <button class="btn btn-success" @onclick="OpenRechargeDialog">手动充值</button>
</div>

<TablePager @ref="_tablePager"
            StateKey="finance:orders:table"
            Total="_total"
            DefaultPageSize="20"
            UnpagedLimit="1000"
            QueryChanged="OnPageQueryChangedAsync">
    <ChildContent>
        <div class="table-responsive mt-3">
            <table class="table table-bordered table-sm table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>订单ID</th>
                        <th>用户ID</th>
                        <th>金额</th>
                        <th>状态</th>
                        <th>支付方式</th>
                        <th>订单号</th>
                        <th>类型</th>
                        <th>备注</th>
                        <th>创建时间</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="10" class="text-center text-muted">加载中...</td></tr>
                    }
                    else if (_items.Count == 0)
                    {
                        <tr><td colspan="10" class="text-center text-muted">暂无数据</td></tr>
                    }
                    else
                    {
                        @foreach (var item in _items)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.UserId</td>
                                <td>¥@item.Amount.ToString("F2")</td>
                                <td>
                                    @if (item.Status == 1)
                                    {
                                        <span class="badge bg-success">已支付</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">未支付</span>
                                    }
                                </td>
                                <td>@(item.PayType ?? "-")</td>
                                <td class="text-break" style="max-width:200px">@(item.OrderNo ?? "-")</td>
                                <td>@(item.Type ?? "-")</td>
                                <td class="text-break" style="max-width:200px">@(item.Remark ?? "-")</td>
                                <td>@(item.CreatedAt ?? "-")</td>
                                <td>
                                    @if (item.Status == 0)
                                    {
                                        <button class="btn btn-sm btn-link p-0" @onclick="() => MarkPaidAsync(item)">标记已支付</button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </ChildContent>
</TablePager>

@* 余额调整对话框 *@
@if (_showRechargeDialog)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.4)">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">余额调整</h5>
                    <button type="button" class="btn-close" @onclick="CloseRechargeDialog"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">用户ID</label>
                        <InputNumber class="form-control" @bind-Value="_rechargeForm.UserId" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">动作</label>
                        <select class="form-select" @bind="_rechargeForm.Action">
                            <option value="credit">加款</option>
                            <option value="debit">扣款</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">金额</label>
                        <InputNumber class="form-control" @bind-Value="_rechargeForm.Amount" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">原因</label>
                        <InputText class="form-control" @bind-Value="_rechargeForm.Reason" />
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_rechargeError))
                    {
                        <div class="alert alert-danger py-1">@_rechargeError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseRechargeDialog">取消</button>
                    <button class="btn btn-primary btn-sm" @onclick="SubmitRechargeAsync" disabled="@_rechargeLoading">确定</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading;
    private string _keyword = string.Empty;
    private TablePageQuery _pageQuery = new() { PagingEnabled = true, Page = 1, PageSize = 20 };
    private int _total;
    private readonly List<AdminOrderDto> _items = new();
    private TablePager? _tablePager;

    private bool _showRechargeDialog;
    private bool _rechargeLoading;
    private string _rechargeError = string.Empty;
    private RechargeFormModel _rechargeForm = new();

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        var query = new Dictionary<string, string?>
        {
            ["keyword"] = string.IsNullOrWhiteSpace(_keyword) ? null : _keyword,
            ["page"]    = _pageQuery.Page.ToString(),
            ["pageSize"] = _pageQuery.PageSize.ToString()
        };

        var response = await Api.GetAsync<OrderListResult<AdminOrderDto>>("orders", ApiScope.Admin, query);
        _items.Clear();
        _total = 0;
        if (response?.Data != null)
        {
            _items.AddRange(response.Data.List);
            _total = response.Data.Total;
        }

        _loading = false;
        StateHasChanged();
    }

    private async Task SearchAsync()
    {
        if (_tablePager != null)
        {
            await _tablePager.SearchAsync();
            return;
        }

        _pageQuery = new TablePageQuery
        {
            PagingEnabled = _pageQuery.PagingEnabled,
            Page = 1,
            PageSize = _pageQuery.PageSize
        };
        await LoadAsync();
    }

    private Task RefreshAsync()
    {
        if (_tablePager != null)
        {
            return _tablePager.RefreshAsync();
        }

        return LoadAsync();
    }

    private Task OnPageQueryChangedAsync(TablePageQuery query)
    {
        _pageQuery = query;
        return LoadAsync();
    }

    private async Task MarkPaidAsync(AdminOrderDto order)
    {
        var confirmed = await Js.InvokeAsync<bool>("confirm", $"确认将订单 #{order.Id} 标记为已支付？");
        if (!confirmed) return;

        var req = new AdminMarkOrderPaidRequest { Reason = "admin mark paid" };
        var response = await Api.PostAsync<object>($"orders/{order.Id}/mark_paid", req, ApiScope.Admin);
        await RefreshAsync();
    }

    private void OpenRechargeDialog()
    {
        _rechargeForm = new RechargeFormModel();
        _rechargeError = string.Empty;
        _showRechargeDialog = true;
    }

    private void CloseRechargeDialog()
    {
        _showRechargeDialog = false;
    }

    private async Task SubmitRechargeAsync()
    {
        if (_rechargeForm.UserId <= 0 || _rechargeForm.Amount <= 0)
        {
            _rechargeError = "请输入用户ID和金额";
            return;
        }

        _rechargeLoading = true;
        _rechargeError = string.Empty;

        var req = new AdminAdjustBalanceRequest
        {
            UserId = _rechargeForm.UserId,
            Amount = _rechargeForm.Amount,
            Action = _rechargeForm.Action,
            Reason = _rechargeForm.Reason
        };

        var response = await Api.PostAsync<object>("balance/adjust", req, ApiScope.Admin);
        _rechargeLoading = false;

        if (response?.Code == 200)
        {
            _showRechargeDialog = false;
            await RefreshAsync();
        }
        else
        {
            _rechargeError = response?.Message ?? "操作失败";
        }
    }

    private sealed class RechargeFormModel
    {
        public long UserId { get; set; }
        public string Action { get; set; } = "credit";
        public decimal Amount { get; set; }
        public string Reason { get; set; } = string.Empty;
    }
}
