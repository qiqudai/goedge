@page "/node/monitor/config"
@using Cnn.Common.Contracts.Admin
@inject ApiClient Api
@inject ClientSession Session
@inject IJSRuntime Js

<PageTitle>监控配置</PageTitle>

@if (!Session.IsAdmin)
{
    <p class="text-danger">无权限</p>
    return;
}

<div class="page-header">
    <h5 class="page-title">监控配置</h5>
</div>

@if (_loading)
{
    <p class="text-muted">加载中...</p>
}
else
{
    <div class="card" style="max-width:640px">
        <div class="card-body">
            <h6 class="card-subtitle mb-3 text-muted">通知设置</h6>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">通知时间段</label>
                <div class="col-sm-8">
                    <InputText class="form-control" @bind-Value="_form.NotificationPeriod" placeholder="8-22" />
                    <div class="form-text">如: 8-22 表示仅在 8:00~22:00 发送通知</div>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">通知方式</label>
                <div class="col-sm-8">
                    <select class="form-select" @bind="_form.NotifyMethod">
                        <option value="email">邮件</option>
                        <option value="sms">短信</option>
                        <option value="email sms">邮件+短信</option>
                    </select>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">通知类型</label>
                <div class="col-sm-8">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="chk_node_ip_dns"
                               checked="@_notifyTypes.Contains("node_ip_dns")"
                               @onchange='e => ToggleNotifyType("node_ip_dns", (bool)e.Value!)' />
                        <label class="form-check-label" for="chk_node_ip_dns">节点IP变化</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="chk_bandwidth"
                               checked="@_notifyTypes.Contains("bandwidth")"
                               @onchange='e => ToggleNotifyType("bandwidth", (bool)e.Value!)' />
                        <label class="form-check-label" for="chk_bandwidth">带宽超限</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="chk_backup_ip"
                               checked="@_notifyTypes.Contains("backup_ip")"
                               @onchange='e => ToggleNotifyType("backup_ip", (bool)e.Value!)' />
                        <label class="form-check-label" for="chk_backup_ip">备用IP</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="chk_backup_default_line"
                               checked="@_notifyTypes.Contains("backup_default_line")"
                               @onchange='e => ToggleNotifyType("backup_default_line", (bool)e.Value!)' />
                        <label class="form-check-label" for="chk_backup_default_line">默认线路备份</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="chk_backup_group"
                               checked="@_notifyTypes.Contains("backup_group")"
                               @onchange='e => ToggleNotifyType("backup_group", (bool)e.Value!)' />
                        <label class="form-check-label" for="chk_backup_group">节点组备份</label>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">邮箱</label>
                <div class="col-sm-8">
                    <InputText class="form-control" @bind-Value="_form.Email" placeholder="admin@example.com" />
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">手机号</label>
                <div class="col-sm-8">
                    <InputText class="form-control" @bind-Value="_form.Phone" placeholder="+86138..." />
                </div>
            </div>

            <hr />
            <h6 class="card-subtitle mb-3 text-muted">带宽监控</h6>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">带宽超限次数</label>
                <div class="col-sm-8">
                    <InputNumber class="form-control" @bind-Value="_form.BwExceedTimes" />
                </div>
            </div>

            <hr />
            <h6 class="card-subtitle mb-3 text-muted">高负载自动降权</h6>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">启用</label>
                <div class="col-sm-8 d-flex align-items-center">
                    <InputCheckbox @bind-Value="_form.AutoSwitchEnable" />
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">恢复时间(秒)</label>
                <div class="col-sm-8">
                    <InputNumber class="form-control" @bind-Value="_form.AutoSwitchRecover" />
                </div>
            </div>

            <hr />
            <h6 class="card-subtitle mb-3 text-muted">节点监控</h6>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">监控API</label>
                <div class="col-sm-8">
                    <InputText class="form-control" @bind-Value="_form.MonitorApi" placeholder="http://..." />
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">检测间隔(秒)</label>
                <div class="col-sm-8">
                    <InputNumber class="form-control" @bind-Value="_form.Interval" />
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">失败次数</label>
                <div class="col-sm-8">
                    <InputNumber class="form-control" @bind-Value="_form.FailedTimes" />
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">失败率(%)</label>
                <div class="col-sm-8">
                    <InputText class="form-control" @bind-Value="_form.FailedRate" placeholder="50" />
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_saveMsg))
            {
                <div class="alert @(_saveOk ? "alert-success" : "alert-danger") py-2">@_saveMsg</div>
            }

            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">保存配置</button>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _saving;
    private string _saveMsg = string.Empty;
    private bool _saveOk;
    private NodeMonitorConfigDto _form = new();
    private readonly HashSet<string> _notifyTypes = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        var response = await Api.GetAsync<NodeMonitorConfigDto>("monitor_config", ApiScope.Admin);
        if (response?.Data != null)
        {
            _form = response.Data;
            _notifyTypes.Clear();
            if (!string.IsNullOrWhiteSpace(_form.NotifyMsgType))
            {
                foreach (var t in _form.NotifyMsgType.Split(' ', StringSplitOptions.RemoveEmptyEntries))
                {
                    _notifyTypes.Add(t);
                }
            }
        }

        _loading = false;
        StateHasChanged();
    }

    private void ToggleNotifyType(string type, bool isChecked)
    {
        if (isChecked)
            _notifyTypes.Add(type);
        else
            _notifyTypes.Remove(type);
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _saveMsg = string.Empty;
        StateHasChanged();

        _form.NotifyMsgType = string.Join(" ", _notifyTypes);

        var response = await Api.PostAsync<object>("monitor_config", _form, ApiScope.Admin);
        _saving = false;

        if (response?.Code == 200)
        {
            _saveMsg = "保存成功";
            _saveOk = true;
        }
        else
        {
            _saveMsg = response?.Message ?? "保存失败";
            _saveOk = false;
        }

        StateHasChanged();
    }
}
