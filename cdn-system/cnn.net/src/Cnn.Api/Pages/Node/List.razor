    private void OpenCreate()
    {
        _editing = NodeEditModel.CreateDefault();
        _regionLocked = false;
        _originalRegionId = 0;
        _subIpText = string.Empty;
        _editTab = "basic";
        if (_regions.Count > 0)
        {
            _editing.RegionId = _regions[0].Id;
        }
        _editVisible = true;
    }

    private void OpenEdit(NodeListItem item)
    {
        _editing = NodeEditModel.FromItem(item);
        _regionLocked = item.LineCount > 0;
        _originalRegionId = _editing.RegionId;
        _subIpText = item.SubIps == null
            ? string.Empty
            : string.Join("\n", item.SubIps.Select(ip => ip.Ip).Where(ip => !string.IsNullOrWhiteSpace(ip)));
        _editTab = "basic";
        _editVisible = true;
    }

    private void CloseEditor()
    {
        _editVisible = false;
    }

    private async Task SaveNodeAsync()
    {
        if (_saving)
        {
            return;
        }

        if (_regionLocked && _editing.RegionId != _originalRegionId)
        {
            await Js.InvokeVoidAsync("alert", "该节点已有线路分组，禁止修改区域。请先移除线路后再修改。");
            return;
        }

        _saving = true;
        var subIps = _subIpText.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(ip => new NodeSubIp(0, ip))
            .ToList();

        var payload = _editing.ToRequest(subIps);
        if (_editing.Id > 0)
        {
            await Api.PutAsync<object>($"nodes/{_editing.Id}", payload, ApiScope.Admin);
        }
        else
        {
            var response = await Api.PostAsync<NodeListItem>("nodes", payload, ApiScope.Admin);
            if (!string.IsNullOrWhiteSpace(response?.Data?.InstallError))
            {
                await Js.InvokeVoidAsync("alert", $"安装失败: {response.Data.InstallError}");
            }
        }

        _saving = false;
        _editVisible = false;
        await LoadNodesAsync();
    }

