    private async Task BatchAsync(string action)
    {
        if (!_selectedNodeIds.Any())
        {
            return;
        }

        var confirm = await Js.InvokeAsync<bool>("confirm", $"确定执行批量{GetBatchLabel(action)}操作吗？");
        if (!confirm)
        {
            return;
        }

        var payload = new NodeBatchRequest
        {
            Action = action,
            Ids = _selectedNodeIds.ToList()
        };
        await Api.PostAsync<object>("nodes/batch_action", payload, ApiScope.Admin);
        _selectedNodeIds.Clear();
        await LoadNodesAsync();
    }

    private static string GetBatchLabel(string action) => action switch
    {
        "start" => "启用",
        "stop" => "禁用",
        "delete" => "删除",
        _ => action
    };

    private async Task ToggleEnableAsync(NodeListItem item, ChangeEventArgs args)
    {
        var newValue = args.Value?.ToString() == "true" || args.Value?.ToString() == "on";
        var original = item.Enable ?? false;
        item.Enable = newValue;

        var payload = new NodeStatusRequest { Enable = newValue };
        var response = await Api.PutAsync<object>($"nodes/{item.Id}/status", payload, ApiScope.Admin);
        if (response == null || response.Code != 200)
        {
            item.Enable = original;
            await Js.InvokeVoidAsync("alert", response?.Message ?? "状态更新失败");
        }
    }

