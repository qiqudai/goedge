﻿
@page "/node/list"
@using Cnn.Common.Contracts.Admin
@using Cnn.Api.Services
@using Cnn.Api.Services.Deletion
@using Cnn.Api.Services.Tasks.Workflow
@inject ApiClient Api
@inject IJSRuntime Js
@inject NavigationManager Nav

@implements IDisposable

<div class="page-container">
    <div class="page-title">节点管理</div>

    <div class="tab-bar">
        <button class='tab-button @(IsTab("list") ? "active" : "")' @onclick='@(() => SetTab("list"))'>节点列表</button>
        <button class='tab-button @(IsTab("region") ? "active" : "")' @onclick='@(() => SetTab("region"))'>区域管理</button>
    </div>

    @if (_activeTab == "list")
    {
        <div class="filter-bar">
            <button class="btn btn-primary" @onclick="OpenCreate">安装节点</button>
            <button class="btn btn-outline-secondary" disabled="@(!_selectedNodeIds.Any())" @onclick='@(() => BatchAsync("stop"))'>禁用</button>
            <button class="btn btn-outline-secondary" disabled="@(!_selectedNodeIds.Any())" @onclick='@(() => BatchAsync("start"))'>启用</button>
            <button class="btn btn-outline-secondary" @onclick="RefreshNodesAsync">刷新</button>
            <button class="btn btn-outline-danger" disabled="@(!_selectedNodeIds.Any())" @onclick='@(() => BatchAsync("delete"))'>删除</button>
        </div>

        <div class="filter-bar">
            <select class="form-select" style="max-width: 160px" @bind="_filters.RegionId">
                <option value="0">全部区域</option>
                @foreach (var region in _regions)
                {
                    <option value="@region.Id">@region.Name</option>
                }
            </select>
            <select class="form-select" style="max-width: 160px" @bind="_filters.Status">
                <option value="">全部状态</option>
                <option value="enabled">启用</option>
                <option value="disabled">禁用</option>
            </select>
            <select class="form-select" style="max-width: 160px" @bind="_filters.NodeType">
                <option value="0">全部类型</option>
                <option value="1">L1边缘节点</option>
                <option value="2">L2中间节点</option>
            </select>
            <InputText class="form-control" style="max-width: 240px" @bind-Value="_filters.Keyword" placeholder="名称/IP/ID" />
            <button class="btn btn-primary" @onclick="SearchAsync">搜索</button>
            <button class="btn btn-link" @onclick="ResetFilters">重置</button>
            <button class="btn btn-outline-secondary" @onclick="ToggleNodePagingDiagnostics">
                @(_showNodePagingDiagnostics ? "隐藏分页诊断" : "显示分页诊断")
            </button>
        </div>

        @if (_showNodePagingDiagnostics)
        {
            <div class="alert alert-light py-2 px-3 mt-2 mb-2 small">
                <div><strong>分页诊断</strong></div>
                <div>stateKey: <code>node:list:table</code></div>
                <div>pagingEnabled: <code>@(_nodePageQuery.PagingEnabled ? "true" : "false")</code></div>
                <div>page: <code>@_nodePageQuery.Page</code>, pageSize: <code>@_nodePageQuery.PageSize</code></div>
                <div>loaded: <code>@_nodes.Count</code>, total: <code>@_total</code></div>
            </div>
        }

        <TablePager @ref="_nodeTablePager"
                    StateKey="node:list:table"
                    Total="_total"
                    DefaultPageSize="20"
                    UnpagedLimit="1000"
                    QueryChanged="OnNodePageQueryChangedAsync">
            <ChildContent>
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th style="width: 50px">
                                    <input type="checkbox" class="form-check-input" checked="@AllNodesSelected" @onchange="ToggleSelectAll" />
                                </th>
                                <th style="width: 80px">ID</th>
                                <th>名称</th>
                                <th>区域/分组</th>
                                <th>IP</th>
                                <th>监控</th>
                                <th>带宽</th>
                                <th style="width: 120px">状态</th>
                                <th style="width: 140px">安装状态</th>
                                <th style="width: 90px">启用</th>
                                <th style="width: 100px">反代理阻断</th>
                                <th>备注</th>
                                <th style="width: 80px">排序</th>
                                <th style="width: 160px">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_loading)
                            {
                                <tr><td colspan="14">加载中...</td></tr>
                            }
                            else if (_nodes.Count == 0)
                            {
                                <tr><td colspan="14">暂无数据</td></tr>
                            }
                            else
                            {
                                @foreach (var item in _nodes)
                                {
                                    <tr>
                                        <td>
                                            <input type="checkbox" class="form-check-input" checked="@_selectedNodeIds.Contains(item.Id)" @onchange="e => ToggleNode(item.Id, e)" />
                                        </td>
                                        <td>@item.Id</td>
                                        <td>
                                            <button class="btn btn-link btn-sm p-0" @onclick="@(() => OpenEdit(item))">@item.Name</button>
                                        </td>
                                        <td>
                                            <div>@(string.IsNullOrWhiteSpace(item.RegionName) ? "默认" : item.RegionName)</div>
                                            <button class="btn btn-link btn-sm p-0" @onclick='@(() => Nav.NavigateTo("/node/groups"))'>线路分组(@item.LineCount)</button>
                                        </td>
                                        <td>
                                            <div>@item.Ip</div>
                                            @if (item.SubIps != null && item.SubIps.Count > 0)
                                            {
                                                <div class="text-muted small">附加IP：@string.Join("，", item.SubIps.Select(ip => ip.Ip).Where(ip => !string.IsNullOrWhiteSpace(ip)))</div>
                                            }
                                        </td>
                                        <td>
                                            <span class="text-muted">@((item.CheckProtocol ?? "http").ToUpperInvariant())</span>
                                            <button class="btn btn-link btn-sm" @onclick="@(() => OpenMonitorLogs(item))">日志</button>
                                        </td>
                                        <td>
                                            <button class="btn btn-link btn-sm" @onclick='@(() => Nav.NavigateTo("/node/realtime"))'>@FormatBandwidth(item.BwLimit)</button>
                                        </td>
                                        <td>
                                            <span class="status-dot @GetStatusClass(item)"></span>
                                            <span>@GetStatusText(item)</span>
                                        </td>
                                        <td>
                                            <span class="badge @GetInstallBadge(item)">@GetInstallStatus(item)</span>
                                            @if (item.InstallStatus != null && item.InstallStatus.Equals("running", StringComparison.OrdinalIgnoreCase) && item.InstallProgress.HasValue)
                                            {
                                                <span class="ms-1">@item.InstallProgress%</span>
                                            }
                                            @if (item.InstallStatus != null && item.InstallStatus.Equals("failed", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(item.InstallError))
                                            {
                                                <div class="text-danger small">@item.InstallError</div>
                                            }
                                        </td>
                                        <td>
                                            <input type="checkbox" class="form-check-input" checked="@(item.Enable ?? false)" @onchange="e => ToggleEnableAsync(item, e)" />
                                        </td>
                                        <td>
                                            <input type="checkbox" class="form-check-input" checked="@item.AntiBlocking" @onchange="e => ToggleAntiBlockingAsync(item, e)" title="反代理阻断" />
                                            @if (item.ReportedAntiBlocking.HasValue)
                                            {
                                                <span class="badge @(item.ReportedAntiBlocking == item.AntiBlocking ? "bg-success" : "bg-warning") ms-1" style="font-size:10px">
                                                    @(item.ReportedAntiBlocking == item.AntiBlocking ? "已同步" : "待同步")
                                                </span>
                                            }
                                        </td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Remark) ? "-" : item.Remark)</td>
                                        <td>@(item.SortOrder?.ToString() ?? "-")</td>
                                        <td>
                                            <button class="btn btn-link btn-sm" @onclick="@(() => OpenEdit(item))">管理</button>
                                            <button class="btn btn-link btn-sm" disabled="@string.IsNullOrWhiteSpace(item.SshUser)" @onclick="@(() => ReinstallAsync(item))">重装</button>
                                            <button class="btn btn-link btn-sm text-danger" @onclick="@(() => DeleteAsync(item))">删除</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </ChildContent>
        </TablePager>
    }
    else
    {
        <div class="filter-bar">
            <button class="btn btn-primary" @onclick="OpenRegionCreate">新增区域</button>
            <button class="btn btn-outline-danger" disabled="@(!_selectedRegionIds.Any())" @onclick="BatchDeleteRegionsAsync">删除</button>
        </div>

        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th style="width: 50px">
                            <input type="checkbox" class="form-check-input" checked="@AllRegionsSelected" @onchange="ToggleSelectAllRegions" />
                        </th>
                        <th style="width: 80px">ID</th>
                        <th>名称</th>
                        <th>备注</th>
                        <th style="width: 140px">L2检测端口</th>
                        <th style="width: 100px">排序</th>
                        <th style="width: 160px">添加时间</th>
                        <th style="width: 120px">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_regionLoading)
                    {
                        <tr><td colspan="8">加载中...</td></tr>
                    }
                    else if (_regions.Count == 0)
                    {
                        <tr><td colspan="8">暂无数据</td></tr>
                    }
                    else
                    {
                        @foreach (var region in _regions)
                        {
                            <tr>
                                <td>
                                    <input type="checkbox" class="form-check-input" checked="@_selectedRegionIds.Contains(region.Id)" @onchange="e => ToggleRegion(region.Id, e)" />
                                </td>
                                <td>@region.Id</td>
                                <td>@region.Name</td>
                                <td>@(string.IsNullOrWhiteSpace(region.Remark) ? "-" : region.Remark)</td>
                                <td>@(region.L2CheckPort?.ToString() ?? "-")</td>
                                <td>@(region.SortOrder?.ToString() ?? "-")</td>
                                <td>@FormatDate(region.CreatedAt)</td>
                                <td>
                                    <button class="btn btn-link btn-sm" @onclick="@(() => OpenRegionEdit(region))">编辑</button>
                                    <button class="btn btn-link btn-sm text-danger" @onclick="@(() => DeleteRegionAsync(region))">删除</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (_editVisible)
{
    <div class="modal-backdrop">
        <div class="modal-panel node-edit-panel">
            <div class="modal-header">
                <h5>@(_editing.Id > 0 ? "编辑节点" : "安装节点")</h5>
                <button class="btn-close" @onclick="CloseEditor"></button>
            </div>
            <div class="tab-bar">
                <button class='tab-button @(IsEditTab("basic") ? "active" : "")' @onclick='@(() => SetEditTab("basic"))'>基础设置</button>
                <button class='tab-button @(IsEditTab("settings") ? "active" : "")' @onclick='@(() => SetEditTab("settings"))'>节点设置</button>
                <button class='tab-button @(IsEditTab("subips") ? "active" : "")' @onclick='@(() => SetEditTab("subips"))'>附加IP</button>
            </div>

            <div class="modal-body">
                @if (_editTab == "basic")
                {
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">名称</label>
                            <InputText class="form-control" @bind-Value="_editing.Name" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">区域</label>
                            <select class="form-select" @bind="_editing.RegionId" disabled="@_regionLocked">
                                <option value="0">请选择区域</option>
                                @foreach (var region in _regions)
                                {
                                    <option value="@region.Id">@region.Name</option>
                                }
                            </select>
                            @if (_regionLocked)
                            {
                                <div class="form-text text-warning">该节点已有线路分组，禁止修改区域。</div>
                            }
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">备注</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="_editing.Remark" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">排序</label>
                            <InputText class="form-control" @bind-Value="_editing.SortOrder" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">IP</label>
                            <InputText class="form-control" @bind-Value="_editing.Ip" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">节点类型</label>
                            <div class="d-flex gap-3">
                                <label class="form-check">
                                    <input type="radio" class="form-check-input" name="nodeType" value="1" checked="@(_editing.Type == 1)" @onchange="@(() => _editing.Type = 1)" />
                                    <span class="form-check-label">L1边缘节点</span>
                                </label>
                                <label class="form-check">
                                    <input type="radio" class="form-check-input" name="nodeType" value="2" checked="@(_editing.Type == 2)" @onchange="@(() => _editing.Type = 2)" />
                                    <span class="form-check-label">L2中间节点</span>
                                </label>
                            </div>
                        </div>
                        <div class="col-12">
                            <hr />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">SSH端口</label>
                            <InputText class="form-control" @bind-Value="_editing.SshPort" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">SSH用户名</label>
                            <InputText class="form-control" @bind-Value="_editing.SshUser" placeholder="root" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">认证方式</label>
                            <div class="d-flex gap-3">
                                <label class="form-check">
                                    <input type="radio" class="form-check-input" name="authType" value="password" checked='@(_editing.SshAuthType == "password")' @onchange='@(() => _editing.SshAuthType = "password")' />
                                    <span class="form-check-label">密码</span>
                                </label>
                                <label class="form-check">
                                    <input type="radio" class="form-check-input" name="authType" value="key" checked='@(_editing.SshAuthType == "key")' @onchange='@(() => _editing.SshAuthType = "key")' />
                                    <span class="form-check-label">密钥</span>
                                </label>
                            </div>
                        </div>
                        @if (_editing.SshAuthType == "password")
                        {
                            <div class="col-md-12">
                                <label class="form-label">SSH密码</label>
                                <InputText class="form-control" type="password" @bind-Value="_editing.SshPassword" />
                            </div>
                        }
                        else
                        {
                            <div class="col-md-12">
                                <label class="form-label">SSH密钥</label>
                                <InputTextArea class="form-control" rows="4" @bind-Value="_editing.SshKey" />
                            </div>
                        }
                        <div class="col-md-6">
                            <label class="form-label">工作目录</label>
                            <InputText class="form-control" @bind-Value="_editing.WorkDir" disabled />
                            <div class="form-text">工作目录固定在节点可执行文件所在目录。</div>
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check form-switch">
                                <InputCheckbox class="form-check-input" @bind-Value="_editing.AutoInstall" />
                                <label class="form-check-label">自动安装</label>
                            </div>
                        </div>
                    </div>
                }
                else if (_editTab == "settings")
                {
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">缓存目录</label>
                            <InputText class="form-control" @bind-Value="_editing.CacheDir" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">缓存上限(GB)</label>
                            <InputText class="form-control" @bind-Value="_editing.CacheLimit" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">日志目录</label>
                            <InputText class="form-control" @bind-Value="_editing.LogDir" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">带宽限制(Mbps)</label>
                            <InputText class="form-control" @bind-Value="_editing.BwLimit" placeholder="1000" />
                        </div>
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label">附加IP（每行一个）</label>
                        <InputTextArea class="form-control" rows="6" @bind-Value="_subIpText" />
                    </div>
                }
            </div>

            <div class="modal-footer d-flex justify-content-end gap-2">
                <button class="btn btn-secondary" @onclick="CloseEditor">取消</button>
                <button class="btn btn-primary" @onclick="SaveNodeAsync" disabled="@_saving">保存</button>
            </div>
        </div>
    </div>
}

@if (_monitorVisible)
{
    <div class="modal-backdrop">
        <div class="modal-panel">
            <div class="modal-header">
                <h5>监控日志</h5>
                <button class="btn-close" @onclick="CloseMonitor"></button>
            </div>
            <div class="modal-body">
                <div class="filter-bar">
                    <select class="form-select" style="max-width: 200px" @bind="_monitorQuery.Type">
                        <option value="availability">可用性监控日志</option>
                    </select>
                    <InputText class="form-control" style="max-width: 200px" @bind-Value="_monitorQuery.Start" placeholder="开始时间(yyyy-MM-dd HH:mm:ss)" />
                    <InputText class="form-control" style="max-width: 200px" @bind-Value="_monitorQuery.End" placeholder="结束时间(yyyy-MM-dd HH:mm:ss)" />
                    <button class="btn btn-primary" @onclick="SearchMonitorLogsAsync">搜索</button>
                    <button class="btn btn-outline-secondary" @onclick="ToggleMonitorPagingDiagnostics">
                        @(_showMonitorPagingDiagnostics ? "隐藏分页诊断" : "显示分页诊断")
                    </button>
                </div>

                @if (_showMonitorPagingDiagnostics)
                {
                    <div class="alert alert-light py-2 px-3 mt-2 mb-2 small">
                        <div><strong>分页诊断</strong></div>
                        <div>stateKey: <code>node:list:monitor:table</code></div>
                        <div>pagingEnabled: <code>@(_monitorPageQuery.PagingEnabled ? "true" : "false")</code></div>
                        <div>page: <code>@_monitorPageQuery.Page</code>, pageSize: <code>@_monitorPageQuery.PageSize</code></div>
                        <div>loaded: <code>@_monitorLogs.Count</code>, total: <code>@_monitorTotal</code></div>
                    </div>
                }

                <TablePager @ref="_monitorTablePager"
                            StateKey="node:list:monitor:table"
                            Total="_monitorTotal"
                            DefaultPageSize="10"
                            UnpagedLimit="1000"
                            QueryChanged="OnMonitorPageQueryChangedAsync">
                    <ChildContent>
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>检测时间</th>
                                        <th style="width: 120px">失败次数</th>
                                        <th style="width: 120px">总检测点</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_monitorLoading)
                                    {
                                        <tr><td colspan="3">加载中...</td></tr>
                                    }
                                    else if (_monitorLogs.Count == 0)
                                    {
                                        <tr><td colspan="3">暂无数据</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var log in _monitorLogs)
                                        {
                                            <tr>
                                                <td>@FormatDate(log.CheckedAt)</td>
                                                <td>@log.FailCount</td>
                                                <td>@log.TotalCount</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </ChildContent>
                </TablePager>
            </div>
        </div>
    </div>
}

@if (_regionEditorVisible)
{
    <div class="modal-backdrop">
        <div class="modal-panel">
            <div class="modal-header">
                <h5>@(_regionEditor.Id > 0 ? "编辑区域" : "新增区域")</h5>
                <button class="btn-close" @onclick="CloseRegionEditor"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">名称</label>
                    <InputText class="form-control" @bind-Value="_regionEditor.Name" />
                </div>
                <div class="mb-3">
                    <label class="form-label">备注</label>
                    <InputText class="form-control" @bind-Value="_regionEditor.Remark" />
                </div>
                <div class="mb-3">
                    <label class="form-label">L2检测端口</label>
                    <InputText class="form-control" @bind-Value="_regionEditor.L2CheckPort" />
                </div>
                <div class="mb-3">
                    <label class="form-label">排序</label>
                    <InputText class="form-control" @bind-Value="_regionEditor.SortOrder" />
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-end gap-2">
                <button class="btn btn-secondary" @onclick="CloseRegionEditor">取消</button>
                <button class="btn btn-primary" @onclick="SaveRegionAsync">保存</button>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<NodeListItem> _nodes = new();
    private readonly List<RegionListItem> _regions = new();
    private readonly HashSet<long> _selectedNodeIds = new();
    private readonly HashSet<long> _selectedRegionIds = new();
    private readonly NodeFilters _filters = new();
    private string _activeTab = "list";
    private long _total;
    private bool _loading;
    private bool _showNodePagingDiagnostics;
    private bool _regionLoading;
    private TablePageQuery _nodePageQuery = new() { PagingEnabled = true, Page = 1, PageSize = 20 };
    private TablePager? _nodeTablePager;

    private bool _editVisible;
    private bool _saving;
    private string _editTab = "basic";
    private NodeEditModel _editing = new();
    private string _subIpText = string.Empty;
    private bool _regionLocked;
    private long _originalRegionId;

    private bool _monitorVisible;
    private bool _monitorLoading;
    private bool _showMonitorPagingDiagnostics;
    private long _monitorNodeId;
    private long _monitorTotal;
    private readonly List<NodeMonitorLogItem> _monitorLogs = new();
    private readonly MonitorQuery _monitorQuery = new();
    private TablePageQuery _monitorPageQuery = new() { PagingEnabled = true, Page = 1, PageSize = 10 };
    private TablePager? _monitorTablePager;

    private bool _regionEditorVisible;
    private RegionEditModel _regionEditor = new();

    private global::System.Timers.Timer? _pollTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadRegionsAsync();
    }

    private bool IsTab(string tab) => string.Equals(_activeTab, tab, StringComparison.OrdinalIgnoreCase);

    private void SetTab(string tab)
    {
        _activeTab = tab;
        if (_activeTab == "region")
        {
            _ = LoadRegionsAsync();
        }
    }

    private bool IsEditTab(string tab) => string.Equals(_editTab, tab, StringComparison.OrdinalIgnoreCase);

    private void SetEditTab(string tab)
    {
        _editTab = tab;
    }

    private async Task LoadNodesAsync()
    {
        if (_loading)
        {
            return;
        }

        _loading = true;
        var query = new Dictionary<string, string?>
        {
            ["page"] = _nodePageQuery.Page.ToString(),
            ["pageSize"] = _nodePageQuery.PageSize.ToString()
        };

        if (_filters.RegionId > 0)
        {
            query["region_id"] = _filters.RegionId.ToString();
        }

        if (_filters.NodeType > 0)
        {
            query["node_type"] = _filters.NodeType.ToString();
        }

        if (!string.IsNullOrWhiteSpace(_filters.Status))
        {
            query["status"] = _filters.Status;
        }

        if (!string.IsNullOrWhiteSpace(_filters.Keyword))
        {
            query["keyword"] = _filters.Keyword.Trim();
        }

        var response = await Api.GetAsync<NodeListResult>("nodes", ApiScope.Admin, query);
        _nodes.Clear();
        if (response?.Data?.List != null)
        {
            _nodes.AddRange(response.Data.List);
            _total = response.Data.Total;
        }
        else
        {
            _total = 0;
        }

        PruneSelection();
        UpdateInstallPolling();
        _loading = false;
    }

