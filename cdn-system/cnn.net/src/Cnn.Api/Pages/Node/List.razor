    private async Task DeleteAsync(NodeListItem item)
    {
        var result = await DeleteWorkflowHelper.ConfirmAndRequestAsync(
            Api,
            Js,
            $"nodes/{item.Id}",
            ApiScope.Admin,
            "确定删除该节点吗？",
            "节点删除任务已提交");
        if (!result.Success)
        {
            if (!result.Cancelled)
            {
                await Js.InvokeVoidAsync("alert", result.Message);
            }

            return;
        }

        await Js.InvokeVoidAsync("alert", result.Message);
        await LoadNodesAsync();
        if (result.TaskId > 0)
        {
            await RefreshAfterDeleteTaskAsync();
        }
    }

    private async Task RefreshAfterDeleteTaskAsync()
    {
        await Task.Delay(1200);
        await LoadNodesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private static string BuildDeleteBlockedMessage(string? message, IReadOnlyList<DeleteReferenceItem>? references)
    {
        var lines = new List<string>();
        if (!string.IsNullOrWhiteSpace(message))
        {
            lines.Add(message.Trim());
        }

        foreach (var item in references?.Take(5) ?? Array.Empty<DeleteReferenceItem>())
        {
            lines.Add($"- {item.DisplayName} [{item.Relation}]");
        }

        if ((references?.Count ?? 0) > 5)
        {
            lines.Add($"- 还有 {references!.Count - 5} 项依赖未展示");
        }

        return lines.Count == 0 ? "当前资源暂时无法删除" : string.Join("\n", lines);
    }

