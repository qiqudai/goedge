    private sealed class NodeEditModel
    {
        public long Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public long RegionId { get; set; }
        public string Remark { get; set; } = string.Empty;
        public string SortOrder { get; set; } = "100";
        public string Ip { get; set; } = string.Empty;
        public int Type { get; set; } = 1;
        public string CacheDir { get; set; } = string.Empty;
        public string CacheLimit { get; set; } = "0";
        public string LogDir { get; set; } = string.Empty;
        public string BwLimit { get; set; } = string.Empty;
        public string SshHost { get; set; } = string.Empty;
        public string SshPort { get; set; } = "22";
        public string SshUser { get; set; } = string.Empty;
        public string SshAuthType { get; set; } = "password";
        public string SshPassword { get; set; } = string.Empty;
        public string SshKey { get; set; } = string.Empty;
        public string WorkDir { get; set; } = "/www/node";
        public bool AutoInstall { get; set; } = true;

        public static NodeEditModel CreateDefault()
        {
            return new NodeEditModel();
        }

        public static NodeEditModel FromItem(NodeListItem item)
        {
            return new NodeEditModel
            {
                Id = item.Id,
                Name = item.Name ?? string.Empty,
                RegionId = item.RegionId ?? 0,
                Remark = item.Remark ?? string.Empty,
                SortOrder = item.SortOrder?.ToString() ?? "100",
                Ip = item.Ip ?? string.Empty,
                Type = item.Type ?? 1,
                CacheDir = item.CacheDir ?? string.Empty,
                CacheLimit = item.CacheLimit?.ToString() ?? "0",
                LogDir = item.LogDir ?? string.Empty,
                BwLimit = item.BwLimit ?? string.Empty,
                SshHost = item.SshHost ?? string.Empty,
                SshPort = item.SshPort?.ToString() ?? "22",
                SshUser = item.SshUser ?? string.Empty,
                SshAuthType = string.IsNullOrWhiteSpace(item.SshAuthType) ? "password" : item.SshAuthType,
                WorkDir = string.IsNullOrWhiteSpace(item.WorkDir) ? "/www/node" : item.WorkDir,
                AutoInstall = item.AutoInstall ?? true
            };
        }

        public NodeCreateRequest ToRequest(IReadOnlyList<NodeSubIp> subIps)
        {
            return new NodeCreateRequest
            {
                Name = Name,
                RegionId = RegionId > 0 ? RegionId : null,
                Remark = Remark,
                SortOrder = TryParseInt(SortOrder),
                Ip = Ip,
                Type = Type,
                CacheDir = CacheDir,
                CacheLimit = TryParseInt(CacheLimit),
                LogDir = LogDir,
                BwLimit = BwLimit,
                SshHost = SshHost,
                SshPort = TryParseInt(SshPort),
                SshUser = SshUser,
                SshAuthType = SshAuthType,
                SshPassword = string.IsNullOrWhiteSpace(SshPassword) ? null : SshPassword,
                SshKey = string.IsNullOrWhiteSpace(SshKey) ? null : SshKey,
                WorkDir = WorkDir,
                AutoInstall = AutoInstall,
                SubIps = subIps
            };
        }

        private static int? TryParseInt(string? value)
        {
            if (string.IsNullOrWhiteSpace(value))
            {
                return null;
            }

            if (int.TryParse(value, out var result))
            {
                return result;
            }

            return null;
        }
    }

