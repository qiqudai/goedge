    private static string FormatBandwidth(string? limit)
    {
        if (string.IsNullOrWhiteSpace(limit))
        {
            return "-";
        }

        return limit.EndsWith("bps", StringComparison.OrdinalIgnoreCase) ? limit : $"{limit} Mbps";
    }

    private static string GetStatusText(NodeListItem item)
    {
        if (item.Enable != true)
        {
            return "禁用";
        }

        return item.Online ? "在线" : "离线";
    }

    private static string GetStatusClass(NodeListItem item)
    {
        if (item.Enable != true)
        {
            return "status-disabled";
        }

        return item.Online ? "status-online" : "status-offline";
    }

    private static string GetInstallStatus(NodeListItem item)
    {
        var status = item.InstallStatus?.ToLowerInvariant() ?? "idle";
        return status switch
        {
            "running" => "安装中",
            "success" => "已完成",
            "failed" => "失败",
            _ => "空闲"
        };
    }

    private static string GetInstallBadge(NodeListItem item)
    {
        var status = item.InstallStatus?.ToLowerInvariant() ?? "idle";
        return status switch
        {
            "running" => "bg-warning",
            "success" => "bg-success",
            "failed" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private static string FormatDate(DateTime? value)
    {
        if (value == null || value.Value == DateTime.MinValue)
        {
            return "-";
        }

        return value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");
    }

    private void UpdateInstallPolling()
    {
        var hasRunning = _nodes.Any(node => string.Equals(node.InstallStatus, "running", StringComparison.OrdinalIgnoreCase));
        if (hasRunning)
        {
            StartPolling();
        }
        else
        {
            StopPolling();
        }
    }

    private void StartPolling()
    {
        if (_pollTimer != null)
        {
            return;
        }

        _pollTimer = new global::System.Timers.Timer(5000);
        _pollTimer.Elapsed += async (_, _) => await InvokeAsync(LoadNodesAsync);
        _pollTimer.Start();
    }

    private void StopPolling()
    {
        if (_pollTimer == null)
        {
            return;
        }

        _pollTimer.Stop();
        _pollTimer.Dispose();
        _pollTimer = null;
    }

    public void Dispose()
    {
        StopPolling();
    }

