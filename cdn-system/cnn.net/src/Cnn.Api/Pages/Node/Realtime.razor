
@page "/node/realtime"
@using Cnn.Common.Contracts
@using Cnn.Common.Contracts.Admin
@using Cnn.Api.Services
@inject ApiClient Api
@inject IJSRuntime Js

<div class="page-container">
    <div class="page-title">实时监控</div>

    <div class="tab-bar">
        <button class='tab-button @(_activeTab == "ranking" ? "active" : "")' @onclick='@(() => SetTab("ranking"))'>资源排行</button>
        <button class='tab-button @(_activeTab == "metrics" ? "active" : "")' @onclick='@(() => SetTab("metrics"))'>监控指标</button>
        <button class='tab-button @(_activeTab == "traffic" ? "active" : "")' @onclick='@(() => SetTab("traffic"))'>节点流量</button>
    </div>

    @if (_activeTab == "ranking")
    {
        <div class="card config-card">
            <div class="card-body">
                <div class="filter-bar">
                    <span class="text-muted">指标</span>
                    <div class="btn-group">
                        <button class='btn @GetButtonClass(_ranking.Metric == "bandwidth")' @onclick='@(() => SetRankingMetric("bandwidth"))'>带宽</button>
                        <button class='btn @GetButtonClass(_ranking.Metric == "connection")' @onclick='@(() => SetRankingMetric("connection"))'>连接</button>
                        <button class='btn @GetButtonClass(_ranking.Metric == "load")' @onclick='@(() => SetRankingMetric("load"))'>负载</button>
                        <button class='btn @GetButtonClass(_ranking.Metric == "disk")' @onclick='@(() => SetRankingMetric("disk"))'>磁盘</button>
                    </div>
                    <span class="text-muted">时间</span>
                    <div class="btn-group">
                        <button class='btn @GetButtonClass(_ranking.Window == "1m")' @onclick='@(() => SetRankingWindow("1m"))'>1分钟</button>
                        <button class='btn @GetButtonClass(_ranking.Window == "5m")' @onclick='@(() => SetRankingWindow("5m"))'>5分钟</button>
                        <button class='btn @GetButtonClass(_ranking.Window == "30m")' @onclick='@(() => SetRankingWindow("30m"))'>30分钟</button>
                        <button class='btn @GetButtonClass(_ranking.Window == "1h")' @onclick='@(() => SetRankingWindow("1h"))'>1小时</button>
                    </div>
                    <button class="btn btn-primary" @onclick="RefreshRankingAsync">刷新</button>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th style="width: 80px">排行</th>
                                <th>节点</th>
                                <th style="width: 140px">网卡</th>
                                <th style="width: 160px">出站带宽</th>
                                <th style="width: 160px">入站带宽</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_rankingLoading)
                            {
                                <tr><td colspan="5">加载中...</td></tr>
                            }
                            else if (_rankingList.Count == 0)
                            {
                                <tr><td colspan="5">暂无数据</td></tr>
                            }
                            else
                            {
                                @foreach (var item in _rankingList)
                                {
                                    <tr>
                                        <td>@item.Rank</td>
                                        <td>@item.Node</td>
                                        <td>@item.Nic</td>
                                        <td>@item.Out</td>
                                        <td>@item.In</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else if (_activeTab == "metrics")
    {
        <div class="card config-card">
            <div class="card-body">
                <div class="filter-bar">
                    <span class="text-muted">指标</span>
                    <div class="btn-group">
                        <button class='btn @GetButtonClass(_metrics.Metric == "bandwidth")' @onclick='@(() => SetMetricsMetric("bandwidth"))'>带宽</button>
                        <button class='btn @GetButtonClass(_metrics.Metric == "connection")' @onclick='@(() => SetMetricsMetric("connection"))'>连接</button>
                        <button class='btn @GetButtonClass(_metrics.Metric == "load")' @onclick='@(() => SetMetricsMetric("load"))'>负载</button>
                        <button class='btn @GetButtonClass(_metrics.Metric == "disk")' @onclick='@(() => SetMetricsMetric("disk"))'>磁盘</button>
                    </div>
                    <span class="text-muted">时间</span>
                    <div class="btn-group">
                        <button class='btn @GetButtonClass(_metrics.Window == "1h")' @onclick='@(() => SetMetricsWindow("1h"))'>1h</button>
                        <button class='btn @GetButtonClass(_metrics.Window == "6h")' @onclick='@(() => SetMetricsWindow("6h"))'>6h</button>
                        <button class='btn @GetButtonClass(_metrics.Window == "12h")' @onclick='@(() => SetMetricsWindow("12h"))'>12h</button>
                        <button class='btn @GetButtonClass(_metrics.Window == "custom")' @onclick='@(() => SetMetricsWindow("custom"))'>自定义</button>
                    </div>
                    @if (_metrics.Window == "custom")
                    {
                        <InputText class="form-control" style="max-width: 200px" @bind-Value="_metrics.Start" placeholder="开始时间" />
                        <InputText class="form-control" style="max-width: 200px" @bind-Value="_metrics.End" placeholder="结束时间" />
                    }
                    <button class="btn btn-primary" @onclick="RefreshMetricsAsync">刷新</button>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th style="width: 200px">时间</th>
                                <th>值</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_metricsLoading)
                            {
                                <tr><td colspan="2">加载中...</td></tr>
                            }
                            else if (_metricsList.Count == 0)
                            {
                                <tr><td colspan="2">暂无数据</td></tr>
                            }
                            else
                            {
                                @foreach (var item in _metricsList)
                                {
                                    <tr>
                                        <td>@item.Time</td>
                                        <td>@item.Value</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card config-card">
            <div class="card-body">
                <div class="filter-bar">
                    <span class="text-muted">类型</span>
                    <label class="form-check">
                        <input type="checkbox" class="form-check-input" checked="@_traffic.ShowOut" @onchange='e => ToggleTrafficType("out", e)' />
                        <span class="form-check-label">出站流量</span>
                    </label>
                    <label class="form-check">
                        <input type="checkbox" class="form-check-input" checked="@_traffic.ShowIn" @onchange='e => ToggleTrafficType("in", e)' />
                        <span class="form-check-label">入站流量</span>
                    </label>
                    <span class="text-muted">时间</span>
                    <div class="btn-group">
                        <button class='btn @GetButtonClass(_traffic.Window == "1d")' @onclick='@(() => SetTrafficWindow("1d"))'>1d</button>
                        <button class='btn @GetButtonClass(_traffic.Window == "7d")' @onclick='@(() => SetTrafficWindow("7d"))'>7d</button>
                        <button class='btn @GetButtonClass(_traffic.Window == "30d")' @onclick='@(() => SetTrafficWindow("30d"))'>30d</button>
                        <button class='btn @GetButtonClass(_traffic.Window == "custom")' @onclick='@(() => SetTrafficWindow("custom"))'>自定义</button>
                    </div>
                    @if (_traffic.Window == "custom")
                    {
                        <InputText class="form-control" style="max-width: 200px" @bind-Value="_traffic.Start" placeholder="开始时间" />
                        <InputText class="form-control" style="max-width: 200px" @bind-Value="_traffic.End" placeholder="结束时间" />
                    }
                    <span class="text-muted">节点</span>
                    <select class="form-select" style="max-width: 220px" @bind="_traffic.NodeId">
                        <option value="all">全部节点</option>
                        @foreach (var node in _nodeOptions)
                        {
                            <option value="@node.Id">@node.Name</option>
                        }
                    </select>
                    <span class="text-muted">排除网卡</span>
                    <InputText class="form-control" style="max-width: 240px" @bind-Value="_traffic.ExcludeNic" placeholder="多个网卡用空格分隔" />
                    <button class="btn btn-primary" @onclick="RefreshTrafficAsync">刷新</button>
                </div>

                @if (_trafficLoading)
                {
                    <div class="text-center text-muted py-3">加载中...</div>
                }
                else
                {
                    <div id="nodeTrafficChart" style="height: 320px; width: 100%;"></div>
                }
            </div>
        </div>
    }
</div>

@code {
    private string _activeTab = "ranking";

    private readonly List<StatNodeRankingItemDto> _rankingList = new();
    private readonly List<StatNodeMetricPointDto> _metricsList = new();
    private readonly List<NodeListItem> _nodeOptions = new();

    private bool _rankingLoading;
    private bool _metricsLoading;
    private bool _trafficLoading;

    private readonly RankingState _ranking = new();
    private readonly MetricsState _metrics = new();
    private readonly TrafficState _traffic = new();

    protected override async Task OnInitializedAsync()
    {
        await RefreshRankingAsync();
    }

    private string GetButtonClass(bool active) => active ? "btn-primary" : "btn-outline-secondary";

    private async Task SetTab(string tab)
    {
        _activeTab = tab;
        if (tab == "ranking")
        {
            await RefreshRankingAsync();
        }
        else if (tab == "metrics")
        {
            await RefreshMetricsAsync();
        }
        else
        {
            if (_nodeOptions.Count == 0)
            {
                await LoadNodeOptionsAsync();
            }
            await RefreshTrafficAsync();
        }
    }

    private async Task SetRankingMetric(string metric)
    {
        _ranking.Metric = metric;
        await RefreshRankingAsync();
    }

    private async Task SetRankingWindow(string window)
    {
        _ranking.Window = window;
        await RefreshRankingAsync();
    }

    private async Task RefreshRankingAsync()
    {
        if (_rankingLoading)
        {
            return;
        }

        _rankingLoading = true;
        var query = new Dictionary<string, string?>
        {
            ["metric"] = _ranking.Metric,
            ["window"] = _ranking.Window
        };
        var response = await Api.GetAsync<StatNodeRankingResultDto>("stats/node_ranking", ApiScope.Admin, query);
        _rankingList.Clear();
        if (response?.Data?.List != null)
        {
            _rankingList.AddRange(response.Data.List);
        }
        _rankingLoading = false;
    }

    private async Task SetMetricsMetric(string metric)
    {
        _metrics.Metric = metric;
        await RefreshMetricsAsync();
    }

    private async Task SetMetricsWindow(string window)
    {
        _metrics.Window = window;
        if (window != "custom")
        {
            _metrics.Start = string.Empty;
            _metrics.End = string.Empty;
        }
        await RefreshMetricsAsync();
    }

    private async Task RefreshMetricsAsync()
    {
        if (_metricsLoading)
        {
            return;
        }

        if (_metrics.Window == "custom" && (string.IsNullOrWhiteSpace(_metrics.Start) || string.IsNullOrWhiteSpace(_metrics.End)))
        {
            _metricsList.Clear();
            return;
        }

        _metricsLoading = true;
        var query = new Dictionary<string, string?>
        {
            ["metric"] = _metrics.Metric,
            ["window"] = _metrics.Window,
            ["start_time"] = _metrics.Start,
            ["end_time"] = _metrics.End
        };
        var response = await Api.GetAsync<StatNodeMetricsResultDto>("stats/node_metrics", ApiScope.Admin, query);
        _metricsList.Clear();
        if (response?.Data?.List != null)
        {
            _metricsList.AddRange(response.Data.List);
        }
        _metricsLoading = false;
    }

    private async Task ToggleTrafficType(string type, ChangeEventArgs args)
    {
        var isChecked = args.Value?.ToString() == "true" || args.Value?.ToString() == "on";
        if (type == "out")
        {
            _traffic.ShowOut = isChecked;
        }
        else
        {
            _traffic.ShowIn = isChecked;
        }

        await RefreshTrafficAsync();
    }

    private async Task SetTrafficWindow(string window)
    {
        _traffic.Window = window;
        if (window != "custom")
        {
            _traffic.Start = string.Empty;
            _traffic.End = string.Empty;
        }
        await RefreshTrafficAsync();
    }

    private async Task RefreshTrafficAsync()
    {
        if (_trafficLoading)
        {
            return;
        }

        if (_traffic.Window == "custom" && (string.IsNullOrWhiteSpace(_traffic.Start) || string.IsNullOrWhiteSpace(_traffic.End)))
        {
            return;
        }

        _trafficLoading = true;
        StateHasChanged();

        var query = new Dictionary<string, string?>
        {
            ["window"] = _traffic.Window,
            ["node_id"] = _traffic.NodeId,
            ["exclude_nic"] = _traffic.ExcludeNic,
            ["start_time"] = _traffic.Start,
            ["end_time"] = _traffic.End
        };
        var response = await Api.GetAsync<StatNodeTrafficDto>("stats/node_traffic", ApiScope.Admin, query);
        _trafficLoading = false;
        StateHasChanged();

        if (response?.Data != null)
        {
            var xAxis = response.Data.XAxis ?? Array.Empty<string>();
            var inTraffic = response.Data.InTraffic ?? Array.Empty<double>();
            var outTraffic = response.Data.OutTraffic ?? Array.Empty<double>();

            var series = new List<object>();
            if (_traffic.ShowOut)
            {
                series.Add(new { name = "出站流量(MB)", type = "line", data = outTraffic, smooth = true, lineStyle = new { color = "#3a7bff" } });
            }
            if (_traffic.ShowIn)
            {
                series.Add(new { name = "入站流量(MB)", type = "line", data = inTraffic, smooth = true, lineStyle = new { color = "#4bc58e" } });
            }

            await Js.InvokeVoidAsync("cnn.realtime.renderTraffic", "nodeTrafficChart", new
            {
                xAxis,
                series
            });
        }
    }

    private async Task LoadNodeOptionsAsync()
    {
        var query = new Dictionary<string, string?> { ["pageSize"] = "1000" };
        var response = await Api.GetAsync<NodeListResult>("nodes", ApiScope.Admin, query);
        _nodeOptions.Clear();
        if (response?.Data?.List != null)
        {
            _nodeOptions.AddRange(response.Data.List);
        }
    }

    private sealed class RankingState
    {
        public string Metric { get; set; } = "bandwidth";
        public string Window { get; set; } = "1m";
    }

    private sealed class MetricsState
    {
        public string Metric { get; set; } = "bandwidth";
        public string Window { get; set; } = "1h";
        public string Start { get; set; } = string.Empty;
        public string End { get; set; } = string.Empty;
    }

    private sealed class TrafficState
    {
        public string Window { get; set; } = "30d";
        public bool ShowOut { get; set; } = true;
        public bool ShowIn { get; set; } = true;
        public string Start { get; set; } = string.Empty;
        public string End { get; set; } = string.Empty;
        public string NodeId { get; set; } = "all";
        public string ExcludeNic { get; set; } = string.Empty;
    }
}

