@page "/login"
@layout LoginLayout
@using Cnn.Common.Contracts
@using Microsoft.AspNetCore.WebUtilities
@using global::System.Timers
@inject ApiClient Api
@inject SystemInfoClient SystemInfoClient
@inject LocalStorageService Storage
@inject ClientSession Session
@inject NavigationManager Navigation

<div class="login-card card shadow-sm">
    <div class="card-body">
        <div class="login-header">
            @if (!string.IsNullOrWhiteSpace(_bannerUrl))
            {
                <img src="@_bannerUrl" class="login-logo" alt="logo" />
            }
            <h2 class="login-title">@_title</h2>
        </div>

        <EditForm Model="@_form" OnValidSubmit="HandleLoginAsync">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <InputText class="form-control" @bind-Value="_form.Username" placeholder="用户名" />
            </div>
            <div class="mb-3">
                <InputText class="form-control" @bind-Value="_form.Password" placeholder="密码" type="password" />
            </div>
            @if (_showCaptchaType)
            {
                <InputRadioGroup @bind-Value="_form.CaptchaType">
                    <div class="mb-3">
                        <div class="form-check form-check-inline">
                            <InputRadio class="form-check-input" Value='@("email")' />
                            <label class="form-check-label">邮箱验证码</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <InputRadio class="form-check-input" Value='@("sms")' />
                            <label class="form-check-label">短信验证码</label>
                        </div>
                    </div>
                </InputRadioGroup>
            }
            @if (_showCaptcha)
            {
                <div class="mb-3 d-flex gap-2">
                    <InputText class="form-control" @bind-Value="_form.Captcha" placeholder="@_captchaPlaceholder" />
                    <button type="button" class="btn btn-outline-secondary" disabled="@_captchaSending || _captchaCountdown > 0" @onclick="SendCaptchaAsync">
                        @_captchaButtonText
                    </button>
                </div>
            }
            <div class="d-grid">
                <button type="submit" class="btn btn-primary" disabled="@_loading">
                    @(_loading ? "登录中..." : "登录")
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert alert-danger mt-3">@_error</div>
            }
        </EditForm>
    </div>
</div>

@code {
    private readonly LoginForm _form = new();
    private bool _loading;
    private bool _captchaSending;
    private int _captchaCountdown;
    private string _error = string.Empty;
    private string _title = "管理后台";
    private string _bannerUrl = string.Empty;
    private bool _showCaptcha;
    private bool _showCaptchaType;
    private string _captchaPlaceholder = "邮箱验证码";
    private string _captchaButtonText = "获取验证码";
    private Timer? _timer;
    private bool _impersonateApplied;

    protected override async Task OnInitializedAsync()
    {
        var info = await SystemInfoClient.GetAsync();
        _title = info.AdminConsoleTitle ?? info.SysName ?? "管理后台";
        _bannerUrl = info.LoginAdFile ?? info.LogoFile ?? string.Empty;
        _showCaptcha = info.EnableEmailLogin || info.EnableSmsLogin;
        _showCaptchaType = info.EnableEmailLogin && info.EnableSmsLogin;
        _form.CaptchaType = info.EnableEmailLogin ? "email" : (info.EnableSmsLogin ? "sms" : string.Empty);
        UpdateCaptchaUi();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _impersonateApplied)
        {
            return;
        }

        _impersonateApplied = true;
        await ApplyImpersonateFromQueryAsync();
    }

    private async Task ApplyImpersonateFromQueryAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (string.IsNullOrWhiteSpace(uri.Query))
        {
            return;
        }

        var query = QueryHelpers.ParseQuery(uri.Query);
        if (!query.TryGetValue("token", out var tokenValues))
        {
            return;
        }

        var token = tokenValues.FirstOrDefault();
        if (string.IsNullOrWhiteSpace(token))
        {
            return;
        }

        var role = query.TryGetValue("role", out var roleValues) ? roleValues.FirstOrDefault() : "admin";
        var redirect = query.TryGetValue("redirect", out var redirectValues) ? redirectValues.FirstOrDefault() : "/dashboard";

        Session.Set(token, role, null);
        await Storage.SetItemAsync("admin_token", token);
        await Storage.SetItemAsync("role", role ?? "admin");
        Navigation.NavigateTo(redirect ?? "/dashboard", forceLoad: true);
    }

    private async Task HandleLoginAsync()
    {
        _error = string.Empty;
        if (string.IsNullOrWhiteSpace(_form.Username) || string.IsNullOrWhiteSpace(_form.Password))
        {
            _error = "请输入用户名和密码";
            return;
        }

        if (_showCaptcha && string.IsNullOrWhiteSpace(_form.Captcha))
        {
            _error = "请输入验证码";
            return;
        }

        _loading = true;
        var payload = new LoginRequest
        {
            Username = _form.Username,
            Password = _form.Password,
            Captcha = _form.Captcha,
            CaptchaType = _form.CaptchaType
        };

        var response = await Api.PostAsync<LoginResponse>("login", payload, ApiScope.Public);
        _loading = false;
        if (response?.Data == null)
        {
            _error = response?.Message ?? "登录失败";
            return;
        }

        var token = response.Data.Token;
        var role = response.Data.Role ?? "user";
        Session.Set(token, role, _form.Username);
        await Storage.SetItemAsync("admin_token", token);
        await Storage.SetItemAsync("role", role);
        await Storage.SetItemAsync("username", _form.Username);
        Navigation.NavigateTo("/dashboard", forceLoad: true);
    }

    private async Task SendCaptchaAsync()
    {
        _error = string.Empty;
        if (!_showCaptcha)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_form.Username))
        {
            _error = "请输入用户名";
            return;
        }

        _captchaSending = true;
        var request = new LoginCaptchaRequest
        {
            Username = _form.Username,
            Type = _form.CaptchaType
        };
        var response = await Api.PostAsync<object>("login/captcha", request, ApiScope.Public);
        _captchaSending = false;
        if (response?.Code != 0 && response?.Code != 200)
        {
            _error = response?.Message ?? "发送失败";
            return;
        }

        StartCountdown();
    }

    private void StartCountdown()
    {
        _captchaCountdown = 60;
        UpdateCaptchaUi();
        _timer?.Stop();
        _timer?.Dispose();
        _timer = new Timer(1000);
        _timer.Elapsed += (_, _) =>
        {
            if (_captchaCountdown <= 0)
            {
                _timer?.Stop();
                _timer?.Dispose();
                _timer = null;
                return;
            }
            _captchaCountdown -= 1;
            InvokeAsync(UpdateCaptchaUi);
        };
        _timer.Start();
    }

    private void UpdateCaptchaUi()
    {
        _captchaPlaceholder = _form.CaptchaType == "sms" ? "短信验证码" : "邮箱验证码";
        _captchaButtonText = _captchaCountdown > 0 ? $"{_captchaCountdown}s" : "获取验证码";
        StateHasChanged();
    }

    private sealed class LoginForm
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string Captcha { get; set; } = string.Empty;
        public string CaptchaType { get; set; } = string.Empty;
    }
}
